<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsShipping>false</IsShipping>
    <IsAotCompatible>true</IsAotCompatible>
    <PublishAot>true</PublishAot>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Aspire.Hosting.Native.Core.Tests" />
    <ProjectReference Include="../Ats/NativeHosting.Ats.csproj" />
    <EmbeddedResource Include="../generated/*.mts;../generated/*.mjs" LogicalName="NativeSdk.%(Filename)%(Extension)" />
    <EmbeddedResource Include="CompatibleContract.json" LogicalName="CompatibleContract.json" />
  </ItemGroup>
</Project>
