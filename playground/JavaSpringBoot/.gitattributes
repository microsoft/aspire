# The Maven and Gradle wrappers are shell scripts. Committing them with CRLF makes them unrunnable on
# Linux and macOS, which is where CI builds these samples.
/catalog/mvnw text eol=lf
/worker/mvnw text eol=lf
/JavaSpringBoot.AppHost.Java/gradlew text eol=lf
/orders/gradlew text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
