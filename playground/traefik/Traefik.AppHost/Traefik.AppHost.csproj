<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(DefaultTargetFramework)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAspireHost>true</IsAspireHost>
  </PropertyGroup>

  <ItemGroup>
    <AspireProjectOrPackageReference Include="Aspire.Hosting.AppHost" />
    <AspireProjectOrPackageReference Include="Aspire.Hosting.Docker" />
    <AspireProjectOrPackageReference Include="Aspire.Hosting.Keycloak" />
    <AspireProjectOrPackageReference Include="Aspire.Hosting.Traefik" />
    <ProjectReference Include="..\Traefik.Api\Traefik.Api.csproj" />
  </ItemGroup>

</Project>
