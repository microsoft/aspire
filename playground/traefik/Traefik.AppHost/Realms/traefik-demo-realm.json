{
  "realm": "traefik-demo",
  "enabled": true,
  "sslRequired": "none",
  "clients": [
    {
      "clientId": "oauth2-proxy",
      "name": "oauth2-proxy (Traefik forward authentication)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${TRAEFIK_DEMO_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [ "${TRAEFIK_DEMO_HTTP_REDIRECT_URI}", "${TRAEFIK_DEMO_REDIRECT_URI}", "${TRAEFIK_DEMO_API_REDIRECT_URI}" ],
      "webOrigins": [ "+" ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "oauth2-proxy audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "oauth2-proxy",
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "alice",
      "email": "alice@example.com",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Example",
      "enabled": true,
      "credentials": [
        { "type": "password", "value": "alice", "temporary": false }
      ]
    }
  ]
}
