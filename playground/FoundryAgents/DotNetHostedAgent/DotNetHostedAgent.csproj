<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Suppress experimental API warnings from Agent Framework Foundry packages -->
    <NoWarn>$(NoWarn);OPENAI001;MAIF001;MAAI001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.AI.Projects" />
    <PackageReference Include="OpenAI" />
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Microsoft.Agents.AI.Foundry.Hosting" VersionOverride="1.12.0-preview.260629.1" />
    <PackageReference Include="Microsoft.Extensions.AI" VersionOverride="10.7.0" />
    <!-- 10.10.1 aligns the Responses tool adapter with OpenAI 2.14's MCP approval types. -->
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" VersionOverride="10.10.1" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" VersionOverride="10.10.1" />
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="Azure.Core" />
  </ItemGroup>

</Project>