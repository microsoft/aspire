{
  "name": "react-weather",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "build": "webpack --mode production --config webpack.config.js",
    "start": "run-script-os",
    "start:win32": "webpack-dev-server --mode development --hot --env PORT=%PORT%",
    "start:default": "webpack-dev-server --mode development --hot --env PORT=$PORT"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.6",
    "@babel/preset-react": "^7.29.6",
    "babel-loader": "^10.1.1",
    "css-loader": "^7.1.5",
    "html-webpack-plugin": "^5.6.8",
    "run-script-os": "^1.1.6",
    "style-loader": "^4.0.0",
    "webpack": "^5.110.3",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.0.0"
  },
  "overrides": {
    "postcss": "8.5.28",
    "uuid": "14.0.2",
    "esbuild": "0.28.2",
    "fast-uri": "3.1.7",
    "http-proxy-middleware": "3.0.7",
    "launch-editor": "2.14.1",
