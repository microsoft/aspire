{
  "name": "vue-weather",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.13.0"
  },
  "scripts": {
    "start": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint . --fix",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "vue": "^3.5.18"
  },
  "devDependencies": {
    "@tsconfig/node20": "^20.1.6",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^10.0.0",
    "eslint-plugin-vue": "^10.10.0",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.7.4",
    "typescript": "~5.9.3",
    "vite": "^8.0.16",
    "vue-tsc": "^3.0.5"
  },
  "overrides": {
    "postcss": "8.5.23",
    "esbuild": "0.28.1",
    "nanoid": "3.3.17",
    "shell-quote": "1.9.0",
    "minimatch@3.1.5": {
      "brace-expansion": "2.1.3"
    }
  }
}
