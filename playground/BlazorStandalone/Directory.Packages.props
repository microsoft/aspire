<Project>
  <PropertyGroup>
    <MicrosoftAspNetCoreComponentsWebAssemblyNet11Version>11.0.0-rc.3.26522.148</MicrosoftAspNetCoreComponentsWebAssemblyNet11Version>
  </PropertyGroup>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Packages.props', '$(MSBuildThisFileDirectory)../'))" />

  <!-- Pin the .NET 11 packages that provide the SDK-generated SPA fallback contract. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="$(MicrosoftAspNetCoreComponentsWebAssemblyNet11Version)" />
    <PackageVersion Update="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
    <PackageVersion Update="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageVersion Update="OpenTelemetry.Instrumentation.Http" Version="1.20.2" />
  </ItemGroup>
</Project>
