<Project>
  <ItemGroup Condition="'$(IsAspireHost)' == 'true'">
    <!-- Keep the file-based AppHost discoverable without restoring a released
         package that does not contain the experimental testing APIs. -->
    <PackageReference Remove="Aspire.Hosting.AppHost" />
    <AspireProjectOrPackageReference Include="Aspire.Hosting.AppHost" />
    <AspireProjectOrPackageReference Include="Aspire.Hosting.Dotnet" />
  </ItemGroup>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.targets', '$(MSBuildThisFileDirectory)../'))" />
</Project>
