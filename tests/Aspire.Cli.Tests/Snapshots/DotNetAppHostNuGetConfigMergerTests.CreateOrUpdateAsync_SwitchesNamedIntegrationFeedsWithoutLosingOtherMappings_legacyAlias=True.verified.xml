        <add key="sdk" value="<workspace>/sdk-feed" />
        <add key="public" value="<workspace>/public-feed" />
        <add key="team" value="<workspace>/team-feed" />
      </packageSources>
      <packageSourceCredentials>
        <team>
          <add key="Username" value="user" />
          <add key="ClearTextPassword" value="test-password" />
        </team>
      </packageSourceCredentials>
      <packageSourceMapping>
