{
  "configSource": {
    "repository": "example/config",
    "path": "app.json",
    "custom": "keep"
  },
  "appHost": {
    "path": "apphost.cs",
    "custom": "keep"
  },
  "sdk": {
    "version": "17.0.1",
    "custom": "keep"
  },
  "docs": {
    "llmsTxtUrl": "https://docs.example/llms.txt",
    "api": {
      "sitemapUrl": "https://docs.example/sitemap.xml",
      "custom": {
        "nested": [
          1,
          true
        ]
      }
    },
    "custom": "keep"
  },
  "skillSources": {
    "team": {
      "repository": "example/skills",
      "custom": "keep"
    }
  },
  "integrationSources": {
    "team": {
      "source": "https://feed.example/index.json",
      "custom": "keep"
    }
  },
  "certificates": {
    "nssDbPaths": "/nss",
    "custom": "keep"
  },
  "containerTunnel": {
    "baseImage": "example/tunnel",
    "custom": "keep"
  },
  "portAllocation": {
    "persistInIsolatedMode": true,
    "custom": "keep"
  },
  "profiles": {
    "default": {
      "applicationUrl": "https://localhost:17000",
      "custom": "keep"
    }
  },
  "templateSources": {
    "local": {
      "path": "/templates",
      "custom": "keep"
    }
  }
}
