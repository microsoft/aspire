{
  "resources": {
    "frontend": {
      "type": "container.v0",
      "image": "image:latest",
      "bindings": {
        "http": {
          "scheme": "http",
          "protocol": "tcp",
          "transport": "http",
          "targetPort": 8080
        }
      }
    },
    "module": {
      "type": "azure.bicep.v0",
      "path": "module.module.bicep",
      "params": {
        "custom": "{customValue}",
        "mixed": "{customValue}|{frontend-http-BrowserOrigins.value}"
      }
    },
    "frontend-http-BrowserOrigins": {
      "type": "parameter.v0",
      "value": "{frontend-http-BrowserOrigins.inputs.value}",
      "inputs": {
        "value": {
          "type": "string"
        }
      }
    }
  }
}