{
  "resources": {
    "frontend": {
      "type": "container.v0",
      "image": "image:latest",
      "bindings": {
        "http": {
          "scheme": "http",
          "protocol": "tcp",
          "transport": "http",
          "targetPort": 8080
        }
      }
    },
    "backend": {
      "type": "container.v0",
      "image": "image:latest",
      "env": {
        "ORIGIN": "{cond-frontend-bindings-http-tlsenabled-2c72d853.connectionString}"
      }
    },
    "cond-frontend-bindings-http-tlsenabled-2c72d853": {
      "type": "value.v0",
      "connectionString": "https://deployed.example"
    }
  }
}