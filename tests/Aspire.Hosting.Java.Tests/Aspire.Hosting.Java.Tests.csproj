<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(DefaultTargetFramework)</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Aspire.Tests.Utils" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Aspire.Hosting.AppHost\Aspire.Hosting.AppHost.csproj" />
    <ProjectReference Include="..\..\src\Aspire.Hosting.Java\Aspire.Hosting.Java.csproj" />
    <ProjectReference Include="..\..\src\Aspire.Hosting.Dotnet\Aspire.Hosting.Dotnet.csproj" />
    <ProjectReference Include="..\Aspire.Hosting.TestUtilities\Aspire.Hosting.TestUtilities.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\playground\AspireCliTesting\java-tests\**\*" Exclude="..\..\playground\AspireCliTesting\java-tests\target\**\*">
      <Link>Fixtures\java-tests\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\playground\AspireCliTesting\service\service.cs" Link="Fixtures\service.cs" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Verify.XunitV3" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="$(TestsSharedDir)\TestModuleInitializer.cs" />
    <Compile Include="$(TestsSharedDir)\TestPipelineActivityReporter.cs" />
  </ItemGroup>

</Project>
