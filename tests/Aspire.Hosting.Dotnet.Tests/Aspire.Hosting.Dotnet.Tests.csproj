<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(DefaultTargetFramework)</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Aspire.Tests.Utils" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Aspire.Hosting.AppHost\Aspire.Hosting.AppHost.csproj" />
    <ProjectReference Include="..\..\src\Aspire.Hosting.Dotnet\Aspire.Hosting.Dotnet.csproj" Aliases="global,HostingDotnet" />
    <ProjectReference Include="..\..\src\Aspire.Hosting.Orleans\Aspire.Hosting.Orleans.csproj" />
    <ProjectReference Include="..\Aspire.Hosting.Tests\Aspire.Hosting.Tests.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Verify.XunitV3" />
  </ItemGroup>

  <!-- Watch contract tests: the fixture app is copied (not compiled) and launched through the real CLI proxy. -->
  <ItemGroup>
    <Compile Remove="Watch\Fixtures\**" />
    <None Include="Watch\Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Watch\Recordings\**" CopyToOutputDirectory="PreserveNewest" />
    <ProjectReference Include="..\..\src\Aspire.Cli\Aspire.Cli.csproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true"
                      Private="false"
                      ExcludeAssets="all" />
    <AssemblyMetadata Include="AspireCliPath" Value="$(ArtifactsBinDir)Aspire.Cli\$(Configuration)\net11.0\aspire.dll" />
    <!-- The muxer that builds the repo can run aspire.dll; the .NET 10 SDK the watched fixture uses may not. -->
    <AssemblyMetadata Include="AspireCliHost" Value="$(DOTNET_HOST_PATH)" />
    <!-- The watch tool Aspire.Hosting.Dotnet lays out at build (what AppHosts get as the same metadata). -->
    <AssemblyMetadata Include="aspiredotnetwatchtoolsdir" Value="$(AspireDotnetWatchToolsDir)" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="$(TestsSharedDir)AsyncTestHelpers.cs" Link="shared/AsyncTestHelpers.cs" />
    <Compile Include="$(TestsSharedDir)\TestModuleInitializer.cs" />
  </ItemGroup>

</Project>
