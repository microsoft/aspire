<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(DefaultTargetFramework)</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Aspire.Tests.Utils" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Aspire.Hosting.AppHost\Aspire.Hosting.AppHost.csproj" />
    <ProjectReference Include="..\..\src\Aspire.Hosting.Dotnet\Aspire.Hosting.Dotnet.csproj" Aliases="global,HostingDotnet" />
    <ProjectReference Include="..\..\src\Aspire.Hosting.Orleans\Aspire.Hosting.Orleans.csproj" />
    <ProjectReference Include="..\Aspire.Hosting.Tests\Aspire.Hosting.Tests.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Verify.XunitV3" />
  </ItemGroup>

  <!-- Watch contract tests: the fixture app is copied (not compiled) and launched through the real watch host. -->
  <ItemGroup>
    <Compile Remove="Watch\Fixtures\**" />
    <None Include="Watch\Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- Aliased so its source-shared internals don't clash with Aspire.Hosting.Dotnet's. -->
    <ProjectReference Include="..\..\src\Aspire.Hosting.Dotnet.WatchHost\Aspire.Hosting.Dotnet.WatchHost.csproj" Aliases="WatchHost" />
    <!-- The watch tool and watch host Aspire.Hosting.Dotnet lays out at build (what AppHosts get as the same metadata). -->
    <AssemblyMetadata Include="aspiredotnetwatchtoolsdir" Value="$(AspireDotnetWatchToolsDir)" />
    <AssemblyMetadata Include="aspiredotnetwatchhostdir" Value="$(AspireDotnetWatchHostDir)" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="$(TestsSharedDir)AsyncTestHelpers.cs" Link="shared/AsyncTestHelpers.cs" />
    <Compile Include="$(TestsSharedDir)\TestModuleInitializer.cs" />
  </ItemGroup>

</Project>
