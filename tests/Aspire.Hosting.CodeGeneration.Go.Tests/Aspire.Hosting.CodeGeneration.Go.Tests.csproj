<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Aspire.Tests.Utils" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Aspire.Hosting.CodeGeneration.Go\Aspire.Hosting.CodeGeneration.Go.csproj" />
    <ProjectReference Include="..\..\src\Aspire.Hosting\Aspire.Hosting.csproj" />
    <ProjectReference Include="..\..\src\Aspire.Hosting.RemoteHost\Aspire.Hosting.RemoteHost.csproj" />
    <ProjectReference Include="..\Aspire.TestUtilities\Aspire.TestUtilities.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Verify.XunitV3" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="$(TestsSharedDir)TestModuleInitializer.cs" Link="shared/TestModuleInitializer.cs" />
    <Compile Include="$(TestsSharedDir)TemporaryWorkspace.cs" Link="shared/TemporaryWorkspace.cs" />
    <!-- Share test types with TypeScript tests -->
    <Compile Include="..\Aspire.Hosting.CodeGeneration.TypeScript.Tests\TestTypes\*.cs" Link="TestTypes\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- GoScaffoldTests checks that the go-starter files use LF line endings and that its Go sources are gofmt-clean. -->
    <None Include="..\..\src\Aspire.Cli\Templating\Templates\go-starter\**\*" Link="go-starter\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
