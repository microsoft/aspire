{
  "schemaVersion": 1,
  "parameters": [
    "cache-password"
  ],
  "secretParameters": [
    "cache-password"
  ],
  "parameterDefaults": {},
  "resources": [
    {
      "name": "cache",
      "type": "hosting/container",
      "kind": "container",
      "image": "redis:7.4-alpine",
      "entrypoint": "/bin/sh",
      "executable": null,
      "workingDirectory": null,
      "computeEnvironment": null,
      "environment": {
        "REDIS_PASSWORD": {
          "kind": "parameter",
          "name": "cache-password"
        }
      },
      "arguments": [
        {
          "kind": "literal",
          "value": "-c"
        },
        {
          "kind": "literal",
          "value": "exec redis-server --requirepass \u0022$REDIS_PASSWORD\u0022"
        }
      ],
      "endpoints": [
        {
          "name": "tcp",
          "protocol": "tcp",
          "scheme": "redis",
          "targetPort": 6379,
          "isExternal": false,
          "hostPort": 0,
          "environmentVariable": ""
        }
      ],
      "mounts": [
        {
          "kind": "volume",
          "source": "cache-data",
          "target": "/data",
          "readOnly": false
        }
      ],
      "dependencies": [],
      "lifecycle": [],
      "configuration": {}
    },
    {
      "name": "web",
      "type": "hosting/executable",
      "kind": "executable",
      "image": null,
      "entrypoint": null,
      "executable": "/app/host",
      "workingDirectory": "/app",
      "computeEnvironment": null,
      "environment": {
        "CACHE_URL": {
          "kind": "composite",
          "parts": [
            {
              "kind": "literal",
              "value": "redis://:"
            },
            {
              "kind": "uriEncoded",
              "value": {
                "kind": "parameter",
                "name": "cache-password"
              }
            },
            {
              "kind": "literal",
              "value": "@"
            },
            {
              "kind": "endpoint",
              "resource": "cache",
              "endpoint": "tcp",
              "property": "HostAndPort"
            }
          ]
        }
      },
      "arguments": [
        {
          "kind": "literal",
          "value": "server.mjs"
        }
      ],
      "endpoints": [],
      "mounts": [],
      "dependencies": [
        "cache"
      ],
      "lifecycle": [],
      "configuration": {
        "publish.dockerCompose": "{\u0022build\u0022:{\u0022context\u0022:\u0022.\u0022},\u0022image\u0022:\u0022web:latest\u0022}"
      }
    }
  ]
}