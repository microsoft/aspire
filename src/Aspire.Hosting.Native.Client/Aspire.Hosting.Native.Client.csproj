<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsShipping>false</IsShipping>
    <IsAspirePolyglotCompatible>false</IsAspirePolyglotCompatible>
    <EnablePackageValidation>false</EnablePackageValidation>
    <NativeGeneratedDirectory>$(IntermediateOutputPath)native-client/</NativeGeneratedDirectory>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Aspire.Hosting.Native.Core.Tests" />
    <PackageReference Include="StreamJsonRpc" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
    <ProjectReference Include="../Aspire.Hosting.Native.CodeGeneration/Aspire.Hosting.Native.CodeGeneration.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>
  <Target Name="GenerateNativeCSharpClient" BeforeTargets="CoreCompile" DependsOnTargets="ResolveProjectReferences">
    <MSBuild Projects="../Aspire.Hosting.Native.CodeGeneration/Aspire.Hosting.Native.CodeGeneration.csproj"
             Targets="GetTargetPath" Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework)">
      <Output TaskParameter="TargetOutputs" ItemName="_NativeClientCodeGenerationPath" />
    </MSBuild>
    <!-- Client-only generation never writes the server dispatch or TypeScript SDK. -->
    <Exec Command="&quot;$(DotNetTool)&quot; exec &quot;@(_NativeClientCodeGenerationPath)&quot; &quot;$(NativeGeneratedDirectory)&quot; --csharp" />
    <ItemGroup>
      <Compile Include="$(NativeGeneratedDirectory)NativeClient.g.cs" />
    </ItemGroup>
  </Target>
</Project>
