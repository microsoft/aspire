<Project>

  <!-- Packed as buildTransitive/Aspire.Hosting.Dotnet.targets; in-repo AppHosts import it from source with
       AspireDotnetWatchToolsDir preset to the repo layout (Directory.Build.props). -->
  <PropertyGroup>
    <AspireDotnetWatchToolsDir Condition="'$(AspireDotnetWatchToolsDir)' == ''">$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', 'tools', 'dotnet-watch'))</AspireDotnetWatchToolsDir>
    <AspireDotnetWatchHostDir Condition="'$(AspireDotnetWatchHostDir)' == ''">$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', 'tools', 'dotnet-watch-host'))</AspireDotnetWatchHostDir>
  </PropertyGroup>

  <!-- Explicit prelaunch query only: ordinary Restore/Build/Run/Publish never resolves or acquires a watcher.
       DotNetHostPath identifies the muxer that selected this project's SDK, including global.json paths. -->
  <Target Name="ResolveAspireDotnetWatch" Returns="@(_AspireDotnetWatch)">
    <PropertyGroup>
      <_AspireDotnetWatchPath>$([MSBuild]::NormalizePath('$(AspireDotnetWatchToolsDir)', 'Microsoft.DotNet.HotReload.Watch.Aspire.dll'))</_AspireDotnetWatchPath>
      <_AspireDotnetWatchOverride Condition="'$(ASPIRE_DOTNET_WATCH_TOOL_PATH)' != ''">$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(ASPIRE_DOTNET_WATCH_TOOL_PATH)'))</_AspireDotnetWatchOverride>
      <_AspireDotnetWatchPath Condition="'$(_AspireDotnetWatchOverride)' != ''">$(_AspireDotnetWatchOverride)</_AspireDotnetWatchPath>
      <_AspireDotnetWatchPath Condition="'$(_AspireDotnetWatchOverride)' != '' and $([System.IO.Directory]::Exists('$(_AspireDotnetWatchOverride)'))">$([MSBuild]::NormalizePath('$(_AspireDotnetWatchOverride)', 'Microsoft.DotNet.HotReload.Watch.Aspire.dll'))</_AspireDotnetWatchPath>
      <_AspireDotnetWatchHostPath>$([MSBuild]::NormalizePath('$(AspireDotnetWatchHostDir)', 'Aspire.Hosting.Dotnet.WatchHost.dll'))</_AspireDotnetWatchHostPath>
      <_AspireDotnetWatchMuxer>$(DotNetHostPath)</_AspireDotnetWatchMuxer>
      <_AspireDotnetWatchMuxer Condition="'$(_AspireDotnetWatchMuxer)' == ''">$(DOTNET_HOST_PATH)</_AspireDotnetWatchMuxer>
    </PropertyGroup>
    <Error Condition="!Exists('$(_AspireDotnetWatchPath)')"
           Text="The bundled watch tool '$(_AspireDotnetWatchPath)' does not exist. Restore and rebuild the AppHost, correct ASPIRE_DOTNET_WATCH_TOOL_PATH, or run without --watch." />
    <Error Condition="!Exists('$(_AspireDotnetWatchHostPath)')"
           Text="The bundled watch host '$(_AspireDotnetWatchHostPath)' does not exist. Restore and rebuild the AppHost or run without --watch." />
    <Error Condition="'$(_AspireDotnetWatchMuxer)' == '' or '$(NETCoreSdkVersion)' == '' or !Exists('$(MSBuildToolsPath)/MSBuild.dll')"
           Text="The AppHost SDK and muxer could not be established for bundled watch prelaunch. Run without --watch or select an installed .NET SDK." />
    <ItemGroup>
      <_AspireDotnetWatch Remove="@(_AspireDotnetWatch)" />
      <_AspireDotnetWatch Include="$(_AspireDotnetWatchPath)">
        <ToolPath>$(_AspireDotnetWatchPath)</ToolPath>
        <WatchHostPath>$(_AspireDotnetWatchHostPath)</WatchHostPath>
        <DotnetPath>$(_AspireDotnetWatchMuxer)</DotnetPath>
        <SdkVersion>$(NETCoreSdkVersion)</SdkVersion>
        <MSBuildPath>$(MSBuildToolsPath)</MSBuildPath>
      </_AspireDotnetWatch>
    </ItemGroup>
  </Target>

  <!-- Records where the hot reload watch tool (Microsoft.DotNet.HotReload.Watch.Aspire.dll) and the watch host
       (Aspire.Hosting.Dotnet.WatchHost.dll) are, so watch runs use the shipped files instead of acquiring them. -->
  <Target Name="_SetAspireDotnetWatchToolsAttribute" BeforeTargets="GetAssemblyAttributes" Condition="'$(IsAspireHost)' == 'true'">
    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadata">
        <_Parameter1>aspiredotnetwatchtoolsdir</_Parameter1>
        <_Parameter2>$([MSBuild]::EnsureTrailingSlash('$(AspireDotnetWatchToolsDir)'))</_Parameter2>
      </AssemblyAttribute>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadata">
        <_Parameter1>aspiredotnetwatchhostdir</_Parameter1>
        <_Parameter2>$([MSBuild]::EnsureTrailingSlash('$(AspireDotnetWatchHostDir)'))</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>

</Project>
