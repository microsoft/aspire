<Project>

  <!-- Packed as buildTransitive/Aspire.Hosting.Dotnet.targets; in-repo AppHosts import it from source with
       AspireDotnetWatchToolsDir preset to the repo layout (Directory.Build.props). -->
  <PropertyGroup>
    <AspireDotnetWatchToolsDir Condition="'$(AspireDotnetWatchToolsDir)' == ''">$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', 'tools', 'dotnet-watch'))</AspireDotnetWatchToolsDir>
    <AspireDotnetWatchHostDir Condition="'$(AspireDotnetWatchHostDir)' == ''">$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', 'tools', 'dotnet-watch-host'))</AspireDotnetWatchHostDir>
  </PropertyGroup>

  <!-- Records where the hot reload watch tool (Microsoft.DotNet.HotReload.Watch.Aspire.dll) and the watch host
       (Aspire.Hosting.Dotnet.WatchHost.dll) are, so watch runs use the shipped files instead of acquiring them. -->
  <Target Name="_SetAspireDotnetWatchToolsAttribute" BeforeTargets="GetAssemblyAttributes" Condition="'$(IsAspireHost)' == 'true'">
    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadata">
        <_Parameter1>aspiredotnetwatchtoolsdir</_Parameter1>
        <_Parameter2>$([MSBuild]::EnsureTrailingSlash('$(AspireDotnetWatchToolsDir)'))</_Parameter2>
      </AssemblyAttribute>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadata">
        <_Parameter1>aspiredotnetwatchhostdir</_Parameter1>
        <_Parameter2>$([MSBuild]::EnsureTrailingSlash('$(AspireDotnetWatchHostDir)'))</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>

</Project>
