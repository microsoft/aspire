<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(DefaultTargetFramework)</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageTags>aspire integration hosting dotnet csharp framework runtime</PackageTags>
    <Description>C# and .NET application support for Aspire.</Description>
    <!-- The first stable release is 17.0.0; older repository baselines have no stable Dotnet package.
         Keep package validation enabled and resume baseline comparisons once that release is the baseline. -->
    <DisablePackageBaselineValidation Condition="'$(PackageValidationBaselineVersion)' != '' and $([MSBuild]::VersionLessThan('$(PackageValidationBaselineVersion)', '17.0.0'))">true</DisablePackageBaselineValidation>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Aspire.Hosting\Aspire.Hosting.csproj" />
  </ItemGroup>

  <!-- Hot reload watch server (Microsoft.DotNet.HotReload.Watch.Aspire), shipped like DCP: the DotnetTool package
       can't be a PackageReference (NU1212), so PackageDownload fetches it at restore and its payload is repacked into
       this package under tools/dotnet-watch/. buildTransitive/Aspire.Hosting.Dotnet.targets stamps that directory on
       the AppHost as 'aspiredotnetwatchtoolsdir' assembly metadata. Nothing is downloaded at run time. -->
  <ItemGroup>
    <PackageDownload Include="Microsoft.DotNet.HotReload.Watch.Aspire" Version="[$(MicrosoftDotNetHotReloadWatchAspireVersion)]" />
  </ItemGroup>

  <!-- The watch host (proxy for each watched replica, host of the watch server process) ships the same way under
       tools/dotnet-watch-host/ and is stamped on the AppHost as 'aspiredotnetwatchhostdir'. Hosting runs it with
       'dotnet exec' on the watcher's muxer, so this package stays RID-neutral. -->
  <ItemGroup>
    <ProjectReference Include="..\Aspire.Hosting.Dotnet.WatchHost\Aspire.Hosting.Dotnet.WatchHost.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="build\Aspire.Hosting.Dotnet.targets" Pack="true" PackagePath="buildTransitive\Aspire.Hosting.Dotnet.targets" />
  </ItemGroup>

  <PropertyGroup>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_AddDotnetWatchToolsToPackage;_AddDotnetWatchHostToPackage</TargetsForTfmSpecificContentInPackage>
    <!-- The repacked tool payload is a runnable app, not a library: its assemblies belong under tools/. -->
    <NoWarn>$(NoWarn);NU5100</NoWarn>
  </PropertyGroup>

  <Target Name="_CollectDotnetWatchToolFiles">
    <PropertyGroup>
      <_AspireDotnetWatchToolSource>$(NuGetPackageRoot)microsoft.dotnet.hotreload.watch.aspire/$(MicrosoftDotNetHotReloadWatchAspireVersion)/tools/net10.0/any/</_AspireDotnetWatchToolSource>
    </PropertyGroup>
    <Error Condition="!Exists('$(_AspireDotnetWatchToolSource)Microsoft.DotNet.HotReload.Watch.Aspire.dll')"
           Text="Microsoft.DotNet.HotReload.Watch.Aspire $(MicrosoftDotNetHotReloadWatchAspireVersion) is missing from '$(_AspireDotnetWatchToolSource)'. Restore this project." />
    <ItemGroup>
      <_AspireDotnetWatchToolFile Remove="@(_AspireDotnetWatchToolFile)" />
      <_AspireDotnetWatchToolFile Include="$(_AspireDotnetWatchToolSource)**/*" />
    </ItemGroup>
  </Target>

  <!-- Lays out the payload for in-repo AppHosts, which reference this project rather than the package. -->
  <Target Name="_LayoutDotnetWatchTools" AfterTargets="Build" DependsOnTargets="_CollectDotnetWatchToolFiles" Condition="'$(AspireDotnetWatchToolsDir)' != ''">
    <Copy SourceFiles="@(_AspireDotnetWatchToolFile)"
          DestinationFiles="@(_AspireDotnetWatchToolFile->'$(AspireDotnetWatchToolsDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="_AddDotnetWatchToolsToPackage" DependsOnTargets="_CollectDotnetWatchToolFiles" Returns="@(TfmSpecificPackageFile)">
    <ItemGroup>
      <!-- Full file path: NuGet appends RecursiveDir to directory PackagePaths, which would nest culture folders (cs/cs/). -->
      <TfmSpecificPackageFile Include="@(_AspireDotnetWatchToolFile)" PackagePath="tools/dotnet-watch/%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>
  </Target>

  <Target Name="_CollectDotnetWatchHostFiles">
    <MSBuild Projects="..\Aspire.Hosting.Dotnet.WatchHost\Aspire.Hosting.Dotnet.WatchHost.csproj"
             Targets="GetTargetPath"
             RemoveProperties="TargetFramework;RuntimeIdentifier">
      <Output TaskParameter="TargetOutputs" PropertyName="_AspireDotnetWatchHostPath" />
    </MSBuild>
    <PropertyGroup>
      <_AspireDotnetWatchHostOutput>$([System.IO.Path]::GetDirectoryName('$(_AspireDotnetWatchHostPath)'))/</_AspireDotnetWatchHostOutput>
    </PropertyGroup>
    <Error Condition="!Exists('$(_AspireDotnetWatchHostPath)')"
           Text="The watch host '$(_AspireDotnetWatchHostPath)' is missing. Build src/Aspire.Hosting.Dotnet.WatchHost." />
    <ItemGroup>
      <_AspireDotnetWatchHostFile Remove="@(_AspireDotnetWatchHostFile)" />
      <_AspireDotnetWatchHostFile Include="$(_AspireDotnetWatchHostOutput)*.dll;$(_AspireDotnetWatchHostOutput)*.deps.json;$(_AspireDotnetWatchHostOutput)*.runtimeconfig.json" />
    </ItemGroup>
  </Target>

  <!-- Lays out the watch host for in-repo AppHosts, like the watch tool. -->
  <Target Name="_LayoutDotnetWatchHost" AfterTargets="Build" DependsOnTargets="_CollectDotnetWatchHostFiles" Condition="'$(AspireDotnetWatchHostDir)' != ''">
    <Copy SourceFiles="@(_AspireDotnetWatchHostFile)"
          DestinationFolder="$(AspireDotnetWatchHostDir)"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="_AddDotnetWatchHostToPackage" DependsOnTargets="_CollectDotnetWatchHostFiles" Returns="@(TfmSpecificPackageFile)">
    <ItemGroup>
      <TfmSpecificPackageFile Include="@(_AspireDotnetWatchHostFile)" PackagePath="tools/dotnet-watch-host/%(Filename)%(Extension)" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <!-- Source-shared helpers keep this package buildable from the public Aspire.Hosting surface only. -->
    <Compile Include="..\Aspire.Hosting\Dcp\Process\ProcessCaptureResult.cs" LinkBase="Process" />
    <Compile Include="..\Aspire.Hosting\Dcp\Process\ProcessUtil.Capture.cs" LinkBase="Process" />
    <Compile Include="$(SharedDir)CommandLineArgsParser.cs" Link="Utils\CommandLineArgsParser.cs" />
    <Compile Include="$(SharedDir)DotnetWatch\DotnetWatchHostProtocol.cs" Link="Watch\DotnetWatchHostProtocol.cs" />
    <Compile Include="$(SharedDir)FileLock.cs" Link="Utils\FileLock.cs" />
    <Compile Include="$(SharedDir)HeldFileLease.cs" Link="Utils\HeldFileLease.cs" />
    <Compile Include="$(SharedDir)MsBuildResponseFile.cs" Link="Utils\MsBuildResponseFile.cs" />
    <Compile Include="$(SharedDir)PathNormalizer.cs" Link="Utils\PathNormalizer.cs" />
    <Compile Include="$(SharedDir)ProjectPathResolver.cs" Link="Utils\ProjectPathResolver.cs" />
    <Compile Include="$(SharedDir)DebugSessionInfoParser.cs" Link="Utils\DebugSessionInfoParser.cs" />
    <Compile Include="$(SharedDir)ConsoleLogs\TimestampParser.cs" Link="Utils\ConsoleLogs\TimestampParser.cs" />
    <Compile Include="$(SharedDir)\LaunchProfiles\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Aspire.Hosting\Resources\LaunchProfileStrings.Designer.cs">
      <Link>Resources\LaunchProfileStrings.Designer.cs</Link>
      <DependentUpon>LaunchProfileStrings.resx</DependentUpon>
    </Compile>
    <EmbeddedResource Include="..\Aspire.Hosting\Resources\LaunchProfileStrings.resx">
      <Link>Resources\LaunchProfileStrings.resx</Link>
      <LogicalName>Aspire.Hosting.Resources.LaunchProfileStrings.resources</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
