<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <SkipAspireIntegrationAnalyzersReference>true</SkipAspireIntegrationAnalyzersReference>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="StreamJsonRpc" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Aspire.TypeSystem\Aspire.TypeSystem.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Aspire.Hosting.RemoteHost.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="$(SharedDir)KnownConfigNames.cs" Link="Utils\KnownConfigNames.cs" />
    <Compile Include="$(SharedDir)PathLookupHelper.cs" Link="Utils\PathLookupHelper.cs" />
    <Compile Include="$(SharedDir)DirectoryHelper.cs" Link="Utils\DirectoryHelper.cs" />
    <Compile Include="$(SharedDir)SocketPermissionHelper.cs" Link="Utils\SocketPermissionHelper.cs" />
    <Compile Include="$(SharedDir)SocketDirectoryNames.cs" Link="Utils\SocketDirectoryNames.cs" />
    <Compile Include="$(SharedDir)ProcessStartTimeHelper.cs" Link="Utils\ProcessStartTimeHelper.cs" />
    <Compile Include="$(SharedDir)ProcessStartInfoHelper.cs" Link="Utils\ProcessStartInfoHelper.cs" />
    <Compile Include="$(SharedDir)CommandPathResolver.cs" Link="Utils\CommandPathResolver.cs" />
    <Compile Include="$(SharedDir)ProcessSignaler.cs" Link="Utils\ProcessSignaler.cs" />
    <Compile Include="$(SharedDir)IChildProcess.cs" Link="Processes\IChildProcess.cs" />
    <Compile Include="$(SharedDir)ChildProcess.cs" Link="Processes\ChildProcess.cs" />
    <Compile Include="$(SharedDir)ChildProcessFactory.cs" Link="Processes\ChildProcessFactory.cs" />
    <Compile Include="$(SharedDir)ChildProcessOptions.cs" Link="Processes\ChildProcessOptions.cs" />
    <Compile Include="$(SharedDir)ProcessScope.cs" Link="Processes\ProcessScope.cs" />
    <Compile Include="$(SharedDir)ProcessSupervisor.cs" Link="Processes\ProcessSupervisor.cs" />
    <Compile Include="$(SharedDir)ProcessSupervisorLogger.cs" Link="Processes\ProcessSupervisorLogger.cs" />
    <Compile Include="$(SharedDir)ProcessSupervisor.Windows.cs" Link="Processes\ProcessSupervisor.Windows.cs" />
    <Compile Include="$(SharedDir)ParentProcessLivenessMonitor.cs" Link="Utils\ParentProcessLivenessMonitor.cs" />
    <Compile Include="$(SharedDir)KnownOtelConfigNames.cs" Link="Utils\KnownOtelConfigNames.cs" />
    <Compile Include="$(SharedDir)IntegrationPackageProbeManifest.cs" Link="IntegrationPackageProbeManifest.cs" />
    <Compile Include="$(SharedDir)TimeSpanMillisecondsJsonConverter.cs" Link="Ats\TimeSpanMillisecondsJsonConverter.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copy appsettings.json to output -->
    <None Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
