<?xml version="1.0" encoding="utf-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" version="1.2" xsi:schemaLocation="urn:oasis:names:tc:xliff:document:1.2 xliff-core-1.2-transitional.xsd">
  <file datatype="xml" source-language="en" target-language="ko" original="../Resources.resx">
    <body>
      <trans-unit id="ApplicationNotStartedExceptionMessage">
        <source>The application must be started before resolving endpoints or connection strings.</source>
        <target state="translated">엔드포인트 또는 연결 문자열을 확인하려면 먼저 애플리케이션을 시작해야 합니다.</target>
        <note />
      </trans-unit>
      <trans-unit id="DashboardDisabledExceptionMessage">
        <source>The dashboard is not enabled for this application.</source>
        <target state="translated">이 애플리케이션에는 대시보드가 활성화되어 있지 않습니다.</target>
        <note />
      </trans-unit>
      <trans-unit id="DashboardTestingPublishModeExceptionMessage">
        <source>Dashboard testing is not supported in publish mode.</source>
        <target state="translated">대시보드 테스트는 게시 모드에서 지원되지 않습니다.</target>
        <note />
      </trans-unit>
      <trans-unit id="DashboardUrlApplicationNotStartedExceptionMessage">
        <source>The application must be started before retrieving the dashboard URL.</source>
        <target state="translated">대시보드 URL을 가져오려면 먼저 앱을 시작하세요.</target>
        <note />
      </trans-unit>
      <trans-unit id="DashboardUrlPublishModeExceptionMessage">
        <source>The dashboard URL is not available in publish mode.</source>
        <target state="translated">게시 모드에서는 대시보드 URL을 사용할 수 없습니다.</target>
        <note />
      </trans-unit>
      <trans-unit id="DashboardUrlUnavailableExceptionMessage">
        <source>The dashboard URL is not available.</source>
        <target state="translated">대시보드 URL을 사용할 수 없습니다.</target>
        <note />
      </trans-unit>
      <trans-unit id="EndpointForResourceNotFoundExceptionMessage">
        <source>Endpoint '{0}' for resource '{1}' not found.</source>
        <target state="translated">'{1}' 리소스에 대한 '{0}' 엔드포인트를 찾을 수 없습니다.</target>
        <note />
      </trans-unit>
      <trans-unit id="ResourceDoesNotExposeConnectionStringExceptionMessage">
        <source>Resource '{0}' does not expose a connection string.</source>
        <target state="translated">'{0}' 리소스가 연결 문자열을 노출하지 않습니다.</target>
        <note />
      </trans-unit>
      <trans-unit id="ResourceHasNoAllocatedEndpointsExceptionMessage">
        <source>Resource '{0}' has no allocated endpoints.</source>
        <target state="translated">'{0}' 리소스에 할당된 엔드포인트가 없습니다.</target>
        <note />
      </trans-unit>
      <trans-unit id="ResourceNotFoundExceptionMessage">
        <source>Resource '{0}' not found.</source>
        <target state="translated">'{0}' 리소스를 찾을 수 없습니다.</target>
        <note />
      </trans-unit>
    </body>
  </file>
</xliff>