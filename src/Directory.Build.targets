<Project>
  <PropertyGroup>
    <DisablePackageBaselineValidation Condition="'$(DisablePackageBaselineValidation)' == '' And '$(SuppressFinalPackageVersion)' == 'true'">true</DisablePackageBaselineValidation>
    <!-- If the project is packable, we generate its API surface in a separate file to be used by the API review process. -->
    <GenAPITargetPath Condition="'$(IsPackable)' == 'true'">$(MSBuildProjectDirectory)/api/$(AssemblyName).cs</GenAPITargetPath>
    <SkipAspireIntegrationAnalyzersReference Condition="'$(SkipAspireIntegrationAnalyzersReference)' == '' And '$(IsRoslynComponent)' == 'true'">true</SkipAspireIntegrationAnalyzersReference>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="$(GenAPITargetPath)" />
  </ItemGroup>

  <Target Name="CreateGenAPITargetPathFolder" BeforeTargets="GenAPIGenerateReferenceAssemblySource">
    <MakeDir Directories="$(MSBuildProjectDirectory)/api" Condition="!Exists('$(MSBuildProjectDirectory)/api')" />
  </Target>

  <!--
    Hex1b's win-x64/win-arm64 native assets carry hex1bpty.exe, a ~5 MB PTY host that Hex1b launches
    only when *it* owns the pseudo-terminal for a child process. Nothing we ship takes that path: DCP
    creates and owns every PTY we surface, and Aspire.TerminalHost just proxies the byte stream DCP is
    already producing (see src/Aspire.TerminalHost/TerminalReplica.cs). So the helper is dead weight in
    every Windows CLI archive, and it is also a second executable that downstream stores have to
    account for — winget runs executable and malware checks against every binary in the archive, which
    turned it into submission friction on https://github.com/microsoft/winget-pkgs/pull/421219.

    That is still true of every path in the tree today. The one deliberate exception is the bundle
    build, which stages the helper ahead of the feature that will use it — see the target below.

    Unix is unaffected: there the package's native asset is libhex1binterop.{so,dylib}, the
    termios/ioctl shim the TUI does need, and it keeps flowing through.

    Deliberately scoped to src/. Test projects drive real terminals through Hex1b.Automation, which
    genuinely needs the PTY host, and this file does not apply to them.
  -->
  <Target Name="RemoveUnusedHex1bPtyHostFromPublish"
          AfterTargets="ComputeResolvedFilesToPublishList"
          Condition="'$(PublishHex1bPtyHost)' != 'true'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish->WithMetadataValue('Filename', 'hex1bpty'))" />
    </ItemGroup>
  </Target>

  <!--
    Aspire.Managed is that exception, and the reason is sequencing rather than a live code path.
    No code in this tree launches hex1bpty.exe today — DCP owns every PTY we currently surface, exactly
    as the comment above says. AppHost-owned terminals (#19887) add the path that does need it: there
    Hex1b owns the pseudo-terminal itself instead of bridging DCP's. #19976 asks for the helper to be
    built, signed and bundled before that feature lands, so the pipeline is ready rather than blocking
    it. Aspire.Managed therefore sets PublishHex1bPtyHost=true, which turns the removal above off for
    this project only. The CLI archive is unaffected and still strips it.

    Once it is back in the publish output it also has to stay a loose file next to aspire-managed.
    hex1bpty.exe is a native asset, so IncludeNativeLibrariesForSelfExtract would otherwise pack it
    inside the single-file executable, leaving nothing on disk for Arcade to Authenticode-sign
    (eng/Signing.props) or for CreateLayout to stage at managed/hex1bpty.exe. ExcludeFromSingleFile
    keeps it out of the bundle without changing where it lands in the publish directory.

    This has to happen before the SDK computes the single-file contents, hence both attributes:
    AfterTargets gives us the resolved publish list, BeforeTargets pins us ahead of the bundler.
  -->
  <Target Name="KeepHex1bPtyHostOutOfSingleFileBundle"
          AfterTargets="ComputeResolvedFilesToPublishList"
          BeforeTargets="_ComputeFilesToBundle"
          Condition="'$(PublishHex1bPtyHost)' == 'true' and '$(PublishSingleFile)' == 'true'">
    <ItemGroup>
      <ResolvedFileToPublish Update="@(ResolvedFileToPublish->WithMetadataValue('Filename', 'hex1bpty'))"
                             ExcludeFromSingleFile="true" />
    </ItemGroup>
  </Target>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.targets', '$(MSBuildThisFileDirectory)../'))" />

  <ItemGroup Condition="$([System.String]::Copy('$(MSBuildProjectName)').StartsWith('Aspire.Hosting'))
                        and
                        '$(SkipAspireIntegrationAnalyzersReference)' != 'true'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)\Aspire.Hosting.Integration.Analyzers\Aspire.Hosting.Integration.Analyzers.csproj"
                    PrivateAssets="all"
                    ReferenceOutputAssembly="false"
                    OutputItemType="Analyzer" />
  </ItemGroup>

  <!-- Polyglot-compatible integration marker (opt-out).
       Every in-repo Aspire.Hosting integration that runs the export analyzer is treated as
       polyglot-compatible by default: it gets the well-known 'polyglot' NuGet tag so `aspire add`
       can surface the package to non-C# (polyglot) AppHosts. An author acknowledges that a project is
       NOT a polyglot integration with <IsAspirePolyglotCompatible>false</IsAspirePolyglotCompatible>,
       which both omits the tag and satisfies ASPIREEXPORT017 (the rule errors when such a project has
       no [AspireExport] coverage and has not opted out). The property is also surfaced to the analyzer.
       The shipped equivalent for external authors lives in
       src/Aspire.Hosting/buildTransitive/Aspire.Hosting.targets. -->
  <ItemGroup Condition="$([System.String]::Copy('$(MSBuildProjectName)').StartsWith('Aspire.Hosting'))
                        and
                        '$(SkipAspireIntegrationAnalyzersReference)' != 'true'">
    <CompilerVisibleProperty Include="IsAspirePolyglotCompatible" />
  </ItemGroup>

  <!-- Evaluated at import time (Directory.Build.targets is imported after the project body), so both
       $(IsAspirePolyglotCompatible) and $(PackageTags) already hold their final csproj-assigned values.
       Scoped to the same Aspire.Hosting* projects that run the analyzer so the default-on tag never lands
       on unrelated repo projects (tests, components, etc.). The marker is opt-out: the tag is added unless
       the project sets the property to 'false'. The guard space-pads $(PackageTags) and looks for a whole
       ' polyglot ' token so an unrelated tag that merely contains the substring (e.g. 'monopolyglot') does
       not suppress the marker, and Concat(...).Trim() avoids a leading space when $(PackageTags) was empty. -->
  <PropertyGroup Condition="$([System.String]::Copy('$(MSBuildProjectName)').StartsWith('Aspire.Hosting'))
                            and '$(SkipAspireIntegrationAnalyzersReference)' != 'true'
                            and '$(IsAspirePolyglotCompatible)' != 'false'
                            and !$([System.String]::Concat(' ', '$(PackageTags)', ' ').Contains(' polyglot '))">
    <PackageTags>$([System.String]::Concat('$(PackageTags)', ' polyglot').Trim())</PackageTags>
  </PropertyGroup>

  <!-- Used by Aspire.Templates.Testing.targets and by Aspire.RepoTesting.targets to
       dynamically compute per-package versions for Helix testing.
       Returns items with PackageId as Include and the per-project computed PackageVersion
       as WithPackageVersion metadata. The version is computed by the Arcade SDK and respects
       SuppressFinalPackageVersion, StabilizePackageVersion, etc.

       Reads $(PackageVersion) declaratively (i.e. as a property whose value Arcade has
       already set via property groups during evaluation, not via a prior target). That is
       correct as of the current Arcade SDK. If a future Arcade bump moves PackageVersion
       computation into a target body, callers of this target may observe the pre-target
       value; the Helix package-versions generation in
       tests/Shared/RepoTesting/Aspire.RepoTesting.targets would then need an explicit
       dependency on whatever target sets PackageVersion. -->
  <Target Name="GetPackageName" Returns="@(PackageName)">
    <ItemGroup>
      <PackageName Include="$(PackageId)" Condition="'$(IsPackable)' == 'true'" WithPackageVersion="$(PackageVersion)" />
    </ItemGroup>
  </Target>
</Project>
