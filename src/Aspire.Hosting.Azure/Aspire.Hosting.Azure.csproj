<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(DefaultTargetFramework)</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageTags>aspire hosting azure cloud provisioning orchestration</PackageTags>
    <Description>Azure resource types for Aspire.</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PackageIconFullPath>$(SharedDir)Azure_256x.png</PackageIconFullPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Aspire.Hosting\Dcp\Process\IProcessRunner.cs" Link="Process\IProcessRunner.cs" />
    <Compile Include="..\Aspire.Hosting\Dcp\Process\DefaultProcessRunner.Execution.cs" Link="Process\DefaultProcessRunner.Execution.cs" />
    <Compile Include="..\Aspire.Hosting\Dcp\Process\ProcessCommand.cs" Link="Process\ProcessCommand.cs" />
    <Compile Include="..\Aspire.Hosting\Dcp\Process\ProcessInput.cs" Link="Process\ProcessInput.cs" />
    <Compile Include="..\Aspire.Hosting\Dcp\Process\ProcessEvent.cs" Link="Process\ProcessEvent.cs" />
    <Compile Include="..\Aspire.Hosting\Dcp\Process\ProcessEventStream.cs" Link="Process\ProcessEventStream.cs" />
    <Compile Include="..\Aspire.Hosting\Dcp\Process\ProcessEventExtensions.cs" Link="Process\ProcessEventExtensions.cs" />
    <Compile Include="..\Aspire.Hosting\Dcp\Process\ProcessCaptureResult.cs" Link="Process\ProcessCaptureResult.cs" />
    <Compile Include="$(SharedDir)AzurePortalUrls.cs" Link="AzurePortalUrls.cs" />
    <Compile Include="$(SharedDir)CustomResourceSnapshotExtensions.cs" Link="Utils\CustomResourceSnapshotExtensions.cs" />
    <Compile Include="$(SharedDir)ExceptionUtils.cs" Link="Utils\ExceptionUtils.cs" />
    <Compile Include="$(SharedDir)StringComparers.cs" Link="Utils\StringComparers.cs" />
    <Compile Include="$(SharedDir)StringUtils.cs" Link="Utils\StringUtils.cs" />
    <Compile Include="$(SharedDir)ResourceNameHelpers.cs" Link="Utils\ResourceNameHelpers.cs" />
    <Compile Include="$(SharedDir)Model\KnownRelationshipTypes.cs" />
    <Compile Include="$(SharedDir)PathLookupHelper.cs" Link="Utils\PathLookupHelper.cs" />
    <Compile Include="$(SharedDir)ProcessStartInfoHelper.cs" Link="Utils\ProcessStartInfoHelper.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Bicep\*.bicep" />
  </ItemGroup>

  <ItemGroup>
    <None Include="**/*.targets;AspireAzureConfigurationSchema.json" Pack="true" PackagePath="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Aspire.Hosting\Aspire.Hosting.csproj" />
    <PackageReference Include="System.IO.Hashing" />
    <PackageReference Include="Azure.Provisioning" />
    <PackageReference Include="Azure.Provisioning.KeyVault" />
    <PackageReference Include="Azure.ResourceManager.Authorization" />
    <PackageReference Include="Azure.ResourceManager.KeyVault" />
    <PackageReference Include="Azure.ResourceManager.Resources.Deployments" />
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Azure.Security.KeyVault.Secrets" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Aspire.Hosting.Azure.Tests" />
    <InternalsVisibleTo Include="Aspire.Hosting.Azure.ContainerRegistry" />
    <InternalsVisibleTo Include="Aspire.Hosting.Azure.EntraId.Tests" />
    <InternalsVisibleTo Include="Aspire.Hosting.Foundry" />
  </ItemGroup>

</Project>
