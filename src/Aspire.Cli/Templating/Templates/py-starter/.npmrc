# This package-lock.json must resolve from the public npm registry (see #19370).
# Dependabot looks for .npmrc in parent directories when a package directory has none, which made
# it inherit the repo-root .npmrc (internal dnceng feed) and write dnceng `resolved` URLs that fail
# anonymous `npm ci` with E401. This file pins the public registry for this directory.
# It is excluded from the shipped template payloads.
registry=https://registry.npmjs.org/
