<?xml version="1.0" encoding="utf-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" version="1.2" xsi:schemaLocation="urn:oasis:names:tc:xliff:document:1.2 xliff-core-1.2-transitional.xsd">
  <file datatype="xml" source-language="en" target-language="de" original="../ApiCommandStrings.resx">
    <body>
      <trans-unit id="ApiNotFound">
        <source>API item '{0}' not found. Use 'aspire docs api search' or 'aspire docs api list &lt;scope&gt;' to find available identifiers.</source>
        <target state="translated">API-Element '{0}' nicht gefunden. Verwenden Sie "aspire docs api search" oder "aspire docs api list &lt;scope&gt;", um verfügbare Bezeichner zu finden.</target>
        <note />
      </trans-unit>
      <trans-unit id="Description">
        <source>Browse and search Aspire API reference documentation from aspire.dev</source>
        <target state="translated">Aspire-API-Referenzdokumentation auf aspire.dev durchsehen und durchsuchen</target>
        <note />
      </trans-unit>
      <trans-unit id="FormatOptionDescription">
        <source>Output format (Table or Json)</source>
        <target state="translated">Ausgabeformat (Tabelle oder JSON)</target>
        <note />
      </trans-unit>
      <trans-unit id="FoundApiEntries">
        <source>Found {0} API entries under '{1}'.</source>
        <target state="translated">Es wurden {0} API-Einträge unter „{1}“ gefunden.</target>
        <note />
      </trans-unit>
      <trans-unit id="FoundSearchResults">
        <source>Found {0} API results for '{1}'.</source>
        <target state="translated">Es wurden {0} API-Ergebnisse für „{1}“ gefunden.</target>
        <note />
      </trans-unit>
      <trans-unit id="GetDescription">
        <source>Get the markdown for an API reference item by its identifier</source>
        <target state="translated">Markdown für ein API-Referenzelement anhand seines Bezeichners abrufen</target>
        <note />
      </trans-unit>
      <trans-unit id="HeaderGroup">
        <source>Group</source>
        <target state="translated">Gruppe</target>
        <note />
      </trans-unit>
      <trans-unit id="HeaderId">
        <source>Id</source>
        <target state="translated">ID</target>
        <note />
      </trans-unit>
      <trans-unit id="HeaderKind">
        <source>Kind</source>
        <target state="translated">Variante</target>
        <note />
      </trans-unit>
      <trans-unit id="HeaderLanguage">
        <source>Language</source>
        <target state="translated">Sprache</target>
        <note />
      </trans-unit>
      <trans-unit id="HeaderName">
        <source>Name</source>
        <target state="translated">Name</target>
        <note />
      </trans-unit>
      <trans-unit id="HeaderScore">
        <source>Score</source>
        <target state="translated">Bewertung</target>
        <note />
      </trans-unit>
      <trans-unit id="IdArgumentDescription">
        <source>The API identifier (for example, 'csharp/aspire.azure.ai.inference/aspireazureaiinferenceextensions')</source>
        <target state="translated">Der API-Bezeichner (zum Beispiel „csharp/aspire.azure.ai.inference/aspireazureaiinferenceextensions“)</target>
        <note />
      </trans-unit>
      <trans-unit id="LanguageOptionDescription">
        <source>Limit results to a specific API language</source>
        <target state="translated">Ergebnisse auf eine bestimmte API-Sprache beschränken</target>
        <note />
      </trans-unit>
      <trans-unit id="LimitOptionDescription">
        <source>Maximum number of search results to return (default: 5, max: 10)</source>
        <target state="translated">Die maximale Anzahl der Suchergebnisse, die zurückgegeben werden sollen (Standard: 5, max: 10)</target>
        <note />
      </trans-unit>
      <trans-unit id="ListDescription">
        <source>List API entries under a parent scope</source>
        <target state="translated">API-Einträge unter einem übergeordneten Bereich auflisten</target>
        <note />
      </trans-unit>
      <trans-unit id="LoadingApiDocumentation">
        <source>Loading API documentation...</source>
        <target state="translated">API-Dokumentation wird geladen...</target>
        <note />
      </trans-unit>
      <trans-unit id="NoApiEntriesFound">
        <source>No API entries found under '{0}'.</source>
        <target state="translated">Keine API-Einträge unter „{0}“ gefunden.</target>
        <note />
      </trans-unit>
      <trans-unit id="NoResultsFound">
        <source>No API results found for '{0}'. Try different search terms.</source>
        <target state="translated">Für „{0}“ wurden keine API-Ergebnisse gefunden. Probieren Sie andere Suchbegriffe aus.</target>
        <note />
      </trans-unit>
      <trans-unit id="QueryArgumentDescription">
        <source>The search query</source>
        <target state="translated">Die Suchabfrage</target>
        <note />
      </trans-unit>
      <trans-unit id="ScopeArgumentDescription">
        <source>The parent API scope to browse (for example, 'csharp' or 'typescript/aspire.hosting.azure.appconfiguration')</source>
        <target state="translated">Der übergeordnete API-Bereich, der durchsucht werden soll (zum Beispiel „csharp“ oder „typescript/aspire.hosting.azure.appconfiguration“)</target>
        <note />
      </trans-unit>
      <trans-unit id="SearchDescription">
        <source>Search Aspire API reference documentation by keywords</source>
        <target state="translated">Aspire-API-Referenzdokumentation nach Schlüsselwörtern durchsuchen</target>
        <note />
      </trans-unit>
    </body>
  </file>
</xliff>