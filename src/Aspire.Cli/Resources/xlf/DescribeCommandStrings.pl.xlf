<?xml version="1.0" encoding="utf-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" version="1.2" xsi:schemaLocation="urn:oasis:names:tc:xliff:document:1.2 xliff-core-1.2-transitional.xsd">
  <file datatype="xml" source-language="en" target-language="pl" original="../DescribeCommandStrings.resx">
    <body>
      <trans-unit id="Description">
        <source>Describe resources in a running AppHost</source>
        <target state="translated">Opisz zasoby w działającym środowisku AppHost</target>
        <note />
      </trans-unit>
      <trans-unit id="FollowOptionDescription">
        <source>Continuously stream resource state changes</source>
        <target state="translated">Ciągłe przesyłanie strumieniowo zmian stanu zasobów</target>
        <note />
      </trans-unit>
      <trans-unit id="HeaderHealth">
        <source>Health</source>
        <target state="translated">Kondycja</target>
        <note />
      </trans-unit>
      <trans-unit id="HeaderName">
        <source>Name</source>
        <target state="translated">Nazwa</target>
        <note />
      </trans-unit>
      <trans-unit id="HeaderState">
        <source>State</source>
        <target state="translated">Województwo</target>
        <note />
      </trans-unit>
      <trans-unit id="HeaderType">
        <source>Type</source>
        <target state="translated">Typ</target>
        <note />
      </trans-unit>
      <trans-unit id="HeaderURLs">
        <source>URLs</source>
        <target state="translated">Adresy URL</target>
        <note />
      </trans-unit>
      <trans-unit id="IncludeHiddenOptionDescription">
        <source>Include hidden resources in the output</source>
        <target state="translated">Uwzględnij ukryte zasoby w danych wyjściowych</target>
        <note />
      </trans-unit>
      <trans-unit id="JsonOptionDescription">
        <source>Output format (Table, Json, or Mermaid)</source>
        <target state="translated">Format wyjściowy (tabela, JSON lub Mermaid)</target>
        <note />
      </trans-unit>
      <trans-unit id="MermaidFollowNotSupported">
        <source>The Mermaid output format does not support --follow. Omit --follow to export a resource graph snapshot.</source>
        <target state="translated">Format wyjściowy Mermaid nie obsługuje opcji --follow. Pomiń opcję --follow, aby wyeksportować migawkę grafu zasobów.</target>
        <note />
      </trans-unit>
      <trans-unit id="NoAppHostFound">
        <source>No AppHost project found.</source>
        <target state="translated">Nie znaleziono projektu AppHost.</target>
        <note />
      </trans-unit>
      <trans-unit id="ResourceArgumentDescription">
        <source>The name of the resource to display. If not specified, all resources are shown.</source>
        <target state="translated">Nazwa zasobu do wyświetlenia. Jeśli nie zostanie określony, zostaną wyświetlone wszystkie zasoby.</target>
        <note />
      </trans-unit>
      <trans-unit id="ResourceNotFound">
        <source>Resource '{0}' not found.</source>
        <target state="translated">Nie znaleziono „{0}” zasobu.</target>
        <note />
      </trans-unit>
      <trans-unit id="SelectAppHostAction">
        <source>describe</source>
        <target state="translated">opisz</target>
        <note />
      </trans-unit>
    </body>
  </file>
</xliff>