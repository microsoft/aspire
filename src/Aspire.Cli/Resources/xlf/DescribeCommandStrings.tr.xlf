<?xml version="1.0" encoding="utf-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" version="1.2" xsi:schemaLocation="urn:oasis:names:tc:xliff:document:1.2 xliff-core-1.2-transitional.xsd">
  <file datatype="xml" source-language="en" target-language="tr" original="../DescribeCommandStrings.resx">
    <body>
      <trans-unit id="Description">
        <source>Describe resources in a running AppHost</source>
        <target state="translated">Çalışan bir AppHost'taki kaynakları açıklayın</target>
        <note />
      </trans-unit>
      <trans-unit id="FollowOptionDescription">
        <source>Continuously stream resource state changes</source>
        <target state="translated">Kaynak durumundaki değişiklikleri sürekli olarak aktarın</target>
        <note />
      </trans-unit>
      <trans-unit id="HeaderHealth">
        <source>Health</source>
        <target state="translated">Sistem Durumu</target>
        <note />
      </trans-unit>
      <trans-unit id="HeaderName">
        <source>Name</source>
        <target state="translated">Ad</target>
        <note />
      </trans-unit>
      <trans-unit id="HeaderState">
        <source>State</source>
        <target state="translated">Durum</target>
        <note />
      </trans-unit>
      <trans-unit id="HeaderType">
        <source>Type</source>
        <target state="translated">Tür</target>
        <note />
      </trans-unit>
      <trans-unit id="HeaderURLs">
        <source>URLs</source>
        <target state="translated">URL’ler</target>
        <note />
      </trans-unit>
      <trans-unit id="IncludeHiddenOptionDescription">
        <source>Include hidden resources in the output</source>
        <target state="translated">Çıktıda gizli kaynakları içerecek şekilde ekleyin</target>
        <note />
      </trans-unit>
      <trans-unit id="JsonOptionDescription">
        <source>Output format (Table, Json, or Mermaid)</source>
        <target state="translated">Çıktı biçimi (Tablo, Json veya Mermaid)</target>
        <note />
      </trans-unit>
      <trans-unit id="MermaidFollowNotSupported">
        <source>The Mermaid output format does not support --follow. Omit --follow to export a resource graph snapshot.</source>
        <target state="translated">Mermaid çıktı biçimi --follow seçeneğini desteklemiyor. Kaynak grafiği anlık görüntüsünü dışarı aktarmak için --follow seçeneğini atlayın.</target>
        <note />
      </trans-unit>
      <trans-unit id="NoAppHostFound">
        <source>No AppHost project found.</source>
        <target state="translated">AppHost projesi bulunamadı.</target>
        <note />
      </trans-unit>
      <trans-unit id="ResourceArgumentDescription">
        <source>The name of the resource to display. If not specified, all resources are shown.</source>
        <target state="translated">Görüntülenecek kaynağın adı. Belirtilmezse tüm kaynaklar gösterilir.</target>
        <note />
      </trans-unit>
      <trans-unit id="ResourceNotFound">
        <source>Resource '{0}' not found.</source>
        <target state="translated">'{0}' kaynağı bulunamadı.</target>
        <note />
      </trans-unit>
      <trans-unit id="SelectAppHostAction">
        <source>describe</source>
        <target state="translated">açıklayın</target>
        <note />
      </trans-unit>
    </body>
  </file>
</xliff>