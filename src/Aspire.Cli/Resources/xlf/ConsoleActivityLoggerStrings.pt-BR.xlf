<?xml version="1.0" encoding="utf-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" version="1.2" xsi:schemaLocation="urn:oasis:names:tc:xliff:document:1.2 xliff-core-1.2-transitional.xsd">
  <file datatype="xml" source-language="en" target-language="pt-BR" original="../ConsoleActivityLoggerStrings.resx">
    <body>
      <trans-unit id="ActivityStarting">
        <source>Starting...</source>
        <target state="translated">Iniciando...</target>
        <note />
      </trans-unit>
      <trans-unit id="ActivityStartingWithName">
        <source>Starting {0}...</source>
        <target state="translated">Iniciando {0}...</target>
        <note />
      </trans-unit>
      <trans-unit id="PipelineFailed">
        <source>Pipeline failed</source>
        <target state="translated">Falha no pipeline</target>
        <note />
      </trans-unit>
      <trans-unit id="PipelineSucceeded">
        <source>Pipeline succeeded</source>
        <target state="translated">Pipeline bem-sucedido</target>
        <note />
      </trans-unit>
      <trans-unit id="SummaryFailed">
        <source>{0} failed</source>
        <target state="translated">{0} falhou</target>
        <note />
      </trans-unit>
      <trans-unit id="SummaryLogLevelHelp">
        <source>For more details, add --pipeline-log-level debug/trace to the command.</source>
        <target state="translated">Para obter mais detalhes, adicione --pipeline-log-level debug/trace ao comando.</target>
        <note />
      </trans-unit>
      <trans-unit id="SummaryStepsSucceeded">
        <source>{0} steps succeeded</source>
        <target state="translated">{0} etapas bem-sucedidas</target>
        <note />
      </trans-unit>
      <trans-unit id="SummaryStepsSucceededWithTotal">
        <source>{0}/{1} steps succeeded</source>
        <target state="translated">{0}/{1} etapas bem-sucedidas</target>
        <note />
      </trans-unit>
      <trans-unit id="SummaryTotalTime">
        <source>Total time: {0}</source>
        <target state="translated">Tempo total: {0}</target>
        <note />
      </trans-unit>
      <trans-unit id="SummaryWarningsPlural">
        <source>{0} warnings</source>
        <target state="translated">{0} alertas</target>
        <note />
      </trans-unit>
      <trans-unit id="SummaryWarningsSingular">
        <source>{0} warning</source>
        <target state="translated">{0} alerta</target>
        <note />
      </trans-unit>
    </body>
  </file>
</xliff>