<?xml version="1.0" encoding="utf-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" version="1.2" xsi:schemaLocation="urn:oasis:names:tc:xliff:document:1.2 xliff-core-1.2-transitional.xsd">
  <file datatype="xml" source-language="en" target-language="ja" original="../RestoreCommandStrings.resx">
    <body>
      <trans-unit id="Description">
        <source>Restore dependencies and generate SDK code for an AppHost</source>
        <target state="translated">依存関係を復元し、AppHost の SDK コードを生成する</target>
        <note />
      </trans-unit>
      <trans-unit id="UnrecognizedAppHostType">
        <source>Unrecognized AppHost type.</source>
        <target state="translated">認識されない AppHost の種類。</target>
        <note />
      </trans-unit>
      <trans-unit id="RestoringSdkCode">
        <source>Restoring SDK code...</source>
        <target state="translated">SDK コードを復元しています...</target>
        <note />
      </trans-unit>
      <trans-unit id="RestoreSucceeded">
        <source>SDK code restored successfully for {0}.</source>
        <target state="translated">{0} の SDK コードが正常に復元されました。</target>
        <note>{0} is the AppHost project file name.</note>
      </trans-unit>
    </body>
  </file>
</xliff>