<?xml version="1.0" encoding="utf-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" version="1.2" xsi:schemaLocation="urn:oasis:names:tc:xliff:document:1.2 xliff-core-1.2-transitional.xsd">
  <file datatype="xml" source-language="en" target-language="es" original="../SecretCommandStrings.resx">
    <body>
      <trans-unit id="AllEnvironmentsCannotUseEnvironment">
        <source>The --all option cannot be combined with --environment.</source>
        <target state="translated">La opción --all no se puede combinar con --environment.</target>
        <note />
      </trans-unit>
      <trans-unit id="AllEnvironmentsOptionDescription">
        <source>List secrets from all AppHost environment Aspire secrets files.</source>
        <target state="translated">Enumera los secretos de todos los archivos de secretos de Aspire del entorno de AppHost.</target>
        <note />
      </trans-unit>
      <trans-unit id="CouldNotFindAppHost">
        <source>Could not find an AppHost project.</source>
        <target state="translated">No se pudo encontrar un proyecto AppHost.</target>
        <note />
      </trans-unit>
      <trans-unit id="DeleteDescription">
        <source>Delete a secret</source>
        <target state="translated">Eliminar un secreto</target>
        <note />
      </trans-unit>
      <trans-unit id="Description">
        <source>Manage AppHost secrets</source>
        <target state="translated">Administrar secretos de AppHost</target>
        <note />
      </trans-unit>
      <trans-unit id="EnvironmentColumnHeader">
        <source>Environment</source>
        <target state="translated">Entorno</target>
        <note />
      </trans-unit>
      <trans-unit id="EnvironmentOptionDescription">
        <source>The AppHost environment whose Aspire secrets file is used. Names are case-insensitive. The default is 'Development'.</source>
        <target state="translated">Archivo de secretos de Aspire que se usa del entorno de AppHost. Los nombres no distinguen mayúsculas de minúsculas. El valor predeterminado es "Development".</target>
        <note />
      </trans-unit>
      <trans-unit id="FormatOptionDescription">
        <source>Output format</source>
        <target state="translated">Formato de salida</target>
        <note />
      </trans-unit>
      <trans-unit id="GetDescription">
        <source>Get a secret value</source>
        <target state="translated">Obtener un valor secreto</target>
        <note />
      </trans-unit>
      <trans-unit id="InvalidEnvironmentName">
        <source>Environment names must contain 1-80 ASCII letters, digits, hyphens, or underscores, start with a letter or digit, and must not be Windows reserved device names.</source>
        <target state="translated">Los nombres de entorno deben contener entre 1 y 80 letras ASCII, dígitos, guiones o guiones bajos, empezar por una letra o un dígito y no coincidir con nombres de dispositivos reservados de Windows.</target>
        <note />
      </trans-unit>
      <trans-unit id="KeyArgumentDescription">
        <source>The secret key (e.g., Azure:Location or Parameters:postgres-password)</source>
        <target state="translated">La clave secreta (por ejemplo, Azure:Location o Parameters:postgres-password)</target>
        <note />
      </trans-unit>
      <trans-unit id="KeyDeleteArgumentDescription">
        <source>The secret key to delete</source>
        <target state="translated">Clave secreta que se va a eliminar</target>
        <note />
      </trans-unit>
      <trans-unit id="KeyRetrieveArgumentDescription">
        <source>The secret key to retrieve</source>
        <target state="translated">Clave secreta que se va a recuperar</target>
        <note />
      </trans-unit>
      <trans-unit id="ListDescription">
        <source>List all secrets</source>
        <target state="translated">Enumerar todos los secretos</target>
        <note />
      </trans-unit>
      <trans-unit id="NoSecretsConfigured">
        <source>No secrets configured.</source>
        <target state="translated">No hay secretos configurados.</target>
        <note />
      </trans-unit>
      <trans-unit id="PathDescription">
        <source>Show the secrets store path.</source>
        <target state="translated">Muestra la ruta de acceso del almacén de secretos.</target>
        <note />
      </trans-unit>
      <trans-unit id="SecretDeleteSuccess">
        <source>Secret '{0}' deleted successfully.</source>
        <target state="translated">El secreto “{0}” se eliminó correctamente.</target>
        <note />
      </trans-unit>
      <trans-unit id="SecretNotFound">
        <source>Secret '{0}' not found.</source>
        <target state="translated">Secreto “{0}” no encontrado.</target>
        <note />
      </trans-unit>
      <trans-unit id="SecretSetSuccess">
        <source>Secret '{0}' set successfully.</source>
        <target state="translated">El secreto “{0}” se estableció correctamente.</target>
        <note />
      </trans-unit>
      <trans-unit id="SetDescription">
        <source>Set a secret value</source>
        <target state="translated">Establecer un valor secreto</target>
        <note />
      </trans-unit>
      <trans-unit id="ValueArgumentDescription">
        <source>The secret value to set</source>
        <target state="translated">Valor de secreto que se va a establecer</target>
        <note />
      </trans-unit>
      <trans-unit id="KeyColumnHeader">
        <source>Key</source>
        <target state="translated">Clave</target>
        <note />
      </trans-unit>
      <trans-unit id="ValueColumnHeader">
        <source>Value</source>
        <target state="translated">Valor</target>
        <note />
      </trans-unit>
    </body>
  </file>
</xliff>