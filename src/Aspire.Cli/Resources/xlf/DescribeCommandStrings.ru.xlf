<?xml version="1.0" encoding="utf-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" version="1.2" xsi:schemaLocation="urn:oasis:names:tc:xliff:document:1.2 xliff-core-1.2-transitional.xsd">
  <file datatype="xml" source-language="en" target-language="ru" original="../DescribeCommandStrings.resx">
    <body>
      <trans-unit id="Description">
        <source>Describe resources in a running AppHost</source>
        <target state="translated">Опишите ресурсы в запущенном хосте приложений</target>
        <note />
      </trans-unit>
      <trans-unit id="FollowOptionDescription">
        <source>Continuously stream resource state changes</source>
        <target state="translated">Непрерывно выполняйте потоковую передачу изменений состояния ресурса</target>
        <note />
      </trans-unit>
      <trans-unit id="HeaderHealth">
        <source>Health</source>
        <target state="translated">Работоспособность</target>
        <note />
      </trans-unit>
      <trans-unit id="HeaderName">
        <source>Name</source>
        <target state="translated">Имя</target>
        <note />
      </trans-unit>
      <trans-unit id="HeaderState">
        <source>State</source>
        <target state="translated">Состояние</target>
        <note />
      </trans-unit>
      <trans-unit id="HeaderType">
        <source>Type</source>
        <target state="translated">Тип</target>
        <note />
      </trans-unit>
      <trans-unit id="HeaderURLs">
        <source>URLs</source>
        <target state="translated">URL-адреса</target>
        <note />
      </trans-unit>
      <trans-unit id="IncludeHiddenOptionDescription">
        <source>Include hidden resources in the output</source>
        <target state="translated">Включить скрытые ресурсы в выходные данные</target>
        <note />
      </trans-unit>
      <trans-unit id="JsonOptionDescription">
        <source>Output format (Table, Json, or Mermaid)</source>
        <target state="translated">Формат вывода (таблица, JSON или Mermaid)</target>
        <note />
      </trans-unit>
      <trans-unit id="MermaidFollowNotSupported">
        <source>The Mermaid output format does not support --follow. Omit --follow to export a resource graph snapshot.</source>
        <target state="translated">Формат вывода Mermaid не поддерживает параметр --follow. Удалите --follow, чтобы экспортировать снимок Resource Graph.</target>
        <note />
      </trans-unit>
      <trans-unit id="NoAppHostFound">
        <source>No AppHost project found.</source>
        <target state="translated">Проект хоста приложений не найден.</target>
        <note />
      </trans-unit>
      <trans-unit id="ResourceArgumentDescription">
        <source>The name of the resource to display. If not specified, all resources are shown.</source>
        <target state="translated">Имя ресурса для отображения. Если не указано, отображаются все ресурсы.</target>
        <note />
      </trans-unit>
      <trans-unit id="ResourceNotFound">
        <source>Resource '{0}' not found.</source>
        <target state="translated">Ресурс "{0}" не найден.</target>
        <note />
      </trans-unit>
      <trans-unit id="SelectAppHostAction">
        <source>describe</source>
        <target state="translated">описать</target>
        <note />
      </trans-unit>
    </body>
  </file>
</xliff>