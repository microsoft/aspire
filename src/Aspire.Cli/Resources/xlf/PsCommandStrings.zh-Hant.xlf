<?xml version="1.0" encoding="utf-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" version="1.2" xsi:schemaLocation="urn:oasis:names:tc:xliff:document:1.2 xliff-core-1.2-transitional.xsd">
  <file datatype="xml" source-language="en" target-language="zh-Hant" original="../PsCommandStrings.resx">
    <body>
      <trans-unit id="Description">
        <source>List running AppHosts</source>
        <target state="translated">列出執行中的 AppHost</target>
        <note />
      </trans-unit>
      <trans-unit id="FollowOptionDescription">
        <source>Keep running and emit updates as running AppHosts change. JSON output uses newline-delimited changed AppHost records by default, or full snapshots with --output snapshot.</source>
        <target state="translated">在執行中 AppHost 變更時持續執行並發出更新。JSON 輸出預設使用以換行符號分隔的已變更 AppHost 記錄，或具有 --output 快照集的完整快照集。</target>
        <note />
      </trans-unit>
      <trans-unit id="FollowRequiresJson">
        <source>The --follow option only supports JSON output. Use --format json.</source>
        <target state="translated">--follow 選項僅支援 JSON 輸出。使用 --format json。</target>
        <note />
      </trans-unit>
      <trans-unit id="HeaderCliPid">
        <source>CLI PID</source>
        <target state="translated">CLI PID</target>
        <note />
      </trans-unit>
      <trans-unit id="HeaderDashboard">
        <source>Dashboard</source>
        <target state="translated">儀表板</target>
        <note />
      </trans-unit>
      <trans-unit id="HeaderPath">
        <source>Path</source>
        <target state="translated">路徑</target>
        <note />
      </trans-unit>
      <trans-unit id="HeaderPid">
        <source>PID</source>
        <target state="translated">PID</target>
        <note />
      </trans-unit>
      <trans-unit id="HeaderSdk">
        <source>SDK</source>
        <target state="translated">SDK</target>
        <note />
      </trans-unit>
      <trans-unit id="InvalidOutputMode">
        <source>The --output option must be default or snapshot.</source>
        <target state="translated">--output 選項必須是預設值或快照集。</target>
        <note />
      </trans-unit>
      <trans-unit id="JsonOptionDescription">
        <source>Output format (Table or Json)</source>
        <target state="translated">輸出格式 (資料表或 Json)</target>
        <note />
      </trans-unit>
      <trans-unit id="OutputOptionDescription">
        <source>Output mode: default preserves the standard AppHost output; snapshot emits full AppHost snapshots with resource health, heartbeats, and errors. Snapshot requires --follow --format json.</source>
        <target state="translated">輸出模式: 預設會保留標準 AppHost 輸出; 快照集會發出完整 AppHost 快照集，包含資源健康狀態、活動訊號和錯誤。快照集需要 --follow --format json。</target>
        <note />
      </trans-unit>
      <trans-unit id="SnapshotRequiresFollowJson">
        <source>The --output snapshot option requires --follow --format json.</source>
        <target state="translated">--output 快照集選項需要 --follow --format json。</target>
        <note />
      </trans-unit>
      <trans-unit id="UnknownPath">
        <source>Unknown</source>
        <target state="translated">未知</target>
        <note />
      </trans-unit>
    </body>
  </file>
</xliff>