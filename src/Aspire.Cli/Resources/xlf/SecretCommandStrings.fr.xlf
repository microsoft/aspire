<?xml version="1.0" encoding="utf-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" version="1.2" xsi:schemaLocation="urn:oasis:names:tc:xliff:document:1.2 xliff-core-1.2-transitional.xsd">
  <file datatype="xml" source-language="en" target-language="fr" original="../SecretCommandStrings.resx">
    <body>
      <trans-unit id="AllEnvironmentsCannotUseEnvironment">
        <source>The --all option cannot be combined with --environment.</source>
        <target state="translated">L’option --all ne peut pas être associée à --environment.</target>
        <note />
      </trans-unit>
      <trans-unit id="AllEnvironmentsOptionDescription">
        <source>List secrets from all AppHost environment Aspire secrets files.</source>
        <target state="translated">Répertoriez les secrets de tous les fichiers de secrets Aspire de l’environnement AppHost.</target>
        <note />
      </trans-unit>
      <trans-unit id="CouldNotFindAppHost">
        <source>Could not find an AppHost project.</source>
        <target state="translated">Projet AppHost introuvable.</target>
        <note />
      </trans-unit>
      <trans-unit id="DeleteDescription">
        <source>Delete a secret</source>
        <target state="translated">Supprimer un secret</target>
        <note />
      </trans-unit>
      <trans-unit id="Description">
        <source>Manage AppHost secrets</source>
        <target state="translated">Gérer des secrets AppHost</target>
        <note />
      </trans-unit>
      <trans-unit id="EnvironmentColumnHeader">
        <source>Environment</source>
        <target state="translated">Environnement</target>
        <note />
      </trans-unit>
      <trans-unit id="EnvironmentOptionDescription">
        <source>The AppHost environment whose Aspire secrets file is used. Names are case-insensitive. The default is 'Development'.</source>
        <target state="translated">Environnement AppHost dont le fichier de secrets Aspire est utilisé. Les noms ne sont pas sensibles à la casse. La valeur par défaut est « éveloppement ».</target>
        <note />
      </trans-unit>
      <trans-unit id="FormatOptionDescription">
        <source>Output format</source>
        <target state="translated">Format de sortie</target>
        <note />
      </trans-unit>
      <trans-unit id="GetDescription">
        <source>Get a secret value</source>
        <target state="translated">Obtenir une valeur secrète</target>
        <note />
      </trans-unit>
      <trans-unit id="InvalidEnvironmentName">
        <source>Environment names must contain 1-80 ASCII letters, digits, hyphens, or underscores, start with a letter or digit, and must not be Windows reserved device names.</source>
        <target state="translated">Les noms d’environnement doivent contenir entre 1 et 80 lettres ASCII, chiffres, traits d’union ou traits de soulignement, commencer par une lettre ou un chiffre et ne pas être des noms de périphériques réservés par Windows.</target>
        <note />
      </trans-unit>
      <trans-unit id="KeyArgumentDescription">
        <source>The secret key (e.g., Azure:Location or Parameters:postgres-password)</source>
        <target state="translated">La clé secrète (par ex. Azure:Location ou Parameters:postgres-password)</target>
        <note />
      </trans-unit>
      <trans-unit id="KeyDeleteArgumentDescription">
        <source>The secret key to delete</source>
        <target state="translated">La clé secrète pour supprimer</target>
        <note />
      </trans-unit>
      <trans-unit id="KeyRetrieveArgumentDescription">
        <source>The secret key to retrieve</source>
        <target state="translated">La clé secrète à récupérer</target>
        <note />
      </trans-unit>
      <trans-unit id="ListDescription">
        <source>List all secrets</source>
        <target state="translated">Lister tous les secrets</target>
        <note />
      </trans-unit>
      <trans-unit id="NoSecretsConfigured">
        <source>No secrets configured.</source>
        <target state="translated">Aucun secret configuré.</target>
        <note />
      </trans-unit>
      <trans-unit id="PathDescription">
        <source>Show the secrets store path.</source>
        <target state="translated">Afficher le chemin du magasin de secrets.</target>
        <note />
      </trans-unit>
      <trans-unit id="SecretDeleteSuccess">
        <source>Secret '{0}' deleted successfully.</source>
        <target state="translated">Secret « {0} » supprimé avec succès.</target>
        <note />
      </trans-unit>
      <trans-unit id="SecretNotFound">
        <source>Secret '{0}' not found.</source>
        <target state="translated">Secret « {0} » introuvable.</target>
        <note />
      </trans-unit>
      <trans-unit id="SecretSetSuccess">
        <source>Secret '{0}' set successfully.</source>
        <target state="translated">Secret « {0} » défini correctement.</target>
        <note />
      </trans-unit>
      <trans-unit id="SetDescription">
        <source>Set a secret value</source>
        <target state="translated">Définir une valeur secrète</target>
        <note />
      </trans-unit>
      <trans-unit id="ValueArgumentDescription">
        <source>The secret value to set</source>
        <target state="translated">La valeur secrète à définir</target>
        <note />
      </trans-unit>
      <trans-unit id="KeyColumnHeader">
        <source>Key</source>
        <target state="translated">Clé</target>
        <note />
      </trans-unit>
      <trans-unit id="ValueColumnHeader">
        <source>Value</source>
        <target state="translated">Valeur</target>
        <note />
      </trans-unit>
    </body>
  </file>
</xliff>