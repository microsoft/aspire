<?xml version="1.0" encoding="utf-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" version="1.2" xsi:schemaLocation="urn:oasis:names:tc:xliff:document:1.2 xliff-core-1.2-transitional.xsd">
  <file datatype="xml" source-language="en" target-language="it" original="../SecretCommandStrings.resx">
    <body>
      <trans-unit id="AllEnvironmentsCannotUseEnvironment">
        <source>The --all option cannot be combined with --environment.</source>
        <target state="translated">L'opzione --all non può essere combinata con --environment.</target>
        <note />
      </trans-unit>
      <trans-unit id="AllEnvironmentsOptionDescription">
        <source>List secrets from all AppHost environment Aspire secrets files.</source>
        <target state="translated">Elenca i segreti di tutti i file dei segreti di Aspire dell'ambiente AppHost.</target>
        <note />
      </trans-unit>
      <trans-unit id="CouldNotFindAppHost">
        <source>Could not find an AppHost project.</source>
        <target state="translated">Non è possibile trovare un progetto AppHost.</target>
        <note />
      </trans-unit>
      <trans-unit id="DeleteDescription">
        <source>Delete a secret</source>
        <target state="translated">Elimina un segreto</target>
        <note />
      </trans-unit>
      <trans-unit id="Description">
        <source>Manage AppHost secrets</source>
        <target state="translated">Gestisce i segreti di AppHost</target>
        <note />
      </trans-unit>
      <trans-unit id="EnvironmentColumnHeader">
        <source>Environment</source>
        <target state="translated">Ambiente</target>
        <note />
      </trans-unit>
      <trans-unit id="EnvironmentOptionDescription">
        <source>The AppHost environment whose Aspire secrets file is used. Names are case-insensitive. The default is 'Development'.</source>
        <target state="translated">Ambiente di AppHost per il quale viene usato il file dei segreti di Aspire. I nomi fanno distinzione tra maiuscole e minuscole. L'impostazione predefinita è 'Development'.</target>
        <note />
      </trans-unit>
      <trans-unit id="FormatOptionDescription">
        <source>Output format</source>
        <target state="translated">Formato di output</target>
        <note />
      </trans-unit>
      <trans-unit id="GetDescription">
        <source>Get a secret value</source>
        <target state="translated">Ottieni un valore segreto</target>
        <note />
      </trans-unit>
      <trans-unit id="InvalidEnvironmentName">
        <source>Environment names must contain 1-80 ASCII letters, digits, hyphens, or underscores, start with a letter or digit, and must not be Windows reserved device names.</source>
        <target state="translated">I nomi degli ambienti devono contenere da 1 a 80 caratteri ASCII, ovvero lettere, numeri, trattini o caratteri di sottolineatura, iniziare con una lettera o un numero e non devono corrispondere a nomi di dispositivi riservati di Windows.</target>
        <note />
      </trans-unit>
      <trans-unit id="KeyArgumentDescription">
        <source>The secret key (e.g., Azure:Location or Parameters:postgres-password)</source>
        <target state="translated">Chiave privata (ad esempio, Azure:Location o Parameters:postgres-password)</target>
        <note />
      </trans-unit>
      <trans-unit id="KeyDeleteArgumentDescription">
        <source>The secret key to delete</source>
        <target state="translated">Chiave privata da eliminare</target>
        <note />
      </trans-unit>
      <trans-unit id="KeyRetrieveArgumentDescription">
        <source>The secret key to retrieve</source>
        <target state="translated">Chiave privata da recuperare</target>
        <note />
      </trans-unit>
      <trans-unit id="ListDescription">
        <source>List all secrets</source>
        <target state="translated">Elenca tutti i segreti</target>
        <note />
      </trans-unit>
      <trans-unit id="NoSecretsConfigured">
        <source>No secrets configured.</source>
        <target state="translated">Nessun segreto configurato.</target>
        <note />
      </trans-unit>
      <trans-unit id="PathDescription">
        <source>Show the secrets store path.</source>
        <target state="translated">Mostra il percorso dell'archivio dei segreti.</target>
        <note />
      </trans-unit>
      <trans-unit id="SecretDeleteSuccess">
        <source>Secret '{0}' deleted successfully.</source>
        <target state="translated">L'eliminazione del segreto '{0}' è stata completata.</target>
        <note />
      </trans-unit>
      <trans-unit id="SecretNotFound">
        <source>Secret '{0}' not found.</source>
        <target state="translated">Segreto {0} non trovato.</target>
        <note />
      </trans-unit>
      <trans-unit id="SecretSetSuccess">
        <source>Secret '{0}' set successfully.</source>
        <target state="translated">Il segreto '{0}' è stato impostato.</target>
        <note />
      </trans-unit>
      <trans-unit id="SetDescription">
        <source>Set a secret value</source>
        <target state="translated">Imposta un valore segreto</target>
        <note />
      </trans-unit>
      <trans-unit id="ValueArgumentDescription">
        <source>The secret value to set</source>
        <target state="translated">Valore del segreto da impostare</target>
        <note />
      </trans-unit>
      <trans-unit id="KeyColumnHeader">
        <source>Key</source>
        <target state="translated">Chiave</target>
        <note />
      </trans-unit>
      <trans-unit id="ValueColumnHeader">
        <source>Value</source>
        <target state="translated">Valore</target>
        <note />
      </trans-unit>
    </body>
  </file>
</xliff>