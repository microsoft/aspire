<?xml version="1.0" encoding="utf-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" version="1.2" xsi:schemaLocation="urn:oasis:names:tc:xliff:document:1.2 xliff-core-1.2-transitional.xsd">
  <file datatype="xml" source-language="en" target-language="cs" original="../DescribeCommandStrings.resx">
    <body>
      <trans-unit id="Description">
        <source>Describe resources in a running AppHost</source>
        <target state="translated">Zobrazit popis prostředků ve spuštěném AppHostu</target>
        <note />
      </trans-unit>
      <trans-unit id="FollowOptionDescription">
        <source>Continuously stream resource state changes</source>
        <target state="translated">Průběžné streamování změn stavu prostředků</target>
        <note />
      </trans-unit>
      <trans-unit id="HeaderHealth">
        <source>Health</source>
        <target state="translated">Stav</target>
        <note />
      </trans-unit>
      <trans-unit id="HeaderName">
        <source>Name</source>
        <target state="translated">Název</target>
        <note />
      </trans-unit>
      <trans-unit id="HeaderState">
        <source>State</source>
        <target state="translated">Stav</target>
        <note />
      </trans-unit>
      <trans-unit id="HeaderType">
        <source>Type</source>
        <target state="translated">Typ</target>
        <note />
      </trans-unit>
      <trans-unit id="HeaderURLs">
        <source>URLs</source>
        <target state="translated">Adresy URL</target>
        <note />
      </trans-unit>
      <trans-unit id="IncludeHiddenOptionDescription">
        <source>Include hidden resources in the output</source>
        <target state="translated">Zahrnout skryté prostředky do výstupu</target>
        <note />
      </trans-unit>
      <trans-unit id="JsonOptionDescription">
        <source>Output format (Table, Json, or Mermaid)</source>
        <target state="translated">Výstupní formát (Table, Json nebo Mermaid)</target>
        <note />
      </trans-unit>
      <trans-unit id="MermaidFollowNotSupported">
        <source>The Mermaid output format does not support --follow. Omit --follow to export a resource graph snapshot.</source>
        <target state="translated">Výstupní formát Mermaid nepodporuje parametr --follow. Vynechte parametr --follow, pokud chcete vyexportovat snímek grafu prostředků.</target>
        <note />
      </trans-unit>
      <trans-unit id="NoAppHostFound">
        <source>No AppHost project found.</source>
        <target state="translated">Nenašel se žádný projekt hostitele aplikací.</target>
        <note />
      </trans-unit>
      <trans-unit id="ResourceArgumentDescription">
        <source>The name of the resource to display. If not specified, all resources are shown.</source>
        <target state="translated">Název prostředku, který se má zobrazit. Pokud se nezadá, zobrazí se všechny prostředky.</target>
        <note />
      </trans-unit>
      <trans-unit id="ResourceNotFound">
        <source>Resource '{0}' not found.</source>
        <target state="translated">Prostředek {0} nebyl nalezen.</target>
        <note />
      </trans-unit>
      <trans-unit id="SelectAppHostAction">
        <source>describe</source>
        <target state="translated">popis</target>
        <note />
      </trans-unit>
    </body>
  </file>
</xliff>