<?xml version="1.0" encoding="utf-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" version="1.2" xsi:schemaLocation="urn:oasis:names:tc:xliff:document:1.2 xliff-core-1.2-transitional.xsd">
  <file datatype="xml" source-language="en" target-language="ko" original="../WaitCommandStrings.resx">
    <body>
      <trans-unit id="AllOptionDescription">
        <source>Wait for every resource the AppHost starts. Resources that wait for an explicit start are skipped.</source>
        <target state="new">Wait for every resource the AppHost starts. Resources that wait for an explicit start are skipped.</target>
        <note />
      </trans-unit>
      <trans-unit id="AllResourcesDone">
        <source>Done waiting for {0} resources. ({1:F1}s)</source>
        <target state="new">Done waiting for {0} resources. ({1:F1}s)</target>
        <note>{0} is the number of resources waited for; {1} is the elapsed time in seconds.</note>
      </trans-unit>
      <trans-unit id="Description">
        <source>Wait for one or more resources to reach a target status</source>
        <target state="needs-review-translation">리소스가 대상 상태에 도달할 때까지 기다립니다.</target>
        <note />
      </trans-unit>
      <trans-unit id="FormatOptionDescription">
        <source>Output format (Table or Json)</source>
        <target state="new">Output format (Table or Json)</target>
        <note />
      </trans-unit>
      <trans-unit id="InvalidStatusValue">
        <source>Invalid status value '{0}'. Valid values are: healthy, up, down.</source>
        <target state="translated">잘못된 상태 값 '{0}'입니다. 유효한 값은 정상, 위, 아래입니다.</target>
        <note />
      </trans-unit>
      <trans-unit id="NoResourcesToWaitFor">
        <source>No resources to wait for.</source>
        <target state="new">No resources to wait for.</target>
        <note />
      </trans-unit>
      <trans-unit id="ResourceAndAllConflict">
        <source>Resource names cannot be combined with --all.</source>
        <target state="new">Resource names cannot be combined with --all.</target>
        <note />
      </trans-unit>
      <trans-unit id="ResourceArgumentDescription">
        <source>The names of the resources to wait for</source>
        <target state="needs-review-translation">대기할 리소스의 이름</target>
        <note />
      </trans-unit>
      <trans-unit id="ResourceCompleted">
        <source>Resource '{0}' completed successfully (exit code 0). ({1:F1}s)</source>
        <target state="new">Resource '{0}' completed successfully (exit code 0). ({1:F1}s)</target>
        <note>{0} is the resource name; {1} is the elapsed time in seconds.</note>
      </trans-unit>
      <trans-unit id="ResourceEnteredFailedState">
        <source>Resource '{0}' entered a failed state: {1}</source>
        <target state="translated">리소스 '{0}'이(가) 실패 상태에 진입했습니다: {1}</target>
        <note />
      </trans-unit>
      <trans-unit id="ResourceLineCancelled">
        <source>{0}: not {1}, stopped waiting after another resource failed, {2}</source>
        <target state="new">{0}: not {1}, stopped waiting after another resource failed, {2}</target>
        <note>{0} is the resource name; {1} is the target status; {2} is the current resource state.</note>
      </trans-unit>
      <trans-unit id="ResourceLineCompleted">
        <source>{0}: completed (exit code 0)</source>
        <target state="new">{0}: completed (exit code 0)</target>
        <note>{0} is the resource name.</note>
      </trans-unit>
      <trans-unit id="ResourceLineFailed">
        <source>{0}: failed, {1}</source>
        <target state="new">{0}: failed, {1}</target>
        <note>{0} is the resource name; {1} is the resource state or error.</note>
      </trans-unit>
      <trans-unit id="ResourceLineNotFound">
        <source>{0}: not found</source>
        <target state="new">{0}: not found</target>
        <note>{0} is the resource name.</note>
      </trans-unit>
      <trans-unit id="ResourceLineReady">
        <source>{0}: {1}</source>
        <target state="new">{0}: {1}</target>
        <note>{0} is the resource name; {1} is the target status.</note>
      </trans-unit>
      <trans-unit id="ResourceLineSkipped">
        <source>{0}: skipped, waiting for an explicit start</source>
        <target state="new">{0}: skipped, waiting for an explicit start</target>
        <note>{0} is the resource name.</note>
      </trans-unit>
      <trans-unit id="ResourceLineTimedOut">
        <source>{0}: not {1} before the timeout, {2}</source>
        <target state="new">{0}: not {1} before the timeout, {2}</target>
        <note>{0} is the resource name; {1} is the target status; {2} is the current resource state.</note>
      </trans-unit>
      <trans-unit id="ResourceLineWithEndpoints">
        <source>{0} - {1}</source>
        <target state="new">{0} - {1}</target>
        <note>{0} is the resource line; {1} is a comma-separated list of endpoint URLs.</note>
      </trans-unit>
      <trans-unit id="ResourceNotFound">
        <source>Resource '{0}' was not found.</source>
        <target state="translated">리소스 '{0}'을(를) 찾을 수 없습니다.</target>
        <note />
      </trans-unit>
      <trans-unit id="ResourceOrAllRequired">
        <source>Specify one or more resource names, or use --all.</source>
        <target state="new">Specify one or more resource names, or use --all.</target>
        <note />
      </trans-unit>
      <trans-unit id="ResourceReachedTargetStatus">
        <source>Resource '{0}' is {1}. ({2:F1}s)</source>
        <target state="translated">리소스 '{0}'이(가) {1}입니다. ({2:F1}s)</target>
        <note />
      </trans-unit>
      <trans-unit id="ResourcesFailed">
        <source>{0} of {1} resources failed.</source>
        <target state="new">{0} of {1} resources failed.</target>
        <note>{0} is the number of failed resources; {1} is the number of resources waited for.</note>
      </trans-unit>
      <trans-unit id="ResourcesTimedOut">
        <source>{0} of {1} resources were not {2} after {3}s.</source>
        <target state="new">{0} of {1} resources were not {2} after {3}s.</target>
        <note>{0} is the number of resources that timed out; {1} is the number of resources waited for; {2} is the target status; {3} is the timeout in seconds.</note>
      </trans-unit>
      <trans-unit id="SelectAppHostAction">
        <source>connect to</source>
        <target state="translated">연결 대상</target>
        <note />
      </trans-unit>
      <trans-unit id="StateWithExitCode">
        <source>{0} (exit code: {1})</source>
        <target state="new">{0} (exit code: {1})</target>
        <note>{0} is the resource state; {1} is the process exit code.</note>
      </trans-unit>
      <trans-unit id="StatusOptionDescription">
        <source>The target status to wait for (healthy, up, down). Defaults to healthy.</source>
        <target state="translated">대기할 대상 상태(정상, 위, 아래)입니다. 기본값은 정상입니다.</target>
        <note />
      </trans-unit>
      <trans-unit id="TimeoutMustBePositive">
        <source>Timeout must be a positive number of seconds.</source>
        <target state="translated">시간 제한은 양수(초)여야 합니다.</target>
        <note />
      </trans-unit>
      <trans-unit id="TimeoutOptionDescription">
        <source>Maximum time to wait in seconds. Defaults to 120.</source>
        <target state="translated">대기할 최대 시간(초)입니다. 기본값은 120입니다.</target>
        <note />
      </trans-unit>
      <trans-unit id="UnknownState">
        <source>Unknown</source>
        <target state="new">Unknown</target>
        <note />
      </trans-unit>
      <trans-unit id="WaitTimedOut">
        <source>Timed out waiting for resource '{0}' to be {1} after {2}s.</source>
        <target state="translated">{2}초 후 리소스 ‘{0}’이(가) {1}이(가) 되기까지 기다리는 동안 시간이 초과되었습니다.</target>
        <note />
      </trans-unit>
      <trans-unit id="WaitingForAllResources">
        <source>Waiting for all resources to be {0}...</source>
        <target state="new">Waiting for all resources to be {0}...</target>
        <note>{0} is the target status.</note>
      </trans-unit>
      <trans-unit id="WaitingForResource">
        <source>Waiting for resource '{0}' to be {1}...</source>
        <target state="translated">리소스 '{0}'이(가) {1}이(가) 되기까지 기다리는 중...</target>
        <note />
      </trans-unit>
      <trans-unit id="WaitingForResources">
        <source>Waiting for {0} resources to be {1}...</source>
        <target state="new">Waiting for {0} resources to be {1}...</target>
        <note>{0} is the number of resources; {1} is the target status.</note>
      </trans-unit>
    </body>
  </file>
</xliff>