<?xml version="1.0" encoding="utf-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" version="1.2" xsi:schemaLocation="urn:oasis:names:tc:xliff:document:1.2 xliff-core-1.2-transitional.xsd">
  <file datatype="xml" source-language="en" target-language="pl" original="../DeployCommandStrings.resx">
    <body>
      <trans-unit id="ClearCacheOptionDescription">
        <source>Clear the deployment cache associated with the current environment and do not save deployment state</source>
        <target state="translated">Wyczyść pamięć podręczną wdrożenia skojarzoną z bieżącym środowiskiem i nie zapisuj stanu wdrożenia</target>
        <note />
      </trans-unit>
      <trans-unit id="DeploymentCanceled">
        <source>The deployment was canceled.</source>
        <target state="translated">Wdrażanie zostało anulowane.</target>
        <note />
      </trans-unit>
      <trans-unit id="Description">
        <source>Deploy an AppHost to its deployment targets</source>
        <target state="translated">Wdrażanie hosta AppHost do docelowych miejsc wdrażania</target>
        <note />
      </trans-unit>
      <trans-unit id="OperationCompletedPrefix">
        <source>DEPLOYMENT COMPLETED</source>
        <target state="translated">UKOŃCZONO WDRAŻANIE</target>
        <note />
      </trans-unit>
      <trans-unit id="OperationFailedPrefix">
        <source>DEPLOYMENT FAILED</source>
        <target state="translated">WDRAŻANIE NIE POWIODŁO SIĘ</target>
        <note />
      </trans-unit>
      <trans-unit id="OutputPathArgumentDescription">
        <source>The optional output path for deployment artifacts</source>
        <target state="translated">Opcjonalna ścieżka danych wyjściowych dla artefaktów wdrażania</target>
        <note />
      </trans-unit>
    </body>
  </file>
