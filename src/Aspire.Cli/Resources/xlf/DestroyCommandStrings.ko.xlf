<?xml version="1.0" encoding="utf-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" version="1.2" xsi:schemaLocation="urn:oasis:names:tc:xliff:document:1.2 xliff-core-1.2-transitional.xsd">
  <file datatype="xml" source-language="en" target-language="ko" original="../DestroyCommandStrings.resx">
    <body>
      <trans-unit id="Description">
        <source>Destroy a previously deployed AppHost environment</source>
        <target state="translated">이전에 배포한 AppHost 환경 삭제</target>
        <note />
      </trans-unit>
      <trans-unit id="DestroyCanceled">
        <source>The destroy operation was canceled.</source>
        <target state="translated">삭제 작업이 취소되었습니다.</target>
        <note />
      </trans-unit>
      <trans-unit id="NonInteractiveRequiresYes">
        <source>The destroy command requires --yes when the --non-interactive option is specified.</source>
        <target state="translated">삭제 명령은 --non-interactive 옵션을 지정한 경우 --yes가 필요합니다.</target>
        <note />
      </trans-unit>
      <trans-unit id="OperationCompletedPrefix">
        <source>Destroy completed</source>
        <target state="translated">삭제 완료</target>
        <note />
      </trans-unit>
      <trans-unit id="OperationFailedPrefix">
        <source>Destroy failed</source>
        <target state="translated">삭제 실패</target>
        <note />
      </trans-unit>
      <trans-unit id="OutputPathArgumentDescription">
        <source>The output path containing the deployment artifacts to destroy</source>
        <target state="translated">삭제할 배포 아티팩트가 포함된 출력 경로</target>
        <note />
      </trans-unit>
      <trans-unit id="YesOptionDescription">
        <source>Do not prompt for confirmation before destroying resources</source>
        <target state="translated">리소스를 삭제하기 전에 확인 메시지 표시 안 함</target>
        <note />
      </trans-unit>
    </body>
  </file>
</xliff>