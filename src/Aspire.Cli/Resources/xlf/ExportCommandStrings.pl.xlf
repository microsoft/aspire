<?xml version="1.0" encoding="utf-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" version="1.2" xsi:schemaLocation="urn:oasis:names:tc:xliff:document:1.2 xliff-core-1.2-transitional.xsd">
  <file datatype="xml" source-language="en" target-language="pl" original="../ExportCommandStrings.resx">
    <body>
      <trans-unit id="DashboardNotAvailable">
        <source>Dashboard is not available. Telemetry data (structured logs, traces) will not be included in the export.</source>
        <target state="translated">Pulpit nawigacyjny jest niedostępny. Dane telemetryczne (dzienniki strukturalne, ślady) nie zostaną uwzględnione w eksporcie.</target>
        <note />
      </trans-unit>
      <trans-unit id="Description">
        <source>Export telemetry and resource data to a zip file</source>
        <target state="translated">Eksportowanie danych telemetrycznych i danych zasobów do pliku zip</target>
        <note />
      </trans-unit>
      <trans-unit id="ExportComplete">
        <source>Export saved to {0}</source>
        <target state="translated">Eksport zapisany w {0}</target>
        <note />
      </trans-unit>
      <trans-unit id="FailedToExport">
        <source>Failed to export resource and telemetry data: {0}</source>
        <target state="translated">Nie można wyeksportować danych zasobów i danych telemetrycznych: {0}</target>
        <note />
      </trans-unit>
      <trans-unit id="GatheringConsoleLogs">
        <source>Gathering console logs...</source>
        <target state="translated">Trwa zbieranie dzienników konsoli...</target>
        <note />
      </trans-unit>
      <trans-unit id="GatheringResources">
        <source>Gathering resource data...</source>
        <target state="translated">Trwa zbieranie danych zasobów...</target>
        <note />
      </trans-unit>
      <trans-unit id="GatheringStructuredLogs">
        <source>Gathering structured logs...</source>
        <target state="translated">Trwa zbieranie dzienników strukturalnych...</target>
        <note />
      </trans-unit>
      <trans-unit id="GatheringTraces">
        <source>Gathering traces...</source>
        <target state="translated">Trwa zbieranie śladów...</target>
        <note />
      </trans-unit>
      <trans-unit id="IncludeHiddenOptionDescription">
        <source>Include hidden resources in the output</source>
        <target state="translated">Uwzględnij ukryte zasoby w danych wyjściowych</target>
        <note />
      </trans-unit>
      <trans-unit id="NoResourcesFound">
        <source>No resources found.</source>
        <target state="translated">Nie znaleziono żadnych zasobów.</target>
        <note />
      </trans-unit>
      <trans-unit id="OutputOptionDescription">
        <source>The output file path for the export zip file</source>
        <target state="translated">Ścieżka pliku wyjściowego dla pliku zip eksportu</target>
        <note />
      </trans-unit>
      <trans-unit id="ResourceNotFound">
        <source>Resource '{0}' not found.</source>
        <target state="translated">Nie znaleziono „{0}” zasobu.</target>
        <note />
      </trans-unit>
      <trans-unit id="ResourceOptionDescription">
        <source>Export data only for the specified resource</source>
        <target state="translated">Eksportuj dane tylko dla określonego zasobu</target>
        <note />
      </trans-unit>
      <trans-unit id="SelectAppHostAction">
        <source>export data from</source>
        <target state="translated">eksportowanie danych z</target>
        <note />
      </trans-unit>
    </body>
  </file>
</xliff>