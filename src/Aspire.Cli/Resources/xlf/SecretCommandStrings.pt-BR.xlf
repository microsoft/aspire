<?xml version="1.0" encoding="utf-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" version="1.2" xsi:schemaLocation="urn:oasis:names:tc:xliff:document:1.2 xliff-core-1.2-transitional.xsd">
  <file datatype="xml" source-language="en" target-language="pt-BR" original="../SecretCommandStrings.resx">
    <body>
      <trans-unit id="AllEnvironmentsCannotUseEnvironment">
        <source>The --all option cannot be combined with --environment.</source>
        <target state="translated">A opção --all não pode ser combinada com --environment.</target>
        <note />
      </trans-unit>
      <trans-unit id="AllEnvironmentsOptionDescription">
        <source>List secrets from all AppHost environment Aspire secrets files.</source>
        <target state="translated">Lista os segredos de todos os arquivos de segredos do ambiente do AppHost do Aspire.</target>
        <note />
      </trans-unit>
      <trans-unit id="CouldNotFindAppHost">
        <source>Could not find an AppHost project.</source>
        <target state="translated">Não foi possível localizar um projeto AppHost.</target>
        <note />
      </trans-unit>
      <trans-unit id="DeleteDescription">
        <source>Delete a secret</source>
        <target state="translated">Excluir um segredo</target>
        <note />
      </trans-unit>
      <trans-unit id="Description">
        <source>Manage AppHost secrets</source>
        <target state="translated">Gerenciar segredos do AppHost</target>
        <note />
      </trans-unit>
      <trans-unit id="EnvironmentColumnHeader">
        <source>Environment</source>
        <target state="translated">Ambiente</target>
        <note />
      </trans-unit>
      <trans-unit id="EnvironmentOptionDescription">
        <source>The AppHost environment whose Aspire secrets file is used. Names are case-insensitive. The default is 'Development'.</source>
        <target state="translated">O ambiente do AppHost cujo arquivo de segredos do Aspire será usado. Os nomes não diferenciam maiúsculas de minúsculas. O padrão é ''Desenvolvimento''.</target>
        <note />
      </trans-unit>
      <trans-unit id="FormatOptionDescription">
        <source>Output format</source>
        <target state="translated">Formato do resultado</target>
        <note />
      </trans-unit>
      <trans-unit id="GetDescription">
        <source>Get a secret value</source>
        <target state="translated">Obter um valor secreto</target>
        <note />
      </trans-unit>
      <trans-unit id="InvalidEnvironmentName">
        <source>Environment names must contain 1-80 ASCII letters, digits, hyphens, or underscores, start with a letter or digit, and must not be Windows reserved device names.</source>
        <target state="translated">Os nomes de ambiente devem conter de 1 a 80 letras ASCII, dígitos, hifens ou sublinhados, começar com uma letra ou um dígito e não podem ser nomes de dispositivos reservados do Windows.</target>
        <note />
      </trans-unit>
      <trans-unit id="KeyArgumentDescription">
        <source>The secret key (e.g., Azure:Location or Parameters:postgres-password)</source>
        <target state="translated">A chave secreta (por exemplo, Azure:Location ou Parameters:postgres-password)</target>
        <note />
      </trans-unit>
      <trans-unit id="KeyDeleteArgumentDescription">
        <source>The secret key to delete</source>
        <target state="translated">A chave secreta a ser excluída</target>
        <note />
      </trans-unit>
      <trans-unit id="KeyRetrieveArgumentDescription">
        <source>The secret key to retrieve</source>
        <target state="translated">A chave secreta a ser recuperada</target>
        <note />
      </trans-unit>
      <trans-unit id="ListDescription">
        <source>List all secrets</source>
        <target state="translated">Listar todos os segredos</target>
        <note />
      </trans-unit>
      <trans-unit id="NoSecretsConfigured">
        <source>No secrets configured.</source>
        <target state="translated">Nenhum segredo configurado.</target>
        <note />
      </trans-unit>
      <trans-unit id="PathDescription">
        <source>Show the secrets store path.</source>
        <target state="translated">Mostrar o caminho do armazenamento de segredos.</target>
        <note />
      </trans-unit>
      <trans-unit id="SecretDeleteSuccess">
        <source>Secret '{0}' deleted successfully.</source>
        <target state="translated">Segredo '{0}' excluído com êxito.</target>
        <note />
      </trans-unit>
      <trans-unit id="SecretNotFound">
        <source>Secret '{0}' not found.</source>
        <target state="translated">Segredo '{0}' não encontrado.</target>
        <note />
      </trans-unit>
      <trans-unit id="SecretSetSuccess">
        <source>Secret '{0}' set successfully.</source>
        <target state="translated">Segredo '{0}' definido com êxito.</target>
        <note />
      </trans-unit>
      <trans-unit id="SetDescription">
        <source>Set a secret value</source>
        <target state="translated">Definir um valor secreto</target>
        <note />
      </trans-unit>
      <trans-unit id="ValueArgumentDescription">
        <source>The secret value to set</source>
        <target state="translated">O valor do segredo a ser definido</target>
        <note />
      </trans-unit>
      <trans-unit id="KeyColumnHeader">
        <source>Key</source>
        <target state="translated">Chave</target>
        <note />
      </trans-unit>
      <trans-unit id="ValueColumnHeader">
        <source>Value</source>
        <target state="translated">Valor</target>
        <note />
      </trans-unit>
    </body>
  </file>
</xliff>