<?xml version="1.0" encoding="utf-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" version="1.2" xsi:schemaLocation="urn:oasis:names:tc:xliff:document:1.2 xliff-core-1.2-transitional.xsd">
  <file datatype="xml" source-language="en" target-language="tr" original="../ApiCommandStrings.resx">
    <body>
      <trans-unit id="ApiNotFound">
        <source>API item '{0}' not found. Use 'aspire docs api search' or 'aspire docs api list &lt;scope&gt;' to find available identifiers.</source>
        <target state="translated">API öğesi '{0}' bulunamadı. Kullanılabilir tanımlayıcıları bulmak için 'aspire docs api search' veya 'aspire docs api list &lt;scope&gt;' kullanın.</target>
        <note />
      </trans-unit>
      <trans-unit id="Description">
        <source>Browse and search Aspire API reference documentation from aspire.dev</source>
        <target state="translated">aspire.dev adresinden Aspire API başvurusu belgelerine göz atın ve belge arayın</target>
        <note />
      </trans-unit>
      <trans-unit id="FormatOptionDescription">
        <source>Output format (Table or Json)</source>
        <target state="translated">Çıktı biçimi (Tablo veya Json)</target>
        <note />
      </trans-unit>
      <trans-unit id="FoundApiEntries">
        <source>Found {0} API entries under '{1}'.</source>
        <target state="translated">'{1}' altında {0} API girişi bulundu.</target>
        <note />
      </trans-unit>
      <trans-unit id="FoundSearchResults">
        <source>Found {0} API results for '{1}'.</source>
        <target state="translated">'{1}' için {0} API sonucu bulundu.</target>
        <note />
      </trans-unit>
      <trans-unit id="GetDescription">
        <source>Get the markdown for an API reference item by its identifier</source>
        <target state="translated">Bir API başvuru öğesine ait Markdown'ı tanımlayıcısına göre alın</target>
        <note />
      </trans-unit>
      <trans-unit id="HeaderGroup">
        <source>Group</source>
        <target state="translated">Grup</target>
        <note />
      </trans-unit>
      <trans-unit id="HeaderId">
        <source>Id</source>
        <target state="translated">Kimlik</target>
        <note />
      </trans-unit>
      <trans-unit id="HeaderKind">
        <source>Kind</source>
        <target state="translated">Çeşit</target>
        <note />
      </trans-unit>
      <trans-unit id="HeaderLanguage">
        <source>Language</source>
        <target state="translated">Dil</target>
        <note />
      </trans-unit>
      <trans-unit id="HeaderName">
        <source>Name</source>
        <target state="translated">Ad</target>
        <note />
      </trans-unit>
      <trans-unit id="HeaderScore">
        <source>Score</source>
        <target state="translated">Puan</target>
        <note />
      </trans-unit>
      <trans-unit id="IdArgumentDescription">
        <source>The API identifier (for example, 'csharp/aspire.azure.ai.inference/aspireazureaiinferenceextensions')</source>
        <target state="translated">API tanımlayıcısı (örneğin, 'csharp/aspire.azure.ai.inference/aspireazureaiinferenceextensions')</target>
        <note />
      </trans-unit>
      <trans-unit id="LanguageOptionDescription">
        <source>Limit results to a specific API language</source>
        <target state="translated">Sonuçları belirli bir API diliyle sınırlandır</target>
        <note />
      </trans-unit>
      <trans-unit id="LimitOptionDescription">
        <source>Maximum number of search results to return (default: 5, max: 10)</source>
        <target state="translated">Döndürülecek maksimum arama sonucu sayısı (varsayılan: 5, maksimum: 10)</target>
        <note />
      </trans-unit>
      <trans-unit id="ListDescription">
        <source>List API entries under a parent scope</source>
        <target state="translated">Bir üst kapsamdaki API girişlerini listele</target>
        <note />
      </trans-unit>
      <trans-unit id="LoadingApiDocumentation">
        <source>Loading API documentation...</source>
        <target state="translated">API belgeleri yükleniyor...</target>
        <note />
      </trans-unit>
      <trans-unit id="NoApiEntriesFound">
        <source>No API entries found under '{0}'.</source>
        <target state="translated">'{0}' altında API girişi bulunamadı.</target>
        <note />
      </trans-unit>
      <trans-unit id="NoResultsFound">
        <source>No API results found for '{0}'. Try different search terms.</source>
        <target state="translated">'{0}' için API sonucu bulunamadı. Farklı arama terimleri deneyin.</target>
        <note />
      </trans-unit>
      <trans-unit id="QueryArgumentDescription">
        <source>The search query</source>
        <target state="translated">Arama sorgusu</target>
        <note />
      </trans-unit>
      <trans-unit id="ScopeArgumentDescription">
        <source>The parent API scope to browse (for example, 'csharp' or 'typescript/aspire.hosting.azure.appconfiguration')</source>
        <target state="translated">Göz atılacak üst API kapsamı (örneğin, 'csharp' veya 'typescript/aspire.hosting.azure.appconfiguration')</target>
        <note />
      </trans-unit>
      <trans-unit id="SearchDescription">
        <source>Search Aspire API reference documentation by keywords</source>
        <target state="translated">Anahtar sözcükleri kullanarak Aspire API başvuru belgelerinde arama yapın</target>
        <note />
      </trans-unit>
    </body>
  </file>
</xliff>