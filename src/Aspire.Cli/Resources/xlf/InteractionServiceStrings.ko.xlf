<?xml version="1.0" encoding="utf-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" version="1.2" xsi:schemaLocation="urn:oasis:names:tc:xliff:document:1.2 xliff-core-1.2-transitional.xsd">
  <file datatype="xml" source-language="en" target-language="ko" original="../InteractionServiceStrings.resx">
    <body>
      <trans-unit id="AppHostConnectionLost">
        <source>The connection to the AppHost was lost: {0}</source>
        <target state="translated">AppHost에 대한 연결이 끊어졌습니다. {0}</target>
        <note />
      </trans-unit>
      <trans-unit id="AppHostConnectionLostGeneric">
        <source>The connection to the application was lost.</source>
        <target state="translated">애플리케이션 연결이 끊어졌습니다.</target>
        <note />
      </trans-unit>
      <trans-unit id="AppHostNotCompatibleConsiderUpgrading">
        <source>The AppHost version is not compatible. Please upgrade the AppHost or Aspire CLI.</source>
        <target state="translated">AppHost 버전이 호환되지 않습니다. AppHost 또는 Aspire CLI를 업그레이드해 주세요.</target>
        <note />
      </trans-unit>
      <trans-unit id="AppHostNotCompatibleUpdateAppHost">
        <source>The AppHost is using an older Aspire version than the Aspire CLI. Update the AppHost's Aspire packages to continue.</source>
        <target state="translated">AppHost가 Aspire CLI보다 더 오래된 Aspire 버전을 사용하고 있습니다. 계속하려면 AppHost의 Aspire 패키지를 업데이트하세요.</target>
        <note />
      </trans-unit>
      <trans-unit id="AppHostNotCompatibleUpdateCli">
        <source>The Aspire CLI is older than the Aspire version used by the AppHost. Update the Aspire CLI to continue.</source>
        <target state="translated">Aspire CLI는 AppHost에서 사용하는 표시 버전보다 이전 버전입니다. 계속하려면 Aspire CLI를 업데이트하세요.</target>
        <note />
      </trans-unit>
      <trans-unit id="AppHostShutDown">
        <source>The application shut down.</source>
        <target state="translated">애플리케이션이 종료되었습니다.</target>
        <note />
      </trans-unit>
      <trans-unit id="AspireCLIVersion">
        <source>Aspire CLI version</source>
        <target state="translated">Aspire CLI 버전</target>
        <note />
      </trans-unit>
      <trans-unit id="AspireHostingSDKVersion">
        <source>Aspire.Hosting version</source>
        <target state="translated">Aspire.Hosting 버전</target>
        <note />
      </trans-unit>
      <trans-unit id="BuildingAppHost">
        <source>Building AppHost...</source>
        <target state="translated">AppHost를 빌드하는 중...</target>
        <note />
      </trans-unit>
      <trans-unit id="CheckingCertificates">
        <source>Checking certificates...</source>
        <target state="translated">인증서를 확인하는 중...</target>
        <note />
      </trans-unit>
      <trans-unit id="CheckingProjectType">
        <source>Checking project type...</source>
        <target state="translated">프로젝트 형식을 확인하는 중...</target>
        <note />
      </trans-unit>
      <trans-unit id="CodespacesLink">
        <source>Codespaces</source>
        <target state="translated">Codespaces</target>
        <note>Represents a type of link</note>
      </trans-unit>
      <trans-unit id="CreatedSettingsFile">
        <source>Created settings file at {0}.</source>
        <target state="translated">{0}에 설정 파일을 만들었습니다.</target>
        <note>{0} is a path</note>
      </trans-unit>
      <trans-unit id="CustomChoiceLabel">
        <source>Other (specify next)</source>
        <target state="translated">기타(다음에 지정)</target>
        <note />
      </trans-unit>
      <trans-unit id="Dashboard">
        <source>Dashboard</source>
        <target state="translated">대시보드</target>
        <note />
      </trans-unit>
      <trans-unit id="DirectLink">
        <source>Direct</source>
        <target state="translated">직접</target>
        <note>Represents a type of link</note>
      </trans-unit>
      <trans-unit id="ErrorConnectingToAppHost">
        <source>An error occurred while connecting to the AppHost: {0}</source>
        <target state="translated">AppHost에 연결하는 동안 오류가 발생했습니다. {0}</target>
        <note />
      </trans-unit>
      <trans-unit id="FindingAppHosts">
        <source>Finding AppHosts...</source>
        <target state="translated">AppHost를 찾는 중...</target>
        <note />
      </trans-unit>
      <trans-unit id="InteractiveInputNotSupported">
        <source>This prompt requires interactive input but the CLI is running in non-interactive mode. This operation does not yet support non-interactive execution.</source>
        <target state="translated">이 프롬프트를 사용하려면 대화형 입력이 필요한데 CLI가 비대화형 모드로 실행되고 있습니다. 이 작업은 아직 비대화형 실행을 지원하지 않습니다.</target>
        <note />
      </trans-unit>
      <trans-unit id="InvalidSelection">
        <source>Invalid selection.</source>
        <target state="translated">잘못된 선택입니다.</target>
        <note />
      </trans-unit>
      <trans-unit id="MoreInfoNewCliVersion">
        <source>[dim]For more information, see: {0}[/]</source>
        <target state="translated">[어둡게]자세한 내용은 다음을 참조하세요. {0}[/]</target>
        <note>Do not translate [dim]. Also leave [/] as-is. {0} is a pre-formatted link</note>
      </trans-unit>
      <trans-unit id="NewCliVersionAvailable">
        <source>[yellow]A new version of Aspire is available: {0}[/]</source>
        <target state="translated">[yellow]새 버전의 Aspire가 있습니다: {0}[/]</target>
        <note>Do not translate [yellow] and also leave [/] as-is. {0} is the version number</note>
      </trans-unit>
      <trans-unit id="NoItemsAvailableForSelection">
        <source>No items available for selection: {0}</source>
        <target state="translated">선택할 수 있는 항목 없음: {0}</target>
        <note>{0} is the original selection prompt text.</note>
      </trans-unit>
      <trans-unit id="NoSupportedAppHostsFound">
        <source>No supported app hosts were found.</source>
        <target state="translated">지원되는 앱 호스트를 찾을 수 없습니다.</target>
        <note />
      </trans-unit>
      <trans-unit id="NonInteractiveAvailableValues">
        <source>Available values: {0}</source>
        <target state="translated">사용 가능한 값: {0}</target>
        <note>{0} is a comma-separated list of valid values</note>
      </trans-unit>
      <trans-unit id="NonInteractiveInvalidValue">
        <source>The value '{0}' is not valid for {1}.</source>
        <target state="translated">'{0}' 값이 {1}에 유효하지 않습니다.</target>
        <note>{0} is the provided value. {1} is the option/argument display name.</note>
      </trans-unit>
      <trans-unit id="NonInteractiveOptionRequired">
        <source>The {0} option must be specified when running in non-interactive mode.</source>
        <target state="translated">비대화형 모드에서 실행할 때는 {0} 옵션을 지정해야 합니다.</target>
        <note>{0} is the option/argument display name like '--publisher' or '&lt;integration&gt;'</note>
      </trans-unit>
      <trans-unit id="OpenAppHostLog">
        <source>Open AppHost Log</source>
        <target state="translated">AppHost 로그 열기</target>
        <note />
      </trans-unit>
      <trans-unit id="OpenCliLog">
        <source>Open CLI Log</source>
        <target state="translated">CLI 로그 열기</target>
        <note />
      </trans-unit>
      <trans-unit id="OperationCancelled">
        <source>The operation was canceled.</source>
        <target state="translated">작업이 취소되었습니다.</target>
        <note />
      </trans-unit>
      <trans-unit id="ProjectCouldNotBeBuilt">
        <source>The project could not be built.</source>
        <target state="translated">프로젝트를 빌드할 수 없습니다.</target>
        <note />
      </trans-unit>
      <trans-unit id="ProjectCouldNotBeCreated">
        <source>The app could not be created.</source>
        <target state="translated">앱을 만들 수 없습니다.</target>
        <note />
      </trans-unit>
      <trans-unit id="ProjectOptionDoesntExist">
        <source>The --apphost option specified a project that does not exist.</source>
        <target state="translated">--apphost 옵션에서 존재하지 않는 프로젝트를 지정했습니다.</target>
        <note />
      </trans-unit>
      <trans-unit id="ProjectOptionNotSpecifiedMultipleAppHostsFound">
        <source>The --apphost option was not specified and multiple AppHost project files were detected.</source>
        <target state="translated">--apphost 옵션이 지정되지 않았고 AppHost 프로젝트 파일이 여러 개 검색되었습니다.</target>
        <note />
      </trans-unit>
      <trans-unit id="ProjectOptionNotSpecifiedNoAppHostsFound">
        <source>The --apphost option was not specified and no AppHost project files were detected.</source>
        <target state="translated">--apphost 옵션이 지정되지 않았고 AppHost 프로젝트 파일이 검색되지 않았습니다.</target>
        <note />
      </trans-unit>
      <trans-unit id="ProjectOptionSpecifiedDirectoryContainsMultipleAppHosts">
        <source>The --apphost option specified a directory that contains multiple AppHost project files.</source>
        <target state="translated">--apphost 옵션이 여러 AppHost 프로젝트 파일이 포함된 디렉터리를 지정했습니다.</target>
        <note />
      </trans-unit>
      <trans-unit id="ProjectOptionSpecifiedDirectoryContainsNoAppHosts">
        <source>The --apphost option specified a directory that does not contain any AppHost project files.</source>
        <target state="translated">--apphost 옵션이 AppHost 프로젝트 파일이 포함되지 않은 디렉터리를 지정했습니다.</target>
        <note />
      </trans-unit>
      <trans-unit id="RequiredCapability">
        <source>Required capability</source>
        <target state="translated">필수 기능</target>
        <note />
      </trans-unit>
      <trans-unit id="SearchingProjects">
        <source>Searching...</source>
        <target state="translated">검색 중...</target>
        <note />
      </trans-unit>
      <trans-unit id="SeeAppHostLogsAt">
        <source>See AppHost logs at {0}</source>
        <target state="translated">{0}에서 AppHost 로그 확인</target>
        <note>{0} is the log file path of the CLI process managing the AppHost</note>
      </trans-unit>
      <trans-unit id="SeeLogsAt">
        <source>See logs at {0}</source>
        <target state="translated">{0}에서 로그 보기</target>
        <note>{0} is the log file path</note>
      </trans-unit>
      <trans-unit id="SelectAppHostToUse">
        <source>Select an AppHost to use:</source>
        <target state="translated">사용할 AppHost 선택:</target>
        <note />
      </trans-unit>
      <trans-unit id="SpecifiedProjectFileNotAppHostProject">
        <source>The specified project file is not an Aspire AppHost project.</source>
        <target state="translated">지정한 프로젝트 파일은 Aspire AppHost 프로젝트가 아닙니다.</target>
        <note />
      </trans-unit>
      <trans-unit id="StoppingAspire">
        <source>Stopping Aspire.</source>
        <target state="translated">Aspire를 중지하는 중입니다.</target>
        <note />
      </trans-unit>
      <trans-unit id="ToUpdateRunCommand">
        <source>[dim]To update, run: {0}[/]</source>
        <target state="translated">[dim]업데이트하려면 다음 명령 실행: {0}[/]</target>
        <note>Do not translate [dim]. Also leave [/] as-is. {0} is the command to run</note>
      </trans-unit>
      <trans-unit id="TrustingCertificates">
        <source>Trusting certificates...</source>
        <target state="translated">인증서를 신뢰하는 중...</target>
        <note />
      </trans-unit>
      <trans-unit id="UnbuildableAppHostsDetected">
        <source>No AppHosts were found (there may be AppHost project files with syntax errors/invalid SDK versions).</source>
        <target state="translated">AppHost를 찾을 수 없음(구문 오류/잘못된 SDK 버전이 있는 AppHost 프로젝트 파일이 있을 수 있음)</target>
        <note />
      </trans-unit>
      <trans-unit id="UnexpectedErrorOccurred">
        <source>An unexpected error occurred: {0}</source>
        <target state="translated">예기치 않은 오류가 발생했습니다. {0}</target>
        <note>{0} is the exception message</note>
      </trans-unit>
      <trans-unit id="UpdatedSettingsFile">
        <source>Updated settings file at {0}.</source>
        <target state="translated">{0}에서 설정 파일을 업데이트했습니다.</target>
        <note>{0} is a path</note>
      </trans-unit>
      <trans-unit id="WaitingForDebuggerToAttachToAppHost">
        <source>Waiting for debugger to attach to AppHost process</source>
        <target state="translated">디버거가 AppHost 프로세스에 연결되기를 기다리는 중</target>
        <note />
      </trans-unit>
    </body>
  </file>
</xliff>