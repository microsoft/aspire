<?xml version="1.0" encoding="utf-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" version="1.2" xsi:schemaLocation="urn:oasis:names:tc:xliff:document:1.2 xliff-core-1.2-transitional.xsd">
  <file datatype="xml" source-language="en" target-language="pl" original="../ConsoleActivityLoggerStrings.resx">
    <body>
      <trans-unit id="ActivityStarting">
        <source>Starting...</source>
        <target state="translated">Trwa uruchamianie...</target>
        <note />
      </trans-unit>
      <trans-unit id="ActivityStartingWithName">
        <source>Starting {0}...</source>
        <target state="translated">Trwa uruchamianie {0}...</target>
        <note />
      </trans-unit>
      <trans-unit id="PipelineFailed">
        <source>Pipeline failed</source>
        <target state="translated">Niepowodzenie potoku</target>
        <note />
      </trans-unit>
      <trans-unit id="PipelineSucceeded">
        <source>Pipeline succeeded</source>
        <target state="translated">Potok zakończył się pomyślnie</target>
        <note />
      </trans-unit>
      <trans-unit id="SummaryFailed">
        <source>{0} failed</source>
        <target state="translated">Zakończone niepowodzeniem: {0}</target>
        <note />
      </trans-unit>
      <trans-unit id="SummaryLogLevelHelp">
        <source>For more details, add --pipeline-log-level debug/trace to the command.</source>
        <target state="translated">Aby uzyskać więcej szczegółów, dodaj do polecenia parametr --pipeline-log-level debug/trace.</target>
        <note />
      </trans-unit>
      <trans-unit id="SummaryStepsSucceeded">
        <source>{0} steps succeeded</source>
        <target state="translated">{0} kroków zakończono pomyślnie</target>
        <note />
      </trans-unit>
      <trans-unit id="SummaryStepsSucceededWithTotal">
        <source>{0}/{1} steps succeeded</source>
        <target state="translated">{0}/{1} kroków zakończono pomyślnie</target>
        <note />
      </trans-unit>
      <trans-unit id="SummaryTotalTime">
        <source>Total time: {0}</source>
        <target state="translated">Całkowity czas: {0}</target>
        <note />
      </trans-unit>
      <trans-unit id="SummaryWarningsPlural">
        <source>{0} warnings</source>
        <target state="translated">Ostrzeżenia: {0}</target>
        <note />
      </trans-unit>
      <trans-unit id="SummaryWarningsSingular">
        <source>{0} warning</source>
        <target state="translated">Ostrzeżenie: {0}</target>
        <note />
      </trans-unit>
    </body>
  </file>
