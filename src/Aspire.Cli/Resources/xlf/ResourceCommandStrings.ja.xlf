        <source>Required.</source>
        <target state="translated">必須です。</target>
        <note />
      </trans-unit>
      <trans-unit id="CommandSpecificHelpUsageSyntax">
        <source>aspire resource {0} {1} [options] [[--] &lt;command-options&gt;...]</source>
        <target state="translated">aspire resource {0} {1} [options] [[--] &lt;command-options&gt;...]</target>
        <note />
