<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net472</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <!-- MSBuild task assembly, not a polyglot integration, so opt out of the default 'polyglot' NuGet tag. -->
    <IsAspirePolyglotCompatible>false</IsAspirePolyglotCompatible>
    <!-- MSBuild Task assemblies don't need XML docs -->
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Match the task's dependency, not the central MSBuild pin used by repository tools. -->
    <PackageReference Include="Microsoft.Build.Framework" VersionOverride="17.9.5" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Aspire.Hosting.Sdk.Tests" />
    <Compile Include="$(SharedDir)ProcessStartInfoHelper.cs" Link="ProcessStartInfoHelper.cs" />
  </ItemGroup>

</Project>
