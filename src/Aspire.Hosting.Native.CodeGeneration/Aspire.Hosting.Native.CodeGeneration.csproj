<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsShipping>false</IsShipping>
    <IsAspirePolyglotCompatible>false</IsAspirePolyglotCompatible>
    <EnablePackageValidation>false</EnablePackageValidation>
    <!-- This executable is a build tool, never a runtime dependency of its AOT caller. -->
    <ShouldBeValidatedAsExecutableReference>false</ShouldBeValidatedAsExecutableReference>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources/native-builder.mts" />
    <EmbeddedResource Include="Resources/native-pipeline.mts" />
    <InternalsVisibleTo Include="Aspire.Hosting.Native.Core.Tests" />
    <ProjectReference Include="../Aspire.Hosting.Native.Core/Aspire.Hosting.Native.Core.csproj" />
    <ProjectReference Include="../Aspire.Hosting.Ats.Abstractions/Aspire.Hosting.Ats.Abstractions.csproj" />
    <ProjectReference Include="../Aspire.Hosting.CodeGeneration.TypeScript/Aspire.Hosting.CodeGeneration.TypeScript.csproj" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <Compile Include="../Aspire.Hosting.RemoteHost/AtsCapabilityScanner.cs" Link="AtsCapabilityScanner.cs" />
    <Compile Include="$(SharedDir)NativeProviderContractReader.cs" Link="Shared/NativeProviderContractReader.cs" />
    <EmbeddedResource Include="../Aspire.Hosting.Native.Server/Api/**/*.cs">
      <LogicalName>NativeContract/%(Identity)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
