<?xml version="1.0" encoding="utf-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" version="1.2" xsi:schemaLocation="urn:oasis:names:tc:xliff:document:1.2 xliff-core-1.2-transitional.xsd">
  <file datatype="xml" source-language="en" target-language="ja" original="../Reconnect.resx">
    <body>
      <trans-unit id="ReconnectFailedText">
        <source>Failed to rejoin.&lt;br /&gt;Please retry or reload the page.</source>
        <target state="translated">再接続できませんでした。&lt;br /&gt;もう一度お試しになるか、ページを再読み込みしてみてください。</target>
        <note />
      </trans-unit>
      <trans-unit id="ReconnectFirstAttemptText">
        <source>Rejoining the server...</source>
        <target state="translated">サーバーに再接続しています...</target>
        <note />
      </trans-unit>
      <trans-unit id="ReconnectRepeatedAttemptText">
        <source>Rejoin failed... trying again in &lt;span id="components-seconds-to-next-attempt"&gt;&lt;/span&gt; seconds.</source>
        <target state="translated">再接続に失敗しました... &lt;span id="components-seconds-to-next-attempt"&gt; &lt;/span&gt; 秒後に再試行します。</target>
        <note />
      </trans-unit>
      <trans-unit id="ReconnectRetryButtonText">
        <source>Retry</source>
        <target state="translated">再試行</target>
        <note />
      </trans-unit>
      <trans-unit id="ResourceServiceReconnectDisconnectedText">
        <source>Lost connection to the AppHost. Attempting to reconnect...</source>
        <target state="translated">AppHost への接続が失われました。再接続を試みています...</target>
        <note />
      </trans-unit>
      <trans-unit id="ResourceServiceReconnectRetryButtonText">
        <source>Retry</source>
        <target state="translated">再試行</target>
        <note />
      </trans-unit>
      <trans-unit id="ResourceServiceReconnectUnsupportedText">
        <source>{0} app requires dashboard {2} or later.&lt;br /&gt;&lt;br /&gt;See &lt;a href="{1}" target="_blank" rel="noreferrer noopener"&gt;upgrade Aspire&lt;/a&gt; for more information.</source>
        <target state="translated">{0} アプリにはダッシュボード {2} 以降が必要です。&lt;br /&gt;&lt;br /&gt;詳細については、&lt;a href="{1}" target="_blank" rel="noreferrer noopener"&gt;Aspire のアップグレード&lt;/a&gt;を参照してください。</target>
        <note />
      </trans-unit>
    </body>
  </file>
</xliff>