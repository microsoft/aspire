        <source>Exceeded structured log limit</source>
        <target state="translated">Překročil se limit strukturovaných protokolů</target>
        <note />
      </trans-unit>
      <trans-unit id="PauseInProgressText">
        <source>Structured logs capture paused at {0}</source>
        <target state="translated">Zachytávání strukturovaných protokolů bylo pozastaveno v {0}.</target>
        <note />
      </trans-unit>
      <trans-unit id="StructuredLogsEntryDetails">
        <source>Log entry details</source>
        <target state="translated">Podrobnosti položky protokolu</target>
        <note />
      </trans-unit>
