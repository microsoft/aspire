<?xml version="1.0" encoding="utf-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" version="1.2" xsi:schemaLocation="urn:oasis:names:tc:xliff:document:1.2 xliff-core-1.2-transitional.xsd">
  <file datatype="xml" source-language="en" target-language="pt-BR" original="../Reconnect.resx">
    <body>
      <trans-unit id="ReconnectFailedText">
        <source>Failed to rejoin.&lt;br /&gt;Please retry or reload the page.</source>
        <target state="translated">Falha ao ingressar novamente.&lt;br /&gt;Tente novamente ou recarregue a página.</target>
        <note />
      </trans-unit>
      <trans-unit id="ReconnectFirstAttemptText">
        <source>Rejoining the server...</source>
        <target state="translated">Ingressando novamente no servidor...</target>
        <note />
      </trans-unit>
      <trans-unit id="ReconnectRepeatedAttemptText">
        <source>Rejoin failed... trying again in &lt;span id="components-seconds-to-next-attempt"&gt;&lt;/span&gt; seconds.</source>
        <target state="translated">Falha ao ingressar novamente... tentando novamente em &lt;span id="components-seconds-to-next-attempt"&gt;&lt;/span&gt; segundos.</target>
        <note />
      </trans-unit>
      <trans-unit id="ReconnectRetryButtonText">
        <source>Retry</source>
        <target state="translated">Repetir</target>
        <note />
      </trans-unit>
      <trans-unit id="ResourceServiceReconnectDisconnectedText">
        <source>Lost connection to the AppHost. Attempting to reconnect...</source>
        <target state="translated">Conexão perdida com o AppHost. Tentando se reconectar...</target>
        <note />
      </trans-unit>
      <trans-unit id="ResourceServiceReconnectRetryButtonText">
        <source>Retry</source>
        <target state="translated">Tentar novamente</target>
        <note />
      </trans-unit>
      <trans-unit id="ResourceServiceReconnectUnsupportedText">
        <source>{0} app requires dashboard {2} or later.&lt;br /&gt;&lt;br /&gt;See &lt;a href="{1}" target="_blank" rel="noreferrer noopener"&gt;upgrade Aspire&lt;/a&gt; for more information.</source>
        <target state="translated">{0} aplicativo requer dashboard {2} ou posterior.&lt;br /&gt;&lt;br /&gt;Consulte &lt;a href="{1}" target="_blank" rel="noreferrer noopener"&gt;Aspire&lt;/a&gt; de atualização para obter mais informações.</target>
        <note />
      </trans-unit>
    </body>
  </file>
</xliff>