        <target state="translated">모든 계측</target>
        <note />
      </trans-unit>
      <trans-unit id="MetricsFilterResultsTitle">
        <source>Metrics matching "{0}"</source>
        <target state="translated">"{0}"과(와) 일치하는 메트릭</target>
        <note>{0} is the filter text</note>
      </trans-unit>
      <trans-unit id="MetricsGroupByLabel">
        <source>Group by</source>
        <target state="translated">그룹화 기준</target>
        <note />
      </trans-unit>
      <trans-unit id="MetricsGroupByTooltip">
        <source>Group instruments</source>
        <target state="translated">계측 그룹화</target>
        <note />
      </trans-unit>
      <trans-unit id="MetricsGroupMenuTitle">
        <source>Group metrics</source>
        <target state="translated">그룹 메트릭</target>
        <note />
      </trans-unit>
      <trans-unit id="MetricsGroupNone">
        <source>None</source>
        <target state="translated">없음</target>
        <note />
      </trans-unit>
