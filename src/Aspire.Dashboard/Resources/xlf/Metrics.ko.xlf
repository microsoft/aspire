        <note>Sorts instruments by their name.</note>
      </trans-unit>
      <trans-unit id="MetricsSortValueAscending">
        <source>Value (low to high)</source>
        <target state="translated">값(오름차순)</target>
        <note />
      </trans-unit>
      <trans-unit id="MetricsSortValueDescending">
        <source>Value (high to low)</source>
        <target state="translated">값(내림차순)</target>
        <note />
      </trans-unit>
