<?xml version="1.0" encoding="utf-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" version="1.2" xsi:schemaLocation="urn:oasis:names:tc:xliff:document:1.2 xliff-core-1.2-transitional.xsd">
  <file datatype="xml" source-language="en" target-language="pl" original="../Reconnect.resx">
    <body>
      <trans-unit id="ReconnectFailedText">
        <source>Failed to rejoin.&lt;br /&gt;Please retry or reload the page.</source>
        <target state="translated">Nie można ponownie dołączyć.&lt;br /&gt;Spróbuj ponownie lub załaduj stronę jeszcze raz.</target>
        <note />
      </trans-unit>
      <trans-unit id="ReconnectFirstAttemptText">
        <source>Rejoining the server...</source>
        <target state="translated">Trwa ponowne dołączanie do serwera...</target>
        <note />
      </trans-unit>
      <trans-unit id="ReconnectRepeatedAttemptText">
        <source>Rejoin failed... trying again in &lt;span id="components-seconds-to-next-attempt"&gt;&lt;/span&gt; seconds.</source>
        <target state="translated">Ponowne dołączanie nie powiodło się... ponowienie próby za &lt;span id="components-seconds-to-next-attempt"&gt;&lt;/span&gt; s.</target>
        <note />
      </trans-unit>
      <trans-unit id="ReconnectRetryButtonText">
        <source>Retry</source>
        <target state="translated">Ponów próbę</target>
        <note />
      </trans-unit>
      <trans-unit id="ResourceServiceReconnectDisconnectedText">
        <source>Lost connection to the AppHost. Attempting to reconnect...</source>
        <target state="translated">Utracono połączenie z usługą AppHost. Trwa próba ponownego nawiązania połączenia...</target>
        <note />
      </trans-unit>
      <trans-unit id="ResourceServiceReconnectRetryButtonText">
        <source>Retry</source>
        <target state="translated">Ponów próbę</target>
        <note />
      </trans-unit>
      <trans-unit id="ResourceServiceReconnectUnsupportedText">
        <source>{0} app requires dashboard {2} or later.&lt;br /&gt;&lt;br /&gt;See &lt;a href="{1}" target="_blank" rel="noreferrer noopener"&gt;upgrade Aspire&lt;/a&gt; for more information.</source>
        <target state="translated">{0} aplikacja wymaga pulpitu nawigacyjnego {2} lub nowszego.&lt;br /&gt;&lt;br /&gt;Aby uzyskać więcej informacji, zobacz &lt;a href="{1}" target="_blank" rel="noreferrer noopener"&gt;Aspire&lt;/a&gt; uaktualniania.</target>
        <note />
      </trans-unit>
    </body>
  </file>
</xliff>