<?xml version="1.0" encoding="utf-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" version="1.2" xsi:schemaLocation="urn:oasis:names:tc:xliff:document:1.2 xliff-core-1.2-transitional.xsd">
  <file datatype="xml" source-language="en" target-language="it" original="../StructuredLogs.resx">
    <body>
      <trans-unit id="ActionLogMessageText">
        <source>Log message</source>
        <target state="translated">Messaggio del log</target>
        <note />
      </trans-unit>
      <trans-unit id="MessageExceededLimitBody">
        <source>A maximum of {0} structured logs are stored. Old structured logs are automatically removed.</source>
        <target state="translated">Sono archiviati al massimo {0} log strutturati. I log strutturati precedenti vengono rimossi automaticamente.</target>
        <note>{0} is the max count</note>
      </trans-unit>
      <trans-unit id="MessageExceededLimitTitle">
        <source>Exceeded structured log limit</source>
        <target state="translated">È stato superato il limite di log strutturati</target>
        <note />
      </trans-unit>
      <trans-unit id="PauseInProgressText">
        <source>Structured logs capture paused at {0}</source>
        <target state="translated">L'acquisizione dei log strutturati è stata sospesa alle {0}</target>
        <note />
      </trans-unit>
      <trans-unit id="StructuredLogsEntryDetails">
        <source>Log entry details</source>
        <target state="translated">Dettagli della voce di log</target>
        <note />
      </trans-unit>
      <trans-unit id="StructuredLogsHeader">
        <source>Structured logs</source>
        <target state="translated">Log strutturati</target>
        <note />
      </trans-unit>
      <trans-unit id="StructuredLogsLevelColumnHeader">
        <source>Level</source>
        <target state="translated">Livello</target>
        <note />
      </trans-unit>
      <trans-unit id="StructuredLogsLevels">
        <source>Level</source>
        <target state="translated">Livello</target>
        <note />
      </trans-unit>
      <trans-unit id="StructuredLogsMessageColumnHeader">
        <source>Message</source>
        <target state="translated">Messaggio</target>
        <note />
      </trans-unit>
      <trans-unit id="StructuredLogsMessageFilter">
        <source>Message filter</source>
        <target state="translated">Filtro messaggi</target>
        <note />
      </trans-unit>
      <trans-unit id="StructuredLogsMinimumLogFilter">
        <source>Minimum log level filter</source>
        <target state="translated">Filtro livello di log minimo</target>
        <note />
      </trans-unit>
      <trans-unit id="StructuredLogsNoLogsFound">
        <source>No structured logs found</source>
        <target state="translated">Nessun log strutturato trovato</target>
        <note />
      </trans-unit>
      <trans-unit id="StructuredLogsPageTitle">
        <source>{0} structured logs</source>
        <target state="translated">{0} log strutturati</target>
        <note>{0} is an application name</note>
      </trans-unit>
      <trans-unit id="StructuredLogsResourceColumnHeader">
        <source>Resource</source>
        <target state="translated">Risorsa</target>
        <note />
      </trans-unit>
      <trans-unit id="StructuredLogsSelectMinimumLogLevel">
        <source>Select a minimum log level</source>
        <target state="translated">Seleziona un livello di log minimo</target>
        <note />
      </trans-unit>
      <trans-unit id="StructuredLogsTimestampColumnHeader">
        <source>Timestamp</source>
        <target state="translated">Timestamp</target>
        <note />
      </trans-unit>
      <trans-unit id="StructuredLogsTraceColumnHeader">
        <source>Trace</source>
        <target state="translated">Traccia</target>
        <note />
      </trans-unit>
      <trans-unit id="TotalItemsFooterPluralText">
        <source>Showing &lt;strong&gt;{0} structured logs&lt;/strong&gt;</source>
        <target state="translated">Visualizzazione di &lt;strong&gt;{0} log strutturati&lt;/strong&gt;</target>
        <note>{0} is a number. This is raw markup, so &lt;strong&gt; and &lt;/strong&gt; should not be modified</note>
      </trans-unit>
      <trans-unit id="TotalItemsFooterSingularText">
        <source>Showing &lt;strong&gt;{0} structured log&lt;/strong&gt;</source>
        <target state="translated">Visualizzazione di &lt;strong&gt;{0} log strutturato&lt;/strong&gt;</target>
        <note>{0} is a number. This is raw markup, so &lt;strong&gt; and &lt;/strong&gt; should not be modified</note>
      </trans-unit>
      <trans-unit id="VirtualizedLimitText">
        <source>Showing &lt;strong&gt;{0} of {1} logs&lt;/strong&gt;. Use filters to narrow the results</source>
        <target state="new">Showing &lt;strong&gt;{0} of {1} logs&lt;/strong&gt;. Use filters to narrow the results</target>
        <note>{0} is the displayed count. {1} is the total count. This is raw markup, so &lt;strong&gt; and &lt;/strong&gt; should not be modified.</note>
      </trans-unit>
    </body>
  </file>
