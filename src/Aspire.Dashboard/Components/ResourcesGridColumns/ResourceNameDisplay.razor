@namespace Aspire.Dashboard.Components

@using Aspire.Dashboard.Resources

@inject IStringLocalizer<Columns> Loc
@inject IconResolver IconResolver

@{
    var showBadge = Resource.IsPersistentContainer && !DashboardExperienceComponents.IsLegacyLocation(NavigationManager);
    RenderFragment resourceIcon = @<FluentIcon Width="16px"
                    Class="resource-icon"
                    Color="Color.Custom"
                    CustomColor="@ColorGenerator.Instance.GetColorVariableByKey(FormatName(Resource))"
                    Value="@ResourceIconHelpers.GetIconForResource(IconResolver, Resource, IconSize.Size16)" />;
}

<span class="resource-name-container">
    @* Do this to trim significant whitespace so there isn't a space added between icon and text *@
    @{
        @if (showBadge)
        {
            <span class="modern-resource-icon">
                @resourceIcon
                <PersistentContainerBadge Resource="@Resource" />
            </span>
        }
        else
        {
            @resourceIcon
        }
    }
    @{
        <span class="resource-name-text"><FluentHighlighter HighlightedText="@FilterText" Text="@FormatName(Resource)" /></span>
    }
    @if (Resource.IsPersistentContainer && !showBadge)
    {
        <FluentIcon Icon="Icons.Regular.Size16.Pin" data-tooltip="@Loc[nameof(Columns.PersistentContainerIconTooltip)]" aria-label="@Loc[nameof(Columns.PersistentContainerIconTooltip)]"
            Color="Color.Default" Class="persistent-container-icon" />
    }
    @if (ShowHiddenIndicator && Resource.IsResourceHidden(showHiddenResources: false))
    {
        <FluentIcon Icon="Icons.Regular.Size16.EyeOff" data-tooltip="@Loc[nameof(Columns.HiddenResourceIconTooltip)]" aria-label="@Loc[nameof(Columns.HiddenResourceIconTooltip)]"
            Color="Color.Custom" CustomColor="var(--colorNeutralForeground3)" Class="resource-hidden-icon" />
    }
</span>

@code {
    [Parameter, EditorRequired]
    public required ResourceViewModel Resource { get; set; }

    [Parameter, EditorRequired]
    public required Func<ResourceViewModel, string> FormatName { get; set; }

    [Parameter, EditorRequired]
    public required string FilterText { get; set; }

    // The indicator's tooltip refers to the "Show hidden resources" toggle, so only show it in
    // contexts that have that toggle. Other callers (e.g. the manage data dialog) list every resource.
    [Parameter, EditorRequired]
    public required bool ShowHiddenIndicator { get; set; }

}
