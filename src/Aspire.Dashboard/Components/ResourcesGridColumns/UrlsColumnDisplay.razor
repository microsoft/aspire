@using Aspire.Dashboard.Model
@namespace Aspire.Dashboard.Components

@if (DisplayedUrls.Count == 0)
{
    <span class="empty-data"></span>
}
else if (DisplayedUrls.Count == 1)
{
    <div class="url-container" style="display: inline-block;" @onclick:stopPropagation="true">
        @WriteUrl(DisplayedUrls[0])
    </div>
}
else if (DisplayedUrls.Count > 1)
{
    // Show the first URL inline and collapse the rest behind a "+N" button that opens a popover.
    // Rendering only one inline element avoids the expensive forced reflow that rendering hundreds
    // of URL elements used to cause (long enough to drop the SignalR connection).
    var firstUrl = DisplayedUrls[0];
    var overflowCount = DisplayedUrls.Count - 1;

    <div class="url-container" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
        <div class="url-overflow">
            <span class="url-overflow-first">@WriteUrl(firstUrl)</span>
            <button type="button"
                    id="@_moreButtonId"
                    class="btn btn--primary btn--sm url-button"
                    @onclick="() => _popoverVisible = !_popoverVisible">
                @($"+{overflowCount}")
            </button>
        </div>
        <Popover AnchorId="@_moreButtonId" @bind-Open="_popoverVisible">
            <Header>
                @Loc[nameof(Resources.Columns.UrlsColumnDisplayOverflowTitle)]
            </Header>
            <Body>
                <div class="url-popup">
                    @foreach (var item in DisplayedUrls)
                    {
                        <div class="url-link">
                            @WriteUrl(item)
                        </div>
                    }
                </div>
            </Body>
        </Popover>
    </div>
}

@if (!string.IsNullOrEmpty(AdditionalMessage))
{
    <div>@AdditionalMessage</div>
}

@code {
    RenderFragment WriteUrl(DisplayedUrl displayedUrl)
    {
        if (displayedUrl.Url != null)
        {
            return @<a href="@displayedUrl.Url" target="_blank" title="@GetTooltipText(displayedUrl)" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">@displayedUrl.Text</a>;
        }
        else
        {
            return @<span title="@GetTooltipText(displayedUrl)">@displayedUrl.Text</span>;
        }
    }
}
