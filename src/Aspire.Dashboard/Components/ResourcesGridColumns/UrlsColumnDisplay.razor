@using Aspire.Dashboard.Model
@namespace Aspire.Dashboard.Components

@if (DisplayedUrls.Count == 0)
{
    <span class="empty-data"></span>
}
else if (DisplayedUrls.Count == 1)
{
    <div class="url-container single-url" @onclick:stopPropagation="true">
        @WriteUrl(DisplayedUrls[0])
    </div>
}
else if (DisplayedUrls.Count > 1)
{
    <div class="url-container" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
        <FluentOverflow TItem="DisplayedUrl" Items="@DisplayedUrls" Class="url-overflow" MaxRenderedItems="@MaxRenderedOverflowItems" Threshold="0">
            <ItemTemplate Context="displayedUrl">
                <div behavior="@(ReferenceEquals(displayedUrl, DisplayedUrls[0]) ? "ellipsis" : null)">
                    @WriteUrl(displayedUrl)
                </div>
            </ItemTemplate>
            <MoreTemplate Context="overflow">
                <div @onclick:stopPropagation="true" @onkeydown:stopPropagation="true" style="display:inherit;">
                    <FluentButton Appearance="ButtonAppearance.Primary" OnClick="() => _popoverVisible = !_popoverVisible" Class="url-button">
                        @($"+{overflow.OverflowCount}")
                    </FluentButton>
                </div>
            </MoreTemplate>
            <OverflowTemplate Context="overflow">
                @{
                    var items = overflow.Items;
                }
                <div @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
                    @* Each item is approximately 36px tall, plus 48px for the header and container padding. The popover body has a CSS max-height of 300px. *@
                    <FluentPopover AnchorId="@overflow.IdMoreButton"
                                   @bind-Opened="_popoverVisible"
                                   Class="content-list-popover url-overflow-popover"
                                   Style="@($"--url-overflow-anchor: --{overflow.IdMoreButton};")">
                        <strong>@Loc[nameof(Resources.Columns.UrlsColumnDisplayOverflowTitle)]</strong>
                        <div class="content-list-popover-items url-popup">
                            @foreach (var item in items)
                            {
                                <div class="url-link">
                                    @WriteExpandedUrl(item)
                                </div>
                            }
                        </div>
                    </FluentPopover>
                </div>
            </OverflowTemplate>
        </FluentOverflow>
    </div>
}

@code {
    // Always a link, including for schemes that aren't browsable (e.g. tcp://), so every URL is presented consistently.
    RenderFragment WriteUrl(DisplayedUrl displayedUrl)
    {
        var address = GetTooltipText(displayedUrl);

        return @<a href="@address" target="_blank" title="@address" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">@displayedUrl.Text</a>;
    }

    // In the overflow popover there's no space constraint, so show "{label}: {address}" rather than the compact
    // default display text. The label is the explicit display name if one was set, otherwise the endpoint name
    // (omitted entirely, along with the colon, if there is neither), so no information is lost. The label is kept
    // outside the link so only the address itself is clickable. The address is always a link, including for
    // schemes that aren't browsable (e.g. tcp://), so every address is presented consistently.
    RenderFragment WriteExpandedUrl(DisplayedUrl displayedUrl)
    {
        var label = displayedUrl.DisplayName ?? (displayedUrl.Name != "-" ? displayedUrl.Name : null);
        var labelPrefix = label is not null ? $"{label}: " : null;
        var address = GetTooltipText(displayedUrl);

        return @<text>@labelPrefix<a href="@address" target="_blank" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">@address</a></text>;
    }
}
