@inject IStringLocalizer<Aspire.Dashboard.Resources.ControlsStrings> ControlsLoc
<!DOCTYPE html>
<html lang="@GlobalizationHelpers.GetHtmlLanguageName(System.Globalization.CultureInfo.CurrentUICulture)">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="aspire-version" content="@VersionHelpers.DashboardDisplayVersion" />
    <meta name="dotnet-runtime-version" content="@System.Runtime.InteropServices.RuntimeInformation.FrameworkDescription" />
    <base href="/" />
    <link rel="icon" type="image/x-icon" href="favicon.ico" />
    <link rel="stylesheet" href="_content/Microsoft.FluentUI.AspNetCore.Components/css/reboot.css" />
    <link rel="stylesheet" href="css/design.css" />
    <link rel="stylesheet" href="css/layout.css" />
    <link rel="stylesheet" href="css/highlight.css" />
    <link rel="stylesheet" href="css/markdown.css" />
    <link rel="stylesheet" href="Aspire.Dashboard.styles.css" />
    <script src="js/app-theme-bootstrap.js"></script>

    <HeadOutlet @rendermode="@(new InteractiveServerRenderMode(prerender: false))" />
</head>

<body data-scroll-to-bottom-label="@ControlsLoc[nameof(Aspire.Dashboard.Resources.ControlsStrings.ScrollToBottom)]">
    <Routes @rendermode="@(new InteractiveServerRenderMode(prerender: false))" />
    <ReconnectModal />
    <script src="js/imask-7.6.1.min.js"></script>
    <BlazorScript />
    <script src="js/app.js"></script>
    <script src="js/app-reconnect.js"></script>

    <script src="js/app-theme.js" type="module"></script>
    <script src="_content/Microsoft.FluentUI.AspNetCore.Components/Microsoft.FluentUI.AspNetCore.Components.lib.module.js" type="module"></script>
</body>
</html>
