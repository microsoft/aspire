@namespace Aspire.Dashboard.Components
@using System.Collections.Immutable

@* Deck-styled menu replacing FluentMenu. When open, the menu renders as a fixed-position surface
   positioned in JS (below its anchor, or at the cursor for context menus). Nested items become
   CSS-driven submenus. Dismissal (outside click / Escape) and arrow-key focus live in the colocated
   module (CSP-safe). *@
@if (Open)
{
    <div @ref="_menuElement" class="deck-menu aspire-menu-container" role="menu" style="@MenuStyle">
        @foreach (var item in Items)
        {
            @RenderMenuItem(item)
        }
    </div>
}

@code {
    private RenderFragment RenderMenuItem(MenuButtonItem item)
    {
        if (item.IsDivider)
        {
            return @<div class="deck-menu__divider" role="separator"></div>;
        }

        var tooltip = !string.IsNullOrEmpty(item.Tooltip) ? item.Tooltip : item.Text ?? string.Empty;
        var attributes = new Dictionary<string, object>(item.AdditionalAttributes ?? ImmutableDictionary<string, object>.Empty)
        {
            ["title"] = tooltip
        };
        var hasSubmenu = item.NestedMenuItems is { Count: > 0 };

        if (hasSubmenu)
        {
            return @<div class="deck-menu__item-wrapper">
                <button type="button" id="@item.Id" class="deck-menu__item deck-menu__item--has-submenu @item.Class" role="menuitem"
                        aria-haspopup="true" disabled="@item.IsDisabled" @attributes="attributes">
                    @RenderItemContent(item)
                    <DeckIcon Name="DeckIconName.ChevronDown" Size="14" Class="deck-menu__submenu-chevron" />
                </button>
                <div class="deck-menu__submenu" role="menu">
                    @foreach (var nestedItem in item.NestedMenuItems!)
                    {
                        @RenderMenuItem(nestedItem)
                    }
                </div>
            </div>;
        }

        return @<button type="button" id="@item.Id" class="deck-menu__item @item.Class" role="menuitem"
                        disabled="@item.IsDisabled" @onclick="() => HandleItemClicked(item)" @attributes="attributes">
            @RenderItemContent(item)
        </button>;
    }

    private RenderFragment RenderItemContent(MenuButtonItem item) => @<text>
        @if (item.Icon is { } iconName)
        {
            <span class="deck-menu__item-icon">
                <DeckIcon Name="iconName" Size="16" Style="vertical-align: text-bottom;" />
            </span>
        }
        <span class="deck-menu__item-text">@item.Text</span>
    </text>;
}
