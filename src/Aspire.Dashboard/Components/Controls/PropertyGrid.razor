@using Aspire.Dashboard.Components.Controls.Grid
@using Aspire.Dashboard.Resources
@typeparam TItem where TItem : IPropertyGridItem
@inject IStringLocalizer<ControlsStrings> Loc

@{
    var (nameWidth, valueWidth) = GetColumnWidths();
}
<div class="property-grid">
    <table class="@TableCssClass">
        <colgroup>
            <col style="width: @nameWidth" />
            <col style="width: @valueWidth" />
        </colgroup>
        @if (GenerateHeader != GridHeaderMode.None)
        {
            <thead class="@(GenerateHeader == GridHeaderMode.Sticky ? "sticky" : null)">
                <tr>
                    <th class="nameColumn" aria-sort="@GetAriaSort(0)">
                        @if (IsNameSortable)
                        {
                            <button type="button" class="column-sort-button" @onclick="() => OnHeaderClicked(0)">
                                <span>@NameColumnTitleText</span>
                                @if (_sortColumnIndex == 0)
                                {
                                    <DeckIcon Name="@(_sortAscending ? DeckIconName.ArrowUp : DeckIconName.ArrowDown)" Size="12" />
                                }
                            </button>
                        }
                        else
                        {
                            @NameColumnTitleText
                        }
                    </th>
                    <th class="valueColumn" aria-sort="@GetAriaSort(1)">
                        @if (IsValueSortable)
                        {
                            <button type="button" class="column-sort-button" @onclick="() => OnHeaderClicked(1)">
                                <span>@ValueColumnTitleText</span>
                                @if (_sortColumnIndex == 1)
                                {
                                    <DeckIcon Name="@(_sortAscending ? DeckIconName.ArrowUp : DeckIconName.ArrowDown)" Size="12" />
                                }
                            </button>
                        }
                        else
                        {
                            @ValueColumnTitleText
                        }
                    </th>
                </tr>
            </thead>
        }
        <tbody>
            @foreach (var context in GetSortedItems())
            {
                <tr @key="ItemKey(context)">
                    <td class="nameColumn">
                        <GridValue ValueDescription="@NameColumnTitleText"
                                   Value="@context.Name"
                                   EnableHighlighting="@(!string.IsNullOrEmpty(HighlightText))"
                                   HighlightText="@HighlightText" />
                    </td>
                    <td class="valueColumn@(Multiline ? " multiline-text" : "")">
                        <GridValue ValueDescription="@(context.Name ?? ValueColumnTitleText)"
                                   Value="@context.Value"
                                   ContentAfterValue="@GetContentAfterValue(context)"
                                   EnableHighlighting="@(!string.IsNullOrEmpty(HighlightText))"
                                   HighlightText="@HighlightText"
                                   EnableMasking="@context.IsValueSensitive"
                                   IsMasked="@context.IsValueMasked"
                                   IsMaskedChanged="(isMasked) => OnIsValueMaskedChanged(context, isMasked)"
                                   TextVisualizerTitle="@context.Name"
                                   ValueToVisualize="@(context.ValueToVisualize ?? context.Value)"
                                   ComponentMetadata="@GetComponentMetadata(context)" />
                        @ExtraValueContent(context)
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
