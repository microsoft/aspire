@namespace Aspire.Dashboard.Components
@using System.Collections.Immutable
@using DialogsResources = Aspire.Dashboard.Resources.Dialogs
@using Aspire.DashboardService.Proto.V1

@{
    var descriptionId = !string.IsNullOrEmpty(InputViewModel.Input.Description)
        ? $"{ForId}-description"
        : null;
}

@if (InputViewModel.Input.InputType != InputType.Boolean)
{
    <label class="interaction-input-label aspire-field-label" for="@ForId">
        @InputViewModel.Input.Label
        @if (InputViewModel.Input.Required)
        {
            <span id="@($"{ForId}-required")" role="img" aria-label="@Loc[nameof(DialogsResources.FieldRequired)]" class="input-label-required">*</span>
        }
    </label>
}
<div class="input-line-container aspire-field-row">
    @ChildContent(new InteractionInputFieldContext { ViewModel = InputViewModel, DescriptionId = descriptionId })
    @if (InputViewModel.Input.Loading)
    {
        <AspireProgressRing Width="20px" Class="input-progress" AriaLabel="@ControlsLoc[nameof(Aspire.Dashboard.Resources.ControlsStrings.Loading)]" />
    }
</div>
@GetDescriptionContent(InputViewModel.Input, descriptionId)

@code {
    private RenderFragment? GetDescriptionContent(InteractionInput vm, string? id)
    {
        @if (!string.IsNullOrEmpty(vm.Description))
        {
            return
            @<div class="input-description" id="@id">
            @if (vm.EnableDescriptionMarkdown)
            {
                <MarkdownRenderer MarkdownProcessor="@MarkdownProcessor" Markdown="@vm.Description" SuppressParagraphOnNewLines="true" />
            }
            else
            {
                <span>@vm.Description</span>
            }
            </div>;
        }
        return null;
    }
}
