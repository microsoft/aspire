@namespace Aspire.Dashboard.Components.Controls

<div class="terminal-view @(Chromeless ? "terminal-chromeless" : null)">
    <div hidden @ref="_selectionTemplateElement">
        <div class="terminal-selection-actions">
            <FluentButton Class="terminal-selection-copy"
                          Appearance="ButtonAppearance.Default"
                          IconOnly="true"
                          data-tooltip="@ControlsLoc[nameof(Resources.ControlsStrings.GridValueCopyToClipboard)]"
                          aria-label="@ControlsLoc[nameof(Resources.ControlsStrings.GridValueCopyToClipboard)]">
                <FluentIcon Value="new Icons.Regular.Size16.Copy()" Width="12px" Color="Color.Default" />
            </FluentButton>
        </div>
    </div>
    <div class="terminal-frame">
        @if (!Chromeless)
        {
            <div class="terminal-titlebar">
                <TerminalTitle State="@_state" IdleIcon="@ResourceIcon" FallbackTitle="@(WindowResourceName ?? ResourceName ?? Loc[nameof(Resources.TerminalStrings.TerminalTitle)].Value)" />
                @if (ShowOpenInWindow && !string.IsNullOrEmpty(ResourceName))
                {
                    <TerminalWindowButton Class="terminal-open-window"
                                          Label="@Loc[nameof(Resources.TerminalStrings.TerminalToolbarOpenInWindow)]"
                                          TerminalKey="@($"resource:{WindowResourceName ?? ResourceName}")"
                                          Url="@($"{TerminalWindowPathPrefix.Trim('/')}/resource/{Uri.EscapeDataString(WindowResourceName ?? ResourceName)}")"
                                          FontSize="@FontSize" />
                }
            </div>
        }
        <div class="terminal-body @(_state.Disconnected ? "terminal-disconnected" : null)">
            <div class="terminal-container" @ref="_terminalElement"></div>
            @if (_state.Disconnected || _terminalError is not null)
            {
                <div class="terminal-overlays @(ShowDisconnectedRecovery && _bannerCollapsed && ConnectionError is not "renderer-failed" ? "terminal-overlays-collapsed" : null)">
                    @if (ShowDisconnectedRecovery)
                    {
                        <TerminalDisconnectedBanner @key="ResourceName" ResourceName="@ResourceName" ReadOnly="@ReadOnly" OnClose="@OnClose"
                                                    OutputUnavailable="@(ConnectionError is "renderer-failed")"
                                                    OnRestarted="@ReconnectAfterRestartAsync"
                                                    OnReconnect="@(_state.RetriesExhausted ? EventCallback.Factory.Create(this, RetryAsync) : default)"
                                                    OnCollapsedChanged="@(collapsed => _bannerCollapsed = collapsed)" />
                    }
                    @if (ConnectionError is "mount-failed" && _terminalError is not "mount-failed")
                    {
                        <div class="terminal-error">
                            <span role="alert">@GetErrorMessage(ConnectionError)</span>
                            <FluentButton Appearance="ButtonAppearance.Default" OnClick="RetryAsync">@Loc[nameof(Resources.TerminalStrings.TerminalRetry)]</FluentButton>
                        </div>
                    }
                    @if (_terminalError is not null && !(ShowDisconnectedRecovery && _terminalError is "disconnected" or "renderer-failed"))
                    {
                        <div class="terminal-error">
                            <span role="alert">@GetErrorMessage(_terminalError)</span>
                            @if (_terminalError is "input-failed" or "sizing-failed" or "palette-failed")
                            {
                                <FluentButton Appearance="ButtonAppearance.Default" OnClick="DismissErrorAsync">@Loc[nameof(Resources.TerminalStrings.TerminalDismissError)]</FluentButton>
                            }
                            else
                            {
                                <FluentButton Appearance="ButtonAppearance.Default" OnClick="RetryAsync">@Loc[nameof(Resources.TerminalStrings.TerminalRetry)]</FluentButton>
                            }
                        </div>
                    }
                </div>
            }
        </div>
        <div class="terminal-footer" tabindex="-1" @ref="_footerElement">
            <span class="terminal-focus-hint"><kbd>F6</kbd>: @Loc[nameof(Resources.TerminalStrings.TerminalFocusControlsDescription)]</span>
            <div class="terminal-controls">
                <div class="terminal-font-controls">
                    <FluentButton Class="terminal-font-minus toolbar-button aspire-icon-button" Appearance="ButtonAppearance.Transparent" IconOnly="true" Disabled="@(!_state.CanDecreaseFontSize || ReadOnly)"
                                  data-tooltip="@Loc[nameof(Resources.TerminalStrings.TerminalToolbarDecreaseFontSize)]"
                                  aria-label="@Loc[nameof(Resources.TerminalStrings.TerminalToolbarDecreaseFontSize)]"
                                  OnClick="@(() => SetFontSizeAsync(_state.FontPx - 1))">
                        <FluentIcon Icon="Icons.Regular.Size16.Subtract" Color="Color.Primary" />
                    </FluentButton>
                    <span class="terminal-font-size">@(_state.FontPx > 0 ? $"{_state.FontPx}px" : null)</span>
                    <FluentButton Class="terminal-font-plus toolbar-button aspire-icon-button" Appearance="ButtonAppearance.Transparent" IconOnly="true" Disabled="@(!_state.CanIncreaseFontSize || ReadOnly)"
                                  data-tooltip="@Loc[nameof(Resources.TerminalStrings.TerminalToolbarIncreaseFontSize)]"
                                  aria-label="@Loc[nameof(Resources.TerminalStrings.TerminalToolbarIncreaseFontSize)]"
                                  OnClick="@(() => SetFontSizeAsync(_state.FontPx + 1))">
                        <FluentIcon Icon="Icons.Regular.Size16.Add" Color="Color.Primary" />
                    </FluentButton>
                </div>
                @if (ShowDimensionsPicker)
                {
                    <div class="terminal-size-controls">
                        <FluentButton Class="terminal-fit toolbar-button aspire-icon-button" Appearance="ButtonAppearance.Transparent" IconOnly="true" Disabled="@(!_state.FitEnabled || ReadOnly)"
                                      data-tooltip="@Loc[nameof(Resources.TerminalStrings.TerminalToolbarGridSizeAuto)]"
                                      aria-label="@Loc[nameof(Resources.TerminalStrings.TerminalToolbarGridSizeAuto)]"
                                      OnClick="FitToContainerAsync">
                            <FluentIcon Icon="Icons.Regular.Size20.ArrowExpand" Width="16px" Color="Color.Primary" />
                        </FluentButton>
                        <label class="terminal-select-label" for="@_sizeSelectId">@Loc[nameof(Resources.TerminalStrings.TerminalSizeLabel)]</label>
                        <FluentSelect TOption="TerminalSizePreset" TValue="string" Id="@_sizeSelectId" Class="terminal-size-select aspire-input" Items="@DisplayedSizePresets"
                                      OptionValue="@(p => p.Value)"
                                      OptionText="@(p => p.Label)"
                                      Value="@_state.SizeKey" ValueChanged="@(value => SetSizeModeAsync(value ?? string.Empty))"
                                      AriaLabel="@Loc[nameof(Resources.TerminalStrings.TerminalToolbarGridSize)]"
                                      Disabled="@(!_state.SizeSelectEnabled || ReadOnly)" />
                    </div>
                }
                <div class="terminal-palette-controls">
                    <label class="terminal-select-label" for="@_paletteSelectId">@Loc[nameof(Resources.TerminalStrings.TerminalPaletteLabel)]</label>
                    <FluentSelect @key="_paletteResetVersion" TOption="string" TValue="string" Id="@_paletteSelectId" Class="terminal-palette-select aspire-input"
                                  Items="@s_paletteChoices" OptionText="@GetPaletteLabel"
                                  Value="@_state.Palette" ValueChanged="SetPaletteAsync"
                                  Disabled="@(_terminalId == 0)"
                                  Title="@Loc[nameof(Resources.TerminalStrings.TerminalPalette)]"
                                  AriaLabel="@Loc[nameof(Resources.TerminalStrings.TerminalPalette)]" />
                </div>
            </div>
        </div>
    </div>
</div>
