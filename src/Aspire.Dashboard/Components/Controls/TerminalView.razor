@namespace Aspire.Dashboard.Components.Controls

<div class="terminal-view @(Chromeless ? "terminal-chromeless" : null)">
    <div hidden @ref="_selectionTemplateElement">
        <div class="terminal-selection-actions">
            <FluentButton Class="terminal-selection-copy"
                          Appearance="ButtonAppearance.Default"
                          IconOnly="true"
                          Title="@ControlsLoc[nameof(Resources.ControlsStrings.GridValueCopyToClipboard)]"
                          aria-label="@ControlsLoc[nameof(Resources.ControlsStrings.GridValueCopyToClipboard)]">
                <FluentIcon Value="new Icons.Regular.Size16.Copy()" Color="Color.Default" />
            </FluentButton>
        </div>
    </div>
    <div class="terminal-frame">
        @if (!Chromeless)
        {
            <div class="terminal-titlebar">
                <span class="terminal-title">@(ResourceName ?? Loc[nameof(Resources.ConsoleLogs.ConsoleLogsViewTerminalOption)].Value)</span>
                @if (_state.Cols > 0 && _state.Rows > 0)
                {
                    <span class="terminal-dimensions" title="@Loc[nameof(Resources.ConsoleLogs.TerminalToolbarGridSize)]">@_state.Cols &times; @_state.Rows</span>
                }
            </div>
        }
        <div class="terminal-body">
            <div class="terminal-container" @ref="_terminalElement"></div>
            @if (_terminalError is not null)
            {
                <div class="terminal-error">
                    <span role="alert">@GetErrorMessage()</span>
                    <FluentButton OnClick="RetryAsync">@Loc[nameof(Resources.ConsoleLogs.TerminalRetry)]</FluentButton>
                </div>
            }
        </div>
        <div class="terminal-footer" tabindex="-1" @ref="_footerElement">
            <span class="terminal-focus-hint">@(FocusControlsHintLabel ?? Loc[nameof(Resources.ConsoleLogs.TerminalFocusControlsHint)])</span>
            <div class="terminal-controls">
                <FluentButton Class="terminal-font-minus" Disabled="@(!_state.CanDecreaseFontSize || ReadOnly)"
                              Title="@(DecreaseFontSizeLabel ?? Loc[nameof(Resources.ConsoleLogs.TerminalToolbarDecreaseFontSize)])"
                              aria-label="@(DecreaseFontSizeLabel ?? Loc[nameof(Resources.ConsoleLogs.TerminalToolbarDecreaseFontSize)])"
                              OnClick="@(() => SetFontSizeAsync(_state.FontPx - 1))">−</FluentButton>
                <span class="terminal-font-size">@(_state.FontPx > 0 ? $"{_state.FontPx}px" : null)</span>
                <FluentButton Class="terminal-font-plus" Disabled="@(!_state.CanIncreaseFontSize || ReadOnly)"
                              Title="@(IncreaseFontSizeLabel ?? Loc[nameof(Resources.ConsoleLogs.TerminalToolbarIncreaseFontSize)])"
                              aria-label="@(IncreaseFontSizeLabel ?? Loc[nameof(Resources.ConsoleLogs.TerminalToolbarIncreaseFontSize)])"
                              OnClick="@(() => SetFontSizeAsync(_state.FontPx + 1))">+</FluentButton>
                @if (ShowDimensionsPicker)
                {
                    <FluentSelect TOption="TerminalSizePreset" TValue="string" Class="terminal-size-select" Items="@_sizePresets"
                                  OptionValue="@(p => p.Value)"
                                  OptionText="@(p => p.Value == "auto" ? FitLabel ?? Loc[nameof(Resources.ConsoleLogs.TerminalToolbarGridSizeAuto)].Value : p.Label)"
                                  Value="@_state.SizeKey" ValueChanged="@(value => SetSizeModeAsync(value ?? "auto"))"
                                  Disabled="@(!_state.SizeSelectEnabled || ReadOnly)"
                                  aria-label="@(TerminalDimensionsLabel ?? Loc[nameof(Resources.ConsoleLogs.TerminalToolbarGridSize)])" />
                }
            </div>
        </div>
    </div>
</div>
