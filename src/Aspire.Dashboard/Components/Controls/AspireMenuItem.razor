@namespace Aspire.Dashboard.Components

@if (Item.IsDivider)
{
    <FluentDivider />
}
else if (Item.IsHeader)
{
    @* Non-interactive label identifying what the menu is for (e.g. the resource a graph
       context menu was opened on). role="presentation" keeps it out of the menu's item
       semantics (matching the FluentDivider above) so it isn't announced as a menu item
       or reached by keyboard navigation. *@
    <div id="@Item.Id" class="aspire-menu-header" role="presentation">
        @if (Item.Icon is not null)
        {
            <FluentIcon Value="@Item.Icon" Width="16px" Class="aspire-menu-header-icon" Color="Color.Primary" />
        }
        <span class="aspire-menu-header-text" data-tooltip="@Item.Text">@Item.Text</span>
    </div>
}
else if (Item.IsGroupHeader)
{
    <div id="@Item.Id" class="aspire-menu-group-header" role="presentation">
        <span class="aspire-menu-header-text" data-tooltip="@Item.Text">@Item.Text</span>
    </div>
}
else if (Item.IsEmptyGroupText)
{
    <div id="@Item.Id" class="aspire-menu-empty-group-text" role="presentation">@Item.Text</div>
}
else
{
    RenderFragment? nestedMenuItems = null;
    if (Item.NestedMenuItems is { Count: > 0 } nestedItems)
    {
        nestedMenuItems = @<text>
            @foreach (var nestedItem in nestedItems)
            {
                <AspireMenuItem @key="nestedItem.RenderKey"
                                Item="nestedItem"
                                OnItemActivated="OnItemActivated"
                                OnSecondaryActionClicked="OnSecondaryActionClicked"
                                OnItemToggled="OnItemToggled" />
            }
        </text>;
    }

    <FluentMenuItem Id="@Item.Id"
                    Class="@Item.Class"
                    OnClick="HandleItemClicked"
                    CheckedChanged="HandleItemCheckedChanged"
                    Disabled="@Item.IsDisabled"
                    Role="@Item.Role"
                    Checked="@Item.Checked"
                    AdditionalAttributes="@AdditionalMenuItemAttributes"
                    Label="@(Item.StartIcon is null ? Item.Text : null)"
                    MenuItems="@nestedMenuItems">
        @if (Item.Icon is not null)
        {
            <span slot="@GetIconSlot(Item.Role)">
                <FluentIcon Value="@Item.Icon" Style="vertical-align: text-bottom;" Width="16px" Color="Color.Primary" />
            </span>
        }
        @if (Item.StartIcon is not null)
        {
            @* Rendered inline with the text rather than in the "start" slot: FluentUI only sizes the
               start column when it computes an extra indent for the whole list, so a slotted icon on a
               single checkable item would overlap its checkmark indicator. *@
            <span class="aspire-menu-item-label">
                <FluentIcon Value="@Item.StartIcon" Width="12px" Color="@Item.StartIconColor" />
                @Item.Text
            </span>
        }
        @if (Item.Description is not null || Item.SecondaryActionIcon is not null)
        {
            <span class="aspire-menu-secondary-action-container" slot="end">
                @if (Item.Description is not null)
                {
                    <span class="aspire-menu-item-description">@Item.Description</span>
                }
                @if (Item.SecondaryActionIcon is not null)
                {
                    <FluentButton Id="@SecondaryActionId"
                                  Class="@($"aspire-menu-secondary-action{(Item.IsSecondaryActionSelected ? " selected" : null)}")"
                                  Appearance="ButtonAppearance.Transparent"
                                  data-tooltip="@Item.SecondaryActionAriaLabel"
                                  aria-label="@Item.SecondaryActionAriaLabel"
                                  aria-pressed="@(Item.IsSecondaryActionSelected ? "true" : "false")"
                                  @onclick="HandleSecondaryActionClicked">
                        <FluentIcon Value="@Item.SecondaryActionIcon" Width="16px" Color="Color.Primary" />
                    </FluentButton>
                }
            </span>
        }
    </FluentMenuItem>
}
