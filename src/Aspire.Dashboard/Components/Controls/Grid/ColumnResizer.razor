@* Wires up Deck column resizing for the immediately preceding data grid. The marker gives the
   component its own stable ElementReference; a parent ElementReference passed as a child parameter
   is still its default value when parameters are assigned. Cleans up the JS listeners on disposal. *@
@namespace Aspire.Dashboard.Components.Controls.Grid
@implements IAsyncDisposable
@inject IJSRuntime JS

<span hidden aria-hidden="true" @ref="_marker"></span>

@code {
    private readonly string _resizerId = $"grid-resizer-{Guid.NewGuid():N}";
    private IJSObjectReference? _module;
    private ElementReference _marker;
    private bool _initialized;

    /// <summary>
    /// When resizing a CSS-grid container (rather than a table), the name of the CSS custom property
    /// that holds the grid-template-columns value (e.g. <c>--trace-grid-columns</c>).
    /// </summary>
    [Parameter]
    public string? GridColumnsVariable { get; set; }

    /// <summary>Minimum column width, in pixels.</summary>
    [Parameter]
    public int MinWidth { get; set; } = 48;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_initialized)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Controls/Grid/ColumnResizer.razor.js");
            await _module.InvokeVoidAsync("initialize", _marker, new
            {
                id = _resizerId,
                minWidth = MinWidth,
                gridColumnsVar = GridColumnsVariable
            });
            _initialized = true;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("dispose", _resizerId);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Circuit already gone; nothing to clean up.
            }
        }
    }
}
