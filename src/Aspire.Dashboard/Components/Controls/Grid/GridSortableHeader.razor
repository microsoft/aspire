@* Renders a header cell for a Deck data table. When sortable, the cell is a borderless button that
   toggles client-side sorting and shows an ascending/descending arrow. When resizable, a focusable
   separator handle is rendered on the cell's trailing edge that the ColumnResizer wires up for
   pointer/keyboard resizing. Sort state is owned by the parent component. *@
@namespace Aspire.Dashboard.Components.Controls.Grid

<th class="@ThClass" aria-sort="@AriaSort">
    @if (Sortable)
    {
        <button type="button" class="column-sort-button" @onclick="OnClick">
            <span>@Title</span>
            @if (IsSorted)
            {
                <DeckIcon Name="@(Ascending ? DeckIconName.ArrowUp : DeckIconName.ArrowDown)" Size="12" />
            }
        </button>
    }
    else
    {
        @Title
    }
    @if (Resizable)
    {
        <ColumnResizeHandle ColumnIndex="@ColumnIndex" Label="@ResizeLabel" />
    }
</th>

@code {
    [Parameter]
    public string? Title { get; set; }

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public bool Sortable { get; set; } = true;

    [Parameter]
    public bool IsSorted { get; set; }

    [Parameter]
    public bool Ascending { get; set; } = true;

    [Parameter]
    public EventCallback OnClick { get; set; }

    /// <summary>Whether this header renders a trailing-edge resize handle.</summary>
    [Parameter]
    public bool Resizable { get; set; }

    /// <summary>Zero-based index of this column; the handle resizes columns <c>ColumnIndex</c> and <c>ColumnIndex + 1</c>.</summary>
    [Parameter]
    public int ColumnIndex { get; set; }

    /// <summary>Localized accessible label for the resize handle.</summary>
    [Parameter]
    public string? ResizeLabel { get; set; }

    // The resize handle is absolutely positioned against the header cell.
    private string? ThClass => string.IsNullOrEmpty(Class)
        ? (Resizable ? "resizable-column" : null)
        : (Resizable ? $"{Class} resizable-column" : Class);

    // aria-sort is only meaningful on sortable columns; omit it entirely otherwise so non-sortable
    // headers don't advertise a sort affordance they don't have.
    private string? AriaSort => !Sortable ? null : !IsSorted ? "none" : Ascending ? "ascending" : "descending";
}
