@using Aspire.Dashboard.Resources
@inject IStringLocalizer<ControlsStrings> Loc

<FluentButton Class="toolbar-button detail-page-close"
              Appearance="ButtonAppearance.Default"
              IconOnly="true"
              IconStart="@(new Icons.Regular.Size20.Dismiss())"
              OnClick="@CloseAsync"
              data-parent-url="@ParentUrl"
              data-tooltip="@Loc[ClosesOnEscape ? nameof(ControlsStrings.SummaryDetailsViewCloseViewWithShortcut) : nameof(ControlsStrings.SummaryDetailsViewCloseView)]"
              aria-label="@Loc[nameof(ControlsStrings.SummaryDetailsViewCloseView)]"
              aria-keyshortcuts="@(ClosesOnEscape ? "Escape" : null)" />
