@if (_showUserProfileMenu)
{
    <AuthorizeView>
        <Authorized>
            <div class="profile-menu-container">
                <details>
                    <summary title="@_name" aria-label="@_name">@_initials</summary>
                    <div>
                        <div>@Loc[nameof(Resources.Login.LoggedInAs)]</div>
                        <div class="full-name">@_name</div>
                        <div class="user-id">@_username</div>
                        <form @formname="sign-out-form" class="sign-out-form" action="authentication/logout" method="post">
                            <AntiforgeryToken />
                            <FluentButton Appearance="ButtonAppearance.Default" Type="ButtonType.Submit">Sign out</FluentButton>
                        </form>
                    </div>
                </details>
            </div>
        </Authorized>
    </AuthorizeView>
}
