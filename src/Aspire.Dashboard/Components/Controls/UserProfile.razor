@if (_showUserProfileMenu)
{
    <AuthorizeView>
        <Authorized>
            <div class="profile-menu-container" style="--profile-button-size: @ButtonSize; --profile-image-size: @ImageSize;">
                <FluentButton Id="@_profileButtonId"
                              Class="profile-menu-button"
                              Appearance="ButtonAppearance.Transparent"
                              IconOnly="true"
                              OnClick="@(() => _profileMenuOpen = !_profileMenuOpen)"
                              Title="@_name"
                              aria-label="@_name"
                              aria-haspopup="dialog"
                              aria-expanded="@_profileMenuOpen.ToString().ToLowerInvariant()">
                    <span class="profile-initials">@_initials</span>
                </FluentButton>
                <FluentPopover AnchorId="@_profileButtonId" @bind-Opened="_profileMenuOpen" Class="profile-menu-popover">
                    <div class="profile-popover-content">
                        <div class="profile-popover-header">
                            <span>@Loc[nameof(Resources.Login.LoggedInAs)]</span>
                            <form @formname="sign-out-form" class="sign-out-form" action="authentication/logout" method="post">
                                <AntiforgeryToken />
                                <FluentButton Appearance="ButtonAppearance.Subtle" Type="ButtonType.Submit">@Loc[nameof(Resources.Login.SignOut)]</FluentButton>
                            </form>
                        </div>
                        <div class="profile-persona">
                            <div class="profile-avatar" aria-hidden="true">@_initials</div>
                            <div class="profile-identity">
                                <div class="full-name">@_name</div>
                                <div class="user-id">@_username</div>
                            </div>
                        </div>
                    </div>
                </FluentPopover>
            </div>
        </Authorized>
    </AuthorizeView>
}
