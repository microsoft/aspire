@if (_showUserProfileMenu)
{
    <AuthorizeView>
        <Authorized>
            <div class="profile-menu-container">
                @* A native <details> gives a keyboard-accessible, JS-free dropdown, replacing
                   ProfileMenu for the Deck redesign. *@
                <details class="deck-profile-menu">
                    <summary class="deck-profile-menu__trigger" title="@_name" aria-label="@_name">
                        <span class="deck-avatar" style="width: @ButtonSize; height: @ButtonSize;">@_initials</span>
                    </summary>
                    <div class="deck-profile-menu__panel">
                        <div class="deck-stack" style="align-items: center;">
                            <Label>@Loc[nameof(Resources.Login.LoggedInAs)]</Label>
                            <div class="deck-spacer"></div>
                            <form @formname="sign-out-form" class="sign-out-form" action="authentication/logout" method="post">
                                <AntiforgeryToken />
                                <button type="submit" class="btn btn--ghost">Sign out</button>
                            </form>
                        </div>
                        <div class="deck-stack inner-persona-container">
                            <span class="deck-avatar inner-persona" style="width: @ImageSize; height: @ImageSize;">@_initials</span>
                            <div>
                                <div class="full-name">@_name</div>
                                <div class="user-id">@_username</div>
                            </div>
                        </div>
                    </div>
                </details>
            </div>
        </Authorized>
    </AuthorizeView>
}
