@using Aspire.Dashboard.Resources
@inject IStringLocalizer<ControlsStrings> Loc

<FluentButton Appearance="ButtonAppearance.Default"
              Class="pause-incoming-data-button"
              Disabled="@Disabled"
              Title="@(IsPaused ? Loc[nameof(ControlsStrings.ResumeButtonTitle)] : Loc[nameof(ControlsStrings.PauseButtonTitle)])"
              OnClick="@OnTogglePauseCoreAsync">
    @if (IsPaused)
    {
        <FluentIcon Value="@(new Icons.Regular.Size16.PauseOff())" Color="Color.Primary" />
    }
    else
    {
        <FluentIcon Value="@(new Icons.Regular.Size16.Pause())" Color="Color.Primary" />
    }
</FluentButton>
