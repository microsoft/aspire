@namespace Aspire.Dashboard.Components.Controls

<div class="pause-warning" data-tooltip="@AbsoluteTooltip">
    <div class="pause-warning-icon">
        <FluentIcon Value="new Icons.Filled.Size16.Warning()" Width="12px" Color="Color.Custom" CustomColor="currentColor" />
    </div>

    <div class="pause-warning-message">
        <span class="pause-warning-title">@PauseWarningText</span> @RelativeAge
    </div>
</div>
