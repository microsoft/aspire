@using Aspire.Dashboard.Model
@using Aspire.Dashboard.Resources
@inject Microsoft.FluentUI.AspNetCore.Components.INotificationService NotificationService
@inject IStringLocalizer<Dialogs> Loc
@inject NavigationManager NavigationManager

<div role="alert" class="dashboard-message-bar @IntentClass">
    <div class="dashboard-message-bar-icon">
        <FluentIcon Value="@IntentIcon" Color="@IntentColor" />
    </div>
    <div class="dashboard-message-bar-content">
        @if (!string.IsNullOrEmpty(Content.Title))
        {
            <span class="dashboard-message-bar-title">@Content.Title</span>
        }
        <span class="dashboard-message-bar-message @(Content.UseMarkupString ? "markdown-container" : null)">
            @if (Content.UseMarkupString)
            {
                @((MarkupString)Content.Message.TrimEnd())
            }
            else
            {
                @Content.Message.TrimEnd()
            }
        </span>
        @if (!Content.LinkAsAction && !string.IsNullOrEmpty(Content.LinkText) && !string.IsNullOrEmpty(Content.LinkUrl))
        {
            @* Message bar links are specified by application code, so they don't need automatic URL sanitization. *@
            <span class="dashboard-message-bar-link">
                <a href="@Content.LinkUrl" target="_blank" rel="noreferrer noopener" @onclick="OnLinkClickAsync">@Content.LinkText</a>
            </span>
        }
    </div>
    <div class="dashboard-message-bar-actions">
        @if (Content.LinkAsAction && !string.IsNullOrEmpty(Content.LinkText) && !string.IsNullOrEmpty(Content.LinkUrl))
        {
            var isExternal = IsExternalUrl(Content.LinkUrl);
            <a class="dashboard-message-bar-link-action"
               href="@Content.LinkUrl"
               target="@(isExternal ? "_blank" : null)"
               rel="@(isExternal ? "noreferrer noopener" : null)"
               @onclick="OnLinkClickAsync">@Content.LinkText</a>
        }
        @if (!string.IsNullOrEmpty(Content.PrimaryAction))
        {
            <FluentButton Class="aspire-compact-button aspire-neutral-button dashboard-message-bar-action" OnClick="@OnPrimaryActionAsync">@Content.PrimaryAction</FluentButton>
        }
        @if (!string.IsNullOrEmpty(Content.SecondaryAction))
        {
            <FluentButton Class="aspire-compact-button aspire-neutral-button dashboard-message-bar-action" OnClick="@(() => CloseAsync(false))">@Content.SecondaryAction</FluentButton>
        }
        @if (Content.AllowDismiss)
        {
            <FluentButton Class="dashboard-message-bar-dismiss" OnClick="@(() => CloseAsync(null))" aria-label="@Loc[nameof(Dialogs.NotificationEntryDismiss)]">
                <FluentIcon Value="@(new Icons.Regular.Size16.Dismiss())" Color="@Color.Default" />
            </FluentButton>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public required DashboardMessageBarContent Content { get; set; }

    [CascadingParameter]
    public required IMessageBarInstance MessageBar { get; set; }

    private Icon IntentIcon => MessageBar.Options.Intent switch
    {
        MessageBarIntent.Success => new Icons.Filled.Size20.CheckmarkCircle(),
        MessageBarIntent.Error => new Icons.Filled.Size20.DismissCircle(),
        MessageBarIntent.Warning => new Icons.Filled.Size20.Warning(),
        _ => new Icons.Filled.Size20.Info()
    };

    private Color IntentColor => MessageBar.Options.Intent switch
    {
        MessageBarIntent.Success => Color.Success,
        MessageBarIntent.Error => Color.Error,
        MessageBarIntent.Warning => Color.Warning,
        _ => Color.Info
    };

    private string IntentClass => MessageBar.Options.Intent switch
    {
        MessageBarIntent.Success => "intent-success",
        MessageBarIntent.Error => "intent-error",
        MessageBarIntent.Warning => "intent-warning",
        _ => "intent-info"
    };

    private Task OnPrimaryActionAsync()
    {
        if (Content.PrimaryActionUrl is { } url)
        {
            NavigationManager.NavigateTo(url);
            return Task.CompletedTask;
        }

        return CloseAsync(true);
    }

    // The browser follows the link natively, so it opens without being popup-blocked. This handler only runs
    // afterward on the server and doesn't prevent the navigation.
    private Task OnLinkClickAsync()
    {
        return Content.CloseOnLinkClick ? CloseAsync(true) : Task.CompletedTask;
    }

    // Only http(s) is treated as external. A dashboard-relative path such as "/resources" also parses as an
    // absolute file:// URI on Unix, so the scheme check is required rather than relying on UriKind.Absolute.
    private static bool IsExternalUrl(string url)
    {
        return Uri.TryCreate(url, UriKind.Absolute, out var uri) && (uri.Scheme == Uri.UriSchemeHttp || uri.Scheme == Uri.UriSchemeHttps);
    }

    private Task CloseAsync(object? data)
    {
        return NotificationService.CloseAsync(MessageBar, data);
    }
}
