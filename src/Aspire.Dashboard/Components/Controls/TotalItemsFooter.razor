@namespace Aspire.Dashboard.Components

<div class="items-footer">
    <span class="result-count" aria-live="polite" aria-atomic="true">
        @if (DisplayedItemCount is { } displayedItemCount && displayedItemCount < TotalItemCount && PartialText is not null)
        {
            @((MarkupString)string.Format(CultureInfo.CurrentCulture, PartialText, displayedItemCount.ToString("N0", CultureInfo.CurrentCulture), TotalItemCount.ToString("N0", CultureInfo.CurrentCulture)))
        }
        else
        {
            @((MarkupString)string.Format(CultureInfo.CurrentCulture, TotalItemCount == 1 ? SingularText : PluralText, TotalItemCount.ToString("N0", CultureInfo.CurrentCulture)))
        }
    </span>

    @if (PauseText is not null)
    {
        <PauseWarning PauseText="@PauseText" />
    }
</div>
