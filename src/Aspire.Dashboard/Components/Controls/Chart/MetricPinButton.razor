@namespace Aspire.Dashboard.Components

@using MetricsResources = Aspire.Dashboard.Resources.Metrics

@{
    var label = _isPinned ? Loc[nameof(MetricsResources.MetricsUnpinInstrument)] : Loc[nameof(MetricsResources.MetricsPinInstrument)];
}

@* The bordered variant matches the dashboard's other header icon buttons (word wrap, close): a square
   bordered button that turns primary while active. Cards use the quieter transparent variant. *@
<FluentButton Appearance="@(Bordered ? (_isPinned ? ButtonAppearance.Primary : ButtonAppearance.Default) : ButtonAppearance.Transparent)"
              IconOnly="true"
              Class="@($"metric-pin-button{(Bordered ? " aspire-button" : null)}{(_isPinned ? " pinned" : null)} {Class}")"
              data-tooltip="@label"
              aria-label="@label"
              aria-pressed="@(_isPinned ? "true" : "false")"
              OnClick="TogglePinnedAsync">
    <FluentIcon Value="@(_isPinned ? s_pinnedIcon : s_unpinnedIcon)" Color="Color.Custom" CustomColor="currentColor" />
</FluentButton>
