@namespace Aspire.Dashboard.Components

@using Aspire.Dashboard.Components.Controls.Chart
@using Aspire.Dashboard.Resources
@using Metrics = Aspire.Dashboard.Components.Pages.Metrics
@inject IStringLocalizer<ControlsStrings> Loc

@if (_instrument is null)
{
    <div>@Loc[nameof(ControlsStrings.ChartContainerUnableToDisplay)]</div>
}
else
{
    <div class="metrics-chart">
        <div class="metrics-chart-header">
            <div class="metrics-chart-title">
                @if (BackLabel is not null && OnBackAsync is not null)
                {
                    @* Same square icon button style as the pin, so the title row's actions read as one set. *@
                    <FluentButton Class="aspire-button metrics-chart-back"
                                  Appearance="ButtonAppearance.Default"
                                  IconOnly="true"
                                  IconStart="@(new Icons.Regular.Size16.ChevronLeft())"
                                  OnClick="@OnBackAsync"
                                  data-tooltip="@BackLabel"
                                  aria-label="@BackLabel" />
                }
                <h3>@_instrument.Summary.Name</h3>
                <MetricPinButton InstrumentKey="@_instrument.Summary.GetKey()" Bordered="true" />
            </div>
            <p>@_instrument.Summary.Description</p>

            @if (_instrumentViewModel.HasIncompatibleHistogramBounds)
            {
                <div class="block-warning" role="status">
                    <div class="block-warning-icon">
                        <FluentIcon Value="new Icons.Filled.Size16.Warning()" Color="Color.Warning" />
                    </div>

                    <div class="block-warning-message">
                        @Loc[nameof(ControlsStrings.ChartContainerIncompatibleHistogramBounds)]
                    </div>
                </div>
            }

            @if (_instrumentViewModel.HasOverflow)
            {
                <div class="block-warning">
                    <div class="block-warning-icon">
                        <FluentIcon Value="new Icons.Filled.Size16.ErrorCircle()" Color="Color.Error" />
                    </div>

                    <div class="block-warning-message">
                        <span class="title">@Loc[nameof(ControlsStrings.ChartContainerOverflowTitle)]</span>
                        @Loc[nameof(ControlsStrings.ChartContainerOverflowDescription)]<br/>
                        @((MarkupString)string.Format(ControlsStrings.ChartContainerOverflowLink, "https://aka.ms/aspire/cardinality-limits"))
                    </div>
                </div>
            }
        </div>
        <FluentTabs Class="aspire-content-tabs" ActiveTabId="@($"tab-{_activeView}")" ActiveTabChanged="@OnTabChangeAsync" Size="null">
            <FluentTab HeaderClass="tab-label"
                       Id="@($"tab-{Metrics.MetricViewKind.Graph}")"
                       DeferredLoading="true"
                       aria-label="@Loc[nameof(ControlsStrings.ChartContainerGraphAccessibleLabel)]"
                       Header="@Loc[nameof(ControlsStrings.ChartContainerGraphTab)]"
                       IconStart="@(new Icons.Regular.Size24.DataArea())">
                <div class="metrics-chart-container metric-tab">
                    <PlotlyChart InstrumentViewModel="_instrumentViewModel" Duration="Duration" Resources="Resources" DataEndTime="_dataEndTime" InstrumentChanged="StateHasChanged" />
                    <ChartFilters @key="(MeterName, InstrumentName)" InstrumentType="_instrument.Summary.Type" ShowCount="_instrumentViewModel.ShowCount" ShowCountChanged="ShowCountChangedAsync" IsCounter="@(ShowChangePerIntervalOption && ChartDataCalculator.IsMonotonicCounter(_instrument.Summary))" ShowChangePerInterval="@(!_instrumentViewModel.ShowRunningTotal)" ShowChangePerIntervalChanged="ShowChangePerIntervalChangedAsync" DimensionFilters="@DimensionFilters" OnDimensionValuesChanged="DimensionValuesChangedAsync" />
                </div>
            </FluentTab>
            <FluentTab HeaderClass="tab-label"
                       Id="@($"tab-{Metrics.MetricViewKind.Table}")"
                       DeferredLoading="true"
                       Header="@Loc[nameof(ControlsStrings.ChartContainerTableTab)]"
                       IconStart="@(new Icons.Regular.Size24.Table())">
                <div class="metrics-chart-container metric-tab">
                    <MetricTable InstrumentViewModel="_instrumentViewModel" Duration="Duration" Resources="Resources" DataEndTime="_dataEndTime" InstrumentChanged="StateHasChanged" />
                    <ChartFilters @key="(MeterName, InstrumentName)" InstrumentType="_instrument.Summary.Type" ShowCount="_instrumentViewModel.ShowCount" ShowCountChanged="ShowCountChangedAsync" IsCounter="@(ShowChangePerIntervalOption && ChartDataCalculator.IsMonotonicCounter(_instrument.Summary))" ShowChangePerInterval="@(!_instrumentViewModel.ShowRunningTotal)" ShowChangePerIntervalChanged="ShowChangePerIntervalChangedAsync" DimensionFilters="@DimensionFilters" OnDimensionValuesChanged="DimensionValuesChangedAsync" />
                </div>
            </FluentTab>
        </FluentTabs>
    </div>
}
