@namespace Aspire.Dashboard.Components.Controls

@using Aspire.Dashboard.Resources
@using Aspire.Dashboard.Components.Controls.Grid

@inherits Aspire.Dashboard.Components.Controls.Chart.ChartBase

@{
    // these colors line up with P50/P90/P99 colors for the plotly graph
    var percentileColumns = new List<(int Percentile, string UnderlineColor)> { (50, "#89B5D3"), (90, "#F9B980"), (99, "#8FC98F") };
    var columnCount = ShowPercentiles() ? percentileColumns.Count + 1 : 2;
    if (_exemplars.Count > 0)
    {
        columnCount++;
    }

    var showPercentiles = ShowPercentiles();
    var showValueColumn = !showPercentiles && _metrics.Values.All(value => value is MetricValueView);
    var rows = _metricsView.ToList();
    var columnWidths = GridColumnWidths.Parse(string.Join(" ", Enumerable.Repeat("1fr", columnCount)), columnCount);
}

<div id="metric-table-container" style="height: 40vh; overflow-y: auto; width:1200px;">
    <table class="data metric-table">
        <colgroup>
            @foreach (var width in columnWidths)
            {
                <col style="width: @width" />
            }
        </colgroup>
        <thead>
            <tr>
                <th>@Loc[nameof(ControlsStrings.MetricTableStartColumnHeader)]</th>
                @if (showPercentiles)
                {
                    foreach (var (percentile, _) in percentileColumns)
                    {
                        <th>@((_metricsView.FirstOrDefault() as HistogramMetricView)?.Percentiles[percentile].Name ?? (_instrument is not null ? $"P{percentile} {InstrumentUnitResolver.ResolveDisplayedUnit(_instrument, titleCase: true, pluralize: true)}" : $"P{percentile}"))</th>
                    }
                }
                else if (showValueColumn)
                {
                    <th>@_unitColumnHeader</th>
                }
                @if (_exemplars.Count > 0)
                {
                    <th>@Loc[nameof(ControlsStrings.MetricTableExemplarsColumnHeader)]</th>
                }
            </tr>
        </thead>
        <tbody>
            @if (rows.Count == 0)
            {
                <tr>
                    <td colspan="@columnCount" class="cell-muted" style="text-align: center; padding: 20px;">
                        <DeckIcon Name="DeckIconName.ChartMultiple" Size="24" />&nbsp;@Loc[nameof(ControlsStrings.MetricTableNoMetricsFound)]
                    </td>
                </tr>
            }
            else
            {
                @* Virtualize keeps the table performant for high-cardinality metrics. SpacerElement="tr"
                   keeps the virtualization spacers valid inside the table body; the scroll container is
                   the surrounding #metric-table-container. ItemSize matches the previous grid row height.
                   @key preserves row focus by associating rows with their timestamp. *@
                <Virtualize @ref="_virtualize" Items="rows" ItemSize="46" SpacerElement="tr" TItem="MetricViewBase" Context="context">
                    <tr @key="context.DateTime" data-row-time="@context.DateTime.Ticks.ToString(CultureInfo.InvariantCulture)">
                        <td title="@FormatHelpers.FormatDateTime(TimeProvider, TimeProvider.ToLocal(context.DateTime), MillisecondsDisplay.None, CultureInfo.CurrentCulture)">
                            @FormatHelpers.FormatTimeWithOptionalDate(TimeProvider, TimeProvider.ToLocal(context.DateTime))
                        </td>
                        @if (showPercentiles)
                        {
                            foreach (var (percentile, underlineColor) in percentileColumns)
                            {
                                <td>
                                    @if (context is HistogramMetricView histogramMetric)
                                    {
                                        var percentileData = histogramMetric.Percentiles[percentile];

                                        <span style="@($"text-decoration-thickness: 2px; text-decoration-line: underline; text-decoration-color: {underlineColor}; margin-right: 4px;")">
                                            @percentileData.Value
                                        </span>

                                        if (GetIconAndTitleForDirection(percentileData.Direction) is var (icon, tone, title))
                                        {
                                            <DeckIcon Name="icon" Size="16" Class="@tone" Title="@title" Style="vertical-align: text-bottom" />
                                        }
                                    }
                                </td>
                            }
                        }
                        else if (showValueColumn)
                        {
                            <td>
                                @{
                                    var metricValueView = context as MetricValueView;
                                }
                                @if (metricValueView is null)
                                {
                                    @Loc[nameof(ControlsStrings.Loading)]
                                }
                                else if (metricValueView.ValueChange is null)
                                {
                                    @FormatMetricValue(metricValueView.Value)
                                }
                                else
                                {
                                    <span style="margin-right: 4px;">@metricValueView.Value</span>
                                    if (GetIconAndTitleForDirection(metricValueView.ValueChange) is var (icon, tone, title))
                                    {
                                        <DeckIcon Name="icon" Size="16" Class="@tone" Title="@title" Style="vertical-align: text-bottom" />
                                    }
                                }
                            </td>
                        }
                        @if (_exemplars.Count > 0)
                        {
                            <td>
                                @if (context.Exemplars.Count > 0)
                                {
                                    @* min-width ensures a consistent button width up to 999 metrics *@
                                    <button type="button"
                                            class="btn btn--primary btn--sm"
                                            aria-label="@Loc[nameof(ControlsStrings.MetricTableViewExemplarsLabel)]"
                                            @onclick="() => OpenExemplarsDialogAsync(context)"
                                            style="min-width: 45px">@context.Exemplars.Count</button>
                                }
                                else
                                {
                                    <span>0</span>
                                }
                            </td>
                        }
                    </tr>
                </Virtualize>
            }
        </tbody>
    </table>
</div>

<div class="deck-stack deck-stack--vertical">
    <Checkbox @bind-Checked="@OnlyShowValueChangesInTable"
              @bind-Checked:after="SettingsChangedAsync"
              Label="@Loc[nameof(ControlsStrings.MetricTableShowOnlyValueChanges)]" />
</div>
