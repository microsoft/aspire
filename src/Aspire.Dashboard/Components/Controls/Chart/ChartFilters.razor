@namespace Aspire.Dashboard.Components

@using Aspire.Dashboard.Resources
@inject IStringLocalizer<ControlsStrings> Loc

<div class="metrics-filters-container">
    @if (DimensionFilters.Count > 0)
    {
        <div class="metrics-filters-section">
            <h5>@Loc[nameof(ControlsStrings.ChartContainerFiltersHeader)]</h5>
            @{
                var filterColumnWidths = new[] { "200px", "1fr", "auto" };
            }
            <table class="data chart-filters-grid">
                <colgroup>
                    <col style="width: @filterColumnWidths[0]" />
                    <col style="width: @filterColumnWidths[1]" />
                    <col style="width: @filterColumnWidths[2]" />
                </colgroup>
                <tbody>
                    @foreach (var context in DimensionFilters)
                    {
                        <tr @key="context">
                            <td title="@context.Name" class="chart-filter-name">@context.Name</td>
                            <td title="@(context.SelectedValues.Count == 0 ? Loc[nameof(ControlsStrings.LabelNone)] : string.Join(", ", context.SelectedValues.OrderBy(v => v.Text).Select(v => v.Text)))">
                                <div class="dimension-overflow">
                                    @if (context.SelectedValues.Count == 0)
                                    {
                                        <Badge>@Loc[nameof(ControlsStrings.LabelNone)]</Badge>
                                    }
                                    else
                                    {
                                        var ordered = context.SelectedValues.OrderBy(v => v.Text).ToList();
                                        <span class="dimension-tag">@ordered[0].Text</span>
                                        @if (ordered.Count > 1)
                                        {
                                            @* The remaining tags are summarized as a "+N" badge; the full list is in the cell tooltip. *@
                                            <span class="dimension-tag" style="display:inline-block;">@($"+{ordered.Count - 1}")</span>
                                        }
                                    }
                                </div>
                            </td>
                            <td>
                                @{
                                    // Use the view model's stable per-instance id so the popover
                                    // anchor keeps the same id across re-renders (a freshly generated
                                    // Guid here would break Popover init/dispose id matching).
                                    var id = context.HtmlElementId;
                                }
                                <button type="button"
                                        id="@id"
                                        class="icon-btn @(context.AreAllValuesSelected is true ? null : "icon-btn--active")"
                                        @onclick="() => context.PopupVisible = !context.PopupVisible"
                                        aria-label="@(context.AreAllValuesSelected is true ? Loc[nameof(ControlsStrings.ChartContainerAllTags)] : Loc[nameof(ControlsStrings.ChartContainerFilteredTags)])">
                                    <DeckIcon Name="DeckIconName.Filter" Size="20" />
                                </button>
                                <Popover AnchorId="@id" @bind-Open="context.PopupVisible">
                                    <Header>@context.Name</Header>
                                    <Body>
                                        <div class="deck-stack deck-stack--vertical dimension-popup">
                                            <Checkbox Label="@Loc[nameof(ControlsStrings.LabelAll)]"
                                                      Checked="@(context.AreAllValuesSelected == true)"
                                                      Indeterminate="@(context.AreAllValuesSelected is null)"
                                                      CheckedChanged="@(v => OnAllValuesSelectionChangedAsync(context, v))" />
                                            @foreach (var tag in context.Values.OrderBy(v => v.Text))
                                            {
                                                var isChecked = context.SelectedValues.Contains(tag);
                                                <Checkbox Label="@tag.Text"
                                                          Title="@tag.Text"
                                                          @key=tag
                                                          Checked="@isChecked"
                                                          CheckedChanged="@(c => OnTagSelectionChangedAsync(context, tag, c))" />
                                            }
                                        </div>
                                    </Body>
                                </Popover>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    @if (Instrument.Summary.Type == OtlpInstrumentType.Histogram)
    {
        <div class="metrics-filters-section">
            <h5>@Loc[nameof(ControlsStrings.ChartContainerOptionsHeader)]</h5>
            <div>
                <Checkbox Label="@Loc[nameof(ControlsStrings.ChartContainerShowCountLabel)]"
                          @bind-Checked="@ShowCounts"
                          @bind-Checked:after="ShowCountChanged"/>
            </div>
        </div>
    }
</div>
