<div class="application-run-select">
    <AspireMenuButton Text="@ButtonText"
                      Title="@RunSelectTitle"
                      aria-label="@RunSelectAccessibleLabel"
                      Icon="@(SelectedRunIsCurrent ? s_historyIcon : null)"
                      IconColor="@(SelectedRunIsCurrent ? Color.Custom : Color.Primary)"
                      IconCustomColor="@(SelectedRunIsCurrent ? "currentColor" : null)"
                      IconStart="@(SelectedRunIsCurrent ? null : s_historyIcon)"
                      IconStartClass="application-run-status"
                      IconStartColor="Color.Warning"
                      ItemsProvider="@LoadRuns"
                      ButtonAppearance="ButtonAppearance.Default"
                      ButtonClass="application-run-select-button"
                      HideIcon="true"
                      RestoreFocusOnItemClick="true" />
</div>
