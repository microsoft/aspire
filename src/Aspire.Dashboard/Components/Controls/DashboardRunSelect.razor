@* The header button of the live view and recordings. It opens the recordings panel, like the notifications and
   settings buttons open theirs. A dot on the icon shows whether the live view or a recording is displayed. While a
   recording is displayed, the button also names it so it's obvious the page isn't live. The name is part of the
   button rather than placed separately in the header so it takes part in the header's layout and shrinks with an
   ellipsis instead of overlapping the page's own header content. *@
<div class="application-run-select">
    <FluentButton Id="@ButtonId"
                  Class="@ButtonClass"
                  Appearance="ButtonAppearance.Default"
                  OnClick="@OnClick"
                  data-tooltip="@RunSelectTitle"
                  aria-label="@RunSelectAccessibleLabel"
                  aria-haspopup="dialog">
        <span class="application-run-icon">
            <FluentIcon Value="@s_historyIcon" Color="Color.Default" />
            <DashboardRunIndicator IsLive="@SelectedRunIsCurrent" />
        </span>
        @if (ShowsRunText)
        {
            <span class="application-run-select-text">@SelectedRunText</span>
        }
    </FluentButton>
</div>
