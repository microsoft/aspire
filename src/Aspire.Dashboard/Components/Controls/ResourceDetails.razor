@using Aspire.Dashboard.Components.Controls.Grid
@using Aspire.Dashboard.Components.Controls.PropertyValues
@using Aspire.Dashboard.Resources
@using Humanizer
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.Extensions.Diagnostics.HealthChecks

@inject IStringLocalizer<ControlsStrings> ControlStringsLoc
@inject IStringLocalizer<Aspire.Dashboard.Resources.Resources> Loc
@inject IStringLocalizer<Columns> ColumnsLoc

<div class="resource-details-layout">

    <Toolbar>
        <SearchBox Placeholder="@ControlStringsLoc[nameof(ControlsStrings.FilterPlaceholder)]"
                   Autofocus="true"
                   @bind-Value="_filter"
                   slot="end" />
        <Divider slot="end" />
        <AspireMenuButton ButtonClass="resource-details-actions"
                          Icon="DeckIconName.Options"
                          Items="@_resourceActionsMenuItems"
                          Title="@Loc[nameof(Aspire.Dashboard.Resources.Resources.ResourcesChangeViewOptions)]"
                          slot="end" />
    </Toolbar>
    <div class="property-grid-container">
        <Accordion>
            <AccordionItem Heading="@ControlStringsLoc[nameof(ControlsStrings.ResourceDetailsResourceHeader)]" Expanded="true" Count="@FilteredResourceProperties.Count()">
                <PropertyGrid TItem="DisplayedResourcePropertyViewModel"
                              Items="@FilteredResourceProperties"
                              IsValueMaskedChanged="@OnValueMaskedChanged"
                              HighlightText="@_filter"
                              GridTemplateColumns="1fr 1.5fr"
                              ValueComponents="_valueComponents" />
            </AccordionItem>
            <AccordionItem Heading="@ControlStringsLoc[nameof(ControlsStrings.ResourceDetailsUrlsHeader)]" Expanded="@_isUrlsExpanded" Count="@FilteredUrls.Count()">
                <table class="data resource-details-grid">
                    <colgroup>
                        <col style="width: @s_standardColumnWidths[0]" />
                        <col style="width: @s_standardColumnWidths[1]" />
                        <col style="width: @s_standardColumnWidths[2]" />
                    </colgroup>
                    <thead>
                        <tr>
                            <GridSortableHeader Title="@ControlStringsLoc[nameof(ControlsStrings.LinkAddressColumnHeader)]" IsSorted="_urlSort.IsSorted(0)" Ascending="_urlSort.Ascending" OnClick="() => SortUrls(0)" />
                            <GridSortableHeader Title="@ControlStringsLoc[nameof(ControlsStrings.LinkTextColumnHeader)]" IsSorted="_urlSort.IsSorted(1)" Ascending="_urlSort.Ascending" OnClick="() => SortUrls(1)" />
                            <GridSortableHeader Title="@ControlStringsLoc[nameof(ControlsStrings.EndpointNameColumnHeader)]" IsSorted="_urlSort.IsSorted(2)" Ascending="_urlSort.Ascending" OnClick="() => SortUrls(2)" />
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var context in _urlSort.Apply(FilteredUrls, s_urlSortKeys))
                        {
                            <tr @key="((IPropertyGridItem)context).Key">
                                <td>
                                    <GridValue ValueDescription="@ControlStringsLoc[nameof(ControlsStrings.LinkAddressColumnHeader)]"
                                               Value="@context.OriginalUrlString"
                                               ValueTemplate="@(_ => RenderAddressValue(context, _filter))"
                                               EnableHighlighting="@(!string.IsNullOrEmpty(_filter))"
                                               IsMaskedChanged="@(_ => OnValueMaskedChanged(context))"
                                               HighlightText="@_filter" />
                                </td>
                                <td>
                                    <GridValue ValueDescription="@ControlStringsLoc[nameof(ControlsStrings.LinkTextColumnHeader)]"
                                               Value="@context.DisplayName"
                                               ValueTemplate="@(_ => RenderTextValue(context, _filter))"
                                               EnableHighlighting="@(!string.IsNullOrEmpty(_filter) && !string.IsNullOrEmpty(context.DisplayName))"
                                               IsMaskedChanged="@(_ => OnValueMaskedChanged(context))"
                                               HighlightText="@_filter" />
                                </td>
                                <td>
                                    <GridValue ValueDescription="@ControlStringsLoc[nameof(ControlsStrings.EndpointNameColumnHeader)]"
                                               Value="@context.Name"
                                               EnableHighlighting="@(!string.IsNullOrEmpty(_filter))"
                                               HighlightText="@_filter" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </AccordionItem>
            @if (Resource.IsContainer())
            {
                <AccordionItem Heading="@ControlStringsLoc[nameof(ControlsStrings.ResourceDetailsVolumesHeader)]" Expanded="@_isVolumesExpanded" Count="@FilteredVolumes.Count()">

                    <table class="data resource-details-grid">
                        <colgroup>
                            <col style="width: @s_standardColumnWidths[0]" />
                            <col style="width: @s_standardColumnWidths[1]" />
                            <col style="width: @s_standardColumnWidths[2]" />
                        </colgroup>
                        <thead>
                            <tr>
                                <GridSortableHeader Title="@ControlStringsLoc[nameof(ControlsStrings.NameColumnHeader)]" IsSorted="_volumeSort.IsSorted(0)" Ascending="_volumeSort.Ascending" OnClick="() => SortVolumes(0)" />
                                <GridSortableHeader Title="@ControlStringsLoc[nameof(ControlsStrings.VolumePathColumnHeader)]" IsSorted="_volumeSort.IsSorted(1)" Ascending="_volumeSort.Ascending" OnClick="() => SortVolumes(1)" />
                                <GridSortableHeader Title="@ControlStringsLoc[nameof(ControlsStrings.VolumeMountTypeColumnHeader)]" IsSorted="_volumeSort.IsSorted(2)" Ascending="_volumeSort.Ascending" OnClick="() => SortVolumes(2)" />
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var context in _volumeSort.Apply(FilteredVolumes, s_volumeSortKeys))
                            {
                                <tr @key="((IPropertyGridItem)context).Key">
                                    <td>
                                        <GridValue ValueDescription="@ControlStringsLoc[nameof(ControlsStrings.NameColumnHeader)]"
                                                   Value="@context.Source"
                                                   EnableHighlighting="@(!string.IsNullOrEmpty(_filter))"
                                                   HighlightText="@_filter" />
                                    </td>
                                    <td>
                                        <GridValue ValueDescription="@ControlStringsLoc[nameof(ControlsStrings.VolumePathColumnHeader)]"
                                                   Value="@context.Target"
                                                   EnableHighlighting="@(!string.IsNullOrEmpty(_filter))"
                                                   HighlightText="@_filter" />
                                    </td>
                                    <td>
                                        <GridValue ValueDescription="@ControlStringsLoc[nameof(ControlsStrings.VolumeMountTypeColumnHeader)]"
                                                   Value="@context.MountType.Humanize()">
                                            <ContentBeforeValue>
                                                @if (context.IsReadOnly)
                                                {
                                                    <DeckIcon Name="DeckIconName.Lock" Size="16" Class="volume-mount-type-icon" />
                                                }
                                            </ContentBeforeValue>
                                        </GridValue>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </AccordionItem>
            }
            <AccordionItem Heading="@ControlStringsLoc[nameof(ControlsStrings.ResourceDetailsReferences)]" Expanded="@_isRelationshipsExpanded" Count="@FilteredRelationships.Count()">
                <table class="data resource-details-grid">
                    <colgroup>
                        <col style="width: @s_standardColumnWidths[0]" />
                        <col style="width: @s_standardColumnWidths[1]" />
                        <col style="width: @s_standardColumnWidths[2]" />
                    </colgroup>
                    <thead>
                        <tr>
                            <th>@ControlStringsLoc[nameof(ControlsStrings.ResourceDetailsResourceHeader)]</th>
                            <th>@ControlStringsLoc[nameof(ControlsStrings.ResourceDetailsTypeHeader)]</th>
                            <th class="no-ellipsis">@ControlStringsLoc[nameof(ControlsStrings.ViewAction)]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var context in FilteredRelationships)
                        {
                            <tr @key="context.ResourceName">
                                <td>
                                    <ResourceNameValue Resource="@context.Resource" Value="@context.ResourceName" FormatName="@FormatName" />
                                </td>
                                <td title="@string.Join(", ", context.Types)">@string.Join(", ", context.Types)</td>
                                <td class="no-ellipsis">
                                    <button type="button" class="button-hyperlink-no-icon" @onclick="@(() => OnViewRelationshipAsync(context))">@ControlStringsLoc[nameof(ControlsStrings.ViewAction)]</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </AccordionItem>
            <AccordionItem Heading="@ControlStringsLoc[nameof(ControlsStrings.ResourceDetailsBackReferences)]" Expanded="@_isBackRelationshipsExpanded" Count="@FilteredBackRelationships.Count()">
                <table class="data resource-details-grid">
                    <colgroup>
                        <col style="width: @s_standardColumnWidths[0]" />
                        <col style="width: @s_standardColumnWidths[1]" />
                        <col style="width: @s_standardColumnWidths[2]" />
                    </colgroup>
                    <thead>
                        <tr>
                            <th>@ControlStringsLoc[nameof(ControlsStrings.ResourceDetailsResourceHeader)]</th>
                            <th>@ControlStringsLoc[nameof(ControlsStrings.ResourceDetailsTypeHeader)]</th>
                            <th class="no-ellipsis">@ControlStringsLoc[nameof(ControlsStrings.ViewAction)]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var context in FilteredBackRelationships)
                        {
                            <tr @key="context.ResourceName">
                                <td>
                                    <ResourceNameValue Resource="@context.Resource" Value="@context.ResourceName" FormatName="@FormatName" />
                                </td>
                                <td title="@string.Join(", ", context.Types)">@string.Join(", ", context.Types)</td>
                                <td class="no-ellipsis">
                                    <button type="button" class="button-hyperlink-no-icon" @onclick="@(() => OnViewRelationshipAsync(context))">@ControlStringsLoc[nameof(ControlsStrings.ViewAction)]</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </AccordionItem>
            <AccordionItem Heading="@ControlStringsLoc[nameof(ControlsStrings.ResourceHealthChecksHeader)]" Expanded="@_isHealthChecksExpanded" Count="@FilteredHealthReports.Count()">

                <table class="data resource-details-grid">
                    <colgroup>
                        <col style="width: @s_healthColumnWidths[0]" />
                        <col style="width: @s_healthColumnWidths[1]" />
                        <col style="width: @s_healthColumnWidths[2]" />
                    </colgroup>
                    <thead>
                        <tr>
                            <th class="nameColumn">@ControlStringsLoc[nameof(ControlsStrings.NameColumnHeader)]</th>
                            <th class="stateColumn">@ControlStringsLoc[nameof(ControlsStrings.StateColumnHeader)]</th>
                            <th class="detailsColumn">@ControlStringsLoc[nameof(ControlsStrings.DetailsColumnHeader)]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var context in FilteredHealthReports)
                        {
                            <tr @key="context.Name">
                                <td class="nameColumn">
                                    <GridValue ValueDescription="@ControlStringsLoc[nameof(ControlsStrings.NameColumnHeader)]"
                                               Value="@context.Name"
                                               EnableHighlighting="@(!string.IsNullOrEmpty(_filter))"
                                               HighlightText="@_filter" />
                                </td>
                                <td class="stateColumn">
                                    <GridValue ValueDescription="@ControlStringsLoc[nameof(ControlsStrings.StateColumnHeader)]"
                                               Value="@GetHealthStatusWithTime(context)"
                                               ToolTip="@GetHealthStatusTooltip(context)"
                                               EnableHighlighting="@(!string.IsNullOrEmpty(_filter))"
                                               HighlightText="@_filter"
                                               TextVisualizerTitle="@context.Name">
                                        <ContentBeforeValue>
                                            @if (context.HealthStatus is null)
                                            {
                                                <div class="spinner severity-icon" style="display: inline-block;" role="progressbar" aria-label="Loading"></div>
                                            }
                                            else
                                            {
                                                (DeckIconName iconName, string toneClass) = ResourceIconHelpers.GetHealthStatusDeckIcon(context.HealthStatus);

                                                <DeckIcon Name="@iconName" Size="16" Class="@($"severity-icon {toneClass}")" />
                                            }
                                        </ContentBeforeValue>
                                    </GridValue>
                                </td>
                                <td class="detailsColumn">
                                    <GridValue ValueDescription="@ControlStringsLoc[nameof(ControlsStrings.DetailsColumnHeader)]"
                                               Value="@(context.HealthStatus is null ? Loc[nameof(Aspire.Dashboard.Resources.Resources.WaitingForHealthDataMessage)] : context.DisplayedDescription)"
                                               EnableHighlighting="@(!string.IsNullOrEmpty(_filter))"
                                               HighlightText="@_filter"
                                               TextVisualizerTitle="@context.Name">
                                        <ContentInButtonArea>
                                            <ExceptionDetails ExceptionText="@context.ExceptionText" />
                                        </ContentInButtonArea>
                                    </GridValue>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </AccordionItem>
            <AccordionItem Heading="@ControlStringsLoc[nameof(ControlsStrings.ResourceDetailsEnvironmentVariablesHeader)]" Expanded="@_isEnvironmentVariablesExpanded" Count="@FilteredEnvironmentVariables.Count()">
                <PropertyGrid TItem="EnvironmentVariableViewModel"
                              Items="@FilteredEnvironmentVariables"
                              IsValueMaskedChanged="@OnValueMaskedChanged"
                              HighlightText="@_filter"
                              GridTemplateColumns="1fr 1.5fr"
                              Class="env-var-properties" />
            </AccordionItem>
        </Accordion>
    </div>
</div>

@code {
    private static RenderFragment RenderAddressValue(DisplayedUrl vm, string filter)
    {
        var highlighting = !string.IsNullOrEmpty(filter);

        // If there's no URL, e.g. this is a tcp:// URI, just show the text
        if (vm.Url is null)
        {
            if (highlighting)
            {
                return @<Highlighter HighlightedText="@filter" Text="@vm.Text" />;
            }
            return @<span>@vm.Text</span>;
        }
        // Otherwise, render a link for the URL
        else
        {
            // Mask querystring values for display
            var displayUrl = DashboardUIHelpers.MaskQueryStringValues(vm.Url);

            if (highlighting)
            {
                return @<a href="@vm.Url" target="_blank"><Highlighter HighlightedText="@filter" Text="@displayUrl" /></a>;
            }
            return @<a href="@vm.Url" target="_blank">@displayUrl</a>;
        }
    }

    private static RenderFragment RenderTextValue(DisplayedUrl vm, string filter)
    {
        var highlighting = !string.IsNullOrEmpty(filter) && !string.IsNullOrEmpty(vm.DisplayName);

        // If there's no DisplayName then show nothing
        if (string.IsNullOrEmpty(vm.DisplayName))
        {
            return @<span class="empty-data"></span>;
        }
        // Otherwise, render a link with the text as the anchor text & title as the URL
        else
        {
            if (highlighting)
            {
                return @<a href="@vm.Url" title="@vm.Url" target="_blank"><Highlighter HighlightedText="@filter" Text="@vm.DisplayName" /></a>;
            }
            return @<a href="@vm.Url" title="@vm.Url" target="_blank">@vm.DisplayName</a>;
        }
    }
}
