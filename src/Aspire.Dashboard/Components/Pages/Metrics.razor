@page "/metrics"
@page "/metrics/resource/{resourceName}"
@page "/metrics/resource/{resourceName}/meter/{meterName}"
@page "/metrics/resource/{resourceName}/meter/{meterName}/instrument/{instrumentName}"
@layout ResourcesLayout

@using System.Globalization
@using Aspire.Dashboard.Components.Controls.Grid
@using Aspire.Dashboard.Resources
@using Microsoft.AspNetCore.Components.Rendering
@using Microsoft.AspNetCore.Components.Sections
@inject IStringLocalizer<Dashboard.Resources.Metrics> Loc
@inject IStringLocalizer<ControlsStrings> ControlsStringsLoc

<PageTitle>
    @{
        string? additionalText;
        if (PageViewModel.SelectedResource.Id is { ReplicaSetName: { } replicaSetName })
        {
            additionalText = PageViewModel.SelectedInstrument is { } selectedInstrument
                ? $"{replicaSetName} - {selectedInstrument.Name}"
                : replicaSetName;
        }
        else
        {
            additionalText = null;
        }
    }

    <ApplicationName
        AdditionalText="@additionalText"
        ResourceName="@nameof(Dashboard.Resources.Metrics.MetricsPageTitle)"
        Loc="@Loc"/>
</PageTitle>

@{
    // Inside the resources layout on desktop, the filter toolbar shares the tabs row instead of taking its own row.
    var toolbarInTabsRow = ViewportInformation.IsDesktop && ResourcesLayout is not null;
}

@if (toolbarInTabsRow)
{
    <StableSectionContent SectionName="@Aspire.Dashboard.Components.Layout.ResourcesLayout.TabToolbarSectionName">
        <div class="main-toolbar filter-toolbar" role="toolbar" aria-label="@ControlsStringsLoc[nameof(ControlsStrings.PageToolbarLandmark)]">
            @((RenderFragment)RenderToolbar)
        </div>
    </StableSectionContent>
}

<div class="page-content-container">
    <AspirePageContentLayout
        AddNewlineOnToolbar="true"
        @ref="_contentLayout"
        HideDesktopToolbar="@toolbarInTabsRow"
        HeaderStyle="margin-bottom: var(--spacingVerticalS);"
        MainContentStyle="margin-top: var(--layout-top-padding);"
        MobileToolbarButtonText="@Loc[nameof(Dashboard.Resources.Metrics.MetricsViewAttributesToolbar)]">
        <PageTitleSection>
            <h1 class="page-header">@Loc[nameof(Dashboard.Resources.Metrics.MetricsHeader)]</h1>
        </PageTitleSection>
        <ToolbarSection>
            @((RenderFragment)RenderToolbar)
        </ToolbarSection>
        <MainSection>
            <div style="width: 100%; height: 100%; overflow: auto;">
                @if (PageViewModel.Instruments?.Count > 0)
                {
                    // Collapsed property only allows us to show Panel1 (which is the metric selector)
                    // but we want to only show Panel2 on mobile. So, hide the bar handle and reduce width to 0
                    // on mobile.
                    <div class="metrics-splitter" @ref="_metricsSplitterElement">
                    <FluentMultiSplitter Style="height:100%"
                                         BarSize="@(ViewportInformation.IsDesktop ? "calc(var(--spacingHorizontalS) + var(--strokeWidthThin))" : "0")"
                                         OnResize="HandleMetricsSplitterResize">
                        <FluentMultiSplitterPane Size="@(ViewportInformation.IsDesktop ? _metricGroupsPaneSize : "0")"
                                                 Collapsed="@(!ViewportInformation.IsDesktop)">
                            @if (ViewportInformation.IsDesktop)
                            {
                                <MetricGroupList
                                    @ref="_metricGroupList"
                                    PageViewModel="@PageViewModel"
                                    SelectGroupAsync="@SelectGroupAsync"
                                    GetGroupUrl="@GetGroupUrl"
                                    TextFilterChanged="@OnTextFilterChanged"/>
                            }
                        </FluentMultiSplitterPane>
                        <FluentMultiSplitterPane Size="@_metricsContentPaneSize">
                            <div class="metrics-content">
                                    @if ((PageViewModel.SelectedResource.Id is not null || IsAggregate) && (PageViewModel.ShowFilterResults || (PageViewModel.ShowAll && PageViewModel.SelectedInstrument is null)))
                                    {
                                        @* Filter results and the all-instruments view both list instruments from every meter, grouped by meter. *@
                                        var resultGroups = GetFilterResultGroups();
                                        var resultsTitle = PageViewModel.TextFilter.Trim().Length > 0
                                            ? string.Format(CultureInfo.CurrentCulture, Loc[nameof(Dashboard.Resources.Metrics.MetricsFilterResultsTitle)], PageViewModel.TextFilter.Trim())
                                            : Loc[nameof(Dashboard.Resources.Metrics.MetricsAllInstrumentsTitle)].Value;
                                        <h3 class="meter-name-title">@resultsTitle</h3>
                                        @if (resultGroups.Count == 0)
                                        {
                                            <p class="metrics-pinned-empty">@Loc[nameof(Dashboard.Resources.Metrics.MetricsNoMatchingInstruments)]</p>
                                        }
                                        @foreach (var resultGroup in resultGroups)
                                        {
                                            @RenderSection(resultGroup, IsAggregate && _groupBy != MetricGroupBy.Meter)
                                        }
                                    }
                                    else if (PageViewModel.SelectedResource.Id?.ReplicaSetName != null && PageViewModel is { SelectedMeter: not null, SelectedInstrument: not null })
                                    {
                                        <ChartContainer
                                            ResourceKey="@(PageViewModel.SelectedResource.Id.GetResourceKey())"
                                            MeterName="@(PageViewModel.SelectedMeter)"
                                            InstrumentName="@(PageViewModel.SelectedInstrument.Name)"
                                            Duration="PageViewModel.SelectedDuration.Id"
                                            ActiveView="@(PageViewModel.SelectedViewKind ?? Metrics.MetricViewKind.Graph)"
                                            OnViewChangedAsync="@OnViewChangedAsync"
                                            ShowRunningTotal="@PageViewModel.ShowRunningTotal"
                                            OnShowRunningTotalChangedAsync="@OnShowRunningTotalChangedAsync"
                                            BackLabel="@GetBackLabel()"
                                            OnBackAsync="@NavigateBackAsync"
                                            Resources="@_resources" />
                                    }
                                    else if (PageViewModel.ShowPinned && (PageViewModel.SelectedResource.Id is not null || IsAggregate))
                                    {
                                        var pinnedInstruments = GetOverviewInstruments();
                                        <h3 class="meter-name-title">@Loc[nameof(Dashboard.Resources.Metrics.MetricsPinnedHeader)]</h3>
                                        @if (pinnedInstruments.Count > 0)
                                        {
                                            @foreach (var section in GetSections(pinnedInstruments, splitByMeterByDefault: false))
                                            {
                                                @RenderSection(section, !IsAggregate || _groupBy != MetricGroupBy.Meter)
                                            }
                                        }
                                        else
                                        {
                                            <p class="metrics-pinned-empty">@Loc[nameof(Dashboard.Resources.Metrics.MetricsPinnedEmpty)]</p>
                                        }
                                    }
                                    else if (PageViewModel.SelectedMeter is not null && (PageViewModel.SelectedResource.Id is not null || IsAggregate))
                                    {
                                        <h3 class="meter-name-title">@PageViewModel.SelectedMeter</h3>
                                        @foreach (var section in GetSections(GetOverviewInstruments(), splitByMeterByDefault: false))
                                        {
                                            @RenderSection(section, false)
                                        }
                                    }
                                    else
                                    {
                                        @if (ViewportInformation.IsDesktop)
                                        {
                                            <p>@Loc[nameof(Dashboard.Resources.Metrics.MetricsSelectInstrument)]</p>
                                        }
                                        else
                                        {
                                            <div class="aspire-empty-content">
                                                <a href="#" @onclick="@(async () => await _contentLayout!.OpenMobileToolbarAsync())" @onclick:preventDefault="true">
                                                    @Loc[nameof(Dashboard.Resources.Metrics.MetricsSelectInstrument)]
                                                </a>
                                            </div>
                                        }
                                    }
                                </div>
                        </FluentMultiSplitterPane>
                    </FluentMultiSplitter>
                    </div>
                }
                else if (PageViewModel.Instruments == null)
                {
                    <div class="aspire-empty-content metrics-empty-content">
                        <TelemetryEmptyContent>
                            <FluentIcon Icon="Icons.Regular.Size24.ChartMultiple" Color="Color.Primary" />
                            @if (ViewportInformation.IsDesktop)
                            {
                                @Loc[nameof(Dashboard.Resources.Metrics.MetricsSelectAResource)]
                            }
                            else
                            {
                                <a href="#" @onclick="@(async () => await _contentLayout!.OpenMobileToolbarAsync())" @onclick:preventDefault="true">@Loc[nameof(Dashboard.Resources.Metrics.MetricsSelectAResource)]</a>
                            }
                        </TelemetryEmptyContent>
                    </div>
                }
                else
                {
                    <div class="aspire-empty-content metrics-empty-content">
                        <TelemetryEmptyContent>
                            <FluentIcon Icon="Icons.Regular.Size24.ChartMultiple" Color="Color.Primary" />
                            @Loc[nameof(Dashboard.Resources.Metrics.MetricsNoMetricsForResource)]
                        </TelemetryEmptyContent>
                    </div>
                }
            </div>
        </MainSection>
        <FooterSection>
            @if (PauseText is not null)
            {
                <div class="items-footer">
                    <PauseWarning PauseText="@PauseText" />
                </div>
            }
        </FooterSection>
    </AspirePageContentLayout>
</div>

@code {
    private RenderFragment RenderSection(IGrouping<string, OtlpInstrumentSummary> section, bool showMeterName) => __builder =>
    {
        var hasTitle = section.Key.Length > 0;
        var isCollapsed = hasTitle && _collapsedSections.Contains(section.Key);
        var instruments = section.ToList();
        var sectionKey = section.Key;

        <section @key="sectionKey" class="metrics-filter-results-group" aria-label="@(hasTitle ? sectionKey : null)">
            @if (hasTitle)
            {
                @* The dotted rule fills the header so the whole row reads as a target for collapsing the group. *@
                <h4 class="metrics-filter-results-meter">
                    <button type="button"
                            class="metrics-section-toggle"
                            aria-expanded="@(isCollapsed ? "false" : "true")"
                            @onclick="@(() => ToggleSection(sectionKey))">
                        <span class="metrics-section-title">@sectionKey</span>
                        <span class="metrics-section-count">@instruments.Count</span>
                        <span class="metrics-section-rule" aria-hidden="true"></span>
                        <FluentIcon Class="metrics-section-chevron" Value="@(isCollapsed ? (Icon)new Icons.Regular.Size16.ChevronDown() : new Icons.Regular.Size16.ChevronUp())" Color="Color.Custom" CustomColor="currentColor" />
                    </button>
                </h4>
            }
            @if (!isCollapsed)
            {
                <MeterOverview ResourceKey="@OverviewResourceKey"
                               GetResourceLabel="@ResourceLabelProvider"
                               SortBy="@OverviewSortBy"
                               Instruments="@instruments"
                               Duration="@PageViewModel.SelectedDuration.Id"
                               ShowMeterName="@showMeterName"
                               GetInstrumentUrl="@GetInstrumentUrl" />
            }
        </section>
    };

    private void RenderToolbar(RenderTreeBuilder __builder)
    {
        @if (ResourcesLayout is null)
        {
            <ResourceSelect Resources="@(_selectionResourceViewModels ?? _resourceViewModels)"
                            AriaLabel="@ControlsStringsLoc[nameof(ControlsStrings.SelectAResource)]"
                            @bind-SelectedResource="PageViewModel.SelectedResource"
                            @bind-SelectedResource:after="HandleSelectedResourceChangedAsync"
                            CanSelectGrouping="true"
                            LabelClass="toolbar-left" />
        }

        @if (IsAggregate)
        {
            @* Shown for lists of several resources, where the same instrument can appear once per resource. *@
            <div class="toolbar-organize" role="group">
                <label for="@_selectGroupById">@Loc[nameof(Dashboard.Resources.Metrics.MetricsGroupByLabel)]</label>
                <FluentSelect TOption="SelectViewModel<MetricGroupBy>" TValue="SelectViewModel<MetricGroupBy>"
                              Class="toolbar-select toolbar-select-compact"
                              Id="@_selectGroupById"
                              Items="@_groupByOptions"
                              OptionText="@(c => c?.Name)"
                              @bind-Value="_selectedGroupBy"
                              @bind-Value:after="OnOrganizeChangedAsync"
                              AriaLabel="@Loc[nameof(Dashboard.Resources.Metrics.MetricsGroupByLabel)]" />

                <label for="@_selectSortById">@Loc[nameof(Dashboard.Resources.Metrics.MetricsSortByLabel)]</label>
                <FluentSelect TOption="SelectViewModel<MetricSortBy>" TValue="SelectViewModel<MetricSortBy>"
                              Class="toolbar-select toolbar-select-compact"
                              Id="@_selectSortById"
                              Items="@_sortByOptions"
                              OptionText="@(c => c?.Name)"
                              @bind-Value="_selectedSortBy"
                              @bind-Value:after="OnOrganizeChangedAsync"
                              AriaLabel="@Loc[nameof(Dashboard.Resources.Metrics.MetricsSortByLabel)]" />
            </div>
        }

        <SignalsActionsDisplay IsPaused="@PauseManager.AreMetricsPaused(out _)"
                              OnPausedChanged="@PauseManager.SetMetricsPaused"
                              HandleClearSignal="ClearMetrics"
                              SelectedResource="@PageViewModel.SelectedResource"/>

        <div class="toolbar-end">
            <label for="@_selectDurationId">@ControlsStringsLoc[nameof(ControlsStrings.DurationColumnHeader)]</label>

            <DesktopToolbarDivider />

            <FluentSelect TOption="SelectViewModel<TimeSpan>" TValue="SelectViewModel<TimeSpan>"
                          Class="toolbar-select"
                          Id="@_selectDurationId"
                          Items="@_durations"
                          OptionText="@(c => c?.Name)"
                          @bind-Value="PageViewModel.SelectedDuration"
                          @bind-Value:after="HandleSelectedDurationChangedAsync"
                          AriaLabel="@ControlsStringsLoc[nameof(ControlsStrings.DurationColumnHeader)]"/>
        </div>

        @if (!ViewportInformation.IsDesktop)
        {
            // Show metric selector in the toolbar for mobile, since we don't have enough room to show both
            // panels on a mobile viewport.
            <MetricGroupList
                @ref="_metricGroupList"
                PageViewModel="@PageViewModel"
                IncludeLabel="true"
                SelectGroupAsync="@SelectGroupAsync"
                GetGroupUrl="@GetGroupUrl"
                TextFilterChanged="@OnTextFilterChanged"/>
        }
    }
}
