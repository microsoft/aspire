@page "/traces/detail/{traceId}"

@using Aspire.Dashboard.Components.Controls.Grid
@using Aspire.Dashboard.Components.Deck
@using Aspire.Dashboard.Resources
@inject IStringLocalizer<StructuredFiltering> FilterLoc
@inject IStringLocalizer<Dialogs> DialogsLoc

<PageTitle>
    <ApplicationName
        AdditionalText="@GetPageTitle()"
        ResourceName="@nameof(Dashboard.Resources.TraceDetail.TraceDetailPageTitle)"
        Loc="@Loc"/>
</PageTitle>

<div class="page">
    @if (_trace is { } trace)
    {
        <div class="page__header">
            <div class="trace-detail-heading">
                <div class="page__title">
                    <span>@GetPageTitle()</span>
                    <span class="trace-id">@OtlpHelpers.ToShortenedId(trace.TraceId)</span>
                </div>
                <div class="page__subtitle trace-detail-meta">
                    <span>@Loc[nameof(Dashboard.Resources.TraceDetail.TraceDetailTraceStartHeader)] <strong title="@FormatHelpers.FormatDateTime(TimeProvider, trace.FirstSpan.StartTime, MillisecondsDisplay.Full)">@FormatHelpers.FormatTimeWithOptionalDate(TimeProvider, trace.FirstSpan.StartTime, MillisecondsDisplay.Truncated)</strong></span>
                    <span class="trace-detail-meta-sep">·</span>
                    <span>@Loc[nameof(Dashboard.Resources.TraceDetail.TraceDetailDurationHeader)] <strong>@DurationFormatter.FormatDuration(trace.Duration, CultureInfo.CurrentCulture)</strong></span>
                    <span class="trace-detail-meta-sep">·</span>
                    <span>@Loc[nameof(Dashboard.Resources.TraceDetail.TraceDetailResourcesHeader)] <strong>@_resourceCount</strong></span>
                    <span class="trace-detail-meta-sep">·</span>
                    <span>@Loc[nameof(Dashboard.Resources.TraceDetail.TraceDetailDepthHeader)] <strong>@_maxDepth</strong></span>
                    <span class="trace-detail-meta-sep">·</span>
                    <span>@Loc[nameof(Dashboard.Resources.TraceDetail.TraceDetailTotalSpansHeader)] <strong>@trace.Spans.Count</strong></span>
                </div>
            </div>
            <div class="page__header-spacer"></div>

            <div class="traces-toolbar">
                <SearchBox Value="@PageViewModel.Filter" ValueChanged="OnFilterChangedAsync"
                           Placeholder="@ControlStringsLoc[nameof(ControlsStrings.FilterPlaceholder)]" />

                <SpanTypeSelect @bind-SpanType="@PageViewModel.SelectedSpanType"
                                SpanTypes="@_spanTypes"
                                HandleSelectedSpanTypeChangedAsync="@HandleSelectedSpanTypeChangedAsync" />

                <label class="min-duration">
                    <span class="min-duration__label">@Loc[nameof(Dashboard.Resources.TraceDetail.TraceDetailMinDurationLabel)]</span>
                    <select class="select" @onchange="OnMinDurationChangedAsync"
                            aria-label="@Loc[nameof(Dashboard.Resources.TraceDetail.TraceDetailMinDurationLabel)]">
                        @foreach (var ms in s_minDurationOptionsMs)
                        {
                            <option value="@ms" selected="@(ms == _minDurationMs)">@GetMinDurationLabel(ms)</option>
                        }
                    </select>
                </label>

                @if (PageViewModel.Filters.Count == 0)
                {
                    <button id="traceDetailFilterButton" type="button" class="icon-btn"
                            @onclick="() => OpenFilterAsync(null)"
                            title="@FilterLoc[nameof(StructuredFiltering.AddFilter)]"
                            aria-label="@FilterLoc[nameof(StructuredFiltering.AddFilter)]">
                        <DeckIcon Name="DeckIconName.Filter" Size="17" />
                    </button>
                }
                else
                {
                    <CounterBadge HorizontalPosition="70" Count="@(PageViewModel.Filters.GetEnabledFilters().Count())">
                        <AspireMenuButton HideIcon="true"
                                          Icon="DeckIconName.Filter"
                                          Items="@GetFilterMenuItems()"
                                          Title="@FilterLoc[nameof(StructuredFiltering.Filters)]" />
                    </CounterBadge>
                }

                <AspireMenuButton Icon="DeckIconName.Options"
                                  Items="@_traceActionsMenuItems"
                                  Title="@ControlStringsLoc[nameof(ControlsStrings.ActionsButtonText)]" />
            </div>
        </div>

        <div class="page__body">
            <div class="trace-waterfall">
                <GridColumnManager @ref="_manager" Columns="@_gridColumns">
                @{
                    var gridTemplateColumns = _manager.GetGridTemplateColumns();
                    var nameColumnVisible = _manager.IsColumnVisible(NameColumn);
                    var resourceColumnVisible = _manager.IsColumnVisible(ResourceColumn);
                    var ticksColumnVisible = _manager.IsColumnVisible(TicksColumn);
                    var actionsColumnVisible = _manager.IsColumnVisible(ActionsColumn);
                    var hasSpans = GetVisibleSpanViewModels().Any();

                    // Assign a zero-based position to each visible column so resize handles know which
                    // adjacent pair they resize. Only columns that have a following visible column get a
                    // handle (the last column has nothing to resize against).
                    var visibleColumnCount = 0;
                    var nameColumnIndex = nameColumnVisible ? visibleColumnCount++ : -1;
                    var resourceColumnIndex = resourceColumnVisible ? visibleColumnCount++ : -1;
                    var ticksColumnIndex = ticksColumnVisible ? visibleColumnCount++ : -1;
                    var actionsColumnIndex = actionsColumnVisible ? visibleColumnCount++ : -1;
                    bool IsResizable(int columnIndex) => columnIndex >= 0 && columnIndex < visibleColumnCount - 1;
                }
                @* The trace waterfall is a CSS grid rather than a table: every row shares the same
                   grid-template-columns (published as the --trace-grid-columns custom property on the
                   container from the column manager) so cells line up, and each cell's inner content
                   (the tick ruler, span bars) uses its own nested grid. Column resizing rewrites that
                   single custom property, so the header and every row follow together. *@
                <div class="main-grid trace-view-grid enable-row-click" role="table" @ref="_waterfallGrid" style="--trace-grid-columns: @gridTemplateColumns;">
                    <div class="trace-grid-header" role="row" data-resize-header style="grid-template-columns: var(--trace-grid-columns);">
                        @if (nameColumnVisible)
                        {
                            <div class="column-header expand-col @(IsResizable(nameColumnIndex) ? "resizable-column" : null)" role="columnheader">
                                @Loc[nameof(Dashboard.Resources.TraceDetail.TraceDetailNameHeader)]
                                @if (IsResizable(nameColumnIndex))
                                {
                                    <ColumnResizeHandle ColumnIndex="@nameColumnIndex" Label="@ResizeLabel" />
                                }
                            </div>
                        }
                        @if (resourceColumnVisible)
                        {
                            <div class="column-header expand-col @(IsResizable(resourceColumnIndex) ? "resizable-column" : null)" role="columnheader">
                                @Loc[nameof(Dashboard.Resources.TraceDetail.TraceDetailResourceHeader)]
                                @if (IsResizable(resourceColumnIndex))
                                {
                                    <ColumnResizeHandle ColumnIndex="@resourceColumnIndex" Label="@ResizeLabel" />
                                }
                            </div>
                        }
                        @if (ticksColumnVisible)
                        {
                            <div class="column-header @(IsResizable(ticksColumnIndex) ? "resizable-column" : null)" role="columnheader">
                                <div class="ticks">
                                    @* First column starts at 0. We don't want to display the smallest unit (0μs) because that looks odd. Use the unit from the next column *@
                                    <div class="tick" style="grid-column: 1;"></div>
                                    <span class="tick-label" style="grid-column: 1;">@($"0{DurationFormatter.GetUnit(trace.Duration / 4)}")</span>

                                    <div class="tick" style="grid-column: 2;"></div>
                                    <span class="tick-label" style="grid-column: 2;">@DurationFormatter.FormatDuration(trace.Duration / 4, CultureInfo.CurrentCulture)</span>

                                    <div class="tick" style="grid-column: 3;"></div>
                                    <span class="tick-label" style="grid-column: 3;">@DurationFormatter.FormatDuration(trace.Duration / 4 * 2, CultureInfo.CurrentCulture)</span>

                                    @* Grid column 4 shows two labels. Hide the left aligned label on mobile to avoid them overlapping *@
                                    <div class="tick" style="grid-column: 4;"></div>
                                    @if (_manager.ViewportInformation.IsDesktop)
                                    {
                                        <span class="tick-label" style="grid-column: 4;">@DurationFormatter.FormatDuration(trace.Duration / 4 * 3, CultureInfo.CurrentCulture)</span>
                                    }

                                    <span class="tick-label end-tick" style="grid-column: 4;">@DurationFormatter.FormatDuration(trace.Duration, CultureInfo.CurrentCulture)</span>
                                    <div class="tick" style="grid-column: 5;"></div>
                                </div>
                                @if (IsResizable(ticksColumnIndex))
                                {
                                    <ColumnResizeHandle ColumnIndex="@ticksColumnIndex" Label="@ResizeLabel" />
                                }
                            </div>
                        }
                        @if (actionsColumnVisible)
                        {
                            <div class="column-header no-ellipsis" role="columnheader">@ControlStringsLoc[nameof(ControlsStrings.ActionsColumnHeader)]</div>
                        }
                    </div>
                    <div class="trace-grid-body">
                        @if (!hasSpans)
                        {
                            <div class="trace-grid-empty cell-muted">
                                <DeckIcon Name="DeckIconName.GanttChart" Size="24" />&nbsp;@Loc[nameof(Dashboard.Resources.TraceDetail.TraceDetailNoSpans)]
                            </div>
                        }
                        else
                        {
                            @* Virtualize streams span rows from GetData. @key preserves row focus across
                               trace updates; ItemSize matches the small row height. *@
                            <Virtualize @ref="_virtualize" ItemsProvider="@GetData" Context="context" ItemSize="32" OverscanCount="100" TItem="SpanWaterfallViewModel">
                                <div class="trace-grid-row @GetRowClass(context)" role="row" style="grid-template-columns: var(--trace-grid-columns);" @key="context.Span.SpanId"
                                     @onclick="@(() => OnShowPropertiesAsync(context, buttonId: null))">
                                    @if (nameColumnVisible)
                                    {
                                        var isServerOrConsumer = context.Span.Kind == OtlpSpanKind.Server || context.Span.Kind == OtlpSpanKind.Consumer;
                                        // Indent the span name based on the depth of the span.
                                        var marginLeft = (context.Depth - 1) * 15;

                                        // We want to have consistent margin for both client and server spans.
                                        string spanNameContainerStyle;
                                        if (!isServerOrConsumer)
                                        {
                                            // Client span has 19px extra content:
                                            // - 5px extra margin-left
                                            // - 5px border
                                            // - 9px padding-left
                                            spanNameContainerStyle = $"margin-left: 5px; border-left-color: {TraceColorPalette.GetColorVariable(GetResourceName(context.Span.Source))}; border-left-width: 5px; border-left-style: solid; padding-left: 9px;";
                                        }
                                        else
                                        {
                                            // Span with icon has 19px extra content:
                                            // - 16px icon
                                            // - 3px padding-left
                                            spanNameContainerStyle = string.Empty;
                                        }

                                        <div class="expand-col" role="cell" title="@context.GetTooltip(_resources)">
                                            <div class="span-overview-container">
                                                <span @onclick:stopPropagation="true" style="margin-left: @(marginLeft)px;" class="main-grid-expand-container @(context.IsCollapsed ? "main-grid-collapsed" : "main-grid-expanded")">
                                                    @if (context.Children.Count > 0)
                                                    {
                                                        <button type="button" aria-label="@ControlStringsLoc[nameof(ControlsStrings.ToggleNesting)]" class="icon-btn icon-btn--sm main-grid-expand-button" @onclick="@(() => OnToggleCollapse(context))">
                                                            <DeckIcon Name="DeckIconName.Chevron" Size="12" />
                                                        </button>
                                                    }
                                                </span>
                                                <span class="span-name-container" style="@spanNameContainerStyle">
                                                    @if (isServerOrConsumer)
                                                    {
                                                        <DeckIcon Class="span-kind-icon"
                                                                  Style="@($"color: {TraceColorPalette.GetColorVariable(GetResourceName(context.Span.Source))};")"
                                                                  Name="@(TraceHelpers.TryGetSpanIcon(context.Span) ?? DeckIconName.Settings)"
                                                                  Size="16" />
                                                    }

                                                    @if (context.IsError)
                                                    {
                                                        <DeckIcon Name="DeckIconName.ErrorCircle" Size="12" Class="trace-tag-icon icon-error" />
                                                    }
                                                    <Highlighter HighlightedText="@PageViewModel.Filter" Text="@context.Span.GetDisplaySummary()" />
                                                    @if (context.HasUninstrumentedPeer)
                                                    {
                                                        <span class="uninstrumented-peer">
                                                            @{
                                                                DeckIconName icon;
                                                                if (context.Span.Attributes.HasKey("db.system"))
                                                                {
                                                                    icon = DeckIconName.Database;
                                                                }
                                                                else if (context.Span.Attributes.HasKey("messaging.system"))
                                                                {
                                                                    icon = DeckIconName.Mail;
                                                                }
                                                                else
                                                                {
                                                                    // Everything else.
                                                                    icon = DeckIconName.ArrowCircleRight;
                                                                }
                                                            }
                                                            <DeckIcon Name="icon"
                                                                Size="16"
                                                                Style="@($"color: {TraceColorPalette.GetColorVariable(context.UninstrumentedPeer)};")"
                                                                Class="uninstrumented-peer-icon" />
                                                            <Highlighter HighlightedText="@PageViewModel.Filter" Text="@context.UninstrumentedPeer" />
                                                        </span>
                                                    }
                                                </span>
                                                <span @onclick:stopPropagation="true">
                                                    @if (IsGenAISpan(context))
                                                    {
                                                        <button type="button" class="icon-btn icon-btn--sm genai-details-button"
                                                                title="@ControlStringsLoc[nameof(ControlsStrings.GenAIDetailsTitle)]"
                                                                @onclick="() => OnGenAIClickedAsync(context.Span)">
                                                            <DeckIcon Name="DeckIconName.Sparkle" Size="20" Class="icon-accent" />
                                                        </button>
                                                    }
                                                </span>
                                            </div>
                                        </div>
                                    }
                                    @if (resourceColumnVisible)
                                    {
                                        <div class="expand-col" role="cell" title="@GetResourceName(context.Span.Source)">
                                            <div class="resource-name">
                                                <Highlighter HighlightedText="@PageViewModel.Filter" Text="@GetResourceName(context.Span.Source)" />
                                            </div>
                                        </div>
                                    }
                                    @if (ticksColumnVisible)
                                    {
                                        var spanColor = @TraceColorPalette.GetColorVariable(GetResourceName(context.Span.Source));
                                        <div role="cell">
                                            <div class="ticks">
                                                <div class="span-container" style="position: relative; grid-template-columns: @context.LeftOffset.ToString("F2", CultureInfo.InvariantCulture)% @context.Width.ToString("F2", CultureInfo.InvariantCulture)% min-content;">
                                                    <div class="span-button-container">
                                                        @foreach (var item in context.SpanLogs)
                                                        {
                                                            var buttonId = $"{context.Span.SpanId}-{item.LogEntry.InternalId}";
                                                            var eventName = StructureLogsDetailsViewModel.GetEventName(item.LogEntry, StructuredLogsLoc);
                                                            var isSelected = SelectedData?.LogEntryViewModel?.LogEntry.InternalId == item.LogEntry.InternalId;
                                                            var buttonColor = item.LogEntry.IsError ? "var(--error)" : spanColor;

                                                            @* A native title tooltip shows the event summary on hover; clicking the button opens the full log entry details. *@
                                                            <button id="@buttonId"
                                                                    title="@($"{eventName} - {item.LogEntry.Scope.Name}")"
                                                                    aria-label="@StructuredLogsLoc[nameof(Dashboard.Resources.StructuredLogs.StructuredLogsEntryDetails)]"
                                                                    class="@($"span-log-entry-button {(isSelected ? "span-log-entry-selected" : null)} {(item.LogEntry.IsError ? "span-log-entry-error" : null)}")"
                                                                    data-span-color="@spanColor"
                                                                    style="@($"left: {@item.LeftOffset.ToString("F2", CultureInfo.InvariantCulture)}%; --button-color: {buttonColor};")"
                                                                    @onclick="@(() => ToggleSpanLogsAsync(item.LogEntry))"
                                                                    @onclick:stopPropagation="true">
                                                            </button>
                                                        }
                                                    </div>
                                                    <div class="span-bar" style="grid-column: 2; background: @spanColor;"></div>
                                                    <div class="span-bar-label @(context.LabelIsRight ? "span-bar-label-right" : "span-bar-label-left")">
                                                        <span class="span-bar-label-detail">@SpanWaterfallViewModel.GetTitle(context.Span, _resources)</span>
                                                        <span>@DurationFormatter.FormatDuration(context.Span.Duration, CultureInfo.CurrentCulture)</span>
                                                    </div>
                                                </div>
                                                <div class="tick" style="grid-column: 1;"></div>
                                                <div class="tick" style="grid-column: 2;"></div>
                                                <div class="tick" style="grid-column: 3;"></div>
                                                <div class="tick" style="grid-column: 4;"></div>
                                                <div class="tick" style="grid-column: 5;"></div>
                                            </div>
                                        </div>
                                    }
                                    @if (actionsColumnVisible)
                                    {
                                        <div class="no-ellipsis" role="cell">
                                            <div @onclick:stopPropagation="true" style="margin-left: 7px;">
                                                <SpanActions SpanViewModel="@context"
                                                             OnViewDetails="@((buttonId) => OnShowPropertiesAsync(context, buttonId))"
                                                             OnLaunchGenAI="@OnGenAIClickedAsync" />
                                            </div>
                                        </div>
                                    }
                                </div>
                            </Virtualize>
                        }
                    </div>
                </div>
                <ColumnResizer Target="_waterfallGrid" GridColumnsVariable="--trace-grid-columns" />
                </GridColumnManager>
            </div>
        </div>
    }
    else
    {
        <div class="page__body">
            <EmptyState Title="@string.Format(CultureInfo.CurrentCulture, Loc[nameof(Dashboard.Resources.TraceDetail.TraceDetailTraceNotFound)], TraceId)">
                <IconContent>
                    <DeckIcon Name="DeckIconName.GanttChart" Size="24" />
                </IconContent>
            </EmptyState>
        </div>
    }
</div>

@* Span / log detail opens in a Deck-style right-side drawer (replaces the old split details pane). *@
@if (_trace is not null && SelectedData is { } selected)
{
    string? drawerTitle = null;
    string? drawerSubtitle = null;
    if (selected.SpanViewModel is { } headerSpanVm)
    {
        drawerTitle = headerSpanVm.Title;
        drawerSubtitle = OtlpHelpers.ToShortenedId(headerSpanVm.Span.SpanId);
    }
    else if (selected.LogEntryViewModel is { } headerLogVm)
    {
        drawerTitle = StructureLogsDetailsViewModel.GetEventName(headerLogVm.LogEntry, StructuredLogsLoc);
        drawerSubtitle = headerLogVm.LogEntry.Scope.Name;
    }

    <Drawer Title="@drawerTitle" Subtitle="@drawerSubtitle"
            OnClose="@(() => ClearSelectedSpanAsync(causedByUserAction: true))">
        @if (selected.SpanViewModel is { } spanVm)
        {
            <SpanDetails ViewModel="spanVm" HideToolbar="true"
                         CloseCallback="() => ClearSelectedSpanAsync(causedByUserAction: true)"
                         LaunchGenAICallback="@OnGenAIClickedAsync" />
        }
        else if (selected.LogEntryViewModel is { } logEntryVm)
        {
            <StructuredLogDetails ViewModel="logEntryVm"
                                  CloseCallback="() => ClearSelectedSpanAsync(causedByUserAction: true)" />
        }
    </Drawer>
}
