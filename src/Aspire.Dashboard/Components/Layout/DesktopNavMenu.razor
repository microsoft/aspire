@using Aspire.Dashboard.Resources
@inject IStringLocalizer<Layout> Loc
@inject IDashboardClient DashboardClient

<nav class="desktop-nav-menu" aria-label="@Loc[nameof(Layout.NavMenuLandmark)]">
    @{
        var displayedSection = GetDisplayedSection();
    }
    @foreach (var item in GetItems())
    {
        var isActive = item.Section == displayedSection;
        var id = $"desktop-nav-{item.Section.ToString().ToLowerInvariant()}";
        <a id="@id"
           href="@item.Href"
           class="desktop-nav-item @(isActive ? "active" : null)"
           aria-label="@item.Text"
           aria-current="@(isActive ? "page" : null)">
            <FluentIcon Value="@(isActive ? item.ActiveIcon : item.Icon)" Width="20px" Color="Color.Custom" CustomColor="currentColor" />
            <span>@item.Text</span>
        </a>
    }
</nav>
