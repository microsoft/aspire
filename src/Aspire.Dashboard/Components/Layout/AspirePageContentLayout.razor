@using Aspire.Dashboard.Resources

@inject IStringLocalizer<Layout> LayoutLoc
@inject IStringLocalizer<ControlsStrings> ControlsStringsLoc

<div class="content-layout">
    <!-- Toolbar -->
    @if (ViewportInformation.IsDesktop)
    {
        @if (DashboardExperienceComponents.IsLegacyLocation(NavigationManager))
        {
            @* The previous experience keeps main's behavior: the page title is teleported into its top header, which
               has no other indication of the page. *@
            <SectionContent SectionName="@DashboardUIHelpers.PageTitleTopBarSection">
                @PageTitleSection
            </SectionContent>
        }
        else
        {
            @* The header's top-level navigation and the resource header already show where the user is, so the
               page title is kept for assistive technology only. *@
            <div class="visually-hidden">@PageTitleSection</div>
        }

        @* A page can opt out of the desktop toolbar row (HideDesktopToolbar) when it renders its toolbar
           controls somewhere else. Skipping the <header>
           entirely lets the "page-header" grid row collapse instead of leaving an empty toolbar band. *@
        @if (!HideDesktopToolbar)
        {
            <header class="content-header" style="@HeaderStyle" aria-label="@ControlsStringsLoc[nameof(ControlsStrings.PageToolbarLandmark)]">
                @if (AddNewlineOnToolbar)
                {
                    <div class="main-toolbar filter-toolbar" role="toolbar">
                        @ToolbarSection
                    </div>
                }
                else
                {
                    <div class="title-toolbar-inline" role="toolbar">
                        @ToolbarSection
                    </div>
                }
            </header>
        }
    }
    else if (!IsSummaryDetailsViewOpen)
    {
        <header class="content-header">
            <div role="toolbar" style="@HeaderStyle">
                @PageTitleSection

                @if (!AddNewlineOnToolbar)
                {
                    @MobilePageTitleToolbarSection
                }
            </div>

            @if (AddNewlineOnToolbar)
            {
                <div style="padding-left: 18px">@MobilePageTitleToolbarSection</div>
            }
        </header>
    }

    <!-- Main content -->
    <main style="@(ViewportInformation.IsDesktop ? $"grid-area: main; overflow: auto; {MainContentStyle}" : GetMobileMainStyle())">
        @MainSection
    </main>

    <!-- Footer -->
    @if (ViewportInformation.IsDesktop)
    {
        @if (FooterSection is not null && !IsSummaryDetailsViewOpen)
        {
            <footer style="grid-area: footer">@FooterSection</footer>
        }
    }
    else if (!IsSummaryDetailsViewOpen)
    {
        if (FooterSection is not null || ToolbarSection is not null)
        {
            <footer style="grid-area: footer">
                @if (FooterSection is not null)
                {
                    @FooterSection
                }

                @if (ToolbarSection is not null)
                {
                    <FluentButton Class="mobile-toolbar"
                                  Appearance="@ButtonAppearance.Primary"
                                  OnClick="@OpenMobileToolbarAsync">
                        @(MobileToolbarButtonText ?? LayoutLoc[nameof(Layout.PageLayoutViewFilters)])
                    </FluentButton>
                }
            </footer>
        }
    }
</div>
