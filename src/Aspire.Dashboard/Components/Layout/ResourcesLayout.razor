@namespace Aspire.Dashboard.Components.Layout
@inherits LayoutComponentBase
@layout MainLayout
@using Aspire.Dashboard.Components.ResourcesGridColumns
@using Aspire.Dashboard.Model
@using Aspire.Dashboard.Resources
@using Humanizer
@using Microsoft.AspNetCore.Components.Rendering
@using Microsoft.AspNetCore.Components.Sections

@{
    var isGrouped = DashboardClient.IsEnabled && _grouping != ResourcePaneGrouping.None;
    var paneRows = isGrouped ? new List<ResourceGridViewModel>() : GetPaneRows().ToList();
    var parameterRows = GetParameterPaneRows();
    var groups = isGrouped ? GetResourceGroups() : new List<ResourceGroup>();
    var telemetryRows = GetVisibleTelemetryResources().ToList();
    // Grouping by tags puts parameters in the groups (see GetTagGroups). Other groupings list them in their own section.
    var parametersInGroups = isGrouped && _grouping == ResourcePaneGrouping.Tags;
    var groupedItems = groups.SelectMany(g => g.Resources).DistinctBy(r => r.Name).ToList();
    var paneResourceCount = isGrouped ? groupedItems.Count(r => !r.IsParameter) : paneRows.Count;
    var paneParameterCount = parametersInGroups ? groupedItems.Count(r => r.IsParameter) : parameterRows.Count;
    var paneTelemetrySourceCount = telemetryRows.Count;
    var paneItemCount = paneResourceCount + paneParameterCount + paneTelemetrySourceCount;
    var isDesktop = ViewportInformation.IsDesktop;
    var showCollapsedPane = isDesktop && _isPaneCollapsed;

    <div class="resources-layout @(showCollapsedPane ? "pane-collapsed" : string.Empty) @(!isDesktop && _isDrawerOpen ? "drawer-open" : string.Empty)"
         style="@GetLayoutStyle()"
         @ref="_layoutElement">
        <aside class="resource-pane" aria-label="@Loc[DashboardClient.IsEnabled ? nameof(Dashboard.Resources.Layout.ResourcePaneLandmark) : nameof(Dashboard.Resources.Layout.NavMenuTelemetrySourcesTab)]" hidden="@(!isDesktop && !_isDrawerOpen)">
            <div class="resource-pane-head">
                <FluentTextInput TextInputType="TextInputType.Search"
                                 Placeholder="@ControlsStringsLoc[nameof(ControlsStrings.FilterPlaceholder)]"
                                 aria-label="@ControlsStringsLoc[nameof(ControlsStrings.FilterPlaceholder)]"
                                 Class="resource-pane-search"
                                 Immediate="true"
                                 ImmediateDelay="@FluentUIExtensions.InputDelay"
                                 Name="resource-pane-search"
                                 AutoComplete="off"
                                 @bind-Value="_filter.TextFilter">
                    <StartTemplate>
                        <FluentIcon Value="@(new Icons.Regular.Size16.Search())" Color="Color.Primary" />
                    </StartTemplate>
                </FluentTextInput>

                @if (DashboardClient.IsEnabled)
                {
                    var filterTitle = ControlsStringsLoc[nameof(ControlsStrings.ChartContainerFiltersHeader)];
                    <ResourcePaneFilter ButtonId="@FilterButtonId"
                                        Title="@filterTitle"
                                        Groups="@GetFilterGroups"
                                        Resources="@GetFilterCountResources"
                                        @* The popover stays open when a value changes. Handling the callback re-renders the pane. *@
                                        OnChanged="@(() => Task.CompletedTask)" />
                    <AspireMenuButton MenuButtonId="@GroupingButtonId"
                                      ButtonClass="resource-pane-button"
                                      ButtonAppearance="@(_grouping == ResourcePaneGrouping.None ? ButtonAppearance.Default : ButtonAppearance.Primary)"
                                      Icon="@(new Icons.Regular.Size20.GroupList())"
                                      IconColor="Color.Custom"
                                      IconCustomColor="currentColor"
                                      ItemsProvider="@GetGroupingMenuItems"
                                      Title="@Loc[nameof(Dashboard.Resources.Layout.ResourcePaneGrouping)]" />
                }

                @if (!isDesktop)
                {
                    <FluentButton Class="resource-pane-button"
                                  Appearance="ButtonAppearance.Transparent"
                                  IconOnly="true"
                                  IconStart="@(new Icons.Regular.Size16.Dismiss())"
                                  OnClick="CloseDrawer"
                                  data-tooltip="@Loc[nameof(Dashboard.Resources.Layout.ResourcePaneClose)]"
                                  aria-label="@Loc[nameof(Dashboard.Resources.Layout.ResourcePaneClose)]" />
                }
            </div>

            @if (_isLoaded && DashboardClient.IsEnabled)
            {
                var allResources = _resourceByName.Values.Where(r => !r.IsResourceHidden(_filter.ShowHiddenResources)).ToList();
                var allResourceCount = allResources.Count(r => !r.IsParameter);
                var allParameterCount = allResources.Count(r => r.IsParameter);

                @* The toggles are outside the scrolling list, so a scrollbar appearing or leaving never changes their
                   width or layout. They decide what the list shows and what "all resources" covers. *@
                <div class="resource-pane-kinds">
                    <div class="resource-kind-toggles" role="group" aria-label="@Loc[nameof(Dashboard.Resources.Layout.ResourcePaneKindsLandmark)]">
                        @KindToggle(ResourcePaneKind.Resources, allResourceCount, new Icons.Regular.Size20.AppFolder(), ResourcesLoc[nameof(Dashboard.Resources.Resources.ResourcesHeader)])
                        @KindToggle(ResourcePaneKind.Parameters, allParameterCount, new Icons.Regular.Size20.Key(), Loc[nameof(Dashboard.Resources.Layout.NavMenuParametersTab)])
                        @KindToggle(ResourcePaneKind.TelemetrySources, _telemetryOnlyResources.Count, new Icons.Regular.Size20.DataUsage(), Loc[nameof(Dashboard.Resources.Layout.NavMenuTelemetrySourcesTab)])
                    </div>
                    @* Selects every item again, like the "All resources" row. It stays pressed while everything is selected,
                       so it also tells whether a selection narrows the pages, without a line that appears and moves the list. *@
                    <div class="resource-select-all">
                        <button type="button"
                                class="resource-select-all-toggle @(IsAllSelected ? "on" : null)"
                                aria-pressed="@(IsAllSelected ? "true" : "false")"
                                aria-label="@Loc[nameof(Dashboard.Resources.Layout.ResourcePaneSelectAll)]"
                                data-tooltip="@Loc[IsAllSelected ? nameof(Dashboard.Resources.Layout.ResourcePaneAllSelected) : nameof(Dashboard.Resources.Layout.ResourcePaneSelectAll)]"
                                data-tooltip-positioning="above"
                                @onclick="OnAllResourcesClickAsync">
                            <FluentIcon Value="@(new Icons.Regular.Size20.SelectAllOn())" Width="20px" Color="Color.Custom" CustomColor="currentColor" />
                        </button>
                    </div>
                </div>
            }

            <nav class="resource-pane-list @(IsCompact ? "density-compact" : IsSpacious ? "density-spacious" : null)"
                 data-reorder-enabled="@CanReorderResources.ToString().ToLowerInvariant()"
                 data-group-reorder-enabled="@CanReorderGroups.ToString().ToLowerInvariant()"
                 aria-label="@Loc[DashboardClient.IsEnabled ? nameof(Dashboard.Resources.Layout.ResourcePaneLandmark) : nameof(Dashboard.Resources.Layout.NavMenuTelemetrySourcesTab)]">
                <span class="visually-hidden" role="status" aria-live="polite">@_orderStatus</span>
                @if (!_isLoaded)
                {
                    <div class="resource-pane-message">
                        <FluentSpinner Size="SpinnerSize.Small" />
                    </div>
                }
                else if (paneItemCount == 0 && !(isGrouped && _grouping == ResourcePaneGrouping.Tags && TagStore.GetAllTags(_resourceByName.Values).Count == 0) && !DashboardClient.IsEnabled)
                {
                    <div class="resource-pane-message">@Loc[nameof(Dashboard.Resources.Layout.TelemetryPaneNoSources)]</div>
                }

                @if (_isLoaded)
                {
                    var isAllSelected = _selectedResourceNames.Count == 0;
                    var allResources = _resourceByName.Values.Where(r => !r.IsResourceHidden(_filter.ShowHiddenResources)).ToList();
                    var allResourceCount = allResources.Count(r => !r.IsParameter);
                    var allParameterCount = allResources.Count(r => r.IsParameter);
                    var allTelemetrySourceCount = DashboardClient.IsEnabled ? paneTelemetrySourceCount : _telemetryOnlyResources.Count;
                    var allResourcesText = Loc[DashboardClient.IsEnabled ? nameof(Dashboard.Resources.Layout.ResourceHeaderAllResources) : nameof(Dashboard.Resources.Layout.TelemetryHeaderAllSources)].Value;
                    var allResourcesCountText = DashboardClient.IsEnabled
                        ? GetPaneCountText(allResourceCount, allParameterCount, allTelemetrySourceCount)
                        : GetPaneCountText(resourceCount: 0, parameterCount: 0, telemetrySourceCount: allTelemetrySourceCount);

                    @if (!DashboardClient.IsEnabled)
                    {
                    <div class="resource-row resource-row-all @(isAllSelected ? "selected" : string.Empty)">
                        <a class="resource-row-link"
                           href="@GetSelectionUrl([])"
                           aria-current="@(isAllSelected ? "page" : null)"
                           aria-label="@allResourcesText"
                           aria-description="@allResourcesCountText"
                           @onclick="OnAllResourcesClickAsync"
                           @onclick:preventDefault="true">
                            <span class="resource-row-icon">
                               <FluentIcon Width="16px" Value="@(new Icons.Regular.Size20.AppsList())" Color="Color.Custom" CustomColor="currentColor" />
                            </span>
                            <span class="resource-row-text">
                                <span class="resource-row-name">@allResourcesText</span>
                                <span class="resource-row-sub">@RenderPaneCounts(allResourceCount, allParameterCount, allTelemetrySourceCount)</span>
                            </span>
                        </a>
                    </div>
                    }

                }

                @if (_isLoaded && DashboardClient.IsEnabled && paneItemCount == 0 && !(isGrouped && _grouping == ResourcePaneGrouping.Tags && TagStore.GetAllTags(_resourceByName.Values).Count == 0))
                {
                    @* Below the toggles, which are the way to bring items back when every kind is off. *@
                    <div class="resource-pane-message">
                        @(!_showResources && !_showParameters && !_showTelemetryOnlyResources
                            ? Loc[nameof(Dashboard.Resources.Layout.ResourcePaneNoKindsHint)]
                            : ResourcesLoc[nameof(Dashboard.Resources.Resources.ResourcesNoResources)])
                    </div>
                }

                @if (isGrouped)
                {
                    @if (_isLoaded && _grouping == ResourcePaneGrouping.Tags && TagStore.GetAllTags(_resourceByName.Values).Count == 0)
                    {
                        <div class="resource-tags-empty">
                            <FluentIcon Value="@(new Icons.Regular.Size24.TagMultiple())" Width="24px" Color="Color.Custom" CustomColor="var(--colorNeutralForeground3)" />
                            <span class="resource-tags-empty-title">@Loc[nameof(Dashboard.Resources.Layout.ResourcePaneNoTagsTitle)]</span>
                            <span class="resource-tags-empty-description">@Loc[nameof(Dashboard.Resources.Layout.ResourcePaneNoTagsDescription)]</span>
                        </div>
                    }

                    @foreach (var group in groups)
                    {
                        var groupName = GetGroupName(group.Value);
                        var isGroupCollapsed = IsGroupCollapsed(group);
                        var countText = string.Format(CultureInfo.CurrentCulture, group.Resources.Count == 1 ? Loc[nameof(Dashboard.Resources.Layout.ResourcePaneCountSingular)] : Loc[nameof(Dashboard.Resources.Layout.ResourcePaneCountPlural)], group.Resources.Count);

                        <div class="resource-tag-group @(_grouping == ResourcePaneGrouping.Tags && group.Value is null ? "untagged" : string.Empty)"
                             role="group"
                             aria-label="@groupName"
                             data-resource-group-key="@GetGroupKey(group)"
                             data-resource-grouping="@_grouping"
                             @key="@GetGroupKey(group)">
                            @{
                                var groupResourceNames = group.Resources.Select(GetResourceName).ToList();
                                var isGroupSelected = IsResourceGroupSelected(groupResourceNames);

                                <div class="resource-tag-header @(isGroupSelected ? "selected" : string.Empty)">
                                    @* Selecting a group selects all of its resources, like a multi-selection of their rows. *@
                                    <a class="resource-tag-link"
                                       href="@GetSelectionUrl(groupResourceNames)"
                                       aria-current="@(isGroupSelected ? "true" : null)"
                                       aria-label="@string.Format(CultureInfo.CurrentCulture, Loc[nameof(Dashboard.Resources.Layout.ResourcePaneTagGroupLabel)], groupName, countText)"
                                       draggable="@(CanReorderGroups ? "true" : null)"
                                       data-resource-group-drag-handle="@CanReorderGroups"
                                       aria-keyshortcuts="@(CanReorderGroups ? "Alt+ArrowUp Alt+ArrowDown" : null)"
                                       @onclick="@(e => OnResourceGroupClick(e, groupResourceNames))"
                                       @onclick:preventDefault="true">
                                        @if (_grouping == ResourcePaneGrouping.State)
                                        {
                                            <span class="state-dot @GetStateClass(group.Resources[0])"></span>
                                        }
                                        else if (_grouping == ResourcePaneGrouping.ResourceType)
                                        {
                                            <FluentIcon Value="@ResourceIconHelpers.GetIconForResource(IconResolver, group.Resources[0], IconSize.Size16)" Width="16px" Color="Color.Primary" />
                                        }
                                        else if (group.Value is { } tag)
                                        {
                                            <FluentIcon Value="@(new Icons.Filled.Size16.Tag())" Width="16px" Color="Color.Custom" CustomColor="@ColorGenerator.Instance.GetColorVariableByKey(tag)" />
                                        }
                                        else
                                        {
                                            <FluentIcon Value="@(new Icons.Regular.Size16.Tag())" Width="16px" Color="Color.Custom" CustomColor="var(--colorNeutralForeground3)" />
                                        }
                                        <span class="resource-tag-name"><FluentHighlighter HighlightedText="@_filter.TextFilter" Text="@groupName" /></span>
                                        <span class="resource-tag-count" aria-hidden="true">@group.Resources.Count</span>
                                    </a>
                                    <button type="button"
                                            class="resource-row-toggle @(isGroupCollapsed ? "collapsed" : string.Empty)"
                                            aria-expanded="@((!isGroupCollapsed).ToString().ToLowerInvariant())"
                                            aria-label="@string.Format(CultureInfo.CurrentCulture, Loc[nameof(Dashboard.Resources.Layout.ResourcePaneTagGroupToggle)], groupName)"
                                            @onclick="@(() => ToggleGroup(group))">
                                        <FluentIcon Value="@(new Icons.Regular.Size12.ChevronDown())" Color="Color.Default" />
                                    </button>
                                </div>
                            }

                            @if (!isGroupCollapsed)
                            {
                                foreach (var resource in group.Resources)
                                {
                                    RenderResourceRow(__builder, resource, row: null);
                                }
                            }
                        </div>
                    }
                }
                else
                {
                    @if (DashboardClient.IsEnabled && paneRows.Count > 0)
                    {
                        var resourcesCollapsed = IsSectionCollapsed(ResourcesSectionKey);
                        <button type="button"
                                class="resource-pane-section-header"
                                aria-expanded="@((!resourcesCollapsed).ToString().ToLowerInvariant())"
                                @onclick="@(() => ToggleSection(ResourcesSectionKey))">
                            <span>@ResourcesLoc[nameof(Dashboard.Resources.Resources.ResourcesHeader)]</span>
                            <span class="resource-pane-section-count">@paneRows.Count</span>
                            <span class="resource-pane-section-chevron @(resourcesCollapsed ? "collapsed" : null)">
                                <FluentIcon Value="@(new Icons.Regular.Size12.ChevronDown())" Color="Color.Default" />
                            </span>
                        </button>
                    }
                    @if (!IsSectionCollapsed(ResourcesSectionKey))
                    {
                        foreach (var row in paneRows)
                        {
                            RenderResourceRow(__builder, row.Resource, row);
                        }
                    }
                }

                @if (DashboardClient.IsEnabled && !parametersInGroups && parameterRows.Count > 0)
                {
                    var parametersCollapsed = IsSectionCollapsed(ParametersSectionKey);
                    <button type="button"
                            class="resource-pane-section-header"
                            aria-expanded="@((!parametersCollapsed).ToString().ToLowerInvariant())"
                            @onclick="@(() => ToggleSection(ParametersSectionKey))">
                        <span>@Loc[nameof(Dashboard.Resources.Layout.NavMenuParametersTab)]</span>
                        <span class="resource-pane-section-count">@parameterRows.Count</span>
                        <span class="resource-pane-section-chevron @(parametersCollapsed ? "collapsed" : null)">
                            <FluentIcon Value="@(new Icons.Regular.Size12.ChevronDown())" Color="Color.Default" />
                        </span>
                    </button>
                    @if (!parametersCollapsed)
                    {
                        foreach (var parameter in parameterRows)
                        {
                            RenderResourceRow(__builder, parameter, row: null);
                        }
                    }
                }

                @if (telemetryRows.Count > 0)
                {
                    var telemetryCollapsed = IsSectionCollapsed(TelemetrySectionKey);
                    <button type="button"
                            class="resource-pane-section-header"
                            aria-expanded="@((!telemetryCollapsed).ToString().ToLowerInvariant())"
                            @onclick="@(() => ToggleSection(TelemetrySectionKey))">
                        <span>@Loc[nameof(Dashboard.Resources.Layout.NavMenuTelemetrySourcesTab)]</span>
                        <span class="resource-pane-section-count">@telemetryRows.Count</span>
                        <span class="resource-pane-section-chevron @(telemetryCollapsed ? "collapsed" : null)">
                            <FluentIcon Value="@(new Icons.Regular.Size12.ChevronDown())" Color="Color.Default" />
                        </span>
                    </button>
                    @if (!telemetryCollapsed)
                    {
                        @foreach (var telemetryResource in telemetryRows)
                        {
                            var telemetryResourceName = telemetryResource.Name;
                            var isSelected = IsSelected(telemetryResourceName);
                            <div class="resource-row @(isSelected || IsAllSelected ? "selected" : string.Empty)" @key="@($"otlp:{telemetryResourceName}")">
                                <a class="resource-row-link"
                                   href="@GetRowUrl(telemetryResourceName)"
                                   aria-current="@GetRowAriaCurrent(isSelected)"
                                   aria-label="@telemetryResourceName"
                                   aria-description="@Loc[nameof(Dashboard.Resources.Layout.NavMenuTelemetrySourcesTab)]"
                                   @onclick="@(e => OnRowClickAsync(e, telemetryResourceName))"
                                   @onclick:preventDefault="true">
                                    <span class="resource-row-icon">
                                        <FluentIcon Width="16px"
                                                    Color="Color.Custom"
                                                    CustomColor="@ColorGenerator.Instance.GetColorVariableByKey(telemetryResourceName)"
                                                    Value="@(new Icons.Regular.Size16.DataUsage())" />
                                    </span>
                                    <span class="resource-row-text">
                                        <span class="resource-row-name"><FluentHighlighter HighlightedText="@_filter.TextFilter" Text="@telemetryResourceName" /></span>
                                    </span>
                                </a>
                            </div>
                        }
                    }
                }
            </nav>

            @if (!isDesktop)
            {
                <div class="resource-pane-foot">
                    <span role="img" aria-label="@GetPaneCountText(paneResourceCount, paneParameterCount, paneTelemetrySourceCount)">
                        @RenderPaneCounts(paneResourceCount, paneParameterCount, paneTelemetrySourceCount)
                    </span>
                    @if (DashboardClient.IsEnabled)
                    {
                        <AspireMenuButton ButtonAppearance="ButtonAppearance.Transparent"
                                          Icon="@(new Icons.Regular.Size16.MoreHorizontal())"
                                          ItemsProvider="@(() => _paneMenuItems)"
                                          Title="@ResourcesLoc[nameof(Dashboard.Resources.Resources.ResourcesChangeViewOptions)]" />
                    }
                </div>
            }

            @if (isDesktop)
            {
                @* Pointer and keyboard handling is registered by ResourcesLayout.razor.js. *@
                <div class="resource-pane-resizer"
                     role="separator"
                     tabindex="0"
                     aria-orientation="vertical"
                     aria-label="@Loc[nameof(Dashboard.Resources.Layout.ResourcePaneResize)]"
                     aria-valuemin="@MinimumPaneWidthPx"
                     aria-valuemax="@MaximumPaneWidthPx"
                     aria-valuenow="@(_paneWidth ?? DefaultPaneWidthPx)"></div>
            }
        </aside>

        <section class="resource-content">
            <header class="resource-header">
                @{ RenderHeaderRow(__builder, isDesktop); }

                @if (isDesktop)
                {
                    <StableSectionContent SectionName="@MainLayout.HeaderContextSectionName">
                        @((RenderFragment)(builder => RenderTabNavigation(builder, isDesktop: true)))
                    </StableSectionContent>
                }

                @if (!isDesktop)
                {
                    <div class="resource-tabs" @key="typeof(ResourcesLayout)">
                        @((RenderFragment)(builder => RenderTabNavigation(builder, isDesktop: false)))
                    </div>
                }
            </header>

            <div class="resource-tab-body">
                <CascadingValue Value="this" IsFixed="true" @key="IsTelemetryPane">
                    @Body
                </CascadingValue>
            </div>
        </section>

        @if (isDesktop)
        {
            <footer class="resource-workspace-foot">
                @if (!_isPaneCollapsed)
                {
                    <div class="resource-pane-foot">
                        <span role="img" aria-label="@GetPaneCountText(paneResourceCount, paneParameterCount, paneTelemetrySourceCount)">
                            @RenderPaneCounts(paneResourceCount, paneParameterCount, paneTelemetrySourceCount)
                        </span>
                        <div class="resource-pane-foot-actions">
                            @if (DashboardClient.IsEnabled)
                            {
                                <AspireMenuButton ButtonAppearance="ButtonAppearance.Transparent"
                                                  Icon="@(new Icons.Regular.Size16.MoreHorizontal())"
                                                  ItemsProvider="@(() => _paneMenuItems)"
                                                  Title="@ResourcesLoc[nameof(Dashboard.Resources.Resources.ResourcesChangeViewOptions)]" />
                            }
                        </div>
                    </div>
                }
                <div class="resource-content-foot">
                    @if (SelectedResource is { IsParameter: false } footerResource)
                    {
                        <div class="resource-footer-status">
                            @{ RenderSelectedResourceMeta(__builder, footerResource); }
                        </div>
                    }
                    <div class="resource-footer-page-status">
                        <SectionOutlet SectionName="@FooterStatusSectionName" />
                    </div>
                </div>
            </footer>
        }
    </div>
}

@code {
    // A resource's highlighted commands, such as Start and Stop, and its "more" menu. The resource overview shows them
    // with labels; the resource list shows them as icons on each row. The menu is built when it opens, so the list
    // doesn't build a menu for every resource it renders.
    internal RenderFragment RenderResourceActions(ResourceViewModel resource, bool showLabels, DisplayedUrl? primaryUrl = null) => __builder =>
    {
        var resourceName = GetResourceName(resource);
        var actionIndex = 0;
        <div class="@(showLabels ? "resource-actions" : "resource-row-actions")">
            @if (!showLabels && primaryUrl?.Url is { } primaryEndpointUrl)
            {
                var primaryEndpointLabel = $"{primaryUrl.DisplayName ?? primaryUrl.Name}: {primaryEndpointUrl}";
                <a class="@($"{GetResourceRowActionClass(actionIndex++)} resource-row-primary-endpoint")"
                   href="@primaryEndpointUrl"
                   target="_blank"
                   rel="noreferrer noopener"
                   data-tooltip="@primaryEndpointLabel"
                   data-tooltip-positioning="above"
                   aria-label="@primaryEndpointLabel"
                   @onclick:stopPropagation="true"
                   @onkeydown:stopPropagation="true">
                    <FluentIcon Value="@(new Icons.Regular.Size16.Open())" Color="Color.Primary" />
                </a>
            }
            @if (!showLabels && CanViewResourceTerminal(resource))
            {
                var terminalLabel = string.Format(CultureInfo.CurrentCulture, TerminalLoc[nameof(TerminalStrings.TerminalOpenForResource)], resourceName);
                <a class="@($"{GetResourceRowActionClass(actionIndex++)} resource-row-terminal")"
                   href="@GetResourceTerminalUrl(resource)"
                   data-tooltip="@terminalLabel"
                   data-tooltip-positioning="above"
                   aria-label="@terminalLabel"
                   @onclick="@(() => NavigateToResourceTerminal(resource))"
                   @onclick:preventDefault="true"
                   @onclick:stopPropagation="true"
                   @onkeydown:stopPropagation="true">
                    <FluentIcon Value="@(new Icons.Regular.Size20.WindowConsole())" Width="16px" Color="Color.Primary" />
                </a>
            }
            @foreach (var command in GetHighlightedCommands(resource))
            {
                var commandTitle = !string.IsNullOrEmpty(command.GetDisplayDescription()) ? command.GetDisplayDescription() : command.GetDisplayName();
                if (showLabels)
                {
                    <FluentButton Appearance="ButtonAppearance.Default"
                                  data-tooltip="@commandTitle"
                                  IconStart="@IconResolver.ResolveHighlightedCommandIcon(command.IconName, command.IconVariant).WithColor(Color.Primary)"
                                  OnClick="@(() => ExecuteResourceCommandAsync(resource, command))"
                                  Disabled="@IsCommandDisabled(resource, command)">
                        @command.GetDisplayName()
                    </FluentButton>
                }
                else
                {
                    <FluentButton Appearance="ButtonAppearance.Transparent"
                                  Class="@GetResourceRowActionClass(actionIndex++)"
                                  IconOnly="true"
                                  IconStart="@IconResolver.ResolveHighlightedCommandIcon(command.IconName, command.IconVariant).WithColor(Color.Primary)"
                                  data-tooltip="@commandTitle"
                                  data-tooltip-positioning="above"
                                  aria-label="@($"{command.GetDisplayName()} {resourceName}")"
                                  OnClick="@(() => ExecuteResourceCommandAsync(resource, command))"
                                  Disabled="@IsCommandDisabled(resource, command)" />
                }
            }
            <AspireMenuButton ButtonAppearance="@(showLabels ? ButtonAppearance.Default : ButtonAppearance.Transparent)"
                              ButtonClass="@(showLabels ? null : "resource-row-action")"
                              Icon="@(new Icons.Regular.Size16.MoreHorizontal())"
                              IconColor="Color.Custom"
                              IconCustomColor="currentColor"
                              ItemsProvider="@(() => GetResourceMenuItems(resource))"
                              data-tooltip-positioning="@(!showLabels ? "above" : null)"
                              Title="@string.Format(CultureInfo.CurrentCulture, Loc[nameof(Dashboard.Resources.Layout.ResourcePaneResourceActions)], resourceName)" />
        </div>
    };

    private RenderFragment KindToggle(ResourcePaneKind kind, int count, Icon icon, string fullLabel) => __builder =>
    {
        var isOn = IsKindShown(kind);
        var countText = kind switch
        {
            ResourcePaneKind.Resources => string.Format(CultureInfo.CurrentCulture, Loc[count == 1 ? nameof(Dashboard.Resources.Layout.ResourcePaneCountSingular) : nameof(Dashboard.Resources.Layout.ResourcePaneCountPlural)], count),
            ResourcePaneKind.Parameters => string.Format(CultureInfo.CurrentCulture, Loc[count == 1 ? nameof(Dashboard.Resources.Layout.ResourcePaneParameterCountSingular) : nameof(Dashboard.Resources.Layout.ResourcePaneParameterCountPlural)], count),
            _ => string.Format(CultureInfo.CurrentCulture, Loc[count == 1 ? nameof(Dashboard.Resources.Layout.TelemetryPaneCountSingular) : nameof(Dashboard.Resources.Layout.TelemetryPaneCountPlural)], count)
        };

        @* Icon-only, like the layout switcher. The name and count are the tooltip and the accessible description. The segments are the same size on or off, so toggling never moves the list below. *@
        <button type="button"
                class="resource-kind-toggle @(isOn ? "on" : null)"
                aria-pressed="@(isOn ? "true" : "false")"
                aria-label="@fullLabel"
                aria-description="@countText"
                data-tooltip="@string.Format(CultureInfo.CurrentCulture, Loc[isOn ? nameof(Dashboard.Resources.Layout.ResourcePaneKindHide) : nameof(Dashboard.Resources.Layout.ResourcePaneKindShow)], countText)"
                data-tooltip-positioning="above"
                @onclick="@(() => ToggleKindAsync(kind))">
            <FluentIcon Value="@icon" Width="20px" Color="Color.Custom" CustomColor="currentColor" />
        </button>
    };
    private RenderFragment RenderPaneCounts(int resourceCount, int parameterCount, int telemetrySourceCount) => __builder =>
    {
        <span class="resource-pane-counts" aria-hidden="true">
            @if (resourceCount > 0)
            {
                var text = string.Format(
                    CultureInfo.CurrentCulture,
                    Loc[resourceCount == 1 ? nameof(Dashboard.Resources.Layout.ResourcePaneCountSingular) : nameof(Dashboard.Resources.Layout.ResourcePaneCountPlural)],
                    resourceCount);
                <span class="resource-pane-count" data-tooltip="@text">
                    <FluentIcon Value="@(new Icons.Regular.Size24.AppFolder())" Width="14px" Color="Color.Custom" CustomColor="currentColor" />
                    <span>@resourceCount</span>
                </span>
            }
            @if (parameterCount > 0)
            {
                var text = string.Format(
                    CultureInfo.CurrentCulture,
                    Loc[parameterCount == 1 ? nameof(Dashboard.Resources.Layout.ResourcePaneParameterCountSingular) : nameof(Dashboard.Resources.Layout.ResourcePaneParameterCountPlural)],
                    parameterCount);
                <span class="resource-pane-count" data-tooltip="@text">
                    <FluentIcon Value="@(new Icons.Regular.Size16.Key())" Width="14px" Color="Color.Custom" CustomColor="currentColor" />
                    <span>@parameterCount</span>
                </span>
            }
            @if (telemetrySourceCount > 0)
            {
                var text = string.Format(
                    CultureInfo.CurrentCulture,
                    Loc[telemetrySourceCount == 1 ? nameof(Dashboard.Resources.Layout.TelemetryPaneCountSingular) : nameof(Dashboard.Resources.Layout.TelemetryPaneCountPlural)],
                    telemetrySourceCount);
                <span class="resource-pane-count" data-tooltip="@text">
                    <FluentIcon Value="@(new Icons.Regular.Size16.DataUsage())" Width="14px" Color="Color.Custom" CustomColor="currentColor" />
                    <span>@telemetrySourceCount</span>
                </span>
            }
        </span>
    };

    private static string GetResourceRowActionClass(int actionIndex) =>
        $"resource-row-action resource-row-action-priority-{Math.Min(actionIndex, 3)}";

    // On desktop the title is a heading. On mobile it also opens the resource list, which is a full-screen sheet, so it
    // is drawn as a select, with the list icon and a chevron, to show that it can be changed. The button is inside the
    // heading rather than replacing it, so the page keeps its heading. A raw button gives the full-width, start-aligned
    // layout that a FluentButton can't without styling its shadow parts.
    private void RenderTitle(RenderTreeBuilder __builder, string text, bool isDesktop)
    {
        if (isDesktop)
        {
    <h1 class="resource-title">@text</h1>
        }
        else
        {
    <h1 class="resource-title">
        <button type="button"
                class="resource-picker resource-pane-open-button"
                aria-haspopup="dialog"
                aria-expanded="@(_isDrawerOpen ? "true" : "false")"
                aria-description="@Loc[nameof(Dashboard.Resources.Layout.ResourcePaneOpen)]"
                @onclick="OpenDrawer">
            <FluentIcon Class="resource-picker-leading-icon" Value="@(new Icons.Regular.Size20.TextBulletListLtr())" Width="20px" Color="Color.Primary" />
            <span class="resource-picker-text">@text</span>
            <FluentIcon Class="resource-picker-chevron" Value="@(new Icons.Regular.Size16.ChevronDown())" Width="16px" Color="Color.Custom" CustomColor="currentColor" />
        </button>
    </h1>
        }
    }

    private void RenderHeaderRow(RenderTreeBuilder __builder, bool isDesktop)
    {
    <div class="resource-header-row">
        @if (isDesktop)
        {
            <FluentButton Class="resource-pane-toggle-button"
                          Appearance="ButtonAppearance.Default"
                          IconOnly="true"
                          IconStart="@(_isPaneCollapsed ? new Icons.Regular.Size20.PanelLeftExpand() : new Icons.Regular.Size20.PanelLeftContract())"
                          OnClick="TogglePaneCollapsedAsync"
                          data-tooltip="@Loc[_isPaneCollapsed ? nameof(Dashboard.Resources.Layout.ResourcePaneExpand) : nameof(Dashboard.Resources.Layout.ResourcePaneCollapse)]"
                          aria-label="@Loc[_isPaneCollapsed ? nameof(Dashboard.Resources.Layout.ResourcePaneExpand) : nameof(Dashboard.Resources.Layout.ResourcePaneCollapse)]"
                          aria-expanded="@((!_isPaneCollapsed).ToString().ToLowerInvariant())" />
        }
        @if (CurrentTab == ResourceTab.Parameters)
        {
            <span class="resource-header-icon neutral">
                <FluentIcon Width="20px" Value="@(new Icons.Regular.Size20.Key())" Color="Color.Default" />
            </span>
            <div class="resource-header-text">
                <div class="resource-header-title">
                    @{ RenderTitle(__builder, Loc[nameof(Dashboard.Resources.Layout.NavMenuParametersTab)], isDesktop); }
                </div>
            </div>
        }
        else if (SelectedResource is { } selected)
        {
            var selectedName = GetResourceName(selected);
            <span class="resource-header-icon">
                <FluentIcon Width="20px"
                            Color="Color.Custom"
                            CustomColor="@ColorGenerator.Instance.GetColorVariableByKey(selectedName)"
                            Value="@ResourceIconHelpers.GetIconForResource(IconResolver, selected, IconSize.Size20)" />
                <PersistentContainerBadge Resource="@selected" />
            </span>
            <div class="resource-header-text">
                <div class="resource-header-title">
                    @{ RenderTitle(__builder, selectedName, isDesktop); }
                </div>
                @if (!isDesktop)
                {
                    <div class="resource-header-meta">
                        @{ RenderSelectedResourceMeta(__builder, selected); }
                    </div>
                }
            </div>
        }
        else if (SelectedTelemetryOnlyResource is { } telemetryOnly)
        {
            <span class="resource-header-icon">
                <FluentIcon Width="20px"
                            Color="Color.Custom"
                            CustomColor="@ColorGenerator.Instance.GetColorVariableByKey(telemetryOnly.Name)"
                            Value="@(new Icons.Regular.Size20.DataUsage())" />
            </span>
            <div class="resource-header-text">
                <div class="resource-header-title">
                    @{ RenderTitle(__builder, telemetryOnly.Name, isDesktop); }
                </div>
            </div>
        }
        else if (IsMultiSelection)
        {
            var selectedItemsAreParameters = _selectedItems.All(item => item.Resource is { IsParameter: true });
            <span class="resource-header-icon">
                @if (selectedItemsAreParameters)
                {
                    <FluentIcon Width="20px" Value="@(new Icons.Regular.Size20.Key())" Color="Color.Primary" />
                }
                else
                {
                    <FluentIcon Width="20px" Value="@(new Icons.Regular.Size20.Stack())" Color="Color.Primary" />
                }
            </span>
            <div class="resource-header-text">
                <div class="resource-header-title">
                    @{
                        var title = string.Format(
                            CultureInfo.CurrentCulture,
                            Loc[selectedItemsAreParameters
                                ? nameof(Dashboard.Resources.Layout.ResourceHeaderSelectedParameters)
                                : nameof(Dashboard.Resources.Layout.ResourceHeaderSelectedResources)],
                            _selectedItems.Count);
                        RenderTitle(__builder, title, isDesktop);
                    }
                </div>
            </div>
        }
        else if (SelectedResourceName is not null && _isLoaded)
        {
            <span class="resource-header-icon neutral">
                <FluentIcon Width="20px" Value="@(new Icons.Regular.Size20.QuestionCircle())" Color="Color.Default" />
            </span>
            <div class="resource-header-text">
                <div class="resource-header-title">
                    @{ RenderTitle(__builder, SelectedResourceName, isDesktop); }
                </div>
                <div class="resource-header-meta">@Loc[nameof(Dashboard.Resources.Layout.ResourceHeaderNotFound)]</div>
            </div>
        }
        else
        {
            <span class="resource-header-icon neutral">
                <FluentIcon Width="20px" Value="@(new Icons.Regular.Size20.AppsList())" Color="Color.Default" />
            </span>
            <div class="resource-header-text">
                <div class="resource-header-title">
                    @{ RenderTitle(__builder, GetScopeTitle(), isDesktop); }
                </div>
            </div>
        }
        <div class="resource-header-controls">
            <div class="resource-header-actions">
                <SectionOutlet SectionName="@HeaderActionsSectionName" />
            </div>
            @if (isDesktop)
            {
                <div class="resource-tab-toolbar">
                    <SectionOutlet SectionName="@TabToolbarSectionName" />
                </div>
            }
        </div>
    </div>
    }

    private void RenderSelectedResourceMeta(RenderTreeBuilder __builder, ResourceViewModel resource)
    {
        var selectedState = ResourceStateViewModel.GetStateViewModel(resource, ColumnsLoc);
        var urls = ResourceUrlHelpers.GetUrls(resource, includeInternalUrls: false, includeNonEndpointUrls: true);

        <span class="state-pill @GetStateClass(resource)">
            <FluentIcon Value="@selectedState.Icon" Width="12px" Color="Color.Custom" CustomColor="currentColor" />
            @selectedState.Text
        </span>
        <span class="resource-status-type">@GetResourceTypeLabel(resource)</span>
        @if (resource.StartTimeStamp is not null)
        {
            <span class="resource-header-sep" aria-hidden="true">·</span>
            <span>@Loc[nameof(Dashboard.Resources.Layout.ResourceHeaderStarted)] <StartTimeColumnDisplay Resource="@resource" /></span>
        }
        @if (urls.Count > 0)
        {
            <span class="resource-header-sep" aria-hidden="true">·</span>
            <span class="resource-header-urls">
                <UrlsColumnDisplay Resource="@resource" HasMultipleReplicas="@HasMultipleReplicas(resource)" DisplayedUrls="@urls" />
            </span>
        }
    }

    private void RenderTabNavigation(RenderTreeBuilder __builder, bool isDesktop)
    {
        // When the row no longer has room for every label, the container query swaps this for the compact dropdown
        // instead of letting the top navigation grow its own scrollbar.
        // While a tab click navigates, the strip keeps showing the clicked tab (see OnTabChanged).
        var activeTab = _navigatingToTab ?? CurrentTab;
        var renderedLocation = _lastLocation;
        var currentTabItem = GetTabs().FirstOrDefault(t => t.Tab == activeTab);
    <div class="resource-tabs-nav">
        @* Keep queued native change events bound to their original location. Reusing the component would
           rebind its callback before those events arrive, making an old change look like a new user navigation. *@
        <FluentTabs @key="renderedLocation"
                    Class="resources-tab-header"
                    ActiveTabId="@GetTabId(activeTab)"
                    ActiveTabChanged="@(tab => OnTabChanged(tab, isDesktop, renderedLocation))"
                    Size="null">
            @foreach (var tab in GetTabs())
            {
                <FluentTab HeaderClass="tab-label"
                           Id="@GetTabId(tab.Tab)"
                           Visible="@tab.IsVisible"
                           data-tooltip="@(tab.IsAvailable ? null : Loc[nameof(Dashboard.Resources.Layout.ResourceTabUnavailable)])"
                           IconStart="@tab.Icon">
                    <HeaderTemplate>
                        <span>@tab.Text</span>
                        @if (tab.ErrorCount > 0)
                        {
                            <FluentBadge Class="resource-tab-error-count" Appearance="BadgeAppearance.Tint" Circular="true">@tab.ErrorCount</FluentBadge>
                        }
                    </HeaderTemplate>
                </FluentTab>
            }
        </FluentTabs>
        @* Tabs that don't fit the row move here, from the right (see registerTabOverflow). *@
        <div class="resource-tabs-overflow @(_overflowTabIds.Length > 0 ? "has-overflow" : null) @(_overflowTabIds.Contains(GetTabId(activeTab)) ? "has-active" : null)">
            <AspireMenuButton ButtonClass="resource-tabs-overflow-button"
                              Icon="@(new Icons.Regular.Size20.MoreHorizontal())"
                              IconColor="Color.Custom"
                              IconCustomColor="currentColor"
                              ButtonAppearance="ButtonAppearance.Transparent"
                              ItemsProvider="@GetOverflowMenuItems"
                              Title="@Loc[nameof(Dashboard.Resources.Layout.ResourceTabsMore)]" />
        </div>
        @* The button already shows the current view, so a tooltip would only cover the controls above it. *@
        <AspireMenuButton ButtonClass="resource-tabs-compact-button"
                          Text="@currentTabItem?.Text"
                          IconStart="@currentTabItem?.Icon"
                          ButtonAppearance="ButtonAppearance.Default"
                          ItemsProvider="@GetTabMenuItems"
                          Title="@Loc[nameof(Dashboard.Resources.Layout.ResourceTabsLandmark)]"
                          data-tooltip="" />
    </div>
    }

    // Rows are rendered by a method rather than a RenderFragment so each row's @key stays among its siblings.
    private void RenderResourceRow(RenderTreeBuilder __builder, ResourceViewModel resource, ResourceGridViewModel? row)
    {
        var resourceName = GetResourceName(resource);
        var isSelected = IsSelected(resourceName);
        var stateViewModel = ResourceStateViewModel.GetStateViewModel(resource, ColumnsLoc);
        var errorCount = GetUnviewedErrorCount(resource);
        var depth = row?.Depth ?? 0;
        var primaryUrl = ResourceUrlHelpers.GetUrls(resource, includeInternalUrls: false, includeNonEndpointUrls: true)
            .FirstOrDefault(url => url.Url is not null);
        var source = ResourceSourceViewModel.GetSourceViewModel(resource);
        // The whole row is the drag source, so reordering doesn't need a separate grip.
        var canReorder = CanReorderResources && !resource.IsParameter;

        <div class="resource-row @(isSelected || IsAllSelected ? "selected" : string.Empty) @(resource.IsResourceHidden(showHiddenResources: false) ? "resource-row-hidden" : null)"
             data-resource-name="@resource.Name"
             data-resource-parent="@GetReorderParentName(resource)"
             @key="resource.Name">
            <a class="resource-row-link"
               href="@GetRowUrl(resourceName)"
               style="@(depth == 0 ? null : $"--resource-row-depth: {depth}")"
               aria-current="@GetRowAriaCurrent(isSelected)"
               aria-label="@resourceName"
               aria-description="@GetResourceAccessibilityDescription(resource, stateViewModel.Text, errorCount)"
               draggable="@(canReorder ? "true" : null)"
               data-resource-drag-handle="@canReorder"
               aria-keyshortcuts="@(canReorder ? "Alt+ArrowUp Alt+ArrowDown" : null)"
               @onclick="@(e => OnRowClickAsync(e, resourceName))"
               @onclick:preventDefault="true">
                <span class="resource-row-icon">
                    <FluentIcon Width="@(IsSpacious ? "20px" : "16px")"
                                Color="Color.Custom"
                                CustomColor="@ColorGenerator.Instance.GetColorVariableByKey(resourceName)"
                                Value="@ResourceIconHelpers.GetIconForResource(IconResolver, resource, IsSpacious ? IconSize.Size20 : IconSize.Size16)" />
                    <PersistentContainerBadge Resource="@resource" />
                </span>
                @if (IsCompact)
                {
                    @* One line per resource: the name, then aligned columns for type and state, so they line up from
                       row to row. The state is a dot here; its name is in the tooltip and the label. *@
                    <span class="resource-row-text">
                        <span class="resource-row-name"><FluentHighlighter HighlightedText="@_filter.TextFilter" Text="@resourceName" /></span>
                        @if (resource.IsResourceHidden(showHiddenResources: false))
                        {
                            <FluentIcon Value="@(new Icons.Regular.Size16.EyeOff())"
                                        Class="resource-row-hidden-icon"
                                        data-tooltip="@ColumnsLoc[nameof(Columns.HiddenResourceIconTooltip)]"
                                        aria-label="@ColumnsLoc[nameof(Columns.HiddenResourceIconTooltip)]"
                                        Color="Color.Custom" CustomColor="var(--colorNeutralForeground3)" />
                        }
                    </span>
                    @if (errorCount > 0)
                    {
                        <span class="error-badge" data-tooltip="@string.Format(CultureInfo.CurrentCulture, Loc[nameof(Dashboard.Resources.Layout.ResourcePaneUnviewedErrors)], errorCount)">@errorCount</span>
                    }
                    <span class="resource-row-meta">
                        <span class="resource-row-type @(resource.IsPersistentContainer ? "resource-row-type-persistent" : null)" data-tooltip="@GetResourceTypeLabel(resource)">@GetResourceTypeLabel(resource)</span>
                        <span class="resource-row-meta-state" data-tooltip="@stateViewModel.Text">
                            <span class="state-dot @GetStateClass(resource)"></span>
                        </span>
                    </span>
                }
                else
                {
                    <span class="resource-row-text">
                        <span class="resource-row-title">
                            <span class="resource-row-name"><FluentHighlighter HighlightedText="@_filter.TextFilter" Text="@resourceName" /></span>
                        </span>
                        <span class="resource-row-sub">
                            @if (resource.IsResourceHidden(showHiddenResources: false))
                            {
                                <FluentIcon Value="@(new Icons.Regular.Size16.EyeOff())"
                                            data-tooltip="@ColumnsLoc[nameof(Columns.HiddenResourceIconTooltip)]"
                                            aria-label="@ColumnsLoc[nameof(Columns.HiddenResourceIconTooltip)]"
                                            Color="Color.Custom" CustomColor="var(--colorNeutralForeground3)" />
                            }
                            <span class="state-dot @GetStateClass(resource)"></span>
                            <span>@stateViewModel.Text</span>
                            <span class="resource-row-sep" aria-hidden="true">·</span>
                            <span class="resource-row-type @(resource.IsPersistentContainer ? "resource-row-type-persistent" : null)" data-tooltip="@GetResourceTypeLabel(resource)">@GetResourceTypeLabel(resource)</span>
                        </span>
                        @if (IsSpacious && !resource.IsParameter)
                        {
                            @if (resource.StartTimeStamp is not null)
                            {
                                @* How long ago it started. The tooltip adds the exact time. *@
                                <span class="resource-row-detail resource-row-started" data-tooltip="@GetStartedTooltip(resource)">
                                    <FluentIcon Value="@(new Icons.Regular.Size12.Clock())" Width="12px" Color="Color.Custom" CustomColor="currentColor" />
                                    <span>@GetStartedAge(resource)</span>
                                </span>
                            }
                            @if (resource.HealthStatus is { } healthStatus &&
                                 healthStatus != Microsoft.Extensions.Diagnostics.HealthChecks.HealthStatus.Healthy)
                            {
                                <span class="resource-row-detail">
                                    <span>@healthStatus.Humanize()</span>
                                </span>
                            }
                            else if (primaryUrl?.Url is not null)
                            {
                                <span class="resource-row-detail" data-tooltip="@primaryUrl.Url">
                                    <span>@primaryUrl.Text</span>
                                </span>
                            }
                            else if (source is not null)
                            {
                                <span class="resource-row-detail" data-tooltip="@source.Tooltip">
                                    <span>@source.Value</span>
                                </span>
                            }
                        }
                    </span>
                    @if (errorCount > 0)
                    {
                        <span class="error-badge" data-tooltip="@string.Format(CultureInfo.CurrentCulture, Loc[nameof(Dashboard.Resources.Layout.ResourcePaneUnviewedErrors)], errorCount)">@errorCount</span>
                    }
                }
            </a>
            @RenderResourceActions(resource, showLabels: false, primaryUrl)
            @if (row is { Children.Count: > 0 })
            {
                <button type="button"
                        class="resource-row-toggle @(row.IsCollapsed ? "collapsed" : string.Empty)"
                        aria-label="@ControlsStringsLoc[nameof(ControlsStrings.ToggleNesting)]"
                        aria-expanded="@((!row.IsCollapsed).ToString().ToLowerInvariant())"
                        @onclick="@(() => OnToggleCollapseAsync(row))">
                    <FluentIcon Value="@(new Icons.Regular.Size12.ChevronDown())" Color="Color.Default" />
                </button>
            }
            else if (IsCompact)
            {
                @* Keeps the compact columns aligned with those of parent rows, which end with the expand toggle. *@
                <span class="resource-row-toggle-spacer" aria-hidden="true"></span>
            }
        </div>
    }
}
