    private static string GetResourceRowActionClass(int actionIndex) =>
        $"resource-row-action resource-row-action-priority-{Math.Min(actionIndex, 3)}";

    // Keep the heading when its title opens the resource list: a popover on collapsed desktop layouts, or a full-screen
    // sheet on mobile. The mobile picker uses a raw button for its full-width, start-aligned layout.
    private void RenderTitle(RenderTreeBuilder __builder, string text, bool isDesktop)
    {
        if (isDesktop && !_isPaneCollapsed)
        {
    <h1 class="resource-title">@text</h1>
        }
        else if (isDesktop)
        {
    <h1 class="resource-title">
        <FluentButton Id="@ResourcePickerButtonId"
                      Class="resource-picker-button"
                      Style="anchor-name: --resource-picker"
                      Appearance="ButtonAppearance.Default"
                      IconEnd="@(new Icons.Regular.Size16.ChevronDown())"
                      OnClick="ToggleResourcePicker"
                      aria-haspopup="dialog"
                      aria-expanded="@(_isResourcePickerOpen ? "true" : "false")"
                      aria-description="@Loc[nameof(Dashboard.Resources.Layout.ResourcePaneOpen)]">
            <span slot="start">@((RenderFragment)RenderHeaderIcon)</span>
            <span class="resource-picker-text">@text</span>
        </FluentButton>
    </h1>
        }
        else
        {
    <h1 class="resource-title">
        <button type="button"
                class="resource-picker resource-pane-open-button"
                aria-haspopup="dialog"
                aria-expanded="@(_isDrawerOpen ? "true" : "false")"
                aria-description="@Loc[nameof(Dashboard.Resources.Layout.ResourcePaneOpen)]"
                @onclick="OpenDrawer">
            <FluentIcon Class="resource-picker-leading-icon" Value="@(new Icons.Regular.Size20.TextBulletListLtr())" Width="20px" Color="Color.Primary" />
            <span class="resource-picker-text">@text</span>
            <FluentIcon Class="resource-picker-chevron" Value="@(new Icons.Regular.Size16.ChevronDown())" Width="16px" Color="Color.Custom" CustomColor="currentColor" />
        </button>
    </h1>
        }
    }

    private void RenderHeaderIcon(RenderTreeBuilder __builder)
    {
        if (CurrentTab == ResourceTab.Parameters)
        {
            <span class="resource-header-icon neutral">
                <FluentIcon Width="20px" Value="@(new Icons.Regular.Size20.Key())" Color="Color.Default" />
            </span>
        }
        else if (SelectedResource is { } selected)
        {
            <span class="resource-header-icon">
                <FluentIcon Width="20px"
                            Color="Color.Custom"
                            CustomColor="@ColorGenerator.Instance.GetColorVariableByKey(GetResourceName(selected))"
                            Value="@ResourceIconHelpers.GetIconForResource(IconResolver, selected, IconSize.Size20)" />
                <PersistentContainerBadge Resource="@selected" />
            </span>
        }
        else if (SelectedTelemetryOnlyResource is { } telemetryOnly)
        {
            <span class="resource-header-icon">
                <FluentIcon Width="20px"
                            Color="Color.Custom"
                            CustomColor="@ColorGenerator.Instance.GetColorVariableByKey(telemetryOnly.Name)"
                            Value="@(new Icons.Regular.Size20.DataUsage())" />
            </span>
        }
        else if (IsMultiSelection)
        {
            <span class="resource-header-icon">
                @if (_selectedItems.All(item => item.Resource is { IsParameter: true }))
                {
                    <FluentIcon Width="20px" Value="@(new Icons.Regular.Size20.Key())" Color="Color.Primary" />
                }
                else
                {
                    <FluentIcon Width="20px" Value="@(new Icons.Regular.Size20.Stack())" Color="Color.Primary" />
                }
            </span>
        }
        else if (SelectedResourceName is not null && _isLoaded)
        {
            <span class="resource-header-icon neutral">
                <FluentIcon Width="20px" Value="@(new Icons.Regular.Size20.QuestionCircle())" Color="Color.Default" />
            </span>
        }
        else
        {
            <span class="resource-header-icon scope">
                <FluentIcon Width="20px" Value="@(new Icons.Regular.Size20.AppsList())" Color="Color.Default" />
            </span>
        }
    }

    private void RenderHeaderRow(RenderTreeBuilder __builder, bool isDesktop)
    {
    <div class="resource-header-row">
        @if (isDesktop)
        {
            <FluentButton Class="resource-pane-toggle-button"
                          Appearance="ButtonAppearance.Default"
                          IconOnly="true"
                          IconStart="@(_isPaneCollapsed && !_isPaneFullCanvas ? new Icons.Regular.Size20.PanelLeftExpand() : new Icons.Regular.Size20.PanelLeftContract())"
                          OnClick="TogglePaneCollapsedAsync"
                          data-tooltip="@Loc[_isPaneCollapsed && !_isPaneFullCanvas ? nameof(Dashboard.Resources.Layout.ResourcePaneExpand) : nameof(Dashboard.Resources.Layout.ResourcePaneCollapse)]"
                          aria-label="@Loc[_isPaneCollapsed && !_isPaneFullCanvas ? nameof(Dashboard.Resources.Layout.ResourcePaneExpand) : nameof(Dashboard.Resources.Layout.ResourcePaneCollapse)]"
                          aria-expanded="@((!_isPaneCollapsed || _isPaneFullCanvas).ToString().ToLowerInvariant())" />
        }
        @if (!isDesktop || !_isPaneCollapsed)
        {
            RenderHeaderIcon(__builder);
        }
        @if (CurrentTab == ResourceTab.Parameters)
        {
            <div class="resource-header-text">
                <div class="resource-header-title">
                    @{ RenderTitle(__builder, Loc[nameof(Dashboard.Resources.Layout.NavMenuParametersTab)], isDesktop); }
                </div>
            </div>
        }
        else if (SelectedResource is { } selected)
        {
            var selectedName = GetResourceName(selected);
            <div class="resource-header-text">
                <div class="resource-header-title">
                    @{ RenderTitle(__builder, selectedName, isDesktop); }
                </div>
            </div>
        }
        else if (SelectedTelemetryOnlyResource is { } telemetryOnly)
        {
            <div class="resource-header-text">
                <div class="resource-header-title">
                    @{ RenderTitle(__builder, telemetryOnly.Name, isDesktop); }
                </div>
            </div>
        }
        else if (IsMultiSelection)
        {
            var selectedItemsAreParameters = _selectedItems.All(item => item.Resource is { IsParameter: true });
            <div class="resource-header-text">
                <div class="resource-header-title">
                    @{
                        var title = string.Format(
                            CultureInfo.CurrentCulture,
                            Loc[selectedItemsAreParameters
                                ? nameof(Dashboard.Resources.Layout.ResourceHeaderSelectedParameters)
                                : nameof(Dashboard.Resources.Layout.ResourceHeaderSelectedResources)],
                            _selectedItems.Count);
                        RenderTitle(__builder, title, isDesktop);
                    }
                </div>
            </div>
        }
        else if (SelectedResourceName is not null && _isLoaded)
        {
            <div class="resource-header-text">
                <div class="resource-header-title">
                    @{ RenderTitle(__builder, SelectedResourceName, isDesktop); }
                </div>
                <div class="resource-header-meta">
                    @Loc[nameof(Dashboard.Resources.Layout.ResourceHeaderNotFound)]
                    @if (GetReplacementReplicas(SelectedResourceName) is { Count: > 0 } replicas)
                    {
                        <a href="@GetTabUrl(CurrentTab, replicas.Select(replica => replica.Name).ToList())">@string.Format(CultureInfo.CurrentCulture, Loc[nameof(Dashboard.Resources.Layout.ResourceHeaderShowReplacement)], replicas[0].DisplayName)</a>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="resource-header-text">
                <div class="resource-header-title">
                    @{ RenderTitle(__builder, GetScopeTitle(), isDesktop); }
                </div>
            </div>
        }
    </div>
    }

    private void RenderSelectedResourceMeta(RenderTreeBuilder __builder, ResourceViewModel resource)
    {
        var selectedState = ResourceStateViewModel.GetStateViewModel(resource, ColumnsLoc);
        var urls = ResourceUrlHelpers.GetUrls(resource, includeInternalUrls: false, includeNonEndpointUrls: true);

        <span class="state-pill @GetStateClass(resource)">
            <FluentIcon Value="@selectedState.Icon" Width="12px" Color="Color.Custom" CustomColor="currentColor" />
            @selectedState.Text
        </span>
        <span class="resource-status-type">@GetResourceTypeLabel(resource)</span>
        @if (resource.StartTimeStamp is not null)
        {
            <span class="resource-header-sep" aria-hidden="true">·</span>
            <span>@Loc[nameof(Dashboard.Resources.Layout.ResourceHeaderStarted)] <StartTimeColumnDisplay Resource="@resource" /></span>
        }
        @if (urls.Count > 0)
        {
            <span class="resource-header-sep" aria-hidden="true">·</span>
            <span class="resource-header-urls">
                <UrlsColumnDisplay Resource="@resource" HasMultipleReplicas="@HasMultipleReplicas(resource)" DisplayedUrls="@urls" />
            </span>
        }
    }

    private void RenderTabNavigation(RenderTreeBuilder __builder, bool isDesktop)
    {
        // When the row no longer has room for every label, the container query swaps this for the compact dropdown
        // instead of letting the top navigation grow its own scrollbar.
        // While a tab click navigates, the strip keeps showing the clicked tab (see OnTabChanged). While the resource
        // list fills the page, its content is closed and no tab is shown selected: each tab then opens that view for
        // the selection, which is all resources once the content is closed. CurrentTab is kept for the session, so
        // selecting resources in the list opens the tab that was last shown.
        ResourceTab? activeTab = _isPaneFullCanvas ? null : _navigatingToTab ?? CurrentTab;
        var renderedLocation = _lastLocation;
        var currentTabItem = activeTab is { } active ? GetTabs().FirstOrDefault(t => t.Tab == active) : null;
    <div class="resource-tabs-nav">
        @* Keep queued native change events bound to their original location. Reusing the component would
           rebind its callback before those events arrive, making an old change look like a new user navigation. *@
        <FluentTabs @key="renderedLocation"
                    Class="resources-tab-header"
                    ActiveTabId="@(activeTab is { } activeId ? GetTabId(activeId) : NoActiveTabId)"
                    ActiveTabChanged="@(tab => OnTabChanged(tab, isDesktop, renderedLocation))"
                    Size="null">
            @foreach (var tab in GetTabs())
            {
                <FluentTab HeaderClass="tab-label"
                           Id="@GetTabId(tab.Tab)"
                           Visible="@tab.IsVisible"
                           data-tooltip="@(tab.IsAvailable ? null : Loc[nameof(Dashboard.Resources.Layout.ResourceTabUnavailable)])"
                           IconStart="@tab.Icon">
                    <HeaderTemplate>
                        <span>@tab.Text</span>
                        @if (tab.ErrorCount > 0)
                        {
                            <FluentBadge Class="resource-tab-error-count" Appearance="BadgeAppearance.Tint" Circular="true">@tab.ErrorCount</FluentBadge>
                        }
                    </HeaderTemplate>
                </FluentTab>
            }
            @* Active while no tab is selected. The tab list selects its first tab when the active id matches no tab,
               and a tab with Visible="false" isn't rendered, so this one is rendered but not displayed (see the
               stylesheet): it's never seen, focused or announced. It's last so the visible tabs keep their order.
               HeaderClass is the class of the fluent-tab element itself. *@
            <FluentTab Id="@NoActiveTabId" HeaderClass="resource-tab-none" aria-hidden="true" />
        </FluentTabs>
        @* Tabs that don't fit the row move here, from the right (see registerTabOverflow). *@
        <div class="resource-tabs-overflow @(_overflowTabIds.Length > 0 ? "has-overflow" : null) @(activeTab is { } overflowTab && _overflowTabIds.Contains(GetTabId(overflowTab)) ? "has-active" : null)">
            <AspireMenuButton ButtonClass="resource-tabs-overflow-button"
                              Icon="@(new Icons.Regular.Size20.MoreHorizontal())"
                              IconColor="Color.Custom"
                              IconCustomColor="currentColor"
                              ButtonAppearance="ButtonAppearance.Transparent"
                              ItemsProvider="@GetOverflowMenuItems"
                              Title="@Loc[nameof(Dashboard.Resources.Layout.ResourceTabsMore)]" />
        </div>
        @* The button already shows the current view, so a tooltip would only cover the controls above it. *@
        <AspireMenuButton ButtonClass="resource-tabs-compact-button"
                          Text="@(currentTabItem?.Text ?? Loc[nameof(Dashboard.Resources.Layout.ResourceTabsLandmark)])"
                          IconStart="@currentTabItem?.Icon"
                          ButtonAppearance="ButtonAppearance.Default"
                          ItemsProvider="@GetTabMenuItems"
                          Title="@Loc[nameof(Dashboard.Resources.Layout.ResourceTabsLandmark)]"
                          data-tooltip="" />
    </div>
    }

    // Rows are rendered by a method rather than a RenderFragment so each row's @key stays among its siblings.
    // The resource list renders its rows two ways: the sidebar's picker rows, and the full-page list's table rows with
    // columns. Each has its own renderer and its own root class (resource-row-sidebar, resource-row-table), and the
    // stylesheet keys each view's rules to that class. The pieces both share (tree guides and expand toggle, icon, error
    // badge, actions) are rendered by the methods below, so they look and behave the same in both.
    private void RenderResourceRow(RenderTreeBuilder __builder, ResourceViewModel resource, ResourceGridViewModel? row, IReadOnlyList<bool>? treeGuides = null)
    {
        if (_isPaneFullCanvas)
        {
            RenderTableRow(__builder, new ResourceRowContext(this, resource, row, treeGuides));
        }
        else
        {
            RenderSidebarRow(__builder, new ResourceRowContext(this, resource, row, treeGuides));
        }
    }

    // What both row renderers compute about a resource.
    private sealed class ResourceRowContext(ResourcesLayout layout, ResourceViewModel resource, ResourceGridViewModel? row, IReadOnlyList<bool>? treeGuides)
    {
        public ResourceViewModel Resource { get; } = resource;
        public ResourceGridViewModel? Row { get; } = row;
        public IReadOnlyList<bool>? TreeGuides { get; } = treeGuides;
        public string Name { get; } = layout.GetResourceName(resource);
        public bool IsSelected { get; } = layout.IsSelected(layout.GetResourceName(resource));
        public ResourceStateViewModel State { get; } = ResourceStateViewModel.GetStateViewModel(resource, layout.ColumnsLoc);
        public int ErrorCount { get; } = layout.GetUnviewedErrorCount(resource);
        public int Depth { get; } = row?.Depth ?? 0;
        public List<DisplayedUrl> Urls { get; } = ResourceUrlHelpers.GetUrls(resource, includeInternalUrls: false, includeNonEndpointUrls: true);
        public DisplayedUrl? PrimaryUrl => Urls.FirstOrDefault(url => url.Url is not null);
        // The whole row is the drag source, so reordering doesn't need a separate grip.
        public bool CanReorder { get; } = layout.CanReorderResources && !resource.IsParameter;
        public string? UnavailableReason { get; } = layout.GetResourceUnavailableReason(resource);
        public bool IsHidden { get; } = resource.IsResourceHidden(showHiddenResources: false);
    }

    private void RenderSidebarRow(RenderTreeBuilder __builder, ResourceRowContext item)
    {
        var resource = item.Resource;
        @* Each view keys its rows with its own prefix. The two renderers emit their rows from different places, so a
           shared key would match a table row with a sidebar row that Blazor can't update in place, and switching views
           would remove the old rows without inserting the new ones. *@
        <div class="@GetRowClass(item, "resource-row-sidebar")"
             data-selection-all="@(IsAllSelected ? "true" : null)"
             data-resource-name="@resource.Name"
             data-resource-parent="@GetReorderParentName(resource)"
             data-resource-tree-row="@(item.Row is not null ? "true" : null)"
             style="@(item.Depth == 0 ? null : $"--resource-row-depth: {item.Depth}")"
             @key="@($"sidebar:{resource.Name}")">
            @{ RenderRowLead(__builder, item); }
            <a @attributes="@GetRowLinkAttributes(item)"
               @onclick="@GetRowHandlers(resource).Click"
               @onclick:preventDefault="true">
                @{ RenderRowIcon(__builder, item); }
                @if (IsCompact)
                {
                    @* One line per resource: the name, then aligned columns for type and state, so they line up from
                       row to row. The state is a dot; its name is in the tooltip and the link's accessible description.
                       There is no room for the availability badge on one line, so an unavailable row relies on its muted
                       colors and on the reason in its tooltip and accessible description. *@
                    <span class="resource-row-text">
                        @{ RenderRowName(__builder, item); }
                        @{ RenderRowHiddenIcon(__builder, item, compact: true); }
                    </span>
                    RenderRowErrorSpacer(__builder, item);
                    <span class="resource-row-meta">
                        @* A parameter's type says nothing its key icon and the Parameters section don't, so it's left
                           out, which leaves its name the room. *@
                        @if (!resource.IsParameter)
                        {
                            <span class="resource-row-type @(resource.IsPersistentContainer ? "resource-row-type-persistent" : null)" data-tooltip="@GetResourceTypeLabel(resource)">@GetResourceTypeLabel(resource)</span>
                        }
                        @{ RenderRowStateDot(__builder, item); }
                    </span>
                }
                else
                {
                    <span class="resource-row-text">
                        <span class="resource-row-title">
                            @{ RenderRowName(__builder, item); }
                        </span>
                        <span class="resource-row-sub">
                            @{ RenderRowHiddenIcon(__builder, item, compact: false); }
                            @* The parts have no whitespace between them. Where this line flows as text, so that it ends with
                               an ellipsis, whitespace would render as spaces on top of their margins. *@
                            <span class="state-dot @GetStateClass(resource)"></span><span>@item.State.Text</span>
                            @if (!resource.IsParameter && GetRowTime(resource) is { } sidebarTime)
                            {
                                @* The verb and a short age, after the state ("Running · Started 7m ago"). *@
                                var sidebarTimeDescription = GetRowTimeDescription(sidebarTime);
                                <span class="resource-row-start-time resource-row-sidebar-start">
                                    <time datetime="@sidebarTime.Time.ToString("O", CultureInfo.InvariantCulture)"
                                          tabindex="0"
                                          aria-label="@sidebarTimeDescription"
                                          data-tooltip="@sidebarTimeDescription"
                                          data-tooltip-positioning="above">@GetRowTimeText(sidebarTime)</time>
                                </span>
                            }
                        </span>
                    </span>
                    RenderRowErrorSpacer(__builder, item);
                }
            </a>
            @{ RenderRowErrorLink(__builder, item); }
            @RenderResourceActions(resource, showLabels: false, item.Row, item.PrimaryUrl)
        </div>
    }

    private void RenderTableRow(RenderTreeBuilder __builder, ResourceRowContext item)
    {
        var resource = item.Resource;
        <div class="@GetRowClass(item, "resource-row-table")"
             data-selection-all="@(IsAllSelected ? "true" : null)"
             data-resource-name="@resource.Name"
             data-resource-parent="@GetReorderParentName(resource)"
             data-resource-tree-row="@(item.Row is not null ? "true" : null)"
             style="@(item.Depth == 0 ? null : $"--resource-row-depth: {item.Depth}")"
             @key="@($"table:{resource.Name}")">
            @{ RenderRowLead(__builder, item); }
            <a @attributes="@GetRowLinkAttributes(item)"
               @onclick="@GetRowHandlers(resource).Click"
               @onclick:preventDefault="true">
                @{ RenderRowIcon(__builder, item); }
                @if (IsCompact)
                {
                    @* One line, as in the sidebar: the name, then the type and the state dot right-aligned at the end of
                       the name column ("frontend      Project ●"), so types and dots line up from row to row and the
                       dot sits next to the Started column it goes with. The Source column shows only the source. *@
                    <span class="resource-row-text">
                        @{ RenderRowName(__builder, item); }
                        @{ RenderRowHiddenIcon(__builder, item, compact: true); }
                    </span>
                    RenderRowErrorSpacer(__builder, item);
                    <span class="resource-row-meta">
                        @* A parameter's type says nothing its key icon and the Parameters section don't. *@
                        @if (!resource.IsParameter)
                        {
                            <span class="resource-row-type @(resource.IsPersistentContainer ? "resource-row-type-persistent" : null)" data-tooltip="@GetResourceTypeLabel(resource)">@GetResourceTypeLabel(resource)</span>
                        }
                        @{ RenderRowStateDot(__builder, item); }
                    </span>
                }
                else
                {
                    <span class="resource-row-text">
                        <span class="resource-row-title">
                            @{ RenderRowName(__builder, item); }
                        </span>
                        <span class="resource-row-sub">
                            @{ RenderRowHiddenIcon(__builder, item, compact: false); }
                            @* The parts have no whitespace between them. Where this line flows as text, so that it ends with
                               an ellipsis, whitespace would render as spaces on top of their margins. *@
                            <span class="state-dot @GetStateClass(resource)"></span><span>@item.State.Text</span><span class="resource-row-sep resource-row-type-sep" aria-hidden="true">·</span><span class="resource-row-type @(resource.IsPersistentContainer ? "resource-row-type-persistent" : null)" tabindex="0" data-tooltip="@GetResourceTypeLabel(resource)">@GetResourceTypeLabel(resource)</span>
                        </span>
                    </span>
                    RenderRowErrorSpacer(__builder, item);
                }
            </a>
            @{ RenderRowErrorLink(__builder, item); }
            @if (!resource.IsParameter)
            {
                @* Sibling links, not nested anchors: opening an endpoint must not change the row selection. *@
                <div class="resource-row-wide-metadata">
                    <span class="resource-row-health">
                        <span class="resource-row-start-time">
                            @if (GetRowTime(resource) is { } rowTime)
                            {
                                var rowTimeDescription = GetRowTimeDescription(rowTime);
                                <FluentIcon Value="@(new Icons.Regular.Size12.Clock())" Width="12px" Color="Color.Custom" CustomColor="currentColor" />
                                <time datetime="@rowTime.Time.ToString("O", CultureInfo.InvariantCulture)"
                                      tabindex="0"
                                      aria-label="@rowTimeDescription"
                                      data-tooltip="@rowTimeDescription"
                                      data-tooltip-positioning="above">
                                    @* The verb and a short age ("Started 7m ago"); the tooltip adds the exact time. *@
                                    <span class="resource-row-started-age">@GetRowTimeText(rowTime)</span>
                                </time>
                            }
                        </span>
                    </span>
                    <div class="resource-row-endpoints">
                        @if (item.Urls.Count > 0)
                        {
                            @* The resources grid's URLs column, showing the first URL and a +N button listing the rest, so a
                               resource with many URLs doesn't widen the column. Links and buttons don't select the row
                               (see ResourcesLayout.razor.js). *@
                            <UrlsColumnDisplay Resource="@resource" HasMultipleReplicas="@HasMultipleReplicas(resource)" DisplayedUrls="@item.Urls" ShowFirstUrlOnly="true" />
                        }
                    </div>
                    @* What ran the resource ("alpine:latest", "Api.csproj"). The type is in the name column, next to the
                       state dot, so this column is the source alone. *@
                    <span class="resource-row-source">
                        @if (ResourceSourceViewModel.GetSourceViewModel(resource) is { } source)
                        {
                            <span class="resource-row-source-value" tabindex="0"
                                  data-tooltip="@source.Tooltip"
                                  data-tooltip-positioning="above"
                                  aria-label="@($"{ResourcesLoc[nameof(Dashboard.Resources.Resources.ResourcesSourceColumnHeader)]}: {source.Tooltip}")">@source.Value</span>
                        }
                    </span>
                </div>
            }
            else
            {
                @* Parameters reserve the same quiet tracks without inventing health, endpoints, or start times. *@
                <div class="resource-row-wide-metadata" aria-hidden="true">
                    <span class="resource-row-health">
                        <span class="resource-row-start-time"></span>
                    </span>
                    <div class="resource-row-endpoints"></div>
                    <span class="resource-row-source"></span>
                </div>
            }
            @if (!resource.IsParameter && GetTelemetryResource(resource) is { } activityResource)
            {
                <ResourcePaneInsights Layout="@this" ResourceKey="@activityResource.ResourceKey" ResourceName="@item.Name" />
            }
            @RenderResourceActions(resource, showLabels: false, item.Row, item.PrimaryUrl)
        </div>
    }

    private static string GetRowClass(ResourceRowContext item, string viewClass) =>
        string.Join(' ', new[]
        {
            "resource-row",
            viewClass,
            item.Resource.IsParameter ? "resource-row-kind-parameter" : "resource-row-kind-resource",
            item.IsSelected ? "selected" : null,
            item.IsHidden ? "resource-row-hidden" : null,
            item.UnavailableReason is not null ? "resource-row-unavailable" : null
        }.Where(c => c is not null));

    private Dictionary<string, object> GetRowLinkAttributes(ResourceRowContext item)
    {
        var attributes = new Dictionary<string, object>
        {
            ["class"] = "resource-row-link",
            ["href"] = GetRowUrl(item.Name),
            ["data-resource-depth"] = item.Depth,
            ["aria-label"] = item.Name,
            ["aria-description"] = GetResourceAccessibilityDescription(item.Resource, item.State.Text, item.ErrorCount, item.UnavailableReason),
            ["data-resource-drag-handle"] = item.CanReorder,
            ["aria-keyshortcuts"] = $"{(item.CanReorder ? "Alt+ArrowUp Alt+ArrowDown " : null)}{(item.Row is not null ? "ArrowLeft ArrowRight" : null)}".Trim()
        };
        if (item.Depth != 0)
        {
            attributes["style"] = $"--resource-row-depth: {item.Depth}";
        }
        if (GetRowAriaCurrent(item.IsSelected) is { } ariaCurrent)
        {
            attributes["aria-current"] = ariaCurrent;
        }
        if (item.UnavailableReason is { } reason)
        {
            attributes["data-tooltip"] = reason;
            attributes["data-resource-unavailable-reason"] = reason;
        }
        if (item.CanReorder)
        {
            attributes["draggable"] = "true";
        }
        return attributes;
    }

    // The tree guides that connect a nested row to its parent, and a parent's expand toggle. The toggle comes before the
    // icon, like a file tree, as a sibling of the row link: a button can't be nested in a link.
    private void RenderRowLead(RenderTreeBuilder __builder, ResourceRowContext item)
    {
        if (item.TreeGuides is { } treeGuides)
        {
            for (var level = 0; level < treeGuides.Count; level++)
            {
                if (treeGuides[level] || level == treeGuides.Count - 1)
                {
                    <span class="resource-tree-guide @(treeGuides[level] ? "continuing" : null) @(level == treeGuides.Count - 1 ? "branch" : null)"
                          style="@($"--tree-level: {level}")" aria-hidden="true"></span>
                }
            }
            if (item.Row is { Children.Count: > 0, IsCollapsed: false })
            {
                <span class="resource-tree-stem" aria-hidden="true"></span>
            }
        }
        if (item.Row is { Children.Count: > 0 } row)
        {
            <FluentButton Appearance="ButtonAppearance.Transparent"
                          Class="@($"resource-row-toggle resource-row-toggle-leading {(row.IsCollapsed ? "collapsed" : string.Empty)}")"
                          IconOnly="true"
                          aria-label="@ControlsStringsLoc[nameof(ControlsStrings.ToggleNesting)]"
                          aria-expanded="@((!row.IsCollapsed).ToString().ToLowerInvariant())"
                          OnClick="@GetRowHandlers(item.Resource).ToggleCollapse">
                <FluentIcon Value="@(new Icons.Regular.Size16.ChevronDown())" Color="Color.Default" />
            </FluentButton>
        }
    }

    private void RenderRowIcon(RenderTreeBuilder __builder, ResourceRowContext item)
    {
        <span class="resource-row-icon">
            <span class="resource-row-glyph">
                <FluentIcon Width="16px"
                            Color="Color.Custom"
                            CustomColor="@(item.UnavailableReason is not null ? "var(--colorNeutralForeground3)" : "var(--resource-row-kind-accent)")"
                            Value="@ResourceIconHelpers.GetIconForResource(IconResolver, item.Resource, IconSize.Size16)" />
            </span>
            <PersistentContainerBadge Resource="@item.Resource" />
        </span>
    }

    private void RenderRowName(RenderTreeBuilder __builder, ResourceRowContext item)
    {
        <span class="resource-row-name"><FluentHighlighter HighlightedText="@_filter.TextFilter" Text="@item.Name" /></span>
        @if (item.Row is { Children.Count: > 0, IsCollapsed: true } collapsedRow)
        {
            @* A collapsed parent says how many rows it hides. The toggle's aria-expanded tells assistive technologies
               it's collapsed, so the count is only shown. *@
            var nestedCount = string.Format(CultureInfo.CurrentCulture, Loc[nameof(Dashboard.Resources.Layout.ResourcePaneNestedCount)], collapsedRow.Children.Count);
            <span class="resource-row-child-count" data-tooltip="@nestedCount" aria-hidden="true">@collapsedRow.Children.Count</span>
        }
    }

    private void RenderRowStateDot(RenderTreeBuilder __builder, ResourceRowContext item)
    {
        <span class="resource-row-meta-state" data-tooltip="@item.State.Text">
            <span class="state-dot @GetStateClass(item.Resource)"></span>
        </span>
    }

    private void RenderRowHiddenIcon(RenderTreeBuilder __builder, ResourceRowContext item, bool compact)
    {
        if (item.IsHidden)
        {
            <FluentIcon Value="@(new Icons.Regular.Size16.EyeOff())"
                        Class="@(compact ? "resource-row-hidden-icon" : null)"
                        data-tooltip="@ColumnsLoc[nameof(Columns.HiddenResourceIconTooltip)]"
                        aria-label="@ColumnsLoc[nameof(Columns.HiddenResourceIconTooltip)]"
                        Color="Color.Custom" CustomColor="var(--colorNeutralForeground3)" />
        }
    }

    // Reserves the error badge's width in the row link. The real badge, a sibling link (see RenderRowErrorLink), is
    // overlaid here.
    private static void RenderRowErrorSpacer(RenderTreeBuilder __builder, ResourceRowContext item)
    {
        if (item.ErrorCount > 0)
        {
            <span class="error-badge error-badge-spacer" aria-hidden="true">@item.ErrorCount</span>
        }
    }

    // A sibling link, not nested in the row link: opening the error logs must not change the row selection.
    private void RenderRowErrorLink(RenderTreeBuilder __builder, ResourceRowContext item)
    {
        if (item.ErrorCount > 0)
        {
            var errorsLabel = string.Format(CultureInfo.CurrentCulture, Loc[nameof(Dashboard.Resources.Layout.ResourcePaneUnviewedErrors)], item.ErrorCount);
            <a class="error-badge resource-row-error-link"
               href="@DashboardUrls.StructuredLogsUrl(item.Name, logLevel: "error")"
               aria-label="@errorsLabel"
               data-tooltip="@errorsLabel">@item.ErrorCount</a>
        }
    }

}
