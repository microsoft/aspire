@namespace Aspire.Dashboard.Components.Layout

@if (_isDisconnected)
{
    <div class="apphost-connection-status" role="status">
        <FluentIcon Value="@(new Icons.Filled.Size16.Warning())" Color="Color.Error" />
        <div class="apphost-connection-message">
            <strong>@Loc[nameof(Resources.Reconnect.ResourceServiceOfflineTitle)]</strong>
            <span title="@Loc[nameof(Resources.Reconnect.ResourceServiceOfflineDescription)]">@Loc[nameof(Resources.Reconnect.ResourceServiceOfflineDescription)]</span>
        </div>
        <FluentButton Class="apphost-reconnect-action" Appearance="ButtonAppearance.Transparent" OnClick="ReconnectFromJs">@Loc[nameof(Resources.Reconnect.ResourceServiceReconnectRetryButtonText)]</FluentButton>
    </div>
}
