@namespace Aspire.Dashboard.Components.Layout
@using Aspire.Dashboard.Components.Controls
@using Microsoft.FluentUI.AspNetCore.Components

@* The dock is always rendered once it has been opened for the first time. Collapsing translates it off-screen
   rather than unmounting it so the terminal keeps its renderer, measured cell metrics, and WebSocket. *@
@if (_hasBeenOpened)
{
    <div class="terminal-dock fluent-multi-splitter @(_isVisible ? "visible" : "collapsed")"
         id="@_elementIdPrefix"
         orientation="vertical"
         data-theme="dark"
         style="height: @(_heightPx)px;"
         inert="@(!_isVisible)"
         aria-hidden="@(_isVisible ? "false" : "true")"
         @ref="_dockElement">
        @* Reuse Fluent's splitter visuals while retaining the dock's viewport-anchored resizing. *@
        <div class="terminal-dock-resize-handle fluent-multi-splitter-bar"
             status="resizable"
             role="separator"
             tabindex="0"
             aria-orientation="horizontal"
             aria-label="@Loc[nameof(Resources.TerminalStrings.TerminalDockTabs)]"
             aria-controls="@_elementIdPrefix"
             aria-valuemin="@EffectiveMinimumHeightPx"
             aria-valuemax="@_maximumHeightPx"
             aria-valuenow="@_heightPx"
             aria-valuetext="@Loc[nameof(Resources.TerminalStrings.TerminalDockHeight), _heightPx]"
             aria-describedby="@($"{_elementIdPrefix}-resize-help")"
             aria-keyshortcuts="ArrowUp ArrowDown Shift+ArrowUp Shift+ArrowDown Home End"></div>
        <span id="@($"{_elementIdPrefix}-resize-help")" hidden>@Loc[nameof(Resources.TerminalStrings.TerminalDockResizeHelp)]</span>
        <div class="terminal-dock-tabstrip">
            @* FluentTabs resets selection when closing an inactive tab (https://github.com/microsoft/fluentui-blazor/issues/3392).
               Keep selection and removal driven by AppHost updates, with separate tab/close buttons and mounted panes. *@
            @if (_terminals.Count > 0)
            {
                <div class="terminal-dock-tablist aspire-tab-list" role="tablist" aria-label="@Loc[nameof(Resources.TerminalStrings.TerminalDockTabs)]">
                    @foreach (var terminal in _terminals)
                    {
                        <div class="terminal-dock-tab aspire-tab @(IsPaneActive(terminal.TerminalId) ? "active" : string.Empty)"
                             @key="terminal.TerminalId">
                            <button type="button"
                                    role="tab"
                                    class="terminal-dock-tab-select"
                                    id="@GetTabId(terminal.TerminalId)"
                                    aria-controls="@GetPaneId(terminal.TerminalId)"
                                    aria-selected="@(IsPaneActive(terminal.TerminalId) ? "true" : "false")"
                                    tabindex="@(IsPaneActive(terminal.TerminalId) ? 0 : -1)"
                                    @onclick="@(() => Activate(terminal.TerminalId))">
                                <span class="terminal-dock-tab-title">@terminal.Title</span>
                            </button>
                            <FluentButton Appearance="ButtonAppearance.Transparent"
                                          IconOnly="true"
                                          Class="aspire-icon-button terminal-dock-tab-close"
                                          Title="@Loc[nameof(Resources.TerminalStrings.TerminalDockCloseTab), terminal.Title]"
                                          aria-label="@Loc[nameof(Resources.TerminalStrings.TerminalDockCloseTab), terminal.Title]"
                                          tabindex="@(IsPaneActive(terminal.TerminalId) ? 0 : -1)"
                                          OnClick="@(() => CloseTerminalAsync(terminal.TerminalId, terminal.Title))">
                                <FluentIcon Value="@(new Icons.Regular.Size12.Dismiss())" Color="Color.Default" />
                            </FluentButton>
                        </div>
                    }
                </div>
            }
            <div class="terminal-dock-filler"></div>
            @if (_popupBlocked)
            {
                <span class="terminal-dock-popup-blocked">@Loc[nameof(Resources.TerminalStrings.TerminalDockDetachBlocked)]</span>
            }
            <TerminalWindowButton @ref="_windowButton"
                                  Class="terminal-dock-detach"
                                  Label="@Loc[nameof(Resources.TerminalStrings.TerminalDockDetach)]"
                                  TerminalKey="@_activeTerminalId"
                                  Url="@ActiveTerminalWindowUrl"
                                  FontSize="@ActiveTerminalFontSize"
                                  FocusGroup="@_elementIdPrefix"
                                  Disabled="@(!_isVisible || IsPanelVisible || _activeTerminalId is null || _detachedTerminalIds.Contains(_activeTerminalId))"
                                  WindowKeysToAdopt="@(_terminals.Select(t => t.TerminalId).ToArray())"
                                  OnWindowsAdopted="@OnWindowsAdopted"
                                  OnWindowTrackingFailed="@OnWindowTrackingFailed"
                                  OnWindowOpened="@OnDetachedWindowOpenedAsync"
                                  OnWindowClosed="@OnDetachedWindowClosedAsync" />
            <FluentButton Appearance="ButtonAppearance.Transparent"
                          IconOnly="true"
                          Class="aspire-icon-button terminal-dock-collapse"
                          Title="@Loc[nameof(Resources.TerminalStrings.TerminalDockHide)]"
                          aria-label="@Loc[nameof(Resources.TerminalStrings.TerminalDockHide)]"
                          OnClick="@Hide">
                <FluentIcon Value="@(new Icons.Regular.Size16.ChevronDown())" Color="Color.Default" />
            </FluentButton>
        </div>
        <div class="terminal-dock-body">
            @foreach (var terminal in _terminals)
            {
                @* Inactive panes use visibility rather than display so the terminal retains its measured grid
                   instead of deferring its mount until the user selects the tab. *@
                <div class="terminal-dock-pane @(IsPaneActive(terminal.TerminalId) ? "active" : "inactive")"
                     id="@GetPaneId(terminal.TerminalId)"
                     role="tabpanel"
                     aria-labelledby="@GetTabId(terminal.TerminalId)"
                     aria-hidden="@(IsPaneActive(terminal.TerminalId) ? "false" : "true")"
                     inert="@(!IsPaneActive(terminal.TerminalId))"
                     @key="terminal.TerminalId">
                    @if (_detachedTerminalIds.Contains(terminal.TerminalId))
                    {
                        @* Deliberately does not render a TerminalView. The window is the viewer while detached, and a
                           second attached viewer would contend for the HMP1 primary role and resize the PTY behind
                           the window the user is actually typing into. *@
                        <div class="terminal-dock-detached">
                            <span>@Loc[_recoveringWindowIds.Contains(terminal.TerminalId)
                                ? nameof(Resources.TerminalStrings.TerminalDockRecoveringWindow)
                                : nameof(Resources.TerminalStrings.TerminalDockDetached)]</span>
                            <div class="terminal-dock-detached-actions">
                                <FluentButton Appearance="ButtonAppearance.Primary"
                                              Class="aspire-button"
                                              data-terminal-window-focus-group="@_elementIdPrefix"
                                              data-terminal-window-focus-key="@terminal.TerminalId">
                                    @Loc[nameof(Resources.TerminalStrings.TerminalDockFocusWindow)]
                                </FluentButton>
                                <FluentButton Appearance="ButtonAppearance.Default"
                                              Class="aspire-button"
                                              OnClick="@(() => ReturnToDockAsync(terminal.TerminalId))">
                                    @Loc[nameof(Resources.TerminalStrings.TerminalDockReturnToDock)]
                                </FluentButton>
                            </div>
                        </div>
                    }
                    else if (_windowTrackingReadyIds.Contains(terminal.TerminalId))
                    {
                        @* Check browser-owned handles before mounting, including after component replacement:
                           even a briefly mounted auto-fit viewer could resize a still-detached terminal. *@
                        <TerminalView @ref="_terminalViews[terminal.TerminalId]"
                                      EndpointPathAndQuery="@BuildEndpoint(terminal.TerminalId)"
                                      Chromeless="true"
                                      ShowDimensionsPicker="false"
                                      AutoFit="@(_isVisible && IsPaneActive(terminal.TerminalId))"
                                      OnToolbarStateChanged="@OnTerminalToolbarStateChanged"
                                      SizeMemoryKey="@($"dock:{terminal.TerminalId}")" />
                    }
                </div>
            }
            @if (IsPanelVisible)
            {
                <div class="terminal-dock-panel">
                    <div class="terminal-dock-panel-card">
                        <FluentIcon Class="terminal-dock-panel-icon" Value="@(new Icons.Regular.Size20.WindowConsole())" Width="24px" Color="Color.Default" />
                        <h3 class="terminal-dock-panel-heading">@Loc[nameof(Resources.TerminalStrings.TerminalDockPanelHeading)]</h3>
                        <p class="terminal-dock-panel-body">@Loc[nameof(Resources.TerminalStrings.TerminalDockPanelBody)]</p>
                        @if (_resourceTerminalLinks.Length > 0)
                        {
                            <p class="terminal-dock-panel-body terminal-dock-resource-links">
                                @Loc[nameof(Resources.TerminalStrings.TerminalDockResourceTerminals)]@(" ")
                                @for (var i = 0; i < _resourceTerminalLinks.Length; i++)
                                {
                                    if (i > 0)
                                    {
                                        <text>, </text>
                                    }
                                    var link = _resourceTerminalLinks[i];
                                    <a class="aspire-link-button" href="@link.Url">@link.Name</a>
                                }
                            </p>
                        }
                        <a class="aspire-link-button terminal-dock-panel-more-info" href="https://aka.ms/aspire/dashboard-terminal" target="_blank" rel="noopener noreferrer">@Loc[nameof(Resources.TerminalStrings.TerminalDockMoreInformation)]</a>
                        <p class="terminal-dock-panel-hint">@Loc[nameof(Resources.TerminalStrings.TerminalDockPanelHint)]</p>
                    </div>
                </div>
            }
        </div>
    </div>
}
