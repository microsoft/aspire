@if (IsNavMenuOpen)
{
    var firstItem = true;
@* The menu overlays the page instead of taking a layout row, so opening it doesn't push the content down. The scrim
   covers the page below it and closes the menu when tapped. *@
<div class="mobile-nav-scrim" aria-hidden="true" @onclick="CloseNavMenu"></div>
<FluentMenuList Id="@MobileNavMenuId" Class="aspire-menu-container mobile-nav-menu" Style="max-height: calc(100dvh - var(--mobile-header-height)); overflow-y: auto; padding-block: var(--mobile-nav-menu-focus-padding); scroll-padding-block: var(--mobile-nav-menu-focus-padding);">
    @foreach (var item in GetMobileNavMenuEntries())
    {
        if (!firstItem)
        {
            <FluentDivider/>
        }
        firstItem = false;

        @* mobile-nav-menu-item-active drives the accent color bar applied via
           ::before, mirroring the desktop selected
           treatment without needing a separate sibling element. *@
        <FluentMenuItem OnClick="@(async () => { CloseNavMenu(); await item.OnClick(); })"
                        Class="@(item.IsActive ? "mobile-nav-menu-item-active" : null)"
                        data-tooltip="@item.Text" aria-current="@(item.IsActive ? "page" : null)">
            <span>@item.Text</span>
            @if (item.ErrorCount > 0)
            {
                <FluentBadge Class="mobile-nav-menu-error-count" Appearance="BadgeAppearance.Tint" Circular="true">@item.ErrorCount</FluentBadge>
            }
            @{
                var renderedIcon = item.IsActive ? item.ActiveIcon ?? item.Icon : item.Icon;
            }
            @if (renderedIcon is { } icon)
            {
                <span slot="start" class="@(item.IsActive ? "mobile-nav-menu-icon-active" : null)">
                    @if (item.IsActive)
                    {
                        <FluentIcon Class="align-text-bottom" Value="@icon" Slot="start" CustomColor="var(--colorBrandForegroundLinkPressed)" Color="Color.Custom"/>
                    }
                    else
                    {
                        <FluentIcon Class="align-text-bottom" Value="@icon" Slot="start" Color="Color.Default" />
                    }
                </span>
            }
        </FluentMenuItem>
    }
</FluentMenuList>
}
