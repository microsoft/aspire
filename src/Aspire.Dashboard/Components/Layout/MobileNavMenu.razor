@if (IsNavMenuOpen)
{
    var firstItem = true;
<FluentMenuList Id="@MobileNavMenuId" Class="aspire-menu-container mobile-nav-menu" Style="grid-area: nav-menu; max-height: calc(100dvh - var(--mobile-header-height) - var(--mobile-nav-menu-offset)); margin-top: var(--mobile-nav-menu-offset); overflow-y: auto; padding-block: var(--mobile-nav-menu-focus-padding); scroll-padding-block: var(--mobile-nav-menu-focus-padding);">
    @foreach (var item in GetMobileNavMenuEntries())
    {
        if (!firstItem)
        {
            <FluentDivider/>
        }
        firstItem = false;

        var isActive = item.LinkMatchRegex is not null && item.LinkMatchRegex.IsMatch($"/{NavigationManager.ToBaseRelativePath(NavigationManager.Uri)}");
        var menuItemAttributes = new Dictionary<string, object>
        {
            ["title"] = item.Text
        };
        if (isActive)
        {
            menuItemAttributes["aria-current"] = "page";
        }

        @* mobile-nav-menu-item-active drives the accent color bar applied via
           ::before, mirroring the desktop selected
           treatment without needing a separate sibling element. *@
        <FluentMenuItem OnClick="@(async () => { CloseNavMenu(); await item.OnClick(); })" Class="@(isActive ? "mobile-nav-menu-item-active" : null)" AdditionalAttributes="@menuItemAttributes">
            <span>@item.Text</span>

            @{
                var renderedIcon = isActive ? item.ActiveIcon ?? item.Icon : item.Icon;
            }
            @if (renderedIcon is { } icon)
            {
                <span slot="start" class="@(isActive ? "mobile-nav-menu-icon-active" : null)">
                    @if (isActive)
                    {
                        <FluentIcon Class="align-text-bottom" Value="@icon" Slot="start" CustomColor="var(--colorBrandForegroundLinkPressed)" Color="Color.Custom"/>
                    }
                    else
                    {
                        <FluentIcon Class="align-text-bottom" Value="@icon" Slot="start" Color="Color.Default" />
                    }
                </span>
            }
        </FluentMenuItem>
    }
</FluentMenuList>
}
