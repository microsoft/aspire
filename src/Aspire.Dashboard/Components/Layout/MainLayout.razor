@using Aspire.Dashboard.Components.CustomIcons
@using Aspire.Dashboard.Components.Interactions
@using Aspire.Dashboard.Resources
@using Microsoft.AspNetCore.Components.Sections
@inject IStringLocalizer<Dialogs> DialogsLoc
@inherits LayoutComponentBase

<div class="layout @(!RunSelection.SelectedRun.IsCurrent ? "historical-run" : null)" style="@(_isNavMenuOpen ? "overflow: hidden;" : string.Empty)">
    @if (ViewportInformation.IsDesktop)
    {
        @* Full-width top header with the brand lockup (logo + app name) and app-wide actions. The dashboard's main
           views are switched from the icon rail below the logo. *@
        <header>
            <div class="brand-logo-container">
                <a href="/" class="logo"
                              title="@Loc[nameof(Layout.MainLayoutAspire)]"
                              aria-label="@Loc[nameof(Layout.MainLayoutAspire)]">
                    <AspireLogo />
                </a>
            </div>
            <a href="/" class="application-name">
                <ApplicationName/>
            </a>
            <div class="header-context">
                <SectionOutlet SectionName="@HeaderContextSectionName" />
            </div>
            @if (RunStore.SupportsRunSelection)
            {
                var selectedRun = RunSelection.SelectedRun;
                <DashboardRunSelect SelectedRunId="@selectedRun.RunId"
                                    SelectedRunIsCurrent="@selectedRun.IsCurrent"
                                    SelectedRunStartedAtUtc="@selectedRun.StartedAtUtc"
                                    SelectedRunIdChanged="@SwitchDashboardRunAsync" />
            }
            <a class="header-button"
                          href="https://aka.ms/aspire/repo" target="_blank" rel="noreferrer noopener"
                          title="@Loc[nameof(Layout.MainLayoutAspireRepoLink)]" aria-label="@Loc[nameof(Layout.MainLayoutAspireRepoLink)]">
                <FluentIcon Value="@(new AspireIcons.Size24.GitHub())" Color="Color.Default"/>
            </a>
            <FluentButton Class="header-button"
                          Id="@HelpButtonId"
                          Appearance="ButtonAppearance.Default" OnClick="@(() => LaunchHelpAsync(HelpButtonId))"
                          Title="@Loc[nameof(Layout.MainLayoutAspireDashboardHelpLink)]" aria-label="@Loc[nameof(Layout.MainLayoutAspireDashboardHelpLink)]">
                <FluentIcon Value="@(new Icons.Regular.Size24.QuestionCircle())" Color="Color.Default"/>
            </FluentButton>
            @if (Options.CurrentValue.UI.DisableAgentHelp != true)
            {
                <FluentButton Class="header-button"
                              Appearance="ButtonAppearance.Default" OnClick="@LaunchAIAgentsAsync"
                              Title="@Loc[nameof(Layout.MainLayoutLaunchAIAgents)]" aria-label="@Loc[nameof(Layout.MainLayoutLaunchAIAgents)]">
                    <FluentIcon Value="@(new Icons.Regular.Size24.BotSparkle())" Color="Color.Default"/>
                </FluentButton>
            }
            @if (IsTerminalDockEnabled)
            {
                <FluentButton Class="header-button"
                              Appearance="ButtonAppearance.Default" OnClick="@ToggleTerminalDockAsync"
                              Title="@TerminalLoc[nameof(TerminalStrings.MainLayoutToggleTerminalDock)]" aria-label="@TerminalLoc[nameof(TerminalStrings.MainLayoutToggleTerminalDock)]">
                    @* WindowConsole only ships at Size20 in this Fluent version, so it is scaled to 24px to line up with
                       the rest of the header cluster. The Size24 alternatives (WindowDevTools, Code) read as "developer
                       tools" rather than "terminal". *@
                    <FluentIcon Value="@(new Icons.Regular.Size20.WindowConsole())" Width="24px" Color="Color.Default"/>
                </FluentButton>
            }
            <NotificationsHeaderButton OnClick="@LaunchNotificationsAsync" />
            <FluentButton Class="header-button"
                          Id="@SettingsButtonId"
                          Appearance="ButtonAppearance.Default" OnClick="@(() => LaunchSettingsAsync(SettingsButtonId))"
                          Title="@Loc[nameof(Layout.MainLayoutLaunchSettings)]" aria-label="@Loc[nameof(Layout.MainLayoutLaunchSettings)]">
                <FluentIcon Value="@(new Icons.Regular.Size24.Settings())" Color="Color.Default"/>
            </FluentButton>
            <UserProfile/>
        </header>
        <DesktopNavMenu />
    }
    else
    {
        <div class="aspire-icon">
            <a href="/" class="logo"
                          title="@Loc[nameof(Layout.MainLayoutAspire)]"
                          aria-label="@Loc[nameof(Layout.MainLayoutAspire)]">
                <AspireLogo />
            </a>
        </div>
        <header>
            <a href="/" class="application-name">
                <ApplicationName/>
            </a>
            <div class="flex-filler"></div>
            @if (RunStore.SupportsRunSelection)
            {
                var selectedRun = RunSelection.SelectedRun;
                <DashboardRunSelect SelectedRunId="@selectedRun.RunId"
                                    SelectedRunIsCurrent="@selectedRun.IsCurrent"
                                    SelectedRunStartedAtUtc="@selectedRun.StartedAtUtc"
                                    SelectedRunIdChanged="@SwitchDashboardRunAsync" />
            }
            <UserProfile/>
            <FluentButton
                IconEnd="@(_isNavMenuOpen ? new Icons.Regular.Size20.Dismiss() : new Icons.Regular.Size20.Navigation())"
                Id="@NavigationButtonId"
                Title="@(DialogsLoc[nameof(Dialogs.HelpDialogCategoryNavigation)])"
                Appearance="ButtonAppearance.Transparent"
                OnClick="@(() => _isNavMenuOpen = !_isNavMenuOpen)"
                Class="navigation-button aspire-icon-button"/>
        </header>

        <MobileNavMenu
            IsNavMenuOpen="_isNavMenuOpen"
            CloseNavMenu="@CloseMobileNavMenu"
            LaunchHelpAsync="@LaunchHelpAsync"
            LaunchAIAgentsAsync="@LaunchAIAgentsAsync"
            IsAgentHelpEnabled="@(Options.CurrentValue.UI.DisableAgentHelp != true)"
            IsTerminalDockEnabled="@IsTerminalDockEnabled"
            ToggleTerminalDockAsync="@ToggleTerminalDockAsync"
            LaunchNotificationsAsync="@LaunchNotificationsAsync"
            LaunchSettingsAsync="@LaunchSettingsAsync" />
    }

    <div class="messagebar-container">
        <FluentMessageBarProvider Section="@DashboardUIHelpers.MessageBarSection" Class="top-messagebar" MaxMessageCount="null" NewestOnTop="true" />
    </div>
    <div class="layout-body-container">
        <main class="custom-body-content body-content">
            <FluentToastProvider MaxToastCount="3" Timeout="5000" data-update-version="@_toastProviderUpdateVersion" />
            @if (!_isSwitchingRuns)
            {
                var selectedRun = RunSelection.SelectedRun;
                <CascadingValue @key="selectedRun.RunId" Name="DashboardRunId" Value="selectedRun.RunId" IsFixed="true">
                    @Body
                </CascadingValue>
            }
        </main>
    </div>

    <DashboardDialogProvider/>
    <FluentTooltipProvider />
    <InteractionsProvider />
    @if (IsTerminalDockEnabled)
    {
        @* Removing the dock cancels its selected-run subscription and shortcut. Returning to the live run starts a
           new subscription rather than reusing the stream chosen for a previous selection. *@
        <TerminalDock @key="RunSelection.SelectedRun.RunId" @ref="_terminalDock" />
    }
    <ResourceServiceConnectionProvider />
    <div id="blazor-error-ui">
        @Loc[nameof(Layout.MainLayoutUnhandledErrorMessage)]
        <a href="" class="reload">@Loc[nameof(Layout.MainLayoutUnhandledErrorReload)]</a>
        <a class="dismiss">🗙</a>
    </div>
</div>
