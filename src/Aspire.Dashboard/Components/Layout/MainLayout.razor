@using Aspire.Dashboard.Components.Interactions
@using Aspire.Dashboard.Components.Dialogs
@using Aspire.Dashboard.Resources
@inject IStringLocalizer<Dialogs> DialogsLoc
@inherits LayoutComponentBase

@if (ViewportInformation.IsDesktop)
{
    @* Deck-style desktop shell: left sidebar + top bar + content grid. *@
    <div class="app">
        <div class="app__sidebar">
            <DeckSidebar />
        </div>
        <div class="app__topbar">
            <DeckTopBar IsAgentHelpEnabled="@(Options.CurrentValue.UI.DisableAgentHelp != true)"
                        OnHelp="@ToggleHelpPaneAsync"
                        OnAIAgents="@LaunchAIAgentsAsync"
                        OnNotifications="@LaunchNotificationsAsync"
                        OnSettings="@ToggleSettingsPaneAsync" />
        </div>
        <main class="app__content">
            @Body
            @if (_showSettingsPane)
            {
                <Aspire.Dashboard.Components.Dialogs.SettingsPane OnClose="@CloseSettingsPane" OnManageData="@OpenManageDataPane" />
            }
            @if (_showHelpPane)
            {
                <Aspire.Dashboard.Components.Dialogs.HelpPane OnClose="@CloseHelpPane" />
            }
            @if (_showManageDataPane)
            {
                <Aspire.Dashboard.Components.Dialogs.ManageDataPane OnClose="@CloseManageDataPane" />
            }
            @* Inside .app so interaction panes/toasts sit alongside the Deck drawers and the
               `:has(.drawer) .notif-stack` toast-shift applies. *@
            <InteractionsProvider />
        </main>
    </div>
}
else
{
    <div class="layout" style="@(_isNavMenuOpen ? "overflow: hidden;" : string.Empty)">
        <div class="aspire-icon">
            <a href="/" class="logo mobile-logo"
               title="@Loc[nameof(Layout.MainLayoutAspire)]"
               aria-label="@Loc[nameof(Layout.MainLayoutAspire)]">
                <AspireLogo />
            </a>
        </div>

        <header class="mobile-header">
            <a href="/" class="logo mobile-app-name">
                <ApplicationName/>
            </a>
            <div class="flex-filler"></div>

            <UserProfile/>
            <button type="button"
                    id="@NavigationButtonId"
                    title="@(DialogsLoc[nameof(Dialogs.HelpDialogCategoryNavigation)])"
                    aria-expanded="@_isNavMenuOpen"
                    aria-controls="mobile-navigation-menu"
                    @onclick="@(() => _isNavMenuOpen = !_isNavMenuOpen)"
                    class="navigation-button">
                <DeckIcon Name="@(_isNavMenuOpen ? DeckIconName.Close : DeckIconName.AppsList)" Size="24" />
            </button>
        </header>

        <MobileNavMenu
            IsNavMenuOpen="_isNavMenuOpen"
            NavigationButtonId="@NavigationButtonId"
            CloseNavMenu="@CloseMobileNavMenu"
            LaunchHelpAsync="@LaunchHelpAsync"
            LaunchAIAgentsAsync="@LaunchAIAgentsAsync"
            IsAgentHelpEnabled="@(Options.CurrentValue.UI.DisableAgentHelp != true)"
            LaunchNotificationsAsync="@LaunchNotificationsAsync"
            LaunchSettingsAsync="@LaunchSettingsAsync" />

        <InteractionsProvider />
    </div>
}

@* Shared overlay providers. These are message/dialog/toast hosts positioned over the shell;
   they keep working while individual surfaces are migrated to Deck panes/toasts. *@
<div class="messagebar-container">
    <FluentMessageBarProvider Section="@DashboardUIHelpers.MessageBarSection" Class="top-messagebar" MaxMessageCount="null" NewestOnTop="true" />
</div>

<FluentToastProvider MaxToastCount="3" Timeout="5000" />
<FluentDialogProvider/>
<FluentTooltipProvider />
<FluentMenuProvider />
<ResourceServiceConnectionProvider />
<div id="blazor-error-ui">
    @Loc[nameof(Layout.MainLayoutUnhandledErrorMessage)]
    <a href="" class="reload">@Loc[nameof(Layout.MainLayoutUnhandledErrorReload)]</a>
    <a class="dismiss">🗙</a>
</div>
