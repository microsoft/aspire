@using Aspire.Dashboard.Components.CustomIcons
@using Aspire.Dashboard.Components.Interactions
@using Aspire.Dashboard.Resources
@using Microsoft.AspNetCore.Components.Sections
@inject IStringLocalizer<Dialogs> DialogsLoc
@inject IStringLocalizer<TerminalStrings> TerminalLoc
@inherits LayoutComponentBase

<div class="layout @(!RunSelection.SelectedRun.IsCurrent ? "historical-run" : null)">
        @* Full-width top header with the brand lockup (logo + app name) and app-wide actions. The dashboard's main
           views are switched from the icon rail below the logo. *@
        <header @ref="_header">
            <div class="brand-logo-container">
                <a href="/" class="logo" @onclick="GoToAllResourcesAsync" @onclick:preventDefault="true"
                              data-tooltip="@Loc[nameof(Layout.MainLayoutAspire)]"
                              aria-label="@Loc[nameof(Layout.MainLayoutAspire)]">
                    <AspireLogo />
                </a>
            </div>
            <a href="/" class="application-name" data-tooltip="@DashboardClient.ApplicationName" data-tooltip-positioning="after" @onclick="GoToAllResourcesAsync" @onclick:preventDefault="true">
                <ApplicationName/>
            </a>
            <div class="header-context">
                @if (ViewportInformation.IsDesktop)
                {
                    <SectionOutlet SectionName="@HeaderContextSectionName" />
                }
            </div>
            @if (RunStore.SupportsRunSelection && UseRunMenu)
            {
                <DashboardRunMenu SelectedRunId="@RunSelection.SelectedRun.RunId"
                                  SelectedRunIsCurrent="@RunSelection.SelectedRun.IsCurrent"
                                  SelectedRunStartedAtUtc="@RunSelection.SelectedRun.StartedAtUtc"
                                  SelectedRunIdChanged="@SwitchDashboardRunAsync" />
            }
            else if (RunStore.SupportsRunSelection)
            {
                var selectedRun = RunSelection.SelectedRun;
                <DashboardRunSelect ButtonId="@RunSelectButtonId"
                                    SelectedRunIsCurrent="@selectedRun.IsCurrent"
                                    SelectedRunStartedAtUtc="@selectedRun.StartedAtUtc"
                                    OnClick="@LaunchRecordingsAsync" />
                @if (!selectedRun.IsCurrent)
                {
                    <DashboardRunPill SelectedRunStartedAtUtc="@selectedRun.StartedAtUtc"
                                      OnClick="@LaunchRecordingsAsync" />
                }
            }
            @foreach (var action in GetHeaderActions())
            {
                <div class="header-action" data-header-action="@action.Id" @key="action.Id">
                    @if (action.Id == NotificationsButtonId)
                    {
                        <NotificationsHeaderButton Id="@action.Id" OnClick="@(action.OnClick!)" />
                    }
                    else
                    {
                        <FluentButton Class="header-button"
                                      Id="@action.Id"
                                      Appearance="ButtonAppearance.Default"
                                      OnClick="@(action.OnClick!)"
                                      data-tooltip="@action.Text"
                                      aria-label="@action.Text"
                                      @attributes="@action.AdditionalAttributes">
                            <FluentIcon Value="@action.Icon" Color="Color.Default" />
                        </FluentButton>
                    }
                </div>
            }
            <div class="header-overflow" data-has-secondary-actions="@_navigationAvailability.HasResourceTerminals.ToString().ToLowerInvariant()">
                <AspireMenuButton MenuButtonId="@NavigationButtonId"
                                  ButtonClass="header-button"
                                  Icon="@(new Icons.Regular.Size20.MoreHorizontal())"
                                  ButtonAppearance="ButtonAppearance.Transparent"
                                  ItemsProvider="@GetHeaderOverflowItems"
                                  Title="@Loc[nameof(Layout.MainLayoutMoreActions)]" />
            </div>
            <UserProfile/>
        </header>

    <div class="messagebar-container">
        <FluentMessageBarProvider Section="@DashboardUIHelpers.MessageBarSection" Class="top-messagebar" MaxMessageCount="null" NewestOnTop="true" />
    </div>
    <div class="layout-body-container">
        <main class="custom-body-content body-content">
            <FluentToastProvider MaxToastCount="3" Timeout="5000" data-update-version="@_toastProviderUpdateVersion" />
            @if (!_isSwitchingRuns)
            {
                var selectedRun = RunSelection.SelectedRun;
                <CascadingValue @key="selectedRun.RunId" Name="DashboardRunId" Value="selectedRun.RunId" IsFixed="true">
                    @Body
                </CascadingValue>
            }
        </main>
    </div>

    <DashboardDialogProvider/>
    <FluentTooltipProvider />
    <InteractionsProvider />
    @if (IsTerminalDockEnabled)
    {
        @* Removing the dock cancels its selected-run subscription and shortcut. Returning to the live run starts a
           new subscription rather than reusing the stream chosen for a previous selection. *@
        <TerminalDock @ref="_terminalDock" @key="RunSelection.SelectedRun.RunId" />
    }
    <ResourceServiceConnectionProvider />
    @if (IsTerminalDockEnabled)
    {
        <NavigationAvailabilityProvider @key="(typeof(NavigationAvailabilityProvider), RunSelection.SelectedRun.RunId)"
                                        AvailabilityChanged="@(availability => _navigationAvailability = availability)" />
    }
    <div id="blazor-error-ui">
        @Loc[nameof(Layout.MainLayoutUnhandledErrorMessage)]
        <a href="" class="reload">@Loc[nameof(Layout.MainLayoutUnhandledErrorReload)]</a>
        <a class="dismiss">🗙</a>
    </div>
</div>
