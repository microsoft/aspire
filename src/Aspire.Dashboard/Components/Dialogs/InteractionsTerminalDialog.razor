@implements IDisposable
@using Aspire.Dashboard.Model.Interaction

<FluentDialogBody Class="interaction-terminal-dialog">
    <ChildContent>
        <div class="interaction-message">
            @((MarkupString)Content.Message)
        </div>
        <div class="interaction-terminal-container">
            <div class="interaction-terminal-titlebar">
                <TerminalTitle State="@_terminalState" />
            </div>
            <div class="interaction-terminal-body">
                <TerminalView EndpointPathAndQuery="@EndpointPathAndQuery"
                              Chromeless="true"
                              AutoFit="true"
                              ShowDimensionsPicker="false"
                              OnToolbarStateChanged="@OnTerminalToolbarStateChanged" />
            </div>
        </div>
    </ChildContent>

    <ActionTemplate>
        @if (!string.IsNullOrEmpty(Dialog.Options.Footer.PrimaryAction.Label))
        {
            <FluentButton Appearance="ButtonAppearance.Default" Class="aspire-button aspire-neutral-button" OnClick="@CancelAsync">
                @Dialog.Options.Footer.PrimaryAction.Label
            </FluentButton>
        }
    </ActionTemplate>
</FluentDialogBody>
