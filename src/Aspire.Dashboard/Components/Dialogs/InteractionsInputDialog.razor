@using Aspire.Dashboard.Components.Controls.Chart
@using Aspire.Dashboard.Model.Interaction
@using Aspire.Dashboard.Resources
@using Aspire.Dashboard.Components.Controls.Grid
@using Aspire.DashboardService.Proto.V1
@using Dialogs = Aspire.Dashboard.Resources.Dialogs
@using Icons = Microsoft.FluentUI.AspNetCore.Components.Icons

<FluentDialogBody Class="interaction-input-dialog">
    <ChildContent>
        @if (!string.IsNullOrEmpty(Content.Message))
        {
            <div class="interaction-message">
                @((MarkupString)Content.Message)
            </div>
        }

        <EditForm EditContext="@_editContext" OnValidSubmit="@SubmitAsync">
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="12">
                @foreach (var vm in _inputDialogInputViewModels)
                {
                    var localItem = vm;
                    <div class="interaction-input input-container">
                        @switch (vm.Input.InputType)
                        {
                        case InputType.Text:
                            <InteractionInputField ForId="@localItem.ElementId"
                                                   InputViewModel="@localItem"
                                                   MarkdownProcessor="@_markdownProcessor"
                                                   Context="input">
                                @*
                                * Immediate value of true on text input ensures the value is set to the server token with every key press in textbox.
                                *@
                                <FluentTextInput @ref="@_elementRefs[input.ViewModel]"
                                                 Id="@input.ViewModel.ElementId"
                                                 Class="aspire-input"
                                                 @bind-Value="input.ViewModel.Value"
                                                 Placeholder="@input.ViewModel.Input.Placeholder"
                                                 Required="input.ViewModel.Input.Required"
                                                 Immediate="true"
                                                 MessageCondition="@(_ => false)"
                                                 AutoComplete="off"
                                                 Disabled="input.ViewModel.InputDisabled"
                                                 aria-describedby="@input.DescriptionId"
                                                 Maxlength="@InteractionHelpers.GetMaxLength(input.ViewModel.Input.MaxLength)" />
                            </InteractionInputField>
                            break;
                        case InputType.SecretText:
                            <InteractionInputField ForId="@localItem.ElementId"
                                                   InputViewModel="@localItem"
                                                   MarkdownProcessor="@_markdownProcessor"
                                                   Context="input">
                                @*
                                * AutoComplete value of one-time-code on password input prevents the browser asking to save the value.
                                * Immediate value of true on text input ensures the value is set to the server token with every key press in textbox.
                                *@
                                <FluentTextInput @ref="@_elementRefs[input.ViewModel]"
                                                 Id="@input.ViewModel.ElementId"
                                                 Class="aspire-input"
                                                 @bind-Value="input.ViewModel.Value"
                                                 Placeholder="@input.ViewModel.Input.Placeholder"
                                                 Required="input.ViewModel.Input.Required"
                                                 TextInputType="TextInputType.Password"
                                                 AutoComplete="one-time-code"
                                                 Immediate="true"
                                                 MessageCondition="@(_ => false)"
                                                 Disabled="input.ViewModel.InputDisabled"
                                                 aria-describedby="@input.DescriptionId"
                                                 Maxlength="@InteractionHelpers.GetMaxLength(input.ViewModel.Input.MaxLength)">
                                    <EndTemplate>
                                        @if (!input.ViewModel.InputDisabled)
                                        {
                                            <FluentButton Appearance="ButtonAppearance.Transparent"
                                                          IconOnly="true"
                                                          Title="@(input.ViewModel.IsSecretTextVisible ? ControlsStringsLoc[nameof(ControlsStrings.GridValueMaskHideValue)] : ControlsStringsLoc[nameof(ControlsStrings.GridValueMaskShowValue)])"
                                                          OnClick="@(() => ToggleSecretTextVisibilityAsync(input.ViewModel))"
                                                          Class="aspire-icon-button secret-text-toggle-button">
                                                <FluentIcon Value="@GetSecretTextIcon(input.ViewModel)" Color="Color.Primary" />
                                            </FluentButton>
                                        }
                                    </EndTemplate>
                                </FluentTextInput>
                            </InteractionInputField>
                            break;
                        case InputType.Choice:
                            <InteractionInputField ForId="@localItem.ElementId"
                                                   InputViewModel="@localItem"
                                                   MarkdownProcessor="@_markdownProcessor"
                                                   Context="input">
                                @*
                                * Need to wrap the select in a div to display a progress bar next to it.
                                * Because of this we have to use a separate label control rather than have the select be responsible for displaying it.
                                *@
                                @if (!localItem.Input.AllowCustomChoice)
                                {
                                    <FluentSelect @key="input.ViewModel.InputKey"
                                                  Id="@input.ViewModel.ElementId"
                                                  TOption="SelectViewModel<string>" TValue="string"
                                                  Class="aspire-input"
                                                  @ref="@_elementRefs[input.ViewModel]"
                                                  @bind-Value="input.ViewModel.Value"
                                                  Placeholder="@input.ViewModel.Input.Placeholder"
                                                  Required="input.ViewModel.Input.Required"
                                                  Items="input.ViewModel.SelectOptions"
                                                  OptionValue="@((SelectViewModel<string>? vm) => vm?.Id)"
                                                  OptionText="@((SelectViewModel<string>? vm) => vm?.Name)"
                                                  OptionTitle="@((SelectViewModel<string> vm) => DashboardUIHelpers.ResolveTooltip(vm.Name))"
                                                  Height="250px"
                                                  Position="SelectPosition.Below"
                                                  Disabled="input.ViewModel.InputDisabled"
                                                  aria-describedby="@input.DescriptionId">
                                    </FluentSelect>
                                }
                                else
                                {
                                    @* Validate the submitted text/key, not the combobox's SelectedOption UI state.
                                       Suppress its automatic field so this wrapper owns both the outline and the message. *@
                                    <FluentField Class="aspire-input"
                                                 ForId="@input.ViewModel.ElementId"
                                                 ValueExpression="@(() => input.ViewModel.Value)"
                                                 IncludeInputSlot="false">
                                        <CascadingValue Name="HideFluentField" Value="@true" IsFixed="true">
                                            <FluentCombobox @key="input.ViewModel.InputKey"
                                                            Id="@input.ViewModel.ElementId"
                                                            TOption="SelectViewModel<string>" TValue="SelectViewModel<string>"
                                                            Class="aspire-input"
                                                            @ref="@_elementRefs[input.ViewModel]"
                                                            @bind-Value="input.ViewModel.SelectedOption"
                                                            @bind-Value:after="@(() => UpdateChoiceValueState(input.ViewModel))"
                                                            @bind-ImmediateText:get="input.ViewModel.SelectedOption?.Name ?? input.ViewModel.Value"
                                                            @bind-ImmediateText:set="@(text => OnChoiceTextChanged(input.ViewModel, text))"
                                                            Immediate="true"
                                                            ImmediateDelay="@FluentUIExtensions.InputDelay"
                                                            Placeholder="@input.ViewModel.Input.Placeholder"
                                                            Required="input.ViewModel.Input.Required"
                                                            Items="@input.ViewModel.FilteredOptions()"
                                                            OptionText="@((SelectViewModel<string>? vm) => vm?.Name)"
                                                            OptionTitle="@((SelectViewModel<string> vm) => DashboardUIHelpers.ResolveTooltip(vm.Name))"
                                                            Height="250px"
                                                            Position="SelectPosition.Below"
                                                            Disabled="input.ViewModel.InputDisabled"
                                                            aria-describedby="@input.DescriptionId">
                                                @* The native dropdown clears unmatched text on blur unless a freeform option exists.
                                                   A synthetic SelectedOption only synchronizes Blazor state, not the native option list. *@
                                                <FreeOption>
                                                    <FreeOptionOutput />
                                                </FreeOption>
                                                <OptionTemplate Context="optionContext">
                                                    <FluentHighlighter Text="@optionContext.Name" HighlightedText="@input.ViewModel.Value" />
                                                </OptionTemplate>
                                            </FluentCombobox>
                                        </CascadingValue>
                                    </FluentField>
                                }
                            </InteractionInputField>
                            break;
                        case InputType.Boolean:
                            <InteractionInputField ForId="@localItem.ElementId"
                                                   InputViewModel="@localItem"
                                                   MarkdownProcessor="@_markdownProcessor"
                                                   Context="input">
                                <FluentCheckbox @ref="@_elementRefs[input.ViewModel]"
                                                Id="@input.ViewModel.ElementId"
                                                Class="aspire-checkbox"
                                                @bind-Value="input.ViewModel.IsChecked"
                                                Label="@input.ViewModel.Input.Label"
                                                Placeholder="@input.ViewModel.Input.Placeholder"
                                                AriaLabel="@input.ViewModel.Input.Label"
                                                Disabled="input.ViewModel.InputDisabled"
                                                aria-describedby="@input.DescriptionId" />
                            </InteractionInputField>
                            break;
                        case InputType.Number:
                            <InteractionInputField ForId="@localItem.ElementId"
                                                   InputViewModel="@localItem"
                                                   MarkdownProcessor="@_markdownProcessor"
                                                   Context="input">
                                <FluentNumberInput TValue="int?"
                                                   Id="@input.ViewModel.ElementId"
                                                   @ref="@_elementRefs[input.ViewModel]"
                                                   Class="aspire-input"
                                                   @bind-Value="input.ViewModel.NumberValue"
                                                   Placeholder="@input.ViewModel.Input.Placeholder"
                                                   AriaLabel="@input.ViewModel.Input.Description"
                                                   Required="input.ViewModel.Input.Required"
                                                   Immediate="true"
                                                   Disabled="input.ViewModel.InputDisabled"
                                                   aria-describedby="@input.DescriptionId" />
                            </InteractionInputField>
                            break;
                        case InputType.File:
                            var inputId = $"{localItem.ElementId}-FileUploadButton";
                            <InteractionInputField ForId="@inputId"
                                                   InputViewModel="@localItem"
                                                   MarkdownProcessor="@_markdownProcessor"
                                                   Context="input">
                                <div class="file-input-container">
                                    <FluentInputFile @ref="@_elementRefs[input.ViewModel]"
                                                     Id="@input.ViewModel.ElementId"
                                                     DragDropZoneVisible="false"
                                                     Mode="InputFileMode.Stream"
                                                     AnchorId="@inputId"
                                                     Accept="@input.ViewModel.Input.FileFilter"
                                                     Multiple="@input.ViewModel.Input.AllowMultipleFiles"
                                                     MaximumFileSize="@GetMaxFileSize(input.ViewModel)"
                                                     Disabled="input.ViewModel.InputDisabled"
                                                     OnInputFileChange="@(args => OnInputFileChangeAsync(input.ViewModel, args))" />
                                    @if (input.ViewModel.FileReferences.Any(f => f.Id is not null))
                                    {
                                        <div class="uploaded-files-list">
                                            @foreach (var fileRef in input.ViewModel.FileReferences.Where(f => f.Id is not null))
                                            {
                                                <div class="uploaded-file-container">
                                                    <FluentIcon Icon="Icons.Filled.Size16.Document" Style="vertical-align: text-bottom;" Color="Color.Primary" />
                                                    <span>@fileRef.Name</span>
                                                </div>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <FluentButton Id="@inputId" Appearance="ButtonAppearance.Primary" Class="aspire-button"
                                                      IconStart="@(new Icons.Regular.Size16.FolderOpen())"
                                                      Disabled="input.ViewModel.InputDisabled"
                                                      aria-label="@input.ViewModel.Input.Label"
                                                      aria-describedby="@(input.ViewModel.Input.Required ? $"{inputId}-required {input.DescriptionId}".TrimEnd() : input.DescriptionId)">
                                            @GetFileButtonText(input.ViewModel)
                                        </FluentButton>
                                    }
                                    <ValidationMessage For="@(() => input.ViewModel.Value)" />
                                </div>
                            </InteractionInputField>
                            break;
                        default:
                            @* Ignore unexpected InputTypes *@
                            break;
                        }
                    </div>
                }
            </FluentStack>

            @* Hidden submit is so the form is submitted when the user presses enter. *@
            <button type="submit" style="display:none"></button>
        </EditForm>
    </ChildContent>

    <ActionTemplate>
        <footer class="interaction-dialog-actions">
            <FluentButton Appearance="ButtonAppearance.Primary" Class="aspire-button" OnClick="@SubmitAsync">
                @Dialog.Options.Footer.PrimaryAction.Label
            </FluentButton>
            @if (!string.IsNullOrEmpty(Dialog.Options.Footer.SecondaryAction.Label))
            {
                <FluentButton Appearance="ButtonAppearance.Default" Class="aspire-button" OnClick="@CancelAsync">
                    @Dialog.Options.Footer.SecondaryAction.Label
                </FluentButton>
            }
        </footer>
    </ActionTemplate>
</FluentDialogBody>
