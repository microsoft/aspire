@using Aspire.Dashboard.Resources

<DeckDialogHeader ShowDismiss="true">
    <div class="dialog-title-grid">
        <DeckIcon Name="DeckIconName.Sparkle" Size="24" Style="grid-area: dialog-icon; align-self: center;" />
        <Label Typo="pane-header" Class="col-long-content" Style="grid-area: dialog-title;">
            @Loc[nameof(Dialogs.AIAgentsDialogTitle)]
        </Label>
    </div>
</DeckDialogHeader>

<DeckDialogBody Style="overflow-x: hidden">
    <div class="markdown-content">
        <MarkdownRenderer Markdown="@Description" MarkdownProcessor="@GetMarkdownProcessor()" SuppressParagraphOnNewLines="false" />
    </div>
</DeckDialogBody>
