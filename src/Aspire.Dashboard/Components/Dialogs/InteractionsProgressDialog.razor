@using Aspire.Dashboard.Model.Interaction
@implements IDeckDialogContentComponent<InteractionsProgressDialogViewModel>

@if (!string.IsNullOrEmpty(Dialog.Instance.Parameters.Title))
{
    <DeckDialogHeader ShowDismiss="@Dialog.Instance.Parameters.ShowDismiss">
        <div class="deck-stack" style="align-items: center;">
            <Label Typo="pane-header">
                @Dialog.Instance.Parameters.Title
            </Label>
        </div>
    </DeckDialogHeader>
}
else
{
    <DeckDialogHeader Visible="false" />
}

<DeckDialogBody Class="interaction-progress-dialog">
    <div class="progress-content">
        <div class="spinner" role="progressbar" aria-label="@Dialog.Instance.Parameters.Title"></div>

        <div class="interaction-message">
            @((MarkupString)Content.Message)
        </div>
    </div>
</DeckDialogBody>

@if (!string.IsNullOrEmpty(Dialog.Instance.Parameters.PrimaryAction))
{
    <DeckDialogFooter>
        <button type="button" class="btn" @onclick="@CancelAsync">
            @Dialog.Instance.Parameters.PrimaryAction
        </button>
    </DeckDialogFooter>
}
else
{
    <DeckDialogFooter Visible="false" />
}
