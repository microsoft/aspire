@*
    Deck dialog host, replacing DialogProvider for the Deck redesign. Subscribes to
    the DeckDialogService and renders each open dialog as a modal (centered) or panel (edge-docked)
    with an overlay. Escape and overlay clicks dismiss the dialog unless suppressed. Each dialog's
    content component is rendered via DynamicComponent with the cascading DeckDialogInstance so it can
    read parameters and close itself.
*@
@namespace Aspire.Dashboard.Components.Dialogs
@using Aspire.Dashboard.Extensions
@using Microsoft.Extensions.Localization
@implements IAsyncDisposable
@inject DeckDialogService DialogService
@inject IJSRuntime JS
@inject IStringLocalizer<Aspire.Dashboard.Resources.Dialogs> Loc

@foreach (var dialog in DialogService.OpenDialogs)
{
    @if (dialog.IsVisible)
    {
        <div class="deck-dialog-overlay @(dialog.Parameters.Modal ? "deck-dialog-overlay--modal" : null) @AlignmentClass(dialog)"
             @key="dialog.Id"
             @onclick="@(() => OnOverlayClickAsync(dialog))">
            <div class="deck-dialog @BoxClass(dialog)"
                 id="@DialogElementId(dialog.Id)"
                 style="@BoxStyle(dialog)"
                 role="dialog"
                 aria-modal="@(dialog.Parameters.Modal ? "true" : "false")"
                 aria-labelledby="@AriaLabelledBy(dialog)"
                 aria-label="@AriaLabel(dialog)"
                 tabindex="-1"
                 @onclick:stopPropagation="true"
                 @onkeydown="@(e => OnKeyDownAsync(e, dialog))">
                <CascadingValue Value="dialog.Instance" IsFixed="true">
                    <DynamicComponent Type="dialog.ComponentType" Parameters="@GetParameters(dialog)" />
                </CascadingValue>
            </div>
        </div>
    }
}

@code {
    private IJSObjectReference? _module;

    // The set of dialog ids we've initialized JS accessibility behavior for. Diffed against the
    // currently visible dialogs after each render so newly shown dialogs are initialized and closed
    // (or hidden) ones are disposed exactly once.
    private readonly HashSet<string> _initialized = new(StringComparer.Ordinal);

    protected override void OnInitialized()
    {
        DialogService.OnChanged += OnChangedAsync;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Import lazily so a provider that never shows a dialog doesn't pull the module. Once loaded
        // it's reused for the lifetime of the provider.
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Dialogs/DeckDialogProvider.razor.js");

        var visibleIds = new HashSet<string>(StringComparer.Ordinal);
        foreach (var dialog in DialogService.OpenDialogs)
        {
            if (dialog.IsVisible)
            {
                visibleIds.Add(dialog.Id);
            }
        }

        // Dispose behavior for dialogs that are no longer visible (closed or hidden). Snapshot the
        // set first because disposing mutates _initialized.
        foreach (var id in _initialized.ToList())
        {
            if (!visibleIds.Contains(id))
            {
                await _module.InvokeVoidAsync("dispose", DialogElementId(id));
                _initialized.Remove(id);
            }
        }

        // Initialize newly visible dialogs. _initialized.Add returns false for ids already set up, so
        // a dialog is only initialized once even though this runs after every render.
        foreach (var dialog in DialogService.OpenDialogs)
        {
            if (dialog.IsVisible && _initialized.Add(dialog.Id))
            {
                var options = new
                {
                    trapFocus = dialog.Parameters.TrapFocus,
                    preventScroll = dialog.Parameters.PreventScroll,
                };
                await _module.InvokeVoidAsync("initialize", DialogElementId(dialog.Id), options);
            }
        }
    }

    private Task OnChangedAsync() => InvokeAsync(StateHasChanged);

    // Stable DOM id for a dialog's root element, used as the JS lookup key and matched by dispose.
    private static string DialogElementId(string id) => $"deck-dialog-{id.SanitizeHtmlId()}";

    private static IDictionary<string, object>? GetParameters(DeckDialogService.DeckOpenDialog dialog)
    {
        // Only dialogs opened with content (IDeckDialogContentComponent<T>) receive a Content parameter.
        return dialog.Content is null
            ? null
            : new Dictionary<string, object> { ["Content"] = dialog.Content };
    }

    private string? AriaLabelledBy(DeckDialogService.DeckOpenDialog dialog)
        => AriaLabel(dialog) is null ? dialog.Instance.TitleElementId : null;

    // Keep normal dialogs associated with their visible header so dynamic titles remain current.
    // Headerless content supplies AccessibleName, while titleless content falls back to its message
    // or a localized generic label.
    private string? AriaLabel(DeckDialogService.DeckOpenDialog dialog)
    {
        if (!string.IsNullOrWhiteSpace(dialog.Parameters.AccessibleName))
        {
            return dialog.Parameters.AccessibleName;
        }

        if (dialog.Content is DeckMessageBoxContent message)
        {
            if (!string.IsNullOrWhiteSpace(message.Title))
            {
               return null;
            }

            if (!string.IsNullOrWhiteSpace(message.Message))
            {
               return message.Message;
            }
        }

        if (!string.IsNullOrWhiteSpace(dialog.Parameters.Title))
        {
            return null;
        }

        return dialog.Parameters.DialogType switch
        {
            DeckDialogType.Panel => Loc[nameof(Aspire.Dashboard.Resources.Dialogs.DeckDialogGenericPanelLabel)],
            DeckDialogType.MessageBox => Loc[nameof(Aspire.Dashboard.Resources.Dialogs.DeckDialogGenericMessageBoxLabel)],
            _ => Loc[nameof(Aspire.Dashboard.Resources.Dialogs.DeckDialogGenericDialogLabel)],
        };
    }

    private static string? AlignmentClass(DeckDialogService.DeckOpenDialog dialog)
    {
        // Alignment (edge docking + vertical stretch) is a panel-only concept. A modal Dialog stays
        // centered even when the caller left Alignment set (e.g. a responsive launcher that shows a
        // right-docked panel on desktop but a centered modal on mobile using the same parameters).
        if (dialog.Parameters.DialogType != DeckDialogType.Panel)
        {
            return null;
        }

        return dialog.Parameters.Alignment switch
        {
            DeckDialogAlignment.Start => "deck-dialog-overlay--start",
            _ => "deck-dialog-overlay--end",
        };
    }

    private static string BoxClass(DeckDialogService.DeckOpenDialog dialog)
    {
        // The box style is driven solely by DialogType. Alignment must not turn a Dialog into a panel:
        // mobile Settings/Notifications are opened as a Dialog (with Alignment still End) and must
        // remain a centered modal rather than a full-height edge panel.
        return dialog.Parameters.DialogType switch
        {
            DeckDialogType.Panel => "deck-dialog--panel",
            DeckDialogType.MessageBox => "deck-dialog--messagebox",
            _ => "deck-dialog--modal",
        };
    }

    private static string? BoxStyle(DeckDialogService.DeckOpenDialog dialog)
    {
        var width = dialog.Parameters.Width is { Length: > 0 } w ? $"width: {w};" : null;
        var height = dialog.Parameters.Height is { Length: > 0 } h && !string.Equals(h, "auto", StringComparison.OrdinalIgnoreCase)
            ? $"height: {h};"
            : null;
        return string.Concat(width, height) is { Length: > 0 } s ? s : null;
    }

    private async Task OnOverlayClickAsync(DeckDialogService.DeckOpenDialog dialog)
    {
        if (!dialog.Parameters.PreventDismissOnOverlayClick)
        {
            await dialog.Instance.CloseAsync();
        }
    }

    private async Task OnKeyDownAsync(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e, DeckDialogService.DeckOpenDialog dialog)
    {
        if (e.Key == "Escape" && !dialog.Parameters.PreventDismissOnOverlayClick)
        {
            await dialog.Instance.CloseAsync();
        }
    }

    public async ValueTask DisposeAsync()
    {
        DialogService.OnChanged -= OnChangedAsync;

        if (_module is not null)
        {
            try
            {
                // Release any still-registered dialogs (scroll lock / focus restore) before dropping
                // the module so the body isn't left with overflow:hidden if the provider is torn down
                // while a dialog is open.
                foreach (var id in _initialized)
                {
                    await _module.InvokeVoidAsync("dispose", DialogElementId(id));
                }

                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Circuit already gone; nothing to clean up.
            }
        }
    }
}
