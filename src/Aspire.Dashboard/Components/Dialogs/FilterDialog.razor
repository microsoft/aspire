@using Aspire.Dashboard.Model
@using Aspire.Dashboard.Model.Otlp
@using Aspire.Dashboard.Resources

@inject IStringLocalizer<Dialogs> Loc
@inject IStringLocalizer<StructuredFiltering> FilterLoc
@inject IStringLocalizer<ControlsStrings> ControlsLoc

<FluentDialogBody Style="width: 100%; max-height: 100%;">
<EditForm EditContext="@EditContext" OnValidSubmit="@Apply">
    <DataAnnotationsValidator />

    <div class="filter-dialog-form">
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="12">
        <div class="filter-input-container input-container">
            <div class="input-line-container">
                <FluentSelect TOption="SelectViewModel<string>" TValue="SelectViewModel<string>"
                              Placeholder="@Loc[nameof(Dialogs.FilterDialogFieldPlaceholder)]"
                              Label="@Loc[nameof(Dialogs.FilterDialogParameterInputLabel)]"
                              Items="@_parameters"
                              @bind-Value="@_formModel.Parameter"
                              @bind-Value:after="ParameterChangedAsync"
                              Width="100%"
                              Height="400px"
                              Disabled="@_loadingPropertyKeys"
                              OptionText="@((SelectViewModel<string>? c) => c?.Name)"
                              OptionDisabled="@((SelectViewModel<string>? c) => c is not null && c.Id is null)"
                              OptionTitle="@((SelectViewModel<string> c) => DashboardUIHelpers.ResolveTooltip(c.Name))">
                </FluentSelect>
                @if (_loadingPropertyKeys)
                {
                    <FluentSpinner Width="20px" Class="input-progress" aria-label="@ControlsLoc[nameof(ControlsStrings.Loading)]" />
                }
            </div>
        </div>

        <div class="filter-input-container input-container">
            <FluentSelect TOption="SelectViewModel<FilterCondition>" TValue="SelectViewModel<FilterCondition>"
                          Items="@_filterConditions"
                          @bind-Value="@_formModel.Condition"
                          Label="@Loc[nameof(Dialogs.FilterDialogConditionInputLabel)]"
                          OptionText="@((SelectViewModel<FilterCondition>? i) => i?.Name)"
                          Width="100%" />
        </div>

        @if (_formModel.ValueIsNumeric)
        {
            <div class="filter-input-container input-container">
                <FluentNumberInput TValue="double?"
                                   @bind-Value="_formModel.NumericValue"
                                   Min="0"
                                   Step="50"
                                   Width="100%"
                                   Immediate="true"
                                   ImmediateDelay="@FluentUIExtensions.InputDelay"
                                   Label="@Loc[nameof(Dialogs.FilterDialogTextValuePlaceholder)]" />
                <ValidationMessage For="() => _formModel.NumericValue" />
            </div>
        }
        else if (_formModel.ValueIsDate)
        {
            <div class="filter-input-container input-container">
                @* Position relative to correctly align the absolute positioned date picker *@
                <div style="position: relative;">
                    <FluentTextInput @bind-Value="_formModel.Value"
                                    Style="min-width: 100%"
                                    Immediate="true"
                                    ImmediateDelay="@FluentUIExtensions.InputDelay"
                                    Placeholder="@Loc[nameof(Dialogs.FilterDialogDatePlaceholder)]"
                                    Label="@Loc[nameof(Dialogs.FilterDialogDateValueLabel)]">
                        <FluentIcon slot="end"
                                    Value="@(new Icons.Regular.Size16.Calendar())"
                                    Title="@Loc[nameof(Dialogs.FilterDialogPickDateButtonTitle)]"
                                    OnClick="OpenDatePickerAsync"
                                    Color="Color.Primary"
                                    Style="cursor: pointer;" />
                    </FluentTextInput>
                    <input type="datetime-local"
                           @ref="_datePickerInput"
                           step="1"
                           value="@_formModel.DateTimeLocalValue"
                           @oninput="OnDateTimePickerChanged"
                           style="position: absolute; right: 0; bottom: 0; height: 0; width: 0; overflow: hidden; border: none; padding: 0; margin: 0; pointer-events: none; opacity: 0;" />
                </div>
                <ValidationMessage For="() => _formModel.Value" />
            </div>
        }
        else
        {
            <div class="filter-input-container input-container">
                <div class="input-line-container">
                    @* TODO: Restore Immediate/ImmediateDelay when https://github.com/microsoft/fluentui-blazor/issues/5173 is fixed. *@
                    <FluentField Id="filter-dialog-text-value-field"
                                 ForId="filter-dialog-text-value"
                                 ValueExpression="@(() => _formModel.Value)"
                                 Label="@Loc[nameof(Dialogs.FilterDialogTextValuePlaceholder)]"
                                 IncludeInputSlot="false">
                        <CascadingValue Name="HideFluentField" Value="@true" IsFixed="true">
                            <FluentCombobox TOption="SelectViewModel<FieldValue>" TValue="SelectViewModel<FieldValue>"
                                            Id="filter-dialog-text-value"
                                            slot="input"
                                            @bind-Value="_selectedValue"
                                            @bind-Value:after="SelectedValueChanged"
                                            Items="@_filteredValues"
                                            Width="100%"
                                            Height="400px"
                                            Disabled="@_loadingFieldValues"
                                            OptionText="@((SelectViewModel<FieldValue>? c) => c?.Name)"
                                            OptionTitle="@((SelectViewModel<FieldValue> c) => DashboardUIHelpers.ResolveTooltip(c.Name))"
                                            @oninput="OnValueInput">
                                <OptionTemplate Context="optionContext">
                                    <FluentHighlighter Text="@optionContext.Name" HighlightedText="@_formModel.Value" />
                                    <FluentBadge slot="description" Circular="true" Appearance="BadgeAppearance.Tint" Color="BadgeColor.Subtle">
                                        @* There is FluentUI bug that causes bad data if there is additional text in an option. *@
                                        @* https://github.com/microsoft/fluentui-blazor/issues/2695 *@
                                        @* Workaround this issue by inserting extra text using CSS. *@
                                        <span data-filtercount="@optionContext.Id!.Count"></span>
                                    </FluentBadge>
                                </OptionTemplate>
                            </FluentCombobox>
                        </CascadingValue>
                    </FluentField>
                    @if (_loadingFieldValues)
                    {
                        <FluentSpinner Width="20px" Class="input-progress" aria-label="@ControlsLoc[nameof(ControlsStrings.Loading)]" />
                    }
                </div>
            </div>
        }

        <div class="filter-input-container filter-button-container input-container">
            <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.Left">
                @if (Content.Filter is not null)
                {
                    if (Content.Filter.Enabled)
                    {
                        <FluentButton Appearance="ButtonAppearance.Default" Title="@Loc[nameof(Dialogs.FilterDialogDisableFilterButtonText)]" aria-label="@Loc[nameof(Dialogs.FilterDialogDisableFilterButtonText)]" OnClick="Disable"><FluentIcon Value="@(new Icons.Regular.Size16.Pause())" Color="Color.Primary" /></FluentButton>
                    }
                    else
                    {
                        <FluentButton Appearance="ButtonAppearance.Default" Title="@Loc[nameof(Dialogs.FilterDialogDisableFilterButtonText)]" aria-label="@Loc[nameof(Dialogs.FilterDialogDisableFilterButtonText)]" OnClick="Enable"><FluentIcon Value="@(new Icons.Regular.Size16.Play())" Color="Color.Primary" /></FluentButton>
                    }
                    <FluentButton Appearance="ButtonAppearance.Default" Title="@Loc[nameof(Dialogs.FilterDialogRemoveFilterButtonText)]" aria-label="@Loc[nameof(Dialogs.FilterDialogRemoveFilterButtonText)]" OnClick="Delete"><FluentIcon Value="@(new Icons.Regular.Size16.Delete())" Color="Color.Primary" /></FluentButton>
                }
            </FluentStack>

            <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.Right">
                <FluentButton OnClick="Cancel">@Loc[nameof(Dialogs.FilterDialogCancelButtonText)]</FluentButton>
                <FluentButton Appearance="ButtonAppearance.Primary" Type="ButtonType.Submit">@Loc[nameof(Dialogs.FilterDialogApplyFilterButtonText)]</FluentButton>
            </FluentStack>
        </div>
    </FluentStack>
    </div>

</EditForm>
</FluentDialogBody>
