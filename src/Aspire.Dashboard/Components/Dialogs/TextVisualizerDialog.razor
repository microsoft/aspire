@using Aspire.Dashboard.Extensions
@using Aspire.Dashboard.Model
@using Aspire.Dashboard.Resources

@inject IStringLocalizer<Dialogs> Loc
@inject IStringLocalizer<ControlsStrings> ControlsStringsLoc

<FluentDialogBody Class="text-visualizer-dialog-body">
    <TitleTemplate>
        <div class="dialog-title-grid">
            <FluentIcon Value="@(new Icons.Regular.Size24.SlideSearch())" Color="Color.Primary" Style="grid-area: dialog-icon; align-self: center;" />
            <FluentLabel Typo="Typography.PaneHeader" Class="col-long-content text-visualizer-dialog-title" Style="grid-area: dialog-title;">
                @Content.Description
            </FluentLabel>

            <div class="dialog-format">
                @if (!HasFixedFormat)
                {
                    <FluentSelect TOption="SelectViewModel<string>" TValue="SelectViewModel<string>"
                                  Id="@_selectFormatId"
                                  Items="@_options"
                                  Position="SelectPosition.Below"
                                  OptionText="@((SelectViewModel<string>? option) => option?.Name)"
                                  OptionDisabled="@((SelectViewModel<string>? option) => option is not null && !EnabledOptions.Contains(option.Id))"
                                  @bind-Value="@_selectedFormat"
                                  @bind-Value:after="OnSelectedFormatChanged"
                                  AriaLabel="@Loc[nameof(Dialogs.TextVisualizerSelectFormatType)]"
                                  Class="aspire-input text-visualizer-format"
                                  Style="width: clamp(7rem, 20vw, 12rem); max-width: 100%;">
                        <OptionTemplate>
                            <span hidden data-tooltip-option="@context.Name"></span>
                            @context.Name
                        </OptionTemplate>
                    </FluentSelect>
                }
                @if (!_isLoading)
                {
                    @if (IsTextContentDisplayed)
                    {
                        <FluentButton Class="aspire-button text-visualizer-word-wrap"
                                      Appearance="@(_noWrap ? ButtonAppearance.Default : ButtonAppearance.Primary)"
                                      IconOnly="true"
                                      IconStart="new Icons.Regular.Size16.TextWrap()"
                                      OnClick="@ToggleWordWrap"
                                      data-tooltip="@Loc[nameof(Dialogs.TextVisualizerWordWrap)]"
                                      aria-label="@Loc[nameof(Dialogs.TextVisualizerWordWrap)]"
                                      aria-pressed="@((!_noWrap).ToString().ToLowerInvariant())" />
                    }
                    <FluentButton Id="@_copyButtonId"
                                  Class="aspire-button text-visualizer-copy"
                                  Appearance="ButtonAppearance.Default"
                                  IconOnly="true"
                                  data-tooltip="@ControlsStringsLoc[nameof(ControlsStrings.GridValueCopyToClipboard)]"
                                  aria-label="@ControlsStringsLoc[nameof(ControlsStrings.GridValueCopyToClipboard)]"
                                  @attributes="@FluentUIExtensions.GetClipboardCopyAdditionalAttributes(TextVisualizerViewModel.FormattedText, ControlsStringsLoc[nameof(ControlsStrings.GridValueCopyToClipboard)], ControlsStringsLoc[nameof(ControlsStrings.GridValueCopied)], ("data-copy-duration", 2000))">
                        <FluentIcon Class="copy-icon" Icon="Icons.Regular.Size16.Copy" Color="Color.Primary" />
                        <FluentIcon Class="checkmark-icon" Style="display:none" Icon="Icons.Regular.Size16.Checkmark" Color="Color.Primary" />
                    </FluentButton>
                }
            </div>
        </div>
    </TitleTemplate>

    <ChildContent>
    <div class="text-visualizer-container">
        @if (IsTextContentDisplayed)
        {
            if (Content.MarkdownDescription is { Length: > 0 } description)
            {
                <div class="text-visualizer-description">
                    <MarkdownRenderer Markdown="@description" MarkdownProcessor="@GetMarkdownProcessor()" SuppressParagraphOnNewLines="false" />
                </div>
            }

            if (IsMarkdownFormat)
            {
                <div class="markdown-content @(_noWrap ? "markdown-content-no-wrap" : null)">
                    <MarkdownRenderer Markdown="@Content.Text" MarkdownProcessor="@GetMarkdownProcessor()" SuppressParagraphOnNewLines="false" />
                </div>
            }
            else
            {
                <TextVisualizer ViewModel="TextVisualizerViewModel" NoWrap="@_noWrap" />
            }
        }
        else if (ShowSecretsWarning is true)
        {
            @* Don't display until ShowSecretsWarning is loaded and is known to be true *@
            <div class="block-warning">
                <div class="block-warning-icon">
                    <FluentIcon Value="new Icons.Filled.Size16.Warning()" Color="Color.Warning" />
                </div>

                <div class="block-warning-message">
                    <span class="title">@Loc[nameof(Dialogs.TextVisualizerSecretWarningTitle)]</span>
                    @Loc[nameof(Dialogs.TextVisualizerSecretWarningDescription)]
                </div>
            </div>
        }
    </div>
    </ChildContent>

    <ActionTemplate>
        @if (!_isLoading && (ShowSecretsWarning is true || Content.DownloadFileName is not null))
        {
            <div class="button-container">
                <div class="button-container-right">
                    @if (ShowSecretsWarning is true)
                    {
                        <FluentButton Class="aspire-button text-visualizer-unmask-content"
                                      OnClick="@UnmaskContentAsync">
                            @Loc[nameof(Dialogs.TextVisualizerSecretWarningAcknowledge)]
                        </FluentButton>
                    }

                    @if (Content.DownloadFileName is not null)
                    {
                        <FluentButton Class="aspire-button"
                                      OnClick="@DownloadAsync"
                                      data-tooltip="@ControlsStringsLoc[nameof(ControlsStrings.Download)]"
                                      aria-label="@ControlsStringsLoc[nameof(ControlsStrings.Download)]"
                                      IconStart="new Icons.Regular.Size16.ArrowDownload()">
                            @ControlsStringsLoc[nameof(ControlsStrings.Download)]
                        </FluentButton>
                    }

                </div>
            </div>
        }
    </ActionTemplate>
</FluentDialogBody>
