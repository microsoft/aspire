<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>$(MSBuildThisFileDirectory)..\Shared\Aspire.ico</ApplicationIcon>
    <AssemblyName>aspire-managed</AssemblyName>

    <!-- Not a shippable package -->
    <IsPackable>false</IsPackable>
    <EnablePackageValidation>false</EnablePackageValidation>
    <UsePublicApiAnalyzers>false</UsePublicApiAnalyzers>

    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- Don't generate web.config or include IIS hosting -->
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>

    <!-- CreateLayout copies only the managed executable, so native dependencies must be embedded in the single file. -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <!-- Locate the SDK's trustedroots directory for NuGet signature verification certificates -->
    <_SdkTrustedRootsDir>$([System.IO.Path]::Combine($([System.IO.Path]::GetDirectoryName($(BundledRuntimeIdentifierGraphFile))), 'trustedroots'))</_SdkTrustedRootsDir>
  </PropertyGroup>

  <!-- On Windows, ship Hex1b's PTY host alongside aspire-managed. Nothing in the tree launches it
       yet: DCP owns every PTY we currently surface. AppHost-owned terminals (#19887) add the path
       that needs it, where Hex1b owns the pseudo-terminal itself, and #19976 asks for the helper to
       be signed and bundled before that lands. src/Directory.Build.targets strips it from publish
       output everywhere else (dead weight in the CLI archive, and extra winget submission friction),
       so this is the one project that opts back in. Publishing it as a loose file next to
       aspire-managed is what lets the build sign it and CreateLayout stage it at
       managed/hex1bpty.exe. -->
  <PropertyGroup Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win'))">
    <PublishHex1bPtyHost>true</PublishHex1bPtyHost>
  </PropertyGroup>

  <!-- Embed NuGet trusted root certificates from the .NET SDK for signature verification on Linux -->
  <ItemGroup>
    <EmbeddedResource Include="$(_SdkTrustedRootsDir)\*.pem" />
    <EmbeddedResource Update="$(_SdkTrustedRootsDir)\*.pem" LogicalName="%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Aspire.Dashboard\Aspire.Dashboard.csproj" />
    <ProjectReference Include="..\Aspire.Hosting.RemoteHost\Aspire.Hosting.RemoteHost.csproj" />
    <ProjectReference Include="..\Aspire.TerminalHost\Aspire.TerminalHost.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Provided by the .NET SDK and points to the SDK's RuntimeIdentifierGraph.json file. -->
    <EmbeddedResource Include="$(BundledRuntimeIdentifierGraphFile)" LogicalName="Aspire.Managed.RuntimeIdentifierGraph.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- Preview package warning suppressions do not flow through the Aspire.Dashboard project reference.
      Exclude compile/runtime assets so this direct reference doesn't displace the Dashboard's runtime asset
      from the single-file publish. -->
    <PackageReference Include="Microsoft.FluentUI.AspNetCore.Components" PrivateAssets="all" ExcludeAssets="compile;runtime" NoWarn="NU3018;NU3027;NU3042" Condition="'$(MicrosoftFluentUIAspNetCoreComponentsIsPreview)' == 'true'" />
    <PackageReference Include="NuGet.Commands" />
    <PackageReference Include="NuGet.Protocol" />
    <PackageReference Include="NuGet.Resolver" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="$(SharedDir)BundleDiscovery.cs" Link="Shared\BundleDiscovery.cs" />
    <Compile Include="$(SharedDir)BundleVersionLease.cs" Link="Shared\BundleVersionLease.cs" />
    <Compile Include="$(SharedDir)HeldFileLease.cs" Link="Shared\HeldFileLease.cs" />
    <Compile Include="$(SharedDir)IntegrationPackageProbeManifest.cs" Link="NuGet\IntegrationPackageProbeManifest.cs" />
    <Compile Include="$(SharedDir)KnownConfigNames.cs" Link="Shared\KnownConfigNames.cs" />
    <Compile Include="$(SharedDir)ParentProcessWatchdog.cs" Link="Shared\ParentProcessWatchdog.cs" />
    <Compile Include="$(SharedDir)ProcessStartTimeHelper.cs" Link="Shared\ProcessStartTimeHelper.cs" />
    <Compile Include="$(SharedDir)ParentProcessLivenessMonitor.cs" Link="Shared\ParentProcessLivenessMonitor.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Aspire.Managed.Tests" />
  </ItemGroup>

  <!-- Exclude unwanted files from publish output -->
  <Target Name="RemoveUnwantedPublishFiles" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(RelativePath)' == 'appsettings.json'" />
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="$([System.String]::Copy('%(RelativePath)').StartsWith('appsettings.'))" />
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.xml'" />
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(RelativePath)' == 'web.config'" />
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(RelativePath)' == 'aspnetcorev2_inprocess.dll'" />
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="$([System.String]::Copy('%(RelativePath)').EndsWith('.runtimeconfig.json'))" />
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="$([System.String]::Copy('%(RelativePath)').EndsWith('.staticwebassets.endpoints.json'))" />
    </ItemGroup>
  </Target>

  <Target Name="ValidateSingleFilePublishConfiguration" BeforeTargets="PrepareForPublish">
    <Error Condition="'$(PublishSingleFile)' == 'true' and '$(IncludeNativeLibrariesForSelfExtract)' != 'true'"
           Text="Aspire.Managed single-file publishing must embed native libraries because CreateLayout copies only the managed executable." />
  </Target>

</Project>
