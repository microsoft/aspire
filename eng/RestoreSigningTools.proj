<Project DefaultTargets="Restore">
  <!-- Use Arcade's bootstrap entry point to locate the pinned SDK without
       importing component build targets or duplicating its version/path rules. -->
  <PropertyGroup>
    <RepoRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..'))</RepoRoot>
    <ArtifactsDir Condition="'$(ArtifactsDir)' == ''">$(RepoRoot)artifacts/</ArtifactsDir>
    <__ToolsetLocationOutputFile>$([MSBuild]::NormalizePath('$(ArtifactsDir)', 'toolset', 'signing-tools-location.txt'))</__ToolsetLocationOutputFile>
  </PropertyGroup>

  <Import Project="Sdk.props" Sdk="Microsoft.DotNet.Arcade.Sdk" />
  <Import Project="Sdk.targets" Sdk="Microsoft.DotNet.Arcade.Sdk" />

  <Target Name="Restore" DependsOnTargets="__WriteToolsetLocation">
    <ReadLinesFromFile File="$(__ToolsetLocationOutputFile)">
      <Output TaskParameter="Lines" PropertyName="_ArcadeBuildProject" />
    </ReadLinesFromFile>
    <PropertyGroup>
      <_ArcadeToolsProject>$([MSBuild]::NormalizePath('$([System.IO.Path]::GetDirectoryName('$(_ArcadeBuildProject)'))', 'Tools.proj'))</_ArcadeToolsProject>
      <_ArcadeSdkDirectory>$([System.IO.Path]::GetDirectoryName('$([System.IO.Path]::GetDirectoryName('$(_ArcadeBuildProject)'))'))</_ArcadeSdkDirectory>
      <_ArcadeSdkVersion>$([System.IO.Path]::GetFileName('$(_ArcadeSdkDirectory)'))</_ArcadeSdkVersion>
      <_SigningToolsIntermediateDir>$([MSBuild]::NormalizeDirectory('$(ArtifactsDir)', 'toolset', 'SigningTools'))</_SigningToolsIntermediateDir>
    </PropertyGroup>
    <!-- Tools.proj needs NuGet targets supplied by its caller, just as Arcade's
         build driver supplies them. No repository project restore is required. -->
    <MSBuild Projects="$(_ArcadeToolsProject)"
             Targets="Restore"
             Properties="RepoRoot=$(RepoRoot);BaseIntermediateOutputPath=$(_SigningToolsIntermediateDir);ExcludeRestorePackageImports=true;_NuGetRestoreTargets=$(MSBuildToolsPath)/NuGet.targets" />
    <!-- The build scripts require artifacts/toolset/<SDK version>.txt even when
         tool packages already exist. Match their bootstrap marker on cold agents;
         its location is repository-relative, independent of ArtifactsDir overrides. -->
    <WriteLinesToFile File="$(RepoRoot)artifacts/toolset/$(_ArcadeSdkVersion).txt"
                      Lines="$(_ArcadeBuildProject)"
                      Overwrite="true" />
  </Target>
</Project>
