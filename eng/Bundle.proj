<Project DefaultTargets="Build" TreatAsLocalProperty="RequireWindowsTraySignature;RequireMacTraySignature">
  <!--
    Bundle.proj - Standalone project for creating the Aspire CLI bundle.

    Usage: dotnet msbuild eng/Bundle.proj /p:TargetRid=linux-x64 /p:Configuration=Release

    Entry points and major steps:
    - Build (default): Used by eng/build.sh, eng/build.ps1, and deployment tests.
      Validate and clean caches -> publish components -> restore DCP -> assemble
      and verify the bundle layout -> publish the CLI unless SkipNativeBuild=true.
      This standalone path does not produce Dashboard/DCP or CLI tool/npm packages.
    - BuildNativeBundle: Selected explicitly by GitHub native-archive CI and the
      official build_sign_native.yml template.
      Validate signing inputs -> publish components -> validate Dashboard warnings
      -> prepare macOS signing inputs -> optionally sign components and tray
      -> restore execute permissions -> package prepared payload -> build/sign/pack CLI.
      The existing clipack/AfterSigning flow owns the final CLI publish and packages.

    The dependency properties below define execution order. Publishing prepares
    Aspire.Managed, Native AOT Dashboard/TerminalHost, and the platform tray.
    Packaging consumes those prepared files without republishing signed inputs.

    Options:
    - SkipNativeBuild=true: Skip building native CLI (use pre-built from artifacts)
    - SkipManagedBuild=true: Skip building managed projects (use pre-built)
    - SkipDashboardPublish=true: Reuse the prepared RID-specific Dashboard publish
    - PackDcpPackage=true: Also produce the RID-specific DCP package during native payload packaging
    - SkipTrayBuild=true: Use a pre-built native tray (required after official signing)
    - TrayAppPath: Override the pre-built macOS app directory
    - WindowsTrayPath: Override the pre-built Windows tray publish directory
    - CliPublishDir: Override the final native CLI publish directory (e.g. for isolated local validation)
    - BundleVersion: Version string for the bundle (auto-computed in CI if not set)
  -->

  <!-- Import Versions.props for version info -->
  <Import Project="Versions.props" />

  <PropertyGroup>
    <PublishBundleComponentsDependsOn>
      _ValidateBundleConfiguration;
      _PublishManagedProjects;
      _PublishNativeTray
    </PublishBundleComponentsDependsOn>

    <!-- Never add publishing here: republishing would overwrite signed inputs. -->
    <PackageBundlePayloadDependsOn>
      _ValidateBundleConfiguration;
      _ValidatePreparedBundle;
      _PackDashboardPackage;
      _PackDcpPackage;
      _RestoreDcpPackage;
      _RunCreateLayout
    </PackageBundlePayloadDependsOn>
    <BuildDependsOn>
      _ShowBanner;
      _CleanCaches;
      $(PublishBundleComponentsDependsOn);
      _RestoreDcpPackage;
      _RunCreateLayout;
      _PublishNativeCli
    </BuildDependsOn>

    <BuildNativeBundleDependsOn>
      _ValidateAndSetNativeBundleSigningProperties;
      $(PublishBundleComponentsDependsOn);
      _ValidateDashboardWarnings;
      _PrepareMacOSBundleSigning;
      _RemoveMacOSBundleDebugSymbols;
      _SignBundleComponents;
      _SignMacOSBundleTray;
      _RestoreBundleExecutePermissions;
      $(PackageBundlePayloadDependsOn);
      _BuildNativePackages
    </BuildNativeBundleDependsOn>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Configuration -->
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>

    <!-- Runtime ID for the bundle -->
    <TargetRid Condition="'$(TargetRid)' == '' and '$(TargetRids)' != ''">$(TargetRids)</TargetRid>
    <TargetRid Condition="'$(TargetRid)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">win-x64</TargetRid>
    <TargetRid Condition="'$(TargetRid)' == '' and $([MSBuild]::IsOSPlatform('OSX'))">osx-arm64</TargetRid>
    <TargetRid Condition="'$(TargetRid)' == ''">linux-x64</TargetRid>

    <!-- Paths -->
    <RepoRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..'))</RepoRoot>
    <_BundleEngineeringDir>$(MSBuildThisFileDirectory)</_BundleEngineeringDir>
    <ArtifactsDir>$(RepoRoot)artifacts\</ArtifactsDir>
    <ArtifactsLogDir>$(ArtifactsDir)log\$(Configuration)\</ArtifactsLogDir>
    <BundleOutputDir>$(ArtifactsDir)bundle\$(TargetRid)\</BundleOutputDir>

    <!-- Project paths -->
    <CliProjectPath>$(RepoRoot)src\Aspire.Cli\Aspire.Cli.csproj</CliProjectPath>
    <ManagedProjectPath>$(RepoRoot)src\Aspire.Managed\Aspire.Managed.csproj</ManagedProjectPath>
    <DashboardProjectPath>$(RepoRoot)src\Aspire.Dashboard\Aspire.Dashboard.csproj</DashboardProjectPath>
    <TerminalHostProjectPath>$(RepoRoot)src\Aspire.TerminalHost\Aspire.TerminalHost.csproj</TerminalHostProjectPath>
    <AppHostProjectPath>$(RepoRoot)src\Aspire.Hosting.AppHost\Aspire.Hosting.AppHost.csproj</AppHostProjectPath>
    <CreateLayoutProjectPath>$(RepoRoot)tools\CreateLayout\CreateLayout.csproj</CreateLayoutProjectPath>
    <DashboardPackProjectPath>$([MSBuild]::NormalizePath('$(_BundleEngineeringDir)', 'dashboardpack', 'Aspire.Dashboard.Sdk.$(TargetRid).csproj'))</DashboardPackProjectPath>
    <DcpPackProjectPath>$([MSBuild]::NormalizePath('$(_BundleEngineeringDir)', 'dcppack', 'Aspire.Hosting.Orchestration.$(TargetRid).csproj'))</DcpPackProjectPath>
    <TrayProjectPath>$(RepoRoot)src\Aspire.Tray\Mac\Aspire.Tray.Mac.csproj</TrayProjectPath>
    <TrayAppPath Condition="'$(TrayAppPath)' == ''">$([MSBuild]::NormalizePath('$(ArtifactsDir)', 'bin', 'Aspire.Tray.Mac', '$(Configuration)', '$(DefaultTargetFramework)', '$(TargetRid)', 'app', 'Aspire Tray.app'))</TrayAppPath>
    <WindowsTrayProjectPath>$(RepoRoot)src\Aspire.Tray\Windows\Aspire.Tray.Windows.csproj</WindowsTrayProjectPath>
    <WindowsTrayPath Condition="'$(WindowsTrayPath)' == ''">$([MSBuild]::NormalizeDirectory('$(ArtifactsDir)', 'bin', 'Aspire.Tray.Windows', '$(Configuration)', '$(DefaultTargetFramework)', '$(TargetRid)', 'publish'))</WindowsTrayPath>
    <RequireWindowsTraySignature Condition="'$(RequireWindowsTraySignature)' == ''">false</RequireWindowsTraySignature>
    <RequireMacTraySignature Condition="'$(RequireMacTraySignature)' == ''">false</RequireMacTraySignature>

    <!-- Bundle version: use VersionSuffix from CI if provided, else dev version for local builds -->
    <!-- In GitHub Actions CI: VersionSuffix is set via /p:VersionSuffix=pr.XXXX.gSHA -->
    <BundleVersion Condition="'$(BundleVersion)' == '' and '$(VersionSuffix)' != ''">$(VersionPrefix)-$(VersionSuffix)</BundleVersion>
    <BundleVersion Condition="'$(BundleVersion)' == ''">$(VersionPrefix)-dev</BundleVersion>

    <ContinuousIntegrationBuild Condition="'$(ContinuousIntegrationBuild)' == ''">false</ContinuousIntegrationBuild>
    <Sign Condition="'$(Sign)' == ''">false</Sign>

    <BuildScriptPath Condition="'$(BuildScriptPath)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">$([MSBuild]::NormalizePath('$(RepoRoot)', 'build.cmd'))</BuildScriptPath>
    <BuildScriptPath Condition="'$(BuildScriptPath)' == ''">$([MSBuild]::NormalizePath('$(RepoRoot)', 'build.sh'))</BuildScriptPath>

    <ManagedPublishDir Condition="'$(ManagedPublishDir)' == ''">$([MSBuild]::NormalizeDirectory('$(ArtifactsDir)', 'bin', 'Aspire.Managed', '$(Configuration)', '$(DefaultTargetFramework)', '$(TargetRid)', 'publish'))</ManagedPublishDir>
    <DashboardPublishDir Condition="'$(DashboardPublishDir)' == ''">$([MSBuild]::NormalizeDirectory('$(ArtifactsDir)', 'bin', 'Aspire.Dashboard', '$(TargetRid)', '$(Configuration)', '$(AspireDashboardTargetFramework)', '$(TargetRid)', 'publish'))</DashboardPublishDir>
    <TerminalHostPublishDir Condition="'$(TerminalHostPublishDir)' == ''">$([MSBuild]::NormalizeDirectory('$(ArtifactsDir)', 'bin', 'Aspire.TerminalHost', '$(Configuration)', '$(AspireTerminalHostTargetFramework)', '$(TargetRid)', 'publish'))</TerminalHostPublishDir>

    <TraySigningProjectPath Condition="'$(TraySigningProjectPath)' == ''">$([MSBuild]::NormalizePath('$(_BundleEngineeringDir)', 'pipelines', 'SignTray.proj'))</TraySigningProjectPath>
    <TraySigningArchive Condition="'$(TraySigningArchive)' == ''">$([MSBuild]::NormalizePath('$(ArtifactsDir)', 'bin', 'Aspire.Tray.Mac', '$(Configuration)', '$(DefaultTargetFramework)', '$(TargetRid)', 'signing', 'AspireTray.zip'))</TraySigningArchive>
    <DashboardPublishLogPath>$([MSBuild]::NormalizePath('$(ArtifactsLogDir)', 'PublishNativeDashboard.log'))</DashboardPublishLogPath>

    <!-- Exec does not inherit MSBuild properties. Forward build identity explicitly,
         but not orchestration switches such as SkipNativeBuild, which would disable
         the Dashboard packaging project's native payload. -->
    <_BundleChildArgs>/p:Configuration=$(Configuration) /p:TargetRid=$(TargetRid) /p:ContinuousIntegrationBuild=$(ContinuousIntegrationBuild) /p:VersionPrefix=$(VersionPrefix)</_BundleChildArgs>
    <!-- Arcade imports package build targets from .packages in CI, but direct
         dotnet restore otherwise uses the user cache. Match those locations on
         cold agents so Grpc.Tools targets are imported and protobufs generated.
         Respect an existing NUGET_PACKAGES cache supplied by the caller. -->
    <_BundleNuGetCache Condition="'$(RestorePackagesPath)' != ''">$([MSBuild]::EnsureTrailingSlash('$(RestorePackagesPath)'))</_BundleNuGetCache>
    <_BundleNuGetCache Condition="'$(_BundleNuGetCache)' == '' and '$(NUGET_PACKAGES)' != ''">$([MSBuild]::EnsureTrailingSlash('$(NUGET_PACKAGES)'))</_BundleNuGetCache>
    <_BundleNuGetCache Condition="'$(_BundleNuGetCache)' == '' and '$(ContinuousIntegrationBuild)' == 'true' and '$(NUGET_PACKAGES)' == ''">$([MSBuild]::NormalizeDirectory('$(RepoRoot)', '.packages'))</_BundleNuGetCache>
    <!-- Arcade's NuGetPackageRoot drives generated package imports and DcpDir
         in Directory.Build.props. Keep it aligned with RestorePackagesPath. -->
    <_BundleNuGetRoot Condition="'$(_BundleNuGetCache)' != ''">$([MSBuild]::EnsureTrailingSlash('$(_BundleNuGetCache)'))</_BundleNuGetRoot>
    <!-- A trailing backslash escapes the closing quote in Windows process arguments. -->
    <_BundleChildArgs Condition="'$(_BundleNuGetCache)' != ''">$(_BundleChildArgs) "/p:RestorePackagesPath=$(_BundleNuGetCache.TrimEnd('\').TrimEnd('/'))/" "/p:NuGetPackageRoot=$(_BundleNuGetRoot.TrimEnd('\').TrimEnd('/'))/"</_BundleChildArgs>
    <!-- CreateLayout discovers DCP from this cache path. -->
    <_BundleChildEnvironment Condition="'$(_BundleNuGetCache)' != ''">NUGET_PACKAGES=$(_BundleNuGetCache)</_BundleChildEnvironment>

    <_BundleChildArgs Condition="'$(VersionSuffix)' != ''">$(_BundleChildArgs) /p:VersionSuffix=$(VersionSuffix)</_BundleChildArgs>
    <_BundleChildArgs Condition="'$(DotNetFinalVersionKind)' != ''">$(_BundleChildArgs) /p:DotNetFinalVersionKind=$(DotNetFinalVersionKind)</_BundleChildArgs>
    <_BundleChildArgs Condition="'$(StabilizePackageVersion)' != ''">$(_BundleChildArgs) /p:StabilizePackageVersion=$(StabilizePackageVersion)</_BundleChildArgs>

    <!-- Official build identity -->
    <_BundleChildArgs Condition="'$(OfficialBuildId)' != ''">$(_BundleChildArgs) /p:OfficialBuildId=$(OfficialBuildId)</_BundleChildArgs>
    <_BundleChildArgs Condition="'$(IsOfficialBuild)' != ''">$(_BundleChildArgs) /p:IsOfficialBuild=$(IsOfficialBuild)</_BundleChildArgs>
    <_BundleChildArgs Condition="'$(OfficialBuild)' != ''">$(_BundleChildArgs) /p:OfficialBuild=$(OfficialBuild)</_BundleChildArgs>

    <_BundleChildArgs Condition="'$(AspireCliChannel)' != ''">$(_BundleChildArgs) /p:AspireCliChannel=$(AspireCliChannel)</_BundleChildArgs>
  </PropertyGroup>

  <Target Name="_SetBundleTrayProperties">
    <!-- Construct at execution time so importing projects can override tray paths.
         Tray preparation/restoration need no fresh evaluation. Task calls inherit
         global properties; forward locally evaluated identity and cache values too. -->
    <PropertyGroup>
      <_BundleTrayProperties>Configuration=$(Configuration);TargetRid=$(TargetRid);RuntimeIdentifier=$(TargetRid);ContinuousIntegrationBuild=$(ContinuousIntegrationBuild);VersionPrefix=$(VersionPrefix);TrayAppPath=$(TrayAppPath);TraySigningArchive=$(TraySigningArchive)</_BundleTrayProperties>
      <_BundleTrayProperties Condition="'$(_BundleNuGetCache)' != ''">$(_BundleTrayProperties);RestorePackagesPath=$(_BundleNuGetCache);NuGetPackageRoot=$(_BundleNuGetRoot)</_BundleTrayProperties>
      <_BundleTrayProperties Condition="'$(VersionSuffix)' != ''">$(_BundleTrayProperties);VersionSuffix=$(VersionSuffix)</_BundleTrayProperties>
      <_BundleTrayProperties Condition="'$(DotNetFinalVersionKind)' != ''">$(_BundleTrayProperties);DotNetFinalVersionKind=$(DotNetFinalVersionKind)</_BundleTrayProperties>
      <_BundleTrayProperties Condition="'$(StabilizePackageVersion)' != ''">$(_BundleTrayProperties);StabilizePackageVersion=$(StabilizePackageVersion)</_BundleTrayProperties>
      <_BundleTrayProperties Condition="'$(OfficialBuildId)' != ''">$(_BundleTrayProperties);OfficialBuildId=$(OfficialBuildId)</_BundleTrayProperties>
      <_BundleTrayProperties Condition="'$(IsOfficialBuild)' != ''">$(_BundleTrayProperties);IsOfficialBuild=$(IsOfficialBuild)</_BundleTrayProperties>
      <_BundleTrayProperties Condition="'$(OfficialBuild)' != ''">$(_BundleTrayProperties);OfficialBuild=$(OfficialBuild)</_BundleTrayProperties>
      <_BundleTrayProperties Condition="'$(AspireCliChannel)' != ''">$(_BundleTrayProperties);AspireCliChannel=$(AspireCliChannel)</_BundleTrayProperties>
    </PropertyGroup>
  </Target>

  <ItemGroup>
    <_SupportedBundleRid Include="win-x64;win-arm64;osx-x64;osx-arm64;linux-x64;linux-arm64;linux-musl-x64" />
  </ItemGroup>

  <!-- Each wrapper invocation is a fresh evaluation: Signing.props discovers files
       with evaluation-time globs, including archives that do not exist until Pack.
       The clipack/AfterSigning flow owns the final CLI publish and package signing. -->
  <Target Name="BuildNativeBundle" DependsOnTargets="$(BuildNativeBundleDependsOn)" />

  <Target Name="_ValidateAndSetNativeBundleSigningProperties" DependsOnTargets="_ValidateBundleConfiguration">
    <!-- These discrete values are forwarded to shell children, never parsed as
         command strings. Reject shell syntax before any child is launched. -->
    <Error Condition="'$(VersionSuffix)' != '' and !$([System.Text.RegularExpressions.Regex]::IsMatch('$(VersionSuffix)', '^[A-Za-z0-9][A-Za-z0-9.-]*$'))"
           Text="VersionSuffix must contain only letters, digits, dots, and hyphens." />
    <Error Condition="'$(AspireCliChannel)' != '' and !$([System.Text.RegularExpressions.Regex]::IsMatch('$(AspireCliChannel)', '^[A-Za-z0-9][A-Za-z0-9.-]*$'))"
           Text="AspireCliChannel must contain only letters, digits, dots, and hyphens." />
    <Error Condition="'$(Sign)' != 'true' and '$(Sign)' != 'false'"
           Text="Sign must be true or false." />
    <Error Condition="'$(DotNetSignType)' != '' and '$(DotNetSignType)' != 'test' and '$(DotNetSignType)' != 'real'"
           Text="DotNetSignType must be empty, test, or real." />
    <Error Condition="'$(Sign)' == 'true' and '$(DotNetSignType)' == ''"
           Text="Signing requires DotNetSignType=test or real." />
    <!-- MicroBuild_SigningEnabled is computed by plugin props imported in signing
         children. This standalone project does not import them; the signing
         projects must validate plugin availability in their own evaluation. -->
    <Error Condition="'$(DotNetSignType)' == 'real' and '$(Sign)' != 'true'"
           Text="Real signing requires Sign=true." />
    <!-- Arcade otherwise silently dry-runs Sign.proj, even when the plugin is
         installed. Identity permits real signing only after the explicit request. -->
    <Error Condition="'$(DotNetSignType)' == 'real' and ('$(OfficialBuild)' == 'false' or ('$(OfficialBuild)' != 'true' and '$(OfficialBuildId)' == '') or '$(ForceDryRunSigning)' == 'true')"
           Text="Real signing requires an official build identity without ForceDryRunSigning." />
    <Error Condition="'$(Sign)' == 'true' and $(TargetRid.StartsWith('linux-'))"
           Text="Linux native bundle lanes must disable signing." />
    <Error Condition="('$(RequireWindowsTraySignature)' == 'true' or '$(RequireMacTraySignature)' == 'true') and ('$(Sign)' != 'true' or '$(DotNetSignType)' != 'real')"
           Text="Tray signature verification requires real signing." />
    <PropertyGroup>
      <_BundleSignSwitch Condition="'$(Sign)' == 'true'">-sign</_BundleSignSwitch>
      <_BundleSigningArgs Condition="'$(DotNetSignType)' != ''">/p:DotNetSignType=$(DotNetSignType)</_BundleSigningArgs>
      <_BundleSigningArgs>$(_BundleSigningArgs) "/p:ArtifactsDir=$(ArtifactsDir.TrimEnd('\').TrimEnd('/'))/"</_BundleSigningArgs>
      <_BundleSigningArgs Condition="'$(TeamName)' != ''">$(_BundleSigningArgs) "/p:TeamName=$(TeamName)"</_BundleSigningArgs>
      <_BundleSigningArgs Condition="'$(DotNetPublishUsingPipelines)' != ''">$(_BundleSigningArgs) /p:DotNetPublishUsingPipelines=$(DotNetPublishUsingPipelines)</_BundleSigningArgs>
      <RequireWindowsTraySignature Condition="$(TargetRid.StartsWith('win-')) and '$(Sign)' == 'true' and '$(DotNetSignType)' == 'real'">true</RequireWindowsTraySignature>
      <RequireMacTraySignature Condition="$(TargetRid.StartsWith('osx-')) and '$(Sign)' == 'true' and '$(DotNetSignType)' == 'real'">true</RequireMacTraySignature>
    </PropertyGroup>
  </Target>

  <Target Name="_ValidateDashboardWarnings" Condition="'$(SkipDashboardPublish)' != 'true'">
    <Exec Command="pwsh -NoProfile -File &quot;$(_BundleEngineeringDir)scripts/verify-native-dashboard-warnings.ps1&quot; -BuildLog &quot;$(DashboardPublishLogPath)&quot;" />
  </Target>

  <Target Name="_PrepareMacOSBundleSigning"
          DependsOnTargets="_SetBundleTrayProperties"
          Condition="$(TargetRid.StartsWith('osx-'))">
    <!-- MicroBuild preserves these entitlements when re-signing. Without them,
         hardened runtime prevents CoreCLR JIT in aspire-managed. Also needed unsigned. -->
    <Exec Command="codesign --sign - --force --entitlements &quot;$(_BundleEngineeringDir)aspire-managed-entitlements.plist&quot; &quot;$([MSBuild]::NormalizePath('$(ManagedPublishDir)', 'aspire-managed'))&quot;" />
    <MSBuild Projects="$(TrayProjectPath)"
             Targets="PrepareTraySigning"
             Condition="'$(Sign)' == 'true' and '$(DotNetSignType)' == 'real'"
             Properties="$(_BundleTrayProperties)"
             RemoveProperties="SkipNativeBuild;SkipManagedBuild;SkipTrayBuild" />
  </Target>

  <Target Name="_RemoveMacOSBundleDebugSymbols" Condition="$(TargetRid.StartsWith('osx-')) and '$(Sign)' == 'true'">
    <!-- ESRP discovery also matches executables inside adjacent dSYM bundles.
         Dashboard symbols are required; TerminalHost does not always emit them. -->
    <PropertyGroup>
      <_DashboardSymbolsPath>$([MSBuild]::NormalizePath('$(DashboardPublishDir)', 'Aspire.Dashboard.dSYM'))</_DashboardSymbolsPath>
      <_TerminalHostSymbolsPath>$([MSBuild]::NormalizePath('$(TerminalHostPublishDir)', 'Aspire.TerminalHost.dSYM'))</_TerminalHostSymbolsPath>
    </PropertyGroup>
    <Error Condition="!Exists('$(_DashboardSymbolsPath)')"
           Text="Dashboard debug symbols are missing: $(_DashboardSymbolsPath)" />
    <RemoveDir Directories="$(_DashboardSymbolsPath);$(_TerminalHostSymbolsPath)" />
  </Target>

  <Target Name="_SignBundleComponents" Condition="'$(Sign)' == 'true'">
    <MakeDir Directories="$(ArtifactsLogDir)" />
    <Exec Command="&quot;$(BuildScriptPath)&quot; -restore -sign -configuration $(Configuration) -projects &quot;$(ManagedProjectPath)&quot; $(_BundleChildArgs) $(_BundleSigningArgs) &quot;/bl:$(ArtifactsLogDir)SignBundleComponents.binlog&quot;"
          EnvironmentVariables="$(_BundleChildEnvironment)" />
  </Target>

  <Target Name="_SignMacOSBundleTray"
          DependsOnTargets="_SetBundleTrayProperties"
          Condition="$(TargetRid.StartsWith('osx-')) and '$(Sign)' == 'true' and '$(DotNetSignType)' == 'real'">
    <MakeDir Directories="$(ArtifactsLogDir)" />
    <!-- Restore must finish before a fresh evaluation imports MicroBuild's SignFiles task. -->
    <Exec Command="dotnet msbuild &quot;$(TraySigningProjectPath)&quot; -restore /t:SignTray /p:RuntimeIdentifier=$(TargetRid) /p:SignType=real /p:TraySigningArchive=&quot;$(TraySigningArchive)&quot; $(_BundleChildArgs) $(_BundleSigningArgs) &quot;/bl:$(ArtifactsLogDir)SignTray.binlog&quot;"
          EnvironmentVariables="$(_BundleChildEnvironment)" />
    <MSBuild Projects="$(TrayProjectPath)"
             Targets="RestoreSignedTray"
             Properties="$(_BundleTrayProperties)"
             RemoveProperties="SkipNativeBuild;SkipManagedBuild;SkipTrayBuild" />
  </Target>

  <Target Name="_RestoreBundleExecutePermissions" Condition="!$(TargetRid.StartsWith('win-')) and '$(Sign)' == 'true'">
    <!-- MicroBuild replaces signed files, resetting their mode to the agent umask. -->
    <Exec Command="chmod +x &quot;$([MSBuild]::NormalizePath('$(ManagedPublishDir)', 'aspire-managed'))&quot; &quot;$([MSBuild]::NormalizePath('$(DashboardPublishDir)', 'Aspire.Dashboard'))&quot; &quot;$([MSBuild]::NormalizePath('$(TerminalHostPublishDir)', 'Aspire.TerminalHost'))&quot;" />
  </Target>

  <Target Name="_BuildNativePackages">
    <MakeDir Directories="$(ArtifactsLogDir)" />
    <Exec Command="&quot;$(BuildScriptPath)&quot; -ci -restore -build -pack -configuration $(Configuration) $(_BundleSignSwitch) /p:SkipManagedBuild=true /p:TargetRids=$(TargetRid) &quot;/p:BundlePayloadPath=$(ArtifactsDir)bundle/aspire-$(BundleVersion)-$(TargetRid).tar.gz&quot; $(_BundleChildArgs) $(_BundleSigningArgs) &quot;/bl:$(ArtifactsLogDir)BuildNativePackages.binlog&quot;"
          EnvironmentVariables="$(_BundleChildEnvironment)" />
  </Target>

  <Target Name="Build" DependsOnTargets="$(BuildDependsOn)">
    <Message Importance="high" Text="" />
    <Message Importance="high" Text="Bundle created at: $(BundleOutputDir)" />
  </Target>

  <Target Name="_ValidateBundleConfiguration">
    <ItemGroup>
      <_MatchingBundleRid Include="@(_SupportedBundleRid)"
                          Condition="$([System.String]::Equals('%(_SupportedBundleRid.Identity)', '$(TargetRid)'))" />
    </ItemGroup>
    <!-- CI archives must exercise the optimized payload that we ship, not Debug Native AOT output. -->
    <Error Condition="'$(ContinuousIntegrationBuild)' == 'true' and '$(Configuration)' != 'Release'"
           Text="CI native bundles must use Configuration=Release." />
    <Error Condition="'@(_MatchingBundleRid)' == ''"
           Text="TargetRid must be exactly one supported bundle RID, not a RID list: '$(TargetRid)'. Supported RIDs: @(_SupportedBundleRid, ', ')." />
  </Target>

  <Target Name="_ShowBanner" DependsOnTargets="_ValidateBundleConfiguration">
    <Message Importance="high" Text="" />
    <Message Importance="high" Text="========================================" />
    <Message Importance="high" Text="Building Aspire CLI Bundle" />
    <Message Importance="high" Text="  RID: $(TargetRid)" />
    <Message Importance="high" Text="  Configuration: $(Configuration)" />
    <Message Importance="high" Text="  Version: $(BundleVersion)" />
    <Message Importance="high" Text="  Output: $(BundleOutputDir)" />
    <Message Importance="high" Text="========================================" />
    <Message Importance="high" Text="" />
  </Target>

  <Target Name="_CleanCaches" Condition="'$(ContinuousIntegrationBuild)' == 'true'">
    <Message Importance="high" Text="Cleaning caches to free disk space..." />
    <Exec Command="dotnet nuget locals http-cache --clear" EnvironmentVariables="$(_BundleChildEnvironment)" IgnoreExitCode="true" StandardOutputImportance="low" />
  </Target>

  <Target Name="_PublishNativeCli" Condition="'$(SkipNativeBuild)' != 'true'">
    <MakeDir Directories="$(ArtifactsLogDir)" Condition="'$(ContinuousIntegrationBuild)' == 'true'" />
    <PropertyGroup>
      <_CliBinlogArg Condition="'$(ContinuousIntegrationBuild)' == 'true'">-bl:$(ArtifactsLogDir)PublishCli.binlog</_CliBinlogArg>
      <!-- The tar.gz archive produced by CreateLayout is embedded as a resource in the CLI binary -->
      <_BundleArchivePath>$(ArtifactsDir)bundle\aspire-$(BundleVersion)-$(TargetRid).tar.gz</_BundleArchivePath>
      <_CliPublishOutputArg Condition="'$(CliPublishDir)' != ''">--output "$(CliPublishDir)"</_CliPublishOutputArg>
    </PropertyGroup>
    <Message Importance="high" Text="Publishing native AOT CLI with embedded bundle: $(_BundleArchivePath)" />
    <Exec Command="dotnet publish &quot;$(CliProjectPath)&quot; -r $(TargetRid) $(_CliPublishOutputArg) /p:BundlePayloadPath=&quot;$(_BundleArchivePath)&quot; $(_BundleChildArgs) &quot;$(_CliBinlogArg)&quot;"
          EnvironmentVariables="$(_BundleChildEnvironment)" />
  </Target>

  <Target Name="_PublishManagedProjects" Condition="'$(SkipManagedBuild)' != 'true'">
    <MakeDir Directories="$(ArtifactsLogDir)" />
    <PropertyGroup>
      <_ManagedBinlogArg Condition="'$(ContinuousIntegrationBuild)' == 'true'">-bl:$(ArtifactsLogDir)PublishManaged.binlog</_ManagedBinlogArg>
      <_DashboardBinlogArg Condition="'$(ContinuousIntegrationBuild)' == 'true'">-bl:$(ArtifactsLogDir)PublishDashboard.binlog</_DashboardBinlogArg>
      <_TerminalHostBinlogArg Condition="'$(ContinuousIntegrationBuild)' == 'true'">-bl:$(ArtifactsLogDir)PublishTerminalHost.binlog</_TerminalHostBinlogArg>
    </PropertyGroup>
    <Message Importance="high" Text="Publishing aspire-managed (self-contained)..." />
    <!-- Publish as self-contained single-file for the target RID -->
    <Exec Command="dotnet publish &quot;$(ManagedProjectPath)&quot; -r $(TargetRid) --self-contained /p:GenerateDocumentationFile=false /p:EnforceCodeStyleInBuild=false $(_BundleChildArgs) &quot;$(_ManagedBinlogArg)&quot;"
          EnvironmentVariables="$(_BundleChildEnvironment)" />
    <PropertyGroup Condition="'$(SkipDashboardPublish)' == 'true'">
      <_DashboardExecutableName>Aspire.Dashboard</_DashboardExecutableName>
      <_DashboardExecutableName Condition="$(TargetRid.StartsWith('win-'))">Aspire.Dashboard.exe</_DashboardExecutableName>
      <_DashboardPublishPath>$([MSBuild]::NormalizePath('$(DashboardPublishDir)', '$(_DashboardExecutableName)'))</_DashboardPublishPath>
    </PropertyGroup>
    <Error Condition="'$(SkipDashboardPublish)' == 'true' and !Exists('$(_DashboardPublishPath)')"
           Text="Prepared Native AOT Dashboard was not found at '$(_DashboardPublishPath)'. Build the RID-specific Dashboard package before using SkipDashboardPublish=true." />
    <Message Importance="high" Text="Publishing Aspire Dashboard (Native AOT)..." Condition="'$(SkipDashboardPublish)' != 'true'" />
    <Exec Command="dotnet publish &quot;$(DashboardProjectPath)&quot; -r $(TargetRid) /p:PlatformName=$(TargetRid) /p:GenerateDocumentationFile=false /p:EnforceCodeStyleInBuild=false $(_BundleChildArgs) &quot;$(_DashboardBinlogArg)&quot; &quot;-flp:logfile=$(DashboardPublishLogPath);verbosity=normal&quot;"
          EnvironmentVariables="$(_BundleChildEnvironment)"
          Condition="'$(SkipDashboardPublish)' != 'true'" />
    <Message Importance="high" Text="Publishing Aspire TerminalHost (Native AOT)..." />
    <Exec Command="dotnet publish &quot;$(TerminalHostProjectPath)&quot; -r $(TargetRid) /p:GenerateDocumentationFile=false /p:EnforceCodeStyleInBuild=false $(_BundleChildArgs) &quot;$(_TerminalHostBinlogArg)&quot;"
          EnvironmentVariables="$(_BundleChildEnvironment)" />
  </Target>

  <Target Name="_ValidatePreparedBundle">
    <PropertyGroup>
      <_PreparedDashboardDir>$([MSBuild]::NormalizeDirectory('$(ArtifactsDir)', 'bin', 'Aspire.Dashboard', '$(TargetRid)', '$(Configuration)', '$(AspireDashboardTargetFramework)', '$(TargetRid)', 'publish'))</_PreparedDashboardDir>
      <_PreparedExecutableExtension Condition="$(TargetRid.StartsWith('win-'))">.exe</_PreparedExecutableExtension>
      <_PreparedSqliteLibrary>libe_sqlite3.so</_PreparedSqliteLibrary>
      <_PreparedSqliteLibrary Condition="$(TargetRid.StartsWith('win-'))">e_sqlite3.dll</_PreparedSqliteLibrary>
      <_PreparedSqliteLibrary Condition="$(TargetRid.StartsWith('osx-'))">libe_sqlite3.dylib</_PreparedSqliteLibrary>
    </PropertyGroup>
    <ItemGroup>
      <_RequiredPreparedBundleFile Include="$(ArtifactsDir)bin\Aspire.Managed\$(Configuration)\$(DefaultTargetFramework)\$(TargetRid)\publish\aspire-managed$(_PreparedExecutableExtension)" />
      <_RequiredPreparedBundleFile Include="$(ArtifactsDir)bin\Aspire.TerminalHost\$(Configuration)\$(AspireTerminalHostTargetFramework)\$(TargetRid)\publish\Aspire.TerminalHost$(_PreparedExecutableExtension)" />
      <_RequiredPreparedBundleFile Include="$(_PreparedDashboardDir)Aspire.Dashboard$(_PreparedExecutableExtension);$(_PreparedDashboardDir)wwwroot\_framework\blazor.web.js;$(_PreparedDashboardDir)$(_PreparedSqliteLibrary)" />
      <_RequiredPreparedBundleFile Include="$([MSBuild]::NormalizePath('$(WindowsTrayPath)', 'aspire-tray.exe'));$([MSBuild]::NormalizePath('$(WindowsTrayPath)', 'Aspire.ico'))" Condition="$(TargetRid.StartsWith('win-'))" />
      <_RequiredPreparedBundleFile Include="$([MSBuild]::NormalizePath('$(TrayAppPath)', 'Contents', 'MacOS', 'aspire-tray'));$([MSBuild]::NormalizePath('$(TrayAppPath)', 'Contents', 'Info.plist'));$([MSBuild]::NormalizePath('$(TrayAppPath)', 'Contents', 'Resources', 'Aspire.icns'))" Condition="$(TargetRid.StartsWith('osx-'))" />
    </ItemGroup>
    <Error Condition="!Exists('%(_RequiredPreparedBundleFile.Identity)')"
           Text="Prepared bundle input is missing: %(_RequiredPreparedBundleFile.Identity). Publish bundle components before signing and packaging." />
  </Target>

  <Target Name="_PackDashboardPackage">
    <Exec Command="dotnet build &quot;$(DashboardPackProjectPath)&quot; $(_BundleChildArgs) /p:SkipDashboardPublish=true"
          EnvironmentVariables="$(_BundleChildEnvironment)" />
  </Target>

  <Target Name="_PackDcpPackage" Condition="'$(PackDcpPackage)' == 'true'">
    <Exec Command="dotnet build &quot;$(DcpPackProjectPath)&quot; $(_BundleChildArgs)"
          EnvironmentVariables="$(_BundleChildEnvironment)" />
  </Target>

  <!-- SkipNativeBuild skips the outer CLI publish, not native payload components.
       Official builds publish/sign the app first, then reuse it with SkipTrayBuild. -->
  <Target Name="_PublishNativeTray" Condition="($(TargetRid.StartsWith('osx-')) or $(TargetRid.StartsWith('win-'))) and '$(SkipTrayBuild)' != 'true'">
    <MakeDir Directories="$(ArtifactsLogDir)" Condition="'$(ContinuousIntegrationBuild)' == 'true'" />
    <PropertyGroup>
      <_TrayBinlogArg Condition="'$(ContinuousIntegrationBuild)' == 'true'">-bl:$(ArtifactsLogDir)PublishTray.binlog</_TrayBinlogArg>
    </PropertyGroup>
    <Error Condition="$(TargetRid.StartsWith('win-')) and !$([MSBuild]::IsOSPlatform('Windows'))"
           Text="Windows NativeAOT tray publishing requires a Windows build lane." />
    <Error Condition="$(TargetRid.StartsWith('win-')) and '$(TargetRid)' != 'win-x64' and '$(TargetRid)' != 'win-arm64'"
           Text="Windows tray supports only win-x64 and win-arm64." />
    <Message Importance="high" Text="Publishing native tray for $(TargetRid)..." />
    <Exec Command="dotnet publish &quot;$(TrayProjectPath)&quot; -r $(TargetRid) /p:TrayAppPath=&quot;$(TrayAppPath.TrimEnd('\').TrimEnd('/'))/&quot; $(_BundleChildArgs) &quot;$(_TrayBinlogArg)&quot;"
          EnvironmentVariables="$(_BundleChildEnvironment)"
          Condition="$(TargetRid.StartsWith('osx-'))" />
    <Exec Command="dotnet publish &quot;$(WindowsTrayProjectPath)&quot; -r $(TargetRid) --self-contained --output &quot;$(WindowsTrayPath.TrimEnd('\').TrimEnd('/'))/&quot; $(_BundleChildArgs) &quot;$(_TrayBinlogArg)&quot;"
          EnvironmentVariables="$(_BundleChildEnvironment)"
          Condition="$(TargetRid.StartsWith('win-'))" />
  </Target>

  <Target Name="_RestoreDcpPackage">
    <MakeDir Directories="$(ArtifactsLogDir)" Condition="'$(ContinuousIntegrationBuild)' == 'true'" />
    <PropertyGroup>
      <_DcpBinlogArg Condition="'$(ContinuousIntegrationBuild)' == 'true'">-bl:$(ArtifactsLogDir)RestoreDcp.binlog</_DcpBinlogArg>

      <!-- Map TargetRid to DCP BuildOs/BuildArch so the AppHost restore downloads
           the correct DCP package for the target platform, not the build machine's platform.
           Without this, cross-compiled bundles (e.g., win-arm64 built on win-x64) would
           be missing DCP because the default BuildOs/BuildArch resolve to the build machine.

           Supported RID format: {os}-{arch} where os is win/osx/linux/linux-musl
           and arch is x64/arm64/x86. Update this mapping when adding new RID patterns. -->
      <_BundleBuildOs Condition="$(TargetRid.StartsWith('win-'))">windows</_BundleBuildOs>
      <_BundleBuildOs Condition="$(TargetRid.StartsWith('osx-'))">darwin</_BundleBuildOs>
      <_BundleBuildOs Condition="$(TargetRid.StartsWith('linux-musl-'))">linux-musl</_BundleBuildOs>
      <_BundleBuildOs Condition="'$(_BundleBuildOs)' == '' and $(TargetRid.StartsWith('linux-'))">linux</_BundleBuildOs>

      <_BundleBuildArch Condition="$(TargetRid.EndsWith('-x64'))">amd64</_BundleBuildArch>
      <_BundleBuildArch Condition="$(TargetRid.EndsWith('-arm64'))">arm64</_BundleBuildArch>
      <_BundleBuildArch Condition="$(TargetRid.EndsWith('-x86'))">386</_BundleBuildArch>
    </PropertyGroup>
    <Error Condition="'$(_BundleBuildOs)' == '' or '$(_BundleBuildArch)' == ''"
           Text="Could not map TargetRid '$(TargetRid)' to DCP BuildOs/BuildArch. Supported RID patterns: win-x64, win-arm64, linux-x64, linux-arm64, linux-musl-x64, osx-x64, osx-arm64." />
    <Message Importance="high" Text="Restoring DCP package for $(TargetRid) (BuildOs=$(_BundleBuildOs), BuildArch=$(_BundleBuildArch))..." />
    <Exec Command="dotnet restore &quot;$(AppHostProjectPath)&quot; /p:BuildOs=$(_BundleBuildOs) /p:BuildArch=$(_BundleBuildArch) &quot;$(_DcpBinlogArg)&quot; $(_BundleChildArgs)"
          EnvironmentVariables="$(_BundleChildEnvironment)" />
  </Target>

  <Target Name="_RunCreateLayout">
    <PropertyGroup>
      <!-- Remove trailing slashes for command line arguments -->
      <_BundleOutputDirArg>$(BundleOutputDir.TrimEnd('\').TrimEnd('/'))</_BundleOutputDirArg>
      <_ArtifactsDirArg>$(ArtifactsDir.TrimEnd('\').TrimEnd('/'))</_ArtifactsDirArg>

      <_CreateLayoutArgs>--output "$(_BundleOutputDirArg)" --artifacts "$(_ArtifactsDirArg)" --rid $(TargetRid) --configuration $(Configuration) --bundle-version $(BundleVersion) --verbose --archive</_CreateLayoutArgs>
      <_CreateLayoutArgs Condition="$(TargetRid.StartsWith('osx-'))">$(_CreateLayoutArgs) --tray-app "$(TrayAppPath.TrimEnd('\').TrimEnd('/'))/"</_CreateLayoutArgs>
      <_CreateLayoutArgs Condition="$(TargetRid.StartsWith('win-'))">$(_CreateLayoutArgs) --tray-windows "$(WindowsTrayPath.TrimEnd('\').TrimEnd('/'))/"</_CreateLayoutArgs>
    </PropertyGroup>

    <Message Importance="high" Text="Creating bundle layout..." />
    <Exec Command="dotnet run --project &quot;$(CreateLayoutProjectPath)&quot; $(_BundleChildArgs) -- $(_CreateLayoutArgs)"
          EnvironmentVariables="$(_BundleChildEnvironment)" />
  </Target>

  <!-- Verify the actual tar payload, not the source app. This also runs in the
       official layout-only path, after signing and before native CLI embedding. -->
  <Target Name="_VerifyNativeTrayArchive" AfterTargets="_RunCreateLayout" Condition="$(TargetRid.StartsWith('osx-'))">
    <Exec Command="bash &quot;$(RepoRoot)tools/CreateLayout/verify-tray-payload.sh&quot; &quot;$(ArtifactsDir)bundle/aspire-$(BundleVersion)-$(TargetRid).tar.gz&quot; &quot;$(TargetRid)&quot; &quot;$(RequireMacTraySignature)&quot;" />
  </Target>

  <Target Name="_VerifyWindowsTrayArchive" AfterTargets="_RunCreateLayout" Condition="$(TargetRid.StartsWith('win-'))">
    <Exec Command="pwsh -NoProfile -File &quot;$(RepoRoot)tools/CreateLayout/verify-windows-tray-payload.ps1&quot; -Archive &quot;$(ArtifactsDir)bundle/aspire-$(BundleVersion)-$(TargetRid).tar.gz&quot; -Rid &quot;$(TargetRid)&quot; -RequireSignature $(RequireWindowsTraySignature)" />
  </Target>

</Project>
