<Project>
  <PropertyGroup>
    <!-- This repo version -->
    <MajorVersion>17</MajorVersion>
    <MinorVersion>0</MinorVersion>
    <PatchVersion>0</PatchVersion>
    <VersionPrefix>$(MajorVersion).$(MinorVersion).$(PatchVersion)</VersionPrefix>
    <PreReleaseVersionLabel>preview.1</PreReleaseVersionLabel>
    <!-- The development branch precedes its dashboard image. Remove this override once the matching image tag is published. -->
    <AspireDashboardImageTag>13.6</AspireDashboardImageTag>
    <DefaultTargetFramework>net10.0</DefaultTargetFramework>
    <AllTargetFrameworks>$(DefaultTargetFramework);net11.0</AllTargetFrameworks>
    <!-- dotnet versions for running template tests -->
    <DotNetRuntimeNet10VersionForTesting>10.0.8</DotNetRuntimeNet10VersionForTesting>
    <DotNetSdkNet10VersionForTesting>10.0.401</DotNetSdkNet10VersionForTesting>
    <XunitV3Version>4.0.0</XunitV3Version>
    <XUnitAnalyzersVersion>2.0.0</XUnitAnalyzersVersion>
    <XunitRunnerVisualStudioVersion>4.0.0</XunitRunnerVisualStudioVersion>
    <MicrosoftTestingPlatformVersion>2.4.0</MicrosoftTestingPlatformVersion>
    <MicrosoftNETTestSdkVersion>18.10.0</MicrosoftNETTestSdkVersion>
    <!-- Enable to remove prerelease label. -->
    <StabilizePackageVersion Condition="'$(StabilizePackageVersion)' == ''">false</StabilizePackageVersion>
    <DotNetFinalVersionKind Condition="'$(StabilizePackageVersion)' == 'true'">release</DotNetFinalVersionKind>
  </PropertyGroup>
  <PropertyGroup>
    <!-- DCP -->
    <MicrosoftDeveloperControlPlanedarwinamd64Version>0.26.5</MicrosoftDeveloperControlPlanedarwinamd64Version>
    <MicrosoftDeveloperControlPlanedarwinarm64Version>0.26.5</MicrosoftDeveloperControlPlanedarwinarm64Version>
    <MicrosoftDeveloperControlPlanelinuxamd64Version>0.26.5</MicrosoftDeveloperControlPlanelinuxamd64Version>
    <MicrosoftDeveloperControlPlanelinuxarm64Version>0.26.5</MicrosoftDeveloperControlPlanelinuxarm64Version>
    <MicrosoftDeveloperControlPlanelinuxmuslamd64Version>0.26.5</MicrosoftDeveloperControlPlanelinuxmuslamd64Version>
    <MicrosoftDeveloperControlPlanewindowsamd64Version>0.26.5</MicrosoftDeveloperControlPlanewindowsamd64Version>
    <MicrosoftDeveloperControlPlanewindowsarm64Version>0.26.5</MicrosoftDeveloperControlPlanewindowsarm64Version>
    <!-- Other -->
    <MicrosoftDotNetRemoteExecutorVersion>10.0.0-beta.26472.2</MicrosoftDotNetRemoteExecutorVersion>
    <MicrosoftDotNetXUnitV3ExtensionsVersion>10.0.0-beta.26472.2</MicrosoftDotNetXUnitV3ExtensionsVersion>
    <MicrosoftDotNetBuildTasksArchivesVersion>10.0.0-beta.26472.2</MicrosoftDotNetBuildTasksArchivesVersion>
    <!-- dotnet/extensions -->
    <MicrosoftExtensionsAIVersion>10.10.0</MicrosoftExtensionsAIVersion>
    <MicrosoftExtensionsAIOpenAIVersion>10.10.0</MicrosoftExtensionsAIOpenAIVersion>
    <MicrosoftExtensionsAIAzureAIInferenceVersion>10.0.0-preview.1.25559.3</MicrosoftExtensionsAIAzureAIInferenceVersion>
    <MicrosoftExtensionsHttpResilienceVersion>10.10.0</MicrosoftExtensionsHttpResilienceVersion>
    <MicrosoftExtensionsDependencyInjectionAutoActivationVersion>10.10.0</MicrosoftExtensionsDependencyInjectionAutoActivationVersion>
    <MicrosoftExtensionsDiagnosticsTestingVersion>10.10.0</MicrosoftExtensionsDiagnosticsTestingVersion>
    <MicrosoftExtensionsTimeProviderTestingVersion>10.10.0</MicrosoftExtensionsTimeProviderTestingVersion>
    <MicrosoftExtensionsServiceDiscoveryVersion>10.10.0</MicrosoftExtensionsServiceDiscoveryVersion>
    <MicrosoftExtensionsServiceDiscoveryYarpVersion>10.10.0</MicrosoftExtensionsServiceDiscoveryYarpVersion>
    <!-- OpenTelemetry (OTel) -->
    <OpenTelemetryInstrumentationAspNetCoreVersion>1.18.0</OpenTelemetryInstrumentationAspNetCoreVersion>
    <OpenTelemetryInstrumentationHttpVersion>1.18.0</OpenTelemetryInstrumentationHttpVersion>
    <OpenTelemetryInstrumentationExtensionsHostingVersion>1.18.0</OpenTelemetryInstrumentationExtensionsHostingVersion>
    <OpenTelemetryInstrumentationRuntimeVersion>1.18.0</OpenTelemetryInstrumentationRuntimeVersion>
    <OpenTelemetryExporterOpenTelemetryProtocolVersion>1.18.0</OpenTelemetryExporterOpenTelemetryProtocolVersion>
    <AzureMonitorOpenTelemetryExporterVersion>1.9.0</AzureMonitorOpenTelemetryExporterVersion>
    <!-- Aspire.Cli runs NuGet restore in-process in a native AOT binary, which needs newer NuGet.*
         builds than the stable versions the rest of the repo uses (see Directory.Packages.props).
         These prereleases come from the dotnet11 feed, which does not carry the stable versions,
         so NuGet.config maps NuGet.* to both feeds. -->
    <NuGetPackageVersionForCli>7.12.0-rc.25</NuGetPackageVersionForCli>
    <!-- MicroBuild.Core version for VS Code extension signing -->
    <MicrosoftVisualStudioEngMicroBuildCoreVersion>1.0.0</MicrosoftVisualStudioEngMicroBuildCoreVersion>
  </PropertyGroup>
  <!-- .NET 10.0 Package Versions -->
  <PropertyGroup Label="Net10">
    <!-- EF -->
    <MicrosoftEntityFrameworkCoreCosmosNet10Version>10.0.12</MicrosoftEntityFrameworkCoreCosmosNet10Version>
    <MicrosoftEntityFrameworkCoreDesignNet10Version>10.0.12</MicrosoftEntityFrameworkCoreDesignNet10Version>
    <MicrosoftEntityFrameworkCoreSqlServerNet10Version>10.0.12</MicrosoftEntityFrameworkCoreSqlServerNet10Version>
    <MicrosoftEntityFrameworkCoreToolsNet10Version>10.0.12</MicrosoftEntityFrameworkCoreToolsNet10Version>
    <!-- ASP.NET Core -->
    <MicrosoftAspNetCoreAuthenticationCertificateNet10Version>10.0.12</MicrosoftAspNetCoreAuthenticationCertificateNet10Version>
    <MicrosoftAspNetCoreAuthenticationJwtBearerNet10Version>10.0.12</MicrosoftAspNetCoreAuthenticationJwtBearerNet10Version>
    <MicrosoftAspNetCoreAuthenticationOpenIdConnectNet10Version>10.0.12</MicrosoftAspNetCoreAuthenticationOpenIdConnectNet10Version>
    <MicrosoftAspNetCoreOpenApiNet10Version>10.0.12</MicrosoftAspNetCoreOpenApiNet10Version>
    <MicrosoftAspNetCoreOutputCachingStackExchangeRedisNet10Version>10.0.12</MicrosoftAspNetCoreOutputCachingStackExchangeRedisNet10Version>
    <MicrosoftAspNetCoreTestHostNet10Version>10.0.12</MicrosoftAspNetCoreTestHostNet10Version>
    <MicrosoftExtensionsCachingStackExchangeRedisNet10Version>10.0.12</MicrosoftExtensionsCachingStackExchangeRedisNet10Version>
    <MicrosoftExtensionsDiagnosticsHealthChecksEntityFrameworkCoreNet10Version>10.0.12</MicrosoftExtensionsDiagnosticsHealthChecksEntityFrameworkCoreNet10Version>
    <MicrosoftExtensionsDiagnosticsHealthChecksNet10Version>10.0.12</MicrosoftExtensionsDiagnosticsHealthChecksNet10Version>
    <MicrosoftExtensionsFileProvidersEmbeddedNet10Version>10.0.12</MicrosoftExtensionsFileProvidersEmbeddedNet10Version>
    <MicrosoftExtensionsFeaturesNet10Version>10.0.12</MicrosoftExtensionsFeaturesNet10Version>
    <MicrosoftAspNetCoreSignalRClientNet10Version>10.0.12</MicrosoftAspNetCoreSignalRClientNet10Version>
    <!-- Runtime -->
    <MicrosoftBclMemoryNet10Version>10.0.12</MicrosoftBclMemoryNet10Version>
    <MicrosoftExtensionsHostingAbstractionsNet10Version>10.0.12</MicrosoftExtensionsHostingAbstractionsNet10Version>
    <MicrosoftExtensionsHostingNet10Version>10.0.12</MicrosoftExtensionsHostingNet10Version>
    <MicrosoftExtensionsCachingMemoryNet10Version>10.0.12</MicrosoftExtensionsCachingMemoryNet10Version>
    <MicrosoftExtensionsConfigurationAbstractionsNet10Version>10.0.12</MicrosoftExtensionsConfigurationAbstractionsNet10Version>
    <MicrosoftExtensionsConfigurationBinderNet10Version>10.0.12</MicrosoftExtensionsConfigurationBinderNet10Version>
    <MicrosoftExtensionsConfigurationEnvironmentVariablesNet10Version>10.0.12</MicrosoftExtensionsConfigurationEnvironmentVariablesNet10Version>
    <MicrosoftExtensionsDependencyInjectionAbstractionsNet10Version>10.0.12</MicrosoftExtensionsDependencyInjectionAbstractionsNet10Version>
    <MicrosoftExtensionsFileSystemGlobbingNet10Version>10.0.12</MicrosoftExtensionsFileSystemGlobbingNet10Version>
    <MicrosoftExtensionsLoggingAbstractionsNet10Version>10.0.12</MicrosoftExtensionsLoggingAbstractionsNet10Version>
    <MicrosoftExtensionsLoggingNet10Version>10.0.12</MicrosoftExtensionsLoggingNet10Version>
    <MicrosoftExtensionsOptionsNet10Version>10.0.12</MicrosoftExtensionsOptionsNet10Version>
    <MicrosoftExtensionsPrimitivesNet10Version>10.0.12</MicrosoftExtensionsPrimitivesNet10Version>
    <MicrosoftExtensionsHttpNet10Version>10.0.12</MicrosoftExtensionsHttpNet10Version>
    <SystemFormatsAsn1Net10Version>10.0.12</SystemFormatsAsn1Net10Version>
    <SystemSecurityCryptographyPkcsNet10Version>10.0.12</SystemSecurityCryptographyPkcsNet10Version>
    <SystemTextJsonNet10Version>10.0.12</SystemTextJsonNet10Version>
  </PropertyGroup>
  <!-- .NET 11.0 Package Versions -->
  <PropertyGroup Label="Net11">
    <!-- EF -->
    <MicrosoftEntityFrameworkCoreCosmosNet11Version>11.0.0-rc.1.26425.128</MicrosoftEntityFrameworkCoreCosmosNet11Version>
    <MicrosoftEntityFrameworkCoreDesignNet11Version>11.0.0-rc.1.26425.128</MicrosoftEntityFrameworkCoreDesignNet11Version>
    <MicrosoftEntityFrameworkCoreSqlServerNet11Version>11.0.0-rc.1.26425.128</MicrosoftEntityFrameworkCoreSqlServerNet11Version>
    <MicrosoftEntityFrameworkCoreToolsNet11Version>11.0.0-rc.1.26425.128</MicrosoftEntityFrameworkCoreToolsNet11Version>
    <!-- ASP.NET Core -->
    <MicrosoftAspNetCoreAuthenticationCertificateNet11Version>11.0.0-rc.1.26425.128</MicrosoftAspNetCoreAuthenticationCertificateNet11Version>
    <MicrosoftAspNetCoreAuthenticationJwtBearerNet11Version>11.0.0-rc.1.26425.128</MicrosoftAspNetCoreAuthenticationJwtBearerNet11Version>
    <MicrosoftAspNetCoreAuthenticationOpenIdConnectNet11Version>11.0.0-rc.1.26425.128</MicrosoftAspNetCoreAuthenticationOpenIdConnectNet11Version>
    <MicrosoftAspNetCoreOpenApiNet11Version>11.0.0-rc.1.26425.128</MicrosoftAspNetCoreOpenApiNet11Version>
    <MicrosoftAspNetCoreOutputCachingStackExchangeRedisNet11Version>11.0.0-rc.1.26425.128</MicrosoftAspNetCoreOutputCachingStackExchangeRedisNet11Version>
    <MicrosoftAspNetCoreTestHostNet11Version>11.0.0-rc.1.26425.128</MicrosoftAspNetCoreTestHostNet11Version>
    <MicrosoftExtensionsCachingStackExchangeRedisNet11Version>11.0.0-rc.1.26425.128</MicrosoftExtensionsCachingStackExchangeRedisNet11Version>
    <MicrosoftExtensionsDiagnosticsHealthChecksEntityFrameworkCoreNet11Version>11.0.0-rc.1.26425.128</MicrosoftExtensionsDiagnosticsHealthChecksEntityFrameworkCoreNet11Version>
    <MicrosoftExtensionsDiagnosticsHealthChecksNet11Version>11.0.0-rc.1.26425.128</MicrosoftExtensionsDiagnosticsHealthChecksNet11Version>
    <MicrosoftExtensionsFeaturesNet11Version>11.0.0-rc.1.26425.128</MicrosoftExtensionsFeaturesNet11Version>
    <MicrosoftAspNetCoreSignalRClientNet11Version>11.0.0-rc.1.26425.128</MicrosoftAspNetCoreSignalRClientNet11Version>
    <!-- Runtime -->
    <MicrosoftBclMemoryNet11Version>11.0.0-rc.1.26425.128</MicrosoftBclMemoryNet11Version>
    <MicrosoftExtensionsHostingAbstractionsNet11Version>11.0.0-rc.1.26425.128</MicrosoftExtensionsHostingAbstractionsNet11Version>
    <MicrosoftExtensionsHostingNet11Version>11.0.0-rc.1.26425.128</MicrosoftExtensionsHostingNet11Version>
    <MicrosoftExtensionsCachingMemoryNet11Version>11.0.0-rc.1.26425.128</MicrosoftExtensionsCachingMemoryNet11Version>
    <MicrosoftExtensionsConfigurationAbstractionsNet11Version>11.0.0-rc.1.26425.128</MicrosoftExtensionsConfigurationAbstractionsNet11Version>
    <MicrosoftExtensionsConfigurationBinderNet11Version>11.0.0-rc.1.26425.128</MicrosoftExtensionsConfigurationBinderNet11Version>
    <MicrosoftExtensionsConfigurationEnvironmentVariablesNet11Version>11.0.0-rc.1.26425.128</MicrosoftExtensionsConfigurationEnvironmentVariablesNet11Version>
    <MicrosoftExtensionsDependencyInjectionAbstractionsNet11Version>11.0.0-rc.1.26425.128</MicrosoftExtensionsDependencyInjectionAbstractionsNet11Version>
    <MicrosoftExtensionsFileSystemGlobbingNet11Version>11.0.0-rc.1.26425.128</MicrosoftExtensionsFileSystemGlobbingNet11Version>
    <MicrosoftExtensionsLoggingAbstractionsNet11Version>11.0.0-rc.1.26425.128</MicrosoftExtensionsLoggingAbstractionsNet11Version>
    <MicrosoftExtensionsLoggingNet11Version>11.0.0-rc.1.26425.128</MicrosoftExtensionsLoggingNet11Version>
    <MicrosoftExtensionsOptionsNet11Version>11.0.0-rc.1.26425.128</MicrosoftExtensionsOptionsNet11Version>
    <MicrosoftExtensionsPrimitivesNet11Version>11.0.0-rc.1.26425.128</MicrosoftExtensionsPrimitivesNet11Version>
    <MicrosoftExtensionsHttpNet11Version>11.0.0-rc.1.26425.128</MicrosoftExtensionsHttpNet11Version>
    <SystemFormatsAsn1Net11Version>11.0.0-rc.1.26425.128</SystemFormatsAsn1Net11Version>
    <SystemSecurityCryptographyPkcsNet11Version>11.0.0-rc.1.26425.128</SystemSecurityCryptographyPkcsNet11Version>
    <SystemTextJsonNet11Version>11.0.0-rc.1.26425.128</SystemTextJsonNet11Version>
    <MicrosoftExtensionsFileProvidersEmbeddedNet11Version>11.0.0-rc.1.26425.128</MicrosoftExtensionsFileProvidersEmbeddedNet11Version>
  </PropertyGroup>
</Project>
