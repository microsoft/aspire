{
  "sdk": {
    "version": "11.0.100",
    "rollForward": "major",
    "allowPrerelease": true,
    "paths": [
      ".dotnet",
      "$host$"
    ],
    "errorMessage": "The .NET SDK could not be found. Run ./restore.sh (Linux/macOS) or ./restore.cmd (Windows) to install the local SDK."
  },
  "tools": {
    "dotnet": "11.0.100",
    "runtimes": {
      "dotnet/x64": [
        "$(DotNetRuntimeNet10VersionForTesting)"
      ],
      "dotnet/arm64": [
        "$(DotNetRuntimeNet10VersionForTesting)"
      ],
      "aspnetcore/x64": [
        "$(DotNetRuntimeNet10VersionForTesting)"
      ],
      "aspnetcore/arm64": [
        "$(DotNetRuntimeNet10VersionForTesting)"
      ]
    }
  },
  "test": {
    "runner": "Microsoft.Testing.Platform"
  },
  "msbuild-sdks": {
    "Microsoft.Build.NoTargets": "3.7.134",
    "Microsoft.Build.Traversal": "4.1.82",
    "Microsoft.DotNet.Arcade.Sdk": "10.0.0-beta.26555.102",
    "Microsoft.DotNet.Helix.Sdk": "10.0.0-beta.26555.102",
    "Microsoft.DotNet.SharedFramework.Sdk": "10.0.0-beta.26555.102"
  }
}