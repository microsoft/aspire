<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
    <IsShippingPackage>false</IsShippingPackage>
    <IsShipping>false</IsShipping>
    <AssemblyName>CreateLayout</AssemblyName>
    <RootNamespace>Aspire.Tools.CreateLayout</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The SDK embeds producer framework values for standalone artifact discovery. -->
    <AssemblyMetadata Include="Aspire.Managed.TargetFramework" Value="$(DefaultTargetFramework)" />
    <AssemblyMetadata Include="Aspire.Dashboard.TargetFramework" Value="$(AspireDashboardTargetFramework)" />
    <AssemblyMetadata Include="Aspire.TerminalHost.TargetFramework" Value="$(AspireTerminalHostTargetFramework)" />
    <AssemblyMetadata Include="Aspire.Hosting.Native.Server.TargetFramework" Value="$(AspireNativeServerTargetFramework)" />
    <Compile Include="$(SharedDir)WindowsTrayPayload.cs" Link="WindowsTrayPayload.cs" />
    <Compile Include="$(SharedDir)LinuxTrayPayload.cs" Link="LinuxTrayPayload.cs" />
    <Compile Include="$(SharedDir)TerminalHostPayload.cs" Link="TerminalHostPayload.cs" />
    <InternalsVisibleTo Include="Infrastructure.Tests" />
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Infrastructure.Tests" />
  </ItemGroup>

</Project>
