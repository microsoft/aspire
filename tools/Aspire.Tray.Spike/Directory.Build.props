<Project>
  <!-- Use the base .NET SDK, not the macOS workload. Only the Mac project is bundled;
       Windows remains a standalone, unvalidated scaffold. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <BaseOutputPath>$(MSBuildThisFileDirectory)../../artifacts/bin/Aspire.Tray.Spike/$(MSBuildProjectName)/</BaseOutputPath>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)../../artifacts/obj/Aspire.Tray.Spike/$(MSBuildProjectName)/</BaseIntermediateOutputPath>
    <BaseOutputPath Condition="'$(MSBuildProjectName)' == 'Aspire.Tray.Spike.Mac'">$(MSBuildThisFileDirectory)../../artifacts/bin/Aspire.Tray/</BaseOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)Common/*.cs" Link="Common/%(Filename)%(Extension)" />
    <Compile Include="$(MSBuildThisFileDirectory)../../src/Shared/TrayCliProtocol.cs" Link="Common/TrayCliProtocol.cs" />
  </ItemGroup>
</Project>
